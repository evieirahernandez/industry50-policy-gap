  booktitle={2024 International Conference on Augmented Reality, Intelligent Systems, and Industrial Automation (ARIIA)}, 
  title={Smart Structures and Building Construction: Leveraging the Industrial Internet of Things (IIoT) and Digital Manufacturing for Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The use of the Industrial Internet of Things (IIoT) and digital manufacturing technologies with smart constructions and building construction will revolutionize smart buildings, leading to the development named Industry 5.0. This paper investigates the improvement in efficiency, sustainability, and safety of construction practices by using IIoT based advanced digital manufacturing techniques. Modern construction processes harness real-time data, predictive analytics, and automation to deliver unheard-of levels of precision and adaptability. The union of the Industrial Internet of things (IIoT) and digital manufacturing will not only maximize material usage and eliminate waste but will build the framework for intelligence in infrastructure that can self- monitor and work autonomously. Adoption will require a sea change in the way work is done, moving from more human centric efforts as well as more collaboration between man and machine, heralding the start of Industry 5.0! To propose an advanced approach Smart Structures and Building Construction: Leveraging IIoT and Digital Manufacturing for Industry 5.0},
  keywords={Technological innovation;Smart buildings;Costs;Real-time systems;Manufacturing;Safety;Intelligent structures;Fifth Industrial Revolution;Sustainable development;Industrial Internet of Things;IIoT;smart manufacturing;Industry 5.0;intelligent structures;construction innovation;real-time insights},
  doi={10.1109/ARIIA63345.2024.11051624},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11015388,
  author={Dwivedi, Gunjan and Parashar, Pranshuman and Jain, Pooja and Jain, Rachit},
  booktitle={2024 International Conference on Logistics and Industrial Engineering (ICLIE)}, 
  title={Logistics Performance and Economic Growth in Developing Economies within the Framework of Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Industry 5.0 is the uprising trend in which technology and manpower collaborate to increase efficiency. The idea behind is that progress cannot be achieved just through equipment and software, it can be grabbed with the help of human capital as well. This article was an effort to identify the linkage amid logistic performance and financial growth in scenario of industry 5.0. The data was taken from IMF and World Bank’s website for developing economies and analyzed through Unit Root Test, Johansen co-integration and regression assessment by E-views9 software. The results depicted that the improved performance of trade logistics also uplift the economic growth as the products need to be accessible to the end customers in timely manner which further enhances the customer demand, ultimately resulting into high profitability and economic growth.},
  keywords={Economics;Economic indicators;Profitability;Supply chains;Industrial engineering;Market research;Software;Indexes;Fifth Industrial Revolution;Logistics;Logistics;Economic Growth;GDP;Industry 5.0;Developing Economies},
  doi={10.1109/ICLIE61478.2024.11015388},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10993994,
  author={Parineeta and Dash, Chandra Sekhar},
  booktitle={2024 International Conference on Communication, Computing and Energy Efficient Technologies (I3CEET)}, 
  title={Leveraging Hybrid Models for DNS Spoofing Detection and Mitigation in the Financial Industry}, 
  year={2024},
  volume={},
  number={},
  pages={1741-1746},
  abstract={Threats from cyber security, especially DNS spoofing attacks have presented imminent dangers to the financial transaction and communication involved in financial sectors. In this work, we explore the performance of various hybrid deep learning approaches such as LSTM, CNN (with and without residual), LSTM-CNN, GRU-CNN in detecting DNS spoofing attack types at financial industry with proposed mitigation mechanism. We use a data-centric approach to harvest information from financial transactions and communications, extract features in our pipeline with extensive pre-processing capabilities, followed by value normalization. In our experiments, the models are trained and evaluated using accuracy, precision, recall, F1-score. Comparative analyses present LSTM-CNN, the best of all possible algorithms for both early detection and identification of DNS spoofing incidents.},
  keywords={Recurrent neural networks;Prevention and mitigation;Computational modeling;Pipelines;Feature extraction;Malware;Telecommunication computing;Convolutional neural networks;Computer crime;Financial industry;Convolutional Neural Networks;Recurrent Neural Networks;Graph Neural Networks;Industry 5.0;Malware detection},
  doi={10.1109/I3CEET61722.2024.10993994},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10994073,
  author={Aditya and Dash, Chandra Sekhar},
  booktitle={2024 International Conference on Communication, Computing and Energy Efficient Technologies (I3CEET)}, 
  title={AI-Driven Defense Mechanisms for Protecting Industry 5.0 from Android Malware Threats}, 
  year={2024},
  volume={},
  number={},
  pages={1735-1740},
  abstract={This study seeks to establish the level of accuracy of CNN, RNN, and GNN in the classification of Android malware threats in industrial 5. 0 applications. To notice the strengths and weaknesses of these neural network architectures the following evaluation metrics are used: precision, recall, F1-score, and accuracy. From the obtained results, it is seen that though CNNs provide fairly good accuracy and recall and log loss in most of the cases, RNNs succeed in sequential data analysis, and GNNs are significantly higher in precision and accuracy in case with graph data. Such conclusions reveal the applicability of GNNs to the tasks that call for fine-grained analysis of relations and high detection accuracy of malware. Thus, the research helps to advance knowledge on the strategic implementation of AI-based countermeasures to secure Industry 5. 0 from evolving cyber threats with a focus on GNNs’ applied relational learning.},
  keywords={Measurement;Industries;Accuracy;Recurrent neural networks;Malware;Graph neural networks;Energy efficiency;Telecommunication computing;Convolutional neural networks;Fifth Industrial Revolution;Convolutional Neural Networks;Recurrent Neural Networks;Graph Neural Networks;Industry 5.0;Malware detection},
  doi={10.1109/I3CEET61722.2024.10994073},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10998995,
  author={Deepanshi and Agarwal, Ankit and Gupta, Sakshi and Chaudhary, Aryan},
  booktitle={2nd International Conference on Pervasive Computing Advances and Applications (PerCAA 2024)}, 
  title={Industry 5.0: enhanced human-machine synergy for revolutionary innovation}, 
  year={2024},
  volume={2024},
  number={},
  pages={134-141},
  abstract={The dynamics of the human-machine interaction have evolved over time, influenced by technological advancements and shifts in manufacturing paradigms. Each industrial revolution has brought about significant changes, empowering machines with new functions and capabilities previously exclusive to humans. The way that technology and human labor have changed has been crucial to the development of industry, bring in technology integration every period. However, the point of view on these alterations and their developmental progression remain sufficiently examined. In order to fill this gap, this article examines the current state of human-machine collaboration and its future directions, with a focus on Industry 5.0. This new stage adds to Industry 4.0’s technological advancements while bringing people back into manufacturing. By exploring this link and its implications, we want to illuminate the trajectory of Industry 5.0 and its impact on global manufacturing. Our study is grounded in a comprehensive examination of specialist and general literature that investigate this developing partnership and its implications for future growth.},
  keywords={},
  doi={10.1049/icp.2025.0783},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10975327,
  author={Kardush, Igor and Kim, Sejeong and Wong, Elaine},
  booktitle={2024 IEEE Opto-Electronics and Communications Conference (OECC)}, 
  title={Enhancing Energy Efficiency in Optical Networks through AI-aided Orchestration and Traffic Prediction}, 
  year={2024},
  volume={},
  number={},
  pages={1-3},
  abstract={Industry 5.0 aims to enhance collaboration between humans and machines, building upon the advancements of Industry 4.0. To achieve this vision, ultra-reliable and low-latency human-to-machine communication is crucial. In this study, we investigate the energy efficiency implications of a proposed proactive protection scheme for optical enterprise networks. Our analysis focuses on the power savings achieved when implementing this scheme in different ITU-T PON protection schemes. The results show power savings of up to 35%. The choice of threshold for activating the backup protection path influences the trade-off between power saving and average availability. The Type A protection scheme showed no significant difference in power consumption, while Type B, C, and D schemes demonstrated varying degrees of power savings potential.},
  keywords={Optical fibers;Power demand;Energy conservation;Redundancy;Collaboration;Energy efficiency;Passive optical networks;Reliability;Protection;Fifth Industrial Revolution;Industry 5.0;optical enterprise network;power consumption;H2M communications;AI-aided network orchestration},
  doi={10.1109/OECC54135.2024.10975327},
  ISSN={2166-8892},
  month={June},}@INPROCEEDINGS{10974159,
  author={Venkatadri, Uday and Raj, Deepa and Diallo, Claver and Khatab, Abdelhakim},
  booktitle={2024 Artificial Intelligence Revolutions (AIR)}, 
  title={Estimating the Throughput of a Closed-Queuing Network Production System Using Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={109-116},
  abstract={Any production system comprising machines and material handling devices is prone to queuing effects and other uncertainties due to reliability issues. An estimate of the long-run throughput rate of the system is therefore important for release decisions in production planning. Within the Industry 5.0 context, there is frequent and real-time data capture through sensor technologies enabling the monitoring and control of such systems. In this paper, a Machine Learning approach is proposed to estimate the throughput of a system comprising unreliable machines with non-stationary processing times and an automated material handling device. We validate our approach through a context-based simulator that uses the Mean-Value Approximation for closed-network queuing systems.},
  keywords={Production systems;Uncertainty;Production planning;Materials handling;Materials reliability;Throughput;Real-time systems;Fifth Industrial Revolution;Random forests;Monitoring;Industry 5.0;Production Systems;Artifi-cial Intelligence;Context-based Simulation;Machine Learning;Throughput;WIP;Queuing;Reliability;Random Forest;Artificial Neural Networks},
  doi={10.1109/AIR63653.2024.00014},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10971757,
  author={Bandaranayake, K. M. S. U. and Rathnayake, Sunimal},
  booktitle={2024 IEEE/ACM 17th International Conference on Utility and Cloud Computing (UCC)}, 
  title={G-TRETA A Novel Multi-Objective Task Scheduling Algorithm in Cloud Computing}, 
  year={2024},
  volume={},
  number={},
  pages={259-267},
  abstract={Cloud computing has revolutionized the IT industry by granting users to access computing resources and services over the Internet. Cloud offers an array of benefits like on-demand, scalable, cost-effective, and reliable resources and services to end users. This revolutionized technology enables various computing capabilities and data requirements to cloud users making it one of the most used computing models in the IT industry today. Task scheduling is considered an NP-complete problem. Genetic algorithms are widely used to find an optimal schedule for a task-scheduling problem with multiple objectives. None of the previous studies has considered the total resource execution time of the virtual machine as a scheduling parameter for finding a better schedule using metaheuristics like genetic algorithms. In this study, we propose a novel fitness function considering total resource execution time and cost in finding an optimum schedule. Hence we propose a novel multi-objective genetic algorithm G-TRETA with the above fitness function. The proposed algorithm was compared with FCFS, MaxMin, MinMin and MCT algorithms for the degree of imbalance, makespan, cost, and system throughput. CloudSim 5.0 simulator and DEAP framework with synthetic data traces and Nasa Ames/iPSC 860 real world traces were used to evaluate the algorithm. From the evaluation results the proposed algorithm gives better results. We can observe 36.37% and 50.46% for makespan, 57.16%, 101.88% for system throughput, 1.47 and 0.94 differences of index improvement for the degree of imbalance for synthetic and real world traces respectively while having efficient cost values.},
  keywords={Industries;Cloud computing;Schedules;Job shop scheduling;Costs;Optimal scheduling;Throughput;Virtual machines;Genetic algorithms;Synthetic data;Cloud Computing;Multi-Objective Task Scheduling;Total Resource Execution Time Aware Scheduling;Genetic Algorithms},
  doi={10.1109/UCC63386.2024.00044},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10964972,
  author={Dhiman, Pummy and Singh, Swati and Bonkra, Anupam and Rana, Arun Kumar and Giri, Jayant and Sabri, Mohammad Omar},
  booktitle={2024 2nd International Conference on Emerging Trends in Engineering and Medical Sciences (ICETEMS)}, 
  title={Bibliometric Exploration of Healthcare Automation and Robotics Through the Lens of the Scopus Database}, 
  year={2024},
  volume={},
  number={},
  pages={723-728},
  abstract={The adoption of artificial intelligence improved medical processes, easing healthcare practitioners' workflow and, ultimately, making the healthcare industry an intelligent healthcare sector. Healthcare 5.0 is, driven by the rapid advancements in automation and robotics. These technologies are enhancing operational efficiency, reshaping care delivery, improving patient payoffs, and easing the load of medical staff. Automation in healthcare refers to using machines and software to perform tasks traditionally done manually, ranging from administrative duties to complex diagnostic processes. On the other hand, robotics involves the design and application of robots in various healthcare settings, including surgery, rehabilitation, and patient care. This study presents a comprehensive bibliometric analysis of healthcare automation and robotics research, focusing on the trends, developments, and scholarly impact within this rapidly evolving field.},
  keywords={Automation;Bibliometrics;Surgery;Medical services;Market research;Software;Artificial intelligence;Wearable devices;Robots;Medical diagnostic imaging;Smart healthcare;robotics;deep-medicine;wearable devices;artificial intelligence;healthcare 5.0},
  doi={10.1109/ICETEMS64039.2024.10964972},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10951049,
  author={Imtiaz, Sakib and Hashi, Emrana Kabir},
  booktitle={2024 6th International Conference on Sustainable Technologies for Industry 5.0 (STI)}, 
  title={Analyzing the Performance of Sentiment Analysis Using BERT, DistilBERT, RoBERTa and GPT-2}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Sentiment analysis, also known as opinion mining, employs natural language processing (NLP) techniques to determine, extract, and measure the emotional undertones within a text. This approach is valuable for measuring public sentiment and interests across various domains, including social media discussions, product and movie reviews, among others. Techniques like Linear Regression, Support Vector Machines, Convolutional Neural Networks (CNN), Recurrent Neural Networks (RNN), and Long Short-Term Memory (LSTM) are utilized in analyzing sentiments. However, these are no comparison to the capabilities of the pre-trained transformer models such as BERT, DistilBERT, RoBERTa, and the recent large language model (LLM) GPT-2, which offer significantly enhanced performance and flexibility. This study employs the Sentiment140 dataset to evaluate sentiments expressed in tweets, utilizing four advanced transformer-based models: BERT, DistilBERT, RoBERTa, and GPT-2. The sentiment analysis conducted within this research framework focuses on accuracy as the primary performance metric. The findings of the analysis indicate that the GPT-2 model outperforms its counterparts by achieving an impressive accuracy of 94.13%, thereby demonstrating its superior capability in handling sentiment analysis tasks. This study not only reinforces the efficacy of transformer-based models in processing complex language data but also highlights the cutting-edge potential of GPT-2 to revolutionize sentiment analysis in social media contexts. Furthermore, the integration of these technologies aligns with the principles of Industry 5.0 by enhancing human-machine collaboration, thus driving more personalized, efficient, and sustainable technological advancements. By leveraging such sophisticated models, businesses can harness real-time sentiment analysis to foster a more responsive and sustainable operational framework, ultimately contributing to smarter and more sustainable technology deployments.},
  keywords={Sentiment analysis;Analytical models;Accuracy;Recurrent neural networks;Social networking (online);Transformers;Data models;Convolutional neural networks;Fifth Industrial Revolution;Long short term memory;Sentiment Analysis;Natural Language Processing;BERT;DistilBERT;RoBERTa;GPT-2},
  doi={10.1109/STI64222.2024.10951049},
  ISSN={2996-170X},
  month={Dec},}@INPROCEEDINGS{10951154,
  author={Ghosh, Sudipto and Chandra, Papel and Asaduzzaman, Md. and Emon, Md. Rabiul Hasan and Foyes, Abul and Rahman, Md. Mahfuzur and Das, Shrabani and Ahammed, Md. Tabil},
  booktitle={2024 6th International Conference on Sustainable Technologies for Industry 5.0 (STI)}, 
  title={PCF-SPR Sensor for Carbonated Drinks Detection Using Random Forest}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper explores the design and performance of a photonic crystal fiber-based surface plasmon resonance (PCF-SPR) sensor for detecting different types of carbonated drinks. The sensor geometry was optimized and analyzed using the Finite Element Method (FEM), with Random Forest employed to predict and enhance its sensitivity. Input parameters such as core diameter, cladding structure, and gold layer thickness were varied, generating a dataset for training the RF model. Experimental simulations revealed that the sensor achieved a maximum sensitivity of 22,000 nm/RIU, with a minimum wavelength resolution of 4.55 × 10−5RIU. Accurately detecting carbonation levels in drinks ensures quality, consistency, and customer satisfaction in the food and beverage industry. Moreover, monitoring alcohol content in beverages is essential for regulatory compliance and product labeling, as well as for meeting consumer expectations. The ability to analyze alcohol levels alongside carbonation adds a new dimension to beverage quality assessment, offering a comprehensive solution for manufacturers. Random Forest demonstrated superior predictive capabilities, reducing computational overhead by 93% compared to traditional optimization techniques. This work demonstrates a novel approach for integrating machine learning into PCF-SPR sensor design, paving the way for applications in beverage quality control and aligning with Industry 5.0 and supporting sustainable technology.},
  keywords={Sensitivity;Accuracy;Quality control;Predictive models;Surface plasmon resonance;Finite element analysis;Labeling;Random forests;Optimization;Monitoring;PCF;SPR Sensor;Random Forest;Carbonated Drinks Detection;Refractive Index;Confinement Loss;Finite Element Method etc},
  doi={10.1109/STI64222.2024.10951154},
  ISSN={2996-170X},
  month={Dec},}@INPROCEEDINGS{10951100,
  author={Dipto, Durjoy Roy and Shib, Sowrov Komar and Rahman, Md Tanvir and Shihab, Saidur Rahman and Dip Sarker, Md Sums and Hosen, Saroar},
  booktitle={2024 6th International Conference on Sustainable Technologies for Industry 5.0 (STI)}, 
  title={Integrating Net-Metering and Feed-in- Tariff Schemes to Balance Electricity Billing System}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Integrating renewable energy sources into existing power grids necessitates effective mechanisms for incentivizing generation and managing surplus energy. This study presents a comparative analysis of two prominent incentive mechanisms, namely Feed-in Tariff (FiT) and Net Metering, focusing on their outcomes in managing surplus power generated by Photovoltaic (PV) systems and industrial loads. This study demonstrates a bidirectional net metering system designed mainly for grid-connected PV panels used by residential consumers. The system effectively controls the difference between imported electricity from the grid and surplus energy exported to the grid. It manages this using a sophisticated bidirectional net meter with voltage and current measurement circuitry. These circuits correctly measure the system's instantaneous voltage and current levels, allowing for precise tracking of electricity flow. Through a comprehensive examination of real-world data and simulation models, insights are derived into the performance and economic implications of FiT and net metering systems. According to the study, FiT saves 6.31 % on monthly energy bills, whereas net metering saves slightly less (4 %). The findings contribute to understanding optimal strategies for integrating renewable energy sources that align with Industry 5.0 and Sustainable Technology while ensuring grid stability and economic viability.},
  keywords={Meters;Renewable energy sources;Voltage measurement;Electricity;Current measurement;Tariffs;Production;Stability analysis;Reliability;Fifth Industrial Revolution;PV System;Net Meter;Utility Grid;Feed-in tariff (FiT);Industrial Billing;Consumers},
  doi={10.1109/STI64222.2024.10951100},
  ISSN={2996-170X},
  month={Dec},}@INPROCEEDINGS{10951093,
  author={Sohel, Amir and Rahman, Md Mizanur and Zubaer, Talha and Rifat, Rifatul Islam and Majumder, Partha Protim and Bijoy, Md. Hasan Imam},
  booktitle={2024 6th International Conference on Sustainable Technologies for Industry 5.0 (STI)}, 
  title={Improving Pneumonia Detection in X-ray Images with Hybrid Deep Learning Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Pneumonia is a lung ailment caused by bacterial or viral infections marked by swelling and trouble breathing deeply. Chest X-rays are a typical way to diagnose, which is so important. This study examines the implementation of deep learning approaches for pneumonia identification through chest X-ray images. The dataset has images of chest X-rays arranged based on whether they are pneumonia cases or not, and these categories are further split into train, test, and validation folders. Providing a dataset comprising 5,863 JPG format X-rays, which are 4,273 Pneumonia and 1,583 Normal, the dataset is a worthy resource for training and verifying deep learning methods in distinguishing pneumonia from a normal X-ray. The methodology that takes place in training the deep learning model is a progressive process, starting with preprocessing steps and executing morphological operations and histogram equalization. Transfer learning comes into play by using pretrained models that have been made from various existing architectures such as MobileNetV2, DenseNet201, VGG19, and Xception, which are used to extract features from the images, either alone or in a hybrid model that integrates features from multiple models. The models performed adequately, with MobileNetV2 achieving the maximum accuracy of 97.43%, followed closely by DenseNet201 at 96.57% and Xception at 95.87%. VGG19 recorded the lowest accuracy at 92.39%. Combining MobileNetV2 and DenseNet201 into a hybrid model notably improved accuracy to 99.10%. In the context of Industry 5.0, these models serve as collaborative instruments for radiologists, enhancing their ability to evaluate images from X-rays with more accuracy and efficiency, so augmenting the role of the human expert rather than substitutes it.},
  keywords={Deep learning;Training;Pneumonia;Accuracy;Transfer learning;X-rays;Feature extraction;Fifth Industrial Revolution;X-ray imaging;Biomedical imaging;Pneumonia detection;Hybrid model;Chest X-ray;Deep learning},
  doi={10.1109/STI64222.2024.10951093},
  ISSN={2996-170X},
  month={Dec},}@INPROCEEDINGS{10951050,
  author={Khan, Tahsina and Emon, Md Mehedi Hasan and Rahman, Sadia},
  booktitle={2024 6th International Conference on Sustainable Technologies for Industry 5.0 (STI)}, 
  title={Marketing Strategy Innovation via AI Adoption: A Study on Bangladeshi SMEs in the Context of Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study investigates the impact of Artificial Intelligence (AI) adoption on marketing strategy innovation among small and medium enterprises (SMEs) in Bangladesh, within the context of Industry 5.0. The research aims to identify the factors influencing AI-driven marketing innovation and how these factors contribute to strategic advancements. A quantitative research design was employed, collecting data from 165 SMEs through a structured questionnaire. Structural Equation Modelling (SEM) using SmartPLS was applied to examine the relationships between the independent variables— Perceived Usefulness (PU), Perceived Ease of Use (PEOU), Industry 5.0 Readiness (I5), Organizational Support (OS), Competitive Pressure (CP), and Cost of AI Implementation (CAI)—and the dependent variable, Marketing Strategy Innovation (MSI). The findings revealed that PEOU, I5, OS, and CP positively influence marketing strategy innovation, while PU was found to have an insignificant impact. Additionally, CAI negatively impacted innovation, though SMEs with strong organizational support and external pressures still innovated despite cost concerns. These results underscore the importance of organizational readiness and user-friendly AI systems in driving innovation. The study's limitations include a focus on Bangladeshi SMEs, which may limit generalizability. Further research is needed across different regions and industries. This research offers insights for SME managers and policymakers to focus on improving AI accessibility and support structures to foster marketing innovation. By highlighting the role of AI in marketing innovation, the study emphasizes the need for technological upskilling and capacity building in developing economies. This study contributes to the literature by exploring AI adoption in the context of Industry 5.0 within Bangladeshi SMEs, addressing a gap in research on AI-driven innovation in developing economies. The limitations of the study include generalizability to other industries and regions, as well as a limited sample size.},
  keywords={Industries;Technological innovation;Costs;Numerical analysis;Biological system modeling;Scholarships;Mathematical models;Research initiatives;Artificial intelligence;Fifth Industrial Revolution;Artificial Intelligence;Marketing Strategy Innovation;SMEs;Industry 5.0;Bangladesh;Structural Equation Modelling},
  doi={10.1109/STI64222.2024.10951050},
  ISSN={2996-170X},
  month={Dec},}@INPROCEEDINGS{10951063,
  author={Akter, Bushra and Tamim, Zannat Hossain and Yeasmim, Sabina and Rahman, Md. Sazzadur},
  booktitle={2024 6th International Conference on Sustainable Technologies for Industry 5.0 (STI)}, 
  title={Exploring the Future of Education Through Implementing Virtual Reality to Enhance Learning Outcomes: A Practical Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper introduces an innovative approach to leveraging Virtual Reality (VR) technology in educational settings, specifically tailored to meet the demands of Industry 5.0. VR technology refers to computer-generated simulations of three-dimensional environments that users can interact with using specialized equipment like VR headsets. The aim of this study is to explore how VR can enhance student learning experiences. The methodology involves a comprehensive process of designing, creating, and implementing an immersive VR environment using Unity 3D. This includes integrating detailed 3D models and interactive elements to replicate historical settings, facilitating experiential learning. The VR environment incorporates an essential audio section to enrich immersion through spatial sound and contextual auditory cues, enhancing the overall learning experience. Additionally, the VR environment features object detection capabilities where students can interact with virtual objects and receive real-time feedback, such as object names and contextual information. This interactive component aims to deepen engagement and understanding of educational content through hands-on exploration. This research contributes to the field by showcasing practical applications of VR in education, highlighting its potential to transform traditional learning methods. By providing students with interactive virtual environments that integrate audio and object recognition technologies, this approach fosters innovative pedagogical practices and explores the future possibilities of immersive learning technologies.},
  keywords={Headphones;Solid modeling;Three-dimensional displays;Education;Virtual environments;Transforms;Real-time systems;Object recognition;Fifth Industrial Revolution;Immersive learning;Immersive learning;Unity 3D;VR;Oculus2;VR headset;Industry 5.0},
  doi={10.1109/STI64222.2024.10951063},
  ISSN={2996-170X},
  month={Dec},}@INPROCEEDINGS{10951088,
  author={Muhtasim, Dewan Ahmed and Pavel, Monirul Islam and Paul, Arindrajit and Amin, Ruhul and Shakib, Abdul Wadud and Limon, Md. Shamihul Islam Khan and Hasan, Md. Mahfujul},
  booktitle={2024 6th International Conference on Sustainable Technologies for Industry 5.0 (STI)}, 
  title={Novel Ensemble Model Utilizing Artificial Neural Networks and Boosting Regressors for Estimation of PM2.5 Concentrations}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Industrial activities have released liquid droplets, solid particles, and gas molecules into the atmosphere, with high concentrations of particulate matter (PM2.5) posing serious health risks, making the assessment of particulate matter concentration crucial for enhancing human well-being and aligning with Industry 5.0's focus on sustainable and human-centric development. To tackle this issue, this study proposes a novel ensemble model based on artificial neural networks and boosting regressors (XGBoost, CatBoost, and LightGBM) to forecast PM2.5 levels using data from eight cities in Beijing, China, spanning from 2010 to 2017. The ensemble model utilizes the bootstrap aggregating method and is evaluated with Root Mean Square Error (RMSE) and the Coefficient of Determination (R2). The model's performance surpasses existing models, achieving a significantly lower RMSE of 0.076 and an impressive R2 of 0.999, indicating high accuracy. Estimating PM2.5 concentrations is crucial for sustainable industry, enabling effective air quality management, regulatory compliance, public health protection, and cleaner production practices.},
  keywords={Atmospheric modeling;Urban areas;Artificial neural networks;Predictive models;Boosting;Air pollution;Fifth Industrial Revolution;Public healthcare;Forecasting;Bagging;Air pollution;pm2.5;ANN;xgboost;lightgbm;catboost;bagging},
  doi={10.1109/STI64222.2024.10951088},
  ISSN={2996-170X},
  month={Dec},}@INPROCEEDINGS{10942898,
  author={Colombi, Lorenzo and Brina, Matteo and Vespa, Michela and Tabanelli, Filippo and Dahdal, Simon and Bellodi, Elena and Venanzi, Riccardo and Tortonesi, Mauro and Vignoli, Massimiliano and Stefanelli, Cesare},
  booktitle={2024 IEEE 29th International Workshop on Computer Aided Modeling and Design of Communication Links and Networks (CAMAD)}, 
  title={Optimizing Industry 5.0 Machine Learning-Based Applications via Synthetic Data Generation}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Machine Learning (ML) innovations are revolutionizing industrial processes by improving productivity and competitiveness, particularly by creating predictive maintenance applications and Artificial Intelligence (AI) powered services. In the Industry 5.0 paradigm, which strives to reach Zero Defect and Zero Waste Manufacturing, the role of ML is crucial for optimizing these processes. However, developing ML solutions for production-ready industrial settings presents various challenges, such as data scarcity and dataset imbalance, which are further amplified when dealing with tabular data. To overcome such issues we investigate the use of various Deep Generative Models (DGMs) to generate synthetic data that closely mimics real-world conditions. Despite extensive studies of DGMs in the literature, there is still limited knowledge of their practical suitability in Industry 5.0 environments. Our research includes a detailed evaluation of several DGMs, such as Generative Adversarial Networks, Variational Autoencoders, and Diffusion Models, implemented in the gearbox assembly and testing line in the Bonfiglioli EVO plant. Based on our results, the evaluated DGMs demonstrate significant potential in generating high-quality synthetic data, that allows training a high-performance classifier to distinguish faulty gearboxes from well-functioning ones.},
  keywords={Training;Technological innovation;Computational modeling;Autoencoders;Generative adversarial networks;Diffusion models;Data models;Fifth Industrial Revolution;Synthetic data;Testing;Industry 5.0;Machine Learning;Deep Generative Model;Generative Adversarial Network;Diffusion Model;Variational Autoencoder},
  doi={10.1109/CAMAD62243.2024.10942898},
  ISSN={2378-4873},
  month={Oct},}@INPROCEEDINGS{10949439,
  author={Shradha, C. S. and Aaradhana, D. A.},
  booktitle={8th IET Smart Cities Symposium (SCS 2024)}, 
  title={Beyond boundaries: quantum cryptography safeguarding industry 5.0 in smart cities}, 
  year={2024},
  volume={2024},
  number={},
  pages={303-308},
  abstract={In the realm of advancing smart cities within the paradigm of Industry 5.0, the integration of technologies like the Internet of Things (IoT) presents transformative opportunities alongside heightened cybersecurity risks. Classical cryptographic methods, crucial for securing digital communications, face escalating threats from quantum computing capabilities. Quantum cryptography, specifically Quantum Key Distribution (QKD), emerges as a promising solution. By leveraging principles from quantum mechanics, QKD ensures unparalleled security by using quantum states of particles to protect the confidentiality and integrity of transmitted data. This research explores the principles of QKD and its application within Industry 5.0 contexts, encompassing IoT, artificial intelligence (AI), and cyber-physical systems. Case studies underscore the feasibility of integrating quantum cryptography into smart city infrastructures, demonstrating its efficacy in enhancing security despite initial complexities. The study proposes strategic investments in research and development, policy frameworks, educational initiatives, and pilot projects to facilitate the widespread adoption of quantum cryptography. Additionally, the paper discusses implications, identifies research gaps, and outlines future directions for further exploration in this critical area.},
  keywords={},
  doi={10.1049/icp.2025.0928},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10935138,
  author={Wang, Jinwei and Du, Zhiguo and Wen, Bin and Wu, Zhihui and Lin, Xudong},
  booktitle={2024 International Conference on Machine Learning and Cybernetics (ICMLC)}, 
  title={A Detection Method for Lion-Head Goose in Complex Scenes Based on Rcd-Yolo}, 
  year={2024},
  volume={},
  number={},
  pages={39-45},
  abstract={To address the challenges of detecting Lion-head goose in complex scenes such as multi-scale targets and occlusion in farming environments, we propose a method based on improved YOLOv8n, named RCD-YOLO. Firstly, the standard convolution module CBS of the backbone is replaced with the Receptive-Field Attention Convolution (RFAConv) module to enhance the network's ability to extract features of Lion-head geese. Secondly, the neck is replaced with the improved CNN-based Cross-scale Feature Fusion (CCFM) network to enhance the network's multi-scale feature fusion capability for feature of Lion-head geese at different scales. Finally, the head is replaced with DynamicHead (DyHead) component to enhance the detection ability for occluded Lion-head geese in farming environment by employing scale-aware, spatial-aware, and task-aware attention mechanisms. Experimental results show that the precision (P), recall (R), mAP@0.5 and mAP@0.5:0.95 of RCD-YOLO are 90.6%, 84.6%, 91.5% and 59.9%, respectively. Compared to YOLOv8n, these metrics have improved by 1.6%, 2.9%, 1.7%, and 2.5%, respectively. This method can achieve visual detection of Lion-head geese in complex scenes in actual farming environments and provide a reference for the Lion-head Goose farming industry, contributing to its intelligence.},
  keywords={YOLO;Measurement;Deep learning;Visualization;Convolution;Feature extraction;Magnetic heads;Neck;Standards;Farming;YOLO;Lion-head Goose;Multi-scale Features;Computer Vision;Object Detection;Deep Learning},
  doi={10.1109/ICMLC63072.2024.10935138},
  ISSN={2160-1348},
  month={Sep.},}@INPROCEEDINGS{10927958,
  author={Bouzarkouna, Imen and Benatia, Mohamed Amin and Sahnoun, M'hammed},
  booktitle={2024 International Conference on Computer and Applications (ICCA)}, 
  title={Fog-Enabled Metaverse: Common Points in an Industry 5.0 Context}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The industrial Metaverse is a virtual world where people and smart machines can meet, work, and interact. It is a constantly evolving domain where physical production assets such as machines, factories, grids, and transportation systems, along with human operators, are represented by interactive virtual objects. However, creating such a virtual world requires an efficient process for data collection, processing, and transmission that can meet real-time requirements. To address this challenge, Fog-based architecture has been designed to cope with the massive data processing and transmission needs by splitting the processing task over a set of parallel Fog nodes. This technology is more cost-effective and efficient for industries. In this paper, we explore the use of the Fog computing architecture for deploying industrial metaverse applications. We identify and explain the challenges that arise during this deployment, with the aim of facilitating their resolution. To meet the real-time requirements of Industry 5.0 application, we propose an industrial metaverse architecture based on Fog-computing nodes. This architecture will enable efficient data collection, processing, and transmission while providing a virtual world where people and machines can interact seamlessly.},
  keywords={Industries;Metaverse;Transportation;Computer architecture;Data collection;Real-time systems;Production facilities;Manufacturing;Fifth Industrial Revolution;Edge computing;Industry 5.0;industrial metaverse;fog computing;manufacturing application},
  doi={10.1109/ICCA62237.2024.10927958},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10935268,
  author={Gyamfi, Eric and Ansere, James Adu and Kamal, Mohsin and Mir, Suleman and Bonsu, Kusi Ankrah},
  booktitle={2024 19th International Conference on Emerging Technologies (ICET)}, 
  title={Adaptive Federated Blockchain-powered Security for MEC-assisted Industrial IoT Ecosystems}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Secure communication is essential for the Industrial Internet of Things (IIoT), but most IIoT devices cannot run conventional security models due to resource constraints. Multi-access mobile edge computing (MEC) brings computational resources closer to the network edge but struggles with scalability and flexibility in centralized security solutions. Distributed data processing on MEC servers also raises privacy and security concerns. This paper proposes a novel IIoT network security using federated blockchain (FB) and machine learning-based (ML) verification. MEC optimizes the FB model to ensure data integrity and confidentiality between the IIoT's local network cluster and external devices. Data within the local network cluster are secured with public-key cryptography. The ML-based verification model ensures legitimate key-pair updates and device joining in MEC-assisted IIoT. This approach outperforms conventional security solutions in scalability, data privacy, and adaptability to IIoT network changes. We present a detailed implementation and evaluate its performance using a realistic IoT testbed, showing improved network security while maintaining the performance and scalability of MEC-assisted IIoT systems.},
  keywords={Performance evaluation;Data privacy;Multi-access edge computing;Scalability;Biological system modeling;Computational modeling;Network security;Security;Fifth Industrial Revolution;Industrial Internet of Things;Industrial Internet of Things;Federated Blockchain;Multi-access Mobile Edge Computing;Cryptography;Deep Learning;Industry 5.0},
  doi={10.1109/ICET63392.2024.10935268},
  ISSN={2994-5798},
  month={Nov},}@INPROCEEDINGS{10931478,
  author={Rossi, Arthur and Leitao, Paulo and Pontes, Joseane},
  booktitle={2024 IEEE 3rd Industrial Electronics Society Annual On-Line Conference (ONCON)}, 
  title={Multi-Dimensional Layers Framework for Classifying Waste in Industrial Plants}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The transition from Industry 4.0 to Industry 5.0 introduces new challenges in waste management, particularly digital, energy and human waste. However its not clear how to classify and categorize without creating new dilemmas in the 8 traditional established wastes from Lean theory. To solve this problem, this paper aims to develop a multi-dimensional layers framework to classify waste by making a interpretation of the traditional lean principles into a digital and sustainable layer perspective. The methodology involves projecting the 8 lean wastes onto physical, digital, and sustainable layers, allowing for a comprehensive waste characterization. With this, its presented a framework that identifies various types of digital waste, such as defective data and excessive non-value-adding data, and highlights the energy inefficiencies and human factors associated with digital transformation. The results shows the framework's ability to provide a n organized approach to attempt to classification new wastes typologies without creating new wastes and keeping the Lean theory at its original state. As such, this study contributes to the literature by expanding the concept of digital waste and integrating sustainability into waste typology and providing the implications of the layer expansion for future research.},
  keywords={Waste management;Technological innovation;Uncertainty;Digital transformation;Human factors;Robustness;Sustainable development;Fifth Industrial Revolution;Organizational aspects;Stress;Digital Transformation;Sustainable Waste;Digital Waste},
  doi={10.1109/ONCON62778.2024.10931478},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10927096,
  author={Shombot, Emmanuel Song and Dusserre, Gilles and Bestak, Robert and Ahmed, Nasir Baba},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Multilabel Classification in IoT NIDS: A Proposed Cross Machine Learning Pipeline}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={Network Intrusion Detection Systems (NIDS) are among the most dynamic cybersecurity assets in most organizations' cyber infrastructure because they provide a reliable means of protection against cyberattacks. In recent years, the expansion of Industry 5.0 technologies has resulted in more IoT devices being connected to the Internet, increasing attack surfaces and placing additional burden on NIDS. In the research world, ML-based solutions for IoT NIDS are evolving very quickly. However, the availability of high-quality publicly available datasets in this area diminishes the potential of this niche. This work compares three IoT-based datasets (ToN-IoT, X-IIoTID and UNSWNB15) through in-depth analysis of their features and architecture. The goal is to assess their readiness for a proposed cross-machine learning pipeline for the purpose of generalizability of the multi-label classification ML model. Using key ML performance metrics such as F1 score, precision, and recall, our results show that our model performed reasonably well in identifying different attack scenarios on each dataset.},
  keywords={Measurement;Pipelines;Standards organizations;Network intrusion detection;Multi label classification;Machine learning;Organizations;Internet of Things;Reliability;Protection;Machine Learning (ML);Artificial Intelligence (AI);Network Intrusion Detection Systems (NIDs);Cybersecurity;Internet of things (IoT)},
  doi={10.1109/NIGERCON62786.2024.10927096},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{10924352,
  author={Prasad, Kapu V Sri Ram and Sai, Neteti Sowmya and Kavya, Runkana and Rajana, Mounika and Sowjanya, Kundrapu and Gowthami, Bokam},
  booktitle={2024 International Conference on Sustainable Power & Energy (ICSPE)}, 
  title={Online Monitoring of Induction Motor to Prevent Faults Through Internet of Things}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The induction motor-(IM) contributes a major part of industrial production and its monitoring is important to increase its reliability and efficiency. This article develops several advantages of using the Cadio app for Internet of Things-based online IM monitoring to avoid unexpected failure to fulfill industry 5.0 standards. Remote control and monitoring of the motor can help to avoid unforeseen disturbances. Universally the IM is monitored for the exterior factors, such as temperature, humidity, and the interior parameters, such as current, voltage. If the machine is run with abnormal internal and external characteristics, the motor is connected to the Internet of Things and is set to shut off. Moreover, if the motor is operated above rated currents for long duration, where the IM is programmed to discontinue the operation automatically. Online operation and monitoring are available to predict temperature, humidity, voltage, and current under various loading scenarios. If the IM is operated above its rated current (6A) for long duration, then the machine is instantaneously shutdown or by using online platform the IM can turned off when abnormal parameters are identified. Therefore, to prevent unanticipated damage, the machine can automatically stop if it continues in an aberrant condition. Finally, the Internet of Things allows for the analysis of the motor's behaviour and performance in a variety of failure circumstances, guaranteeing the dependability of the induction motor in real-time applications.},
  keywords={Temperature sensors;Temperature measurement;Induction motors;Temperature;Loading;Humidity;Real-time systems;Finite element analysis;Internet of Things;Monitoring;Internet of Things;Cardio App;Induction Motor;ESP32-WiFi Module;LCD Display;IoT;Internet of Things;IM;Induction Motor;FEM;Finite Element Method;BRB;Broken rotor bars;BF;Bearing Faults;FVA;Forced Vibration Analysis;MCSA;Motor Current Signature Analysis;DT;Digital twin;ANNs;Artificial Neural Networks;RTDs;Resistance Temperature Detectors;BLE;Bluetooth Low Energy;SMPS;switch mode Power supplies},
  doi={10.1109/ICSPE62629.2024.10924352},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10925718,
  author={Varma, Abhilasha and Vajpayee, Aparna and Sanghani, Parag},
  booktitle={2024 International Conference on Intelligent & Innovative Practices in Engineering & Management (IIPEM)}, 
  title={Organizational Culture of Industry 5.0: Exploration Analysis in Multinational and National Companies}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The evolution of Industry 5.0 signifies a pivotal juncture in the industrial landscape, emphasizing the convergence of human capabilities and advanced technologies. At the heart of this transformative era, the interplay between organizational culture and the principles of Industry 5.0 emerges as a critical determinant of success. This research embarks on an exploration of this dynamic relationship, employing a robust methodology to scrutinize diverse perspectives within multinational and national companies. The study conceptualizes organizational culture as a multifaceted framework encompassing explicit values, implicit norms, and unwritten rules. It explores how these cultural dimensions influence behavior within organizations, impacting their readiness for Industry 5.0 adaptation. The findings, grounded in a robust methodology, offer practical recommendations for cultivating adaptive cultures aligned with the transformative principles of this new industrial era.},
  keywords={Industries;Heart;Technological innovation;Navigation;Companies;Cultural differences;Fifth Industrial Revolution;Convergence;Industry 5.0;Organizational Culture;Innovation;Technological Adoption;Multinational Companies;National Companies;Adaptability},
  doi={10.1109/IIPEM62726.2024.10925718},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10923782,
  author={Narong, David Kongpiwatana},
  booktitle={2024 IEEE 13th International Conference on Engineering Education (ICEED)}, 
  title={Breaking Barriers: Examining Accessibility Research Within the Realm of Engineering Education Between 1986 and 2023}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Exploration of disability representation within engineering education has been limited. There is also a noticeable absence of dedicated reviews on accessibility despite its potential to enhance inclusivity in engineering education. This bibliometric review of research aims to fill the knowledge gap by analyzing 252 Scopus-indexed publications spanning from 1986 to 2023. The descriptive analysis reveals a growing body of literature, primarily contributed by economically developed countries. Citation analysis identifies influential scholars, institutions, and sources, further enriching our understanding and knowledge of this domain. Moreover, keyword co-occurrence analysis uncovers key topics and research themes, including e-learning, assistive technologies, and learning systems and guidelines. Additionally, the study identifies research fronts indicating a shift toward Industry 4.0-related topics focused on promoting user-centered design, inclusion, equity, and accessible education through the use of cognitive technologies, artificial intelligence, augmented reality, and virtual learning. This study concludes by discussing notable gaps in the knowledge base and future research opportunities in such areas as curriculum designs, pedagogical approaches, Industry 5.0, and systematic integration of accessibility, ultimately aimed at enhancing inclusive education, enriching the learning experience, and improving learning outcomes for all students regardless of their abilities and backgrounds within engineering education.},
  keywords={Industries;Technological innovation;Electronic learning;Systematics;User centered design;Knowledge based systems;Stakeholders;Engineering education;Systematic literature review;Guidelines;disability;diversity;equity;inclusion;accessibility;engineering education;inclusive education;systematic review},
  doi={10.1109/ICEED62316.2024.10923782},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10920518,
  author={Shu, Xiaotong and Xu, Lin and He, Zhenzhi and Sheng, Lianchao and Ye, Guo and Lu, Xiangning},
  booktitle={2024 International Conference on Sensing, Measurement & Data Analytics in the era of Artificial Intelligence (ICSMD)}, 
  title={Wafer Defect Detection Based on YOLO-BA}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={With the advancement of the chip industry, manufacturing processes have become increasingly sophisticated, resulting in a significant rise in the scale and complexity of integrated circuits. This complexity has rendered wafer manufacturing processes more intricate, leading to a higher probability and diversity of wafer defects. To enhance production yield and improve process control, it is essential to identify defects and address the corresponding issues. This paper presents an improved wafer detection algorithm, YOLOBA, based on YOLOv10n. The approach incorporates Bottleneck Transformers (BoT) and Adaptive Kernel Convolution (AKConv) into the backbone network, effectively suppressing interference from complex background information while reducing feature redundancy in both spatial and channel dimensions. This facilitates more efficient feature extraction of wafer defects while maintaining the lightweight nature of the model. Experimental results demonstrate that the improved algorithm achieves a 0.9% higher recall rate, a 0.8% increase in mAP@0.5_0.95, and a 0.4% improvement in mAP@0.5 compared to the latest YOLOv10n model, all while maintaining similar parameter counts and GFLOPs.},
  keywords={Semiconductor device modeling;Manufacturing processes;Termination of employment;Production;Chatbots;Feature extraction;Transformers;Complexity theory;Kernel;Defect detection;Wafer;Defect Detection;Deep Learning;YOLOv10;Self-Attention Mechanism},
  doi={10.1109/ICSMD64214.2024.10920518},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10920390,
  author={Nyakudya, Petronella and Madushele, Nkosinathi and Madyira, Daniel M. and Matare, Ezekiel Evans},
  booktitle={2024 International Conference on Electrical and Computer Engineering Researches (ICECER)}, 
  title={Embracing Digital Twin Technology to Enhance Efficacy of Industrial Symbiosis: A Path to Sustainability}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The need to transition to a Circular Economy (CE) has prompted the industry to embrace strategies like Industrial Symbiosis (IS). IS promotes sustainable resource management by facilitating materials exchange, energy, water, and by-products between industries, converting waste streams into valuable inputs across interconnected firms. This paper seeks to present how IS networks, guided by the principles of Reduction, Reuse, Recycle, Recover, Redesign, and Remanufacture (D6R framework) may lead to efficient use of resources and waste minimisation. In this work, different industries were surveyed to explore how the D6R principles can be used to promote Sustainable Resource Management through the collaboration and exchange of resources to create a closed-loop system ensuring waste from one process or industry becomes valuable input for another. Synergistic networks are formed within the clusters and waste is reused, reduced, and recycled. adopting these principles ensures longevity of the natural resources as well as a more sustainable and resilient future. Moreover, with the emergence of the fourth Industrial Revolution, the industry is moving towards Smart Manufacturing and The Digital Twin Technology (DTT) can be applied in industry to enhance efficacy of IS towards sustainability. Digital Twin Technology DTT combined with the D6R Framework can create a powerful approach for Industrial Symbiosis. By integrating DTT with the D6R principles, firmss can monitor and optimize resource flows, prioritize sustainable practices, and initiate collaborative adeptness across the symbiotic network. This paper seeks to explore the efficacy of DTT in IS towards sustainable use and management of resources. By harnessing Digital Twin Technology, industries engaged in symbiotic networks can achieve operational efficiency, save cost, and attaion environmental sustainability. The ability to monitor, replicate, and optimise resource flows in real time allows companies to achieve sustainability. As DTT continues to progress and becomes more accessible, its contribution to the efficacy of IS will only progress, leading to sustainably effective industrial ecosystems.},
  keywords={Industries;Symbiosis;Costs;Real-time systems;Digital twins;Recycling;Resource management;Sustainable development;Monitoring;Smart manufacturing;Circular Economy;Digital Twin Technology;Industrial Symbiosis;Industry 4.0;Industry 5.0;Smart Manufacturing;Sustainability},
  doi={10.1109/ICECER62944.2024.10920390},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10919595,
  author={Monia, Ibrahim and Bechir, Dadi Mohamed. and Chibani, RHAIMI B.},
  booktitle={2024 IEEE International Multi-Conference on Smart Systems & Green Process (IMC-SSGP)}, 
  title={A Medical Platform as an Impact of Digital Transformation}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Technological innovations such as wearable technologies, information technology, virtual reality and the Internet of Things have become an integral part of our daily lives, and have contributed to the transformation of healthcare activities and operations. Patients will have a wider range of more thoughtful care options and experience a new era of care with a patient-centric culture. Hence digital transformation is shaping individual and organizational healthcare. The aim of this article is to talk about the transition of Tunisia to Industry 4.0, to discuss the changes in the healthcare sector due to digital transformation, the realization of a telemedicine platform and the technologies used to realize the latter.},
  keywords={Technological innovation;Telemedicine;Medical services;Virtual reality;Real-time systems;Delays;Internet of Things;Biomedical monitoring;Information technology;Monitoring;industry 4.0;Industry 5.0;Digital transformation;Tunisia;telemedicine},
  doi={10.1109/IMC-SSGP63352.2024.10919595},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10925930,
  author={Svertoka, Ekaterina and Rusu-Casandra, Alexandru and Burget, Radim and Nurmi, Jari and Ometov, Aleksandr},
  booktitle={European Wireless 2024; 29th European Wireless Conference}, 
  title={Towards Industry 5.0 Positioning with k-NN-based Enhanced LoRaWAN Localization}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The usability of Long Range Wide Area Network (LoRaWAN) for localization remained a white space on the navigation map of modern Industry 5.0 wireless technology. Many traditional approaches proved to be not usable for meaningful accuracy. Nonetheless, this paper serves as a culmination of our investigation into the potential of LoRaWAN for localization, synthesizing our key discoveries and advancement. Besides that, the paper brings two key contributions. First, it introduces two new underground LoRaWAN datasets, serving as assets for researchers and practitioners in the field. Secondly, it proposes two innovative k–nearest neighbors (k–NN)-based algorithms aimed at enhancing position estimation accuracy by optimizing nearest neighbor selection. The integration of the preprocessing strategies with the proposed algorithms leads to accuracy improvement of 17.2%, underscoring the potential of LoRaWAN-based localization in sectors where high precision is not paramount.},
  keywords={},
  doi={},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10912992,
  author={Li, Dong and Zhang, Jiahui},
  booktitle={2024 6th International Conference on Frontier Technologies of Information and Computer (ICFTIC)}, 
  title={A New Energy Battery Lightweight Network Based on YOLOv8}, 
  year={2024},
  volume={},
  number={},
  pages={1426-1429},
  abstract={With the rapid development of the new energy battery industry and the increasing demand for intelligent management systems, higher requirements for efficient and low-consumption detection technology have been put forward. Aiming at the problems of high complexity and high computational requirements of existing models, we propose a lightweight neural network model based on deep learning. Specifically, we replace the backbone network in the traditional model with StarNet as the base network, and replace the Bottleneck structure in C2f with its unique StarBlock, and optimize the detection header to accelerate the model training and improve the computational efficiency. The experimental results show that this improved strategy has achieved remarkable results. Improved YOLOv8n Lightweight Model mAP@0.5 Improved by 0.6%, mAP@0.5:0.95 Improved by 0.5%, reaching 81.2%. While maintaining the detection accuracy, the number of parameters has been reduced by 54.46%, the computational complexity has been reduced by 44.44%, the model volume has been reduced by 58.73%, and more importantly, the detection frame rate has been increased by 21.5 FPS. This allows the improved model to show great utility in the task of detecting defects in battery appearance in a real factory environment.},
  keywords={Training;Measurement;Solid modeling;Accuracy;Computational modeling;Neural networks;Object detection;Production facilities;Batteries;Computational complexity;YOLOv8;surface defect detection;lightweight Model;new energy battery},
  doi={10.1109/ICFTIC64248.2024.10912992},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10914433,
  author={Venmani, Daniel Philip and Zerradi, Fares and Hamma, Fatiha and Jahan, Bruno and Singh, Kamal},
  booktitle={2024 IEEE Virtual Conference on Communications (VCC)}, 
  title={Timing-As-A-Service (TAAS): Over-the-Air Synchronization method for Industrial IoT}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a new device model termed as ‘Smart Precision Time Protocol (s-PTP) gateway’. This gateway creates a logical interface between the cellular systems (5G, 5G+, etc.) and the Industrial IoT (IIoT) systems. The goal of this gateway is to synchronize IIoT use cases located inside a factory. It is based on a novel business and operational model that we termed as “Timing-As-A-Service (TAAS)”. TAAS aims to provide the industrial customers, particularly small and medium businesses, with high precision timing accuracy for Industry 4.0 and future Industry 5.0 use cases. Simulation results illustrate the solution's effectiveness, which shows that the 90th percentile timing error falls below the stringent threshold of 900 ns for IIoT use cases defined by 3GPP, even up to distances of 3km.},
  keywords={Service robots;Wireless networks;Simulation;Logic gates;Production facilities;Fourth Industrial Revolution;Synchronization;3GPP;Industrial Internet of Things;Business;Time synchronization;Industry 4.0;TAAS;IIoT},
  doi={10.1109/VCC63113.2024.10914433},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10910391,
  author={Supriya, Pallam and Kumar, Putluru Sravan and Akshaya, Palem and Akhil, Yaragoti and VenkataNaresh, M.},
  booktitle={2024 International Conference on Innovative Computing, Intelligent Communication and Smart Electrical Systems (ICSES)}, 
  title={Automated Cloth Quality Grading for E-Commerce Platform Using Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={In textile industry automation is very necessary for the better productivity and quality control of cloth inspection, especially in large manufacturing operations. The automated cloth quality detection and grading model that we propose in this research has low, medium, and high levels for cloth quality. It uses Python's ML libraries, and the classifiers used are random forest and logistic regression classifiers, along with the Adam optimizer for faster training. The data is labelled fabric image, pre-calibrated with label size and quality. Accuracy, precision, recall and F1 score are all measures by which we assess how good the model is at classification. The results have good accuracy and recall, which shows that the model does well at separating out different quality levels of fabric. The F1 score also confirms that the model is balanced in precision and recall, making it a good choice for field-based quality control applications. The automated system is sure to save you a lot of money and deliver better consistency and scalability, making it a great alternative to the manual inspections. In future updates, deep learning might be implemented to further optimize and upscale accuracy and scalability for larger textile datasets. Features such as high texture accuracy, medium colour detail, and thread densities of 52–299 are also used to distinguish between different quality states. There are tally and evaluate defects, from 0 to 9. Other key attributes are stretchability (low, medium, high), fabric thickness (thin to thick) and qualitative softness index (soft to rough). Moisture absorbency, pilling resistance and tear strength scores help narrow the classification; pilling resistance scores range from 9 to 10 and tear strength is between 5.0 and 49.4. This is evaluated by accuracy, precision, recall, and F1 score of the model. They show excellent classification with 92%accuracy, 90% precision, 88% recall, and 89% F1 score — the model is a well-balanced model for applications in the real world of quality control. The system is able to save money, ensure consistency, and expand as compared to manual checks. Future projects include deep learning to improve accuracy and scalability across textile datasets.},
  keywords={Resistance;Deep learning;Accuracy;Scalability;Quality control;Manuals;Inspection;Fabrics;Textile industry;Random forests;Fabric quality detection;Fabric Grading;Machine learning;Random Forest;logistic regression;Adam optimizer;Texture uniformity;Colour homogeneity;Thread densities;Defect counts;Stretchability;Thickness of fabric;Softness;Moistness retention;Pilling Resistance;Toughness;Textile Industry Automation},
  doi={10.1109/ICSES63760.2024.10910391},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10905116,
  author={Kolesnikov, Mikhail and Lossi, Leonardo and Alberti, Enrico and Atmojo, Udayanto Dwi and Vyatkin, Valeriy},
  booktitle={IECON 2024 - 50th Annual Conference of the IEEE Industrial Electronics Society}, 
  title={Addressing Privacy and Security Challenges at the Industry 5.0 Human-Intensive and Highly Automated Factory Floor}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={With Industry 5.0, prioritizing worker well-being, the integration of human-related data into production processes poses challenges related to data privacy and compliance with regulations such as GDPR. This paper presents a comprehensive approach to anonymizing sensitive data collected from wearable devices. We propose a methodology that combines real-time processing and complex anonymization algorithms, ensuring end-to-end protection. We employ techniques such as normalization, hashing, and feature dropping. Our findings contribute to advancing privacy-preserving techniques in Industry 5.0 and underscore the importance of safeguarding user privacy in the era of advanced manufacturing.},
  keywords={Data privacy;Privacy;Regulation;Real-time systems;Production facilities;Information filtering;Fifth Industrial Revolution;Wearable devices;Protection;Information integrity;Cybersecurity;Industry 5.0;Anonymization},
  doi={10.1109/IECON55916.2024.10905116},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10904393,
  author={Muhtar, Muhtar and Suryanti, Suryanti and Bachri, Bachtiar Sjaiful},
  booktitle={2024 6th International Workshop on Artificial Intelligence and Education (WAIE)}, 
  title={Virtual Labs Uses in Vocational High School: A Bibliometric Analysis}, 
  year={2024},
  volume={},
  number={},
  pages={411-414},
  abstract={The utilization of virtual laboratories is an effort in the era of digital technological advances to achieve maximum learning objectives. Vocational High School (VHS) aims to produce productive age human resources who are ready to work. In addition, vocational schools emphasize aspects of softskills the needs of industry 4.0 and social development 5.0 including 4C skills (communication, collaboration, critical thinking, creative). The purpose of this bibliometric analysis is to present information on the utilization of virtual laboratories in the vocational sector. Articles were searched through the Scopus, Dimensions, ERIC, Taylor & Francis and Springer databases. 326 suitable articles were collected from 2021–2024 and 132 articles were further analyzed. We used VOSviewer software to classify and visualize co-occurrence and citations. The information presented in this review can be used as a starting point for future research on the topic of vocational education virtual laboratories.},
  keywords={Visualization;Reviews;Databases;Conferences;Laboratories;Education;Bibliometrics;Collaboration;Software;Artificial intelligence;Virtual laboratory;vocational education;vocational high school},
  doi={10.1109/WAIE63876.2024.00080},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10903487,
  author={Norcéide, Flore Stécie and Aoki, Emi and Tran, Vinh and Nia, Masoumeh Farhadi and Thompson, Charles and Chandra, Kavitha},
  booktitle={2024 International Conference on Machine Learning and Applications (ICMLA)}, 
  title={Positional Tracking of Physical Objects in an Augmented Reality Environment Using Neuromorphic Vision Sensors}, 
  year={2024},
  volume={},
  number={},
  pages={1031-1036},
  abstract={Immersive systems such as Augmented Reality (AR) devices are being integrated across multiple domains, from manufacturing to health, environment and education. The Industry 5.0 focus on human-centric interfaces to these systems and the desire to enable them for enhancing the skill-sets of the user, present new challenges. One of these is the accurate positional tracking of objects within the AR user's environment that is relevant in real-time applications. Multiple co-located frame based cameras are typical solutions proposed for object tracking in AR. The advent of commercial neuromorphic vision sensors (NVS) in recent years, introduce a novel, event-based approach to computer vision. Inspired by biological vision, these systems reduce the amount of data transferred and enhance power efficiency when tracking in real-time. This work leverages the strengths of AR and NVS technologies to develop an integrated system for tracking physical objects and providing users with required information to interact with these objects in a virtual environment. The computational pipeline from training on a deep neural network, coordinate transformations from image, to physical and virtual coordinate systems and testing the utility of the system for an AR system user is presented. The NVS system shows significant improvement over frame camera based systems in responding to varied lighting conditions.},
  keywords={Training;Neuromorphics;Pipelines;Lighting;Medical treatment;Artificial neural networks;Vision sensors;Cameras;Real-time systems;Augmented reality;neuromorphic vision sensor;augmented reality;coordinate transformation;positional tracking;virtual annotation},
  doi={10.1109/ICMLA61862.2024.00155},
  ISSN={1946-0759},
  month={Dec},}@INPROCEEDINGS{10898417,
  author={Vyas, Abhishek and Lin, Po-Ching and Hwang, Ren-Hung},
  booktitle={2024 IEEE International Conference on Advanced Networks and Telecommunications Systems (ANTS)}, 
  title={FedSplit-HIDS: A Host-Based Intrusion Detection Framework for Heterogeneous Industrial IoT Environments}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper presents FedSplit-HIDS, a novel framework aimed at host-based intrusion detection within diverse Industrial Internet of Things (IIOT) environments. The proposed system utilizes a two-fold strategy: Apply federated learning (FL) for devices with ample resources, while incorporating split learning (SL) along with edge computing and FL for devices with limited resources. This approach effectively handles the challenge of processing varied data across multiple IIoT platforms. To enhance privacy protection, localized Rényi differential privacy (L-RDP) is applied at the device level, ensuring the security and privacy of local model parameters and gradients. FedSplit-IDS is equipped to identify a wide range of known intrusions, cyber attacks, and malware that are common in IIoT environments. We suggest that this framework outperforms existing intrusion detection systems in IIoT environments in various evaluation metrics, thus strengthening the critical security infrastructure for Industry 5.0 and integrated cyber-physical manufacturing systems.},
  keywords={Threat modeling;Privacy;Intrusion detection;Robustness;Real-time systems;Telecommunications;Sensors;Servers;Protection;Industrial Internet of Things;IIoT;Host-based-IDS;Heterogeneous devices;Varied data;Federated learning;Split learning;Edge servers},
  doi={10.1109/ANTS63515.2024.10898417},
  ISSN={2153-1684},
  month={Dec},}@INPROCEEDINGS{10896155,
  author={Verma, Rishita and Indra, Gaurav},
  booktitle={2024 IEEE International Conference on Intelligent Signal Processing and Effective Communication Technologies (INSPECT)}, 
  title={ZAIA: Zero-trust Authentication and Identity Attestation Framework for AI-Enabled IIoTs in Smart Manufacturing Ecosystem}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In the evolving landscape of B5G/6G-enabled AI-based Industrial Internet of Things (AIeIIoTs) crucial for Smart Manufacturing Industry 5.0 (SMIE), this research introduces ZAIA, a NIST-Zero Trust Architecture (NIST-ZTA)-based identity attestation and key agreement framework. Tailored for Split Learning in 6G-SMIE/ AIeIIoTs, ZAIA enhances security by integrating NIST-Principles of Least Privilege (NIST-POLP). It employs NIST-ZTA to eliminate trust assumptions between the edge-enabled Access Point (EAP) and cloud-enabled remote Authentication Server (CAS), ensuring robust cryptographic authentication. ZAIA features a resilient anonymity-preserving cryptographic framework using AES-128 in Galois-Counter Mode (GCM) and Symmetric Key Cryptography for mutual authentication, providing strong defense against various threats. Simulations and real-time testing demonstrate ZAIA's significant optimization in computational cost (12.5%) and communicational cost (14.29%), over current methods in resource-constrained 6G-AIeIIoTs. Formal and informal security analyses, including Scyther-Formal Security Analysis Tool, further validate ZAIA's robust security in the 6G-AIeIIoTs environment.},
  keywords={6G mobile communication;Authentication;Signal processing;Real-time systems;Zero Trust;Cryptography;Servers;Smart manufacturing;Industrial Internet of Things;Testing;Zero Trust;Identity Attestation;AI-enabled AIeIIoT devices (AID);Edge-enabled Access Point(EAP);Cloud enabled-remote Authentication Server(CAS)},
  doi={10.1109/INSPECT63485.2024.10896155},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10894663,
  author={Rukh, Lala and Ahmad, Yasir and Uz Zaman, Uzair Khaleeq and Tiwana, Mohsin Islam and Naseem, Afshan},
  booktitle={2024 International Conference on Robotics and Automation in Industry (ICRAI)}, 
  title={Development and Evaluation of a Machine Learning Model for Cobot Action Prediction: Optimizing Algorithms Through Cognitive Workload Metrics}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Collaborative robots (Cobots) have replaced traditional industrial robots on the factory floors, enhancing automation and efficiency. From the perspective of Industry 5.0, centering around H.F. (Human Factors), concerns about cognitive ergonomics persist as Cobots' unpredictable actions can increase cognitive workload and reduce productivity. Identifying and prioritising the operators' mental and physical well-being is necessary for safer and more efficient Human Robot Collaboration (HRC). This paper proposes a novel machine-learning model for Cobot action prediction and evaluates which algorithm is best for predicting Cobot actions based on operators' cognitive states. 75 participants with different levels of technophobia, technical expertise, and age collaborated with a Cobot to solve a complex maze puzzle. Firstly, each participant's Cognitive Workload (CWL) was measured using a combination of subjective and objective metrics (NASA-Task Load index, Heart Rate Variability, and Error Rate), followed by the development of a machine learning model that takes human factors as input parameters and predicts Cobot's actions accordingly. This study evaluates various machine learning models for Cobot action prediction and identifies that the Random Forest Classifier outperforms other models with an accuracy of 90%. The model can be implemented in various industrial settings to improve HRC safety and operators' cognitive ergonomics.},
  keywords={Productivity;Service robots;Ergonomics;Collaborative robots;Human factors;Predictive models;Prediction algorithms;Safety;Random forests;Load modeling;Human Robot Collaboration;Industry 5.0;Cognitive workload;NASA-TLX;Heart Rate Variability;Random Forest Regression},
  doi={10.1109/ICRAI62391.2024.10894663},
  ISSN={2831-3313},
  month={Dec},}@INPROCEEDINGS{10893144,
  author={Cristerna- Villegas, Juan G. and Solís-Flores, Juan Pablo and Aguilera-Herrera, Silvestre and Matienzo-Cruz, Francisco Carlos and Vázquez-Villegas, Patricia},
  booktitle={2024 IEEE Frontiers in Education Conference (FIE)}, 
  title={Developing Student's Skills and Competencies in the Field of Architecture, Engineering, and Construction (AEC) Industry 5.0 in Mexico}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={This innovative practice full paper describes implementing a challenge-based learning (CBL) strategy in civil engineering education to develop the discipline competencies needed for the next generation of workers in the Architecture, Engineering, and Construction (AEC) Industry. First, it discusses the challenges and opportunities in the AEC following the 5th industrial revolution and highlights the required competencies. Next, we describe implementing a challenge-based learning (CBL) approach as an educational intervention for skills development in the final semester of a civil engineering program at a private Mexican Higher Education Institution. The challenge for the students was to design project components and plan the construction phase for a real construction company. This challenge encompasses everything from the pavement, hydrological studies, and the potable water network to the structural design of the architectural project. A Building Information Management (BIM) tool was included in the challenge for the first time. The entire process was conducted using the BIM methodology and advanced computational tools. The challenge accounts for the involvement of 16 specialized professors in various study areas, demonstrating the interdisciplinary approach taken in the program. From these experience results, it can be concluded that the students showed a genuine interest in the BIM methodology, which aims to integrate all areas of the construction processes through an organized and transparent workflow to avoid deviations and delays in deliverables. Furthermore, the manuscript explains the sessions with the training partner, emphasizing the importance of collaboration and communication between the students and the industry representatives. This needs negotiation, management, operational, digital, and advanced technical skills, which are aimed to be developed during this CBL intervention. Ultimately, this work highlights challenges, opportunities, and the importance of higher education in preparing students for their impact on the AEC Industry 5.0.},
  keywords={Industries;Training;Building information management;Collaboration;Computer architecture;Companies;Delays;Fifth Industrial Revolution;Civil engineering;Next generation networking;educational innovation;higher education;STEM},
  doi={10.1109/FIE61694.2024.10893144},
  ISSN={2377-634X},
  month={Oct},}@INPROCEEDINGS{10891111,
  author={Alvarado, A. and Meneses, H. and Loría, S. and Ruíz, F.},
  booktitle={2024 IEEE Central America and Panama Student Conference (CONESCAPAN)}, 
  title={Low Scale Semi-Automatic Process for the Assembly of SMD Components in Printed Circuit Boards}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents an innovative and fast process for the assembly of surface mounted devices (SMD) in printed circuit boards (PCBs). The methodology described in this work was applied in the assembly of PCBs that will be used to process the voltage signals coming from Wheatstone bridge circuits that measure the strain signals of a force-torque sensor. The main contributions of this paper relies on the fact that the whole process is presented in a clear and simple way, and this can motivate and help potential users, in the design and assembly of PCBs for their own applications.},
  keywords={Industries;Voltage measurement;Force measurement;Ovens;Surface mount technology;Manuals;Strain measurement;Calibration;Soldering;Strain;industry 5.0;pick and place machine;printed circuit board;reflow soldering;surface mounted technology},
  doi={10.1109/CONESCAPAN62181.2024.10891111},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10878184,
  author={Bouaziz, Nourddine and Bettayeb, Belgacem and Sahnoun, M'hammed and Yassine, Adnan},
  booktitle={2024 IEEE International Conference on Technology Management, Operations and Decisions (ICTMOD)}, 
  title={Modeling and Simulation of Worker Profiles in Production Systems Based on Punctuality, Fatigue, and Experience}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The integration of worker behavior profiles into production systems is essential for improving performance and ensuring efficiency in terms of productivity, quality, safety, and worker well-being. This paper presents a model that simultaneously represents worker punctuality, fatigue, and experience through simulation. A Markov chain is employed to model punctuality, while fatigue and experience are captured through some functional models inspired by the literature. The developed simulator enables the exploration of multiple experimental scenarios, illustrating the impact of these factors on production performance. This provides valuable insights for dynamic and anticipatory decision-making. The results indicate that various considerations must be taken into account when selecting worker profile preferences, highlighting the importance of worker allocation on operator productivity.},
  keywords={Productivity;Industries;Production systems;Technology management;Decision making;Fatigue;Safety;Resource management;Industry 5.0;Human-system interaction;Markov chain;Simulation;Throughput},
  doi={10.1109/ICTMOD63116.2024.10878184},
  ISSN={2159-5119},
  month={Nov},}@INPROCEEDINGS{10878170,
  author={Bader, Mariam and Jayaraman, Raja and Goonetilleke, Ravindra S},
  booktitle={2024 IEEE International Conference on Technology Management, Operations and Decisions (ICTMOD)}, 
  title={The Role of Technology in Mitigating Process Improvement Project Failures: A Qualitative Study}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Implementing process improvement projects is critical for organizations steering toward enhanced efficiency and competitiveness. However, companies often struggle to succeed with process improvement projects, with a high failure rate of up to 70%. This paper investigates the role of technology in mitigating failures in process improvement projects, drawing insights from semi-structured interviews with 19 prominent process improvement practitioners. While organizations initially relied on Excel spreadsheets to track the progress of projects, the study highlights the transition towards advanced tools and digital solutions. The findings suggest that these tools facilitate real-time monitoring and visualization, data collection and analysis, communication, and risk management. Furthermore, the research emphasizes the importance of human-automation integration. While digitalization and automation are significant, human involvement remains essential for effective failure mitigation. This perspective aligns with the concept of Industry 5.0, which emphasizes that the actual value of technology lies in its ability to augment human capabilities rather than replace them. This paper provides managers with insights to make strategic decisions about technology adoption, ensuring they remain informed about practical tools and technologies that could avert failures and contribute to better project outcomes.},
  keywords={Surveys;Technology management;Prevention and mitigation;Instruments;Data visualization;Data collection;Real-time systems;Interviews;Fifth Industrial Revolution;Immune system;Process Improvement Failures;Failure Mitigation;Technology},
  doi={10.1109/ICTMOD63116.2024.10878170},
  ISSN={2159-5119},
  month={Nov},}@INPROCEEDINGS{10880251,
  author={Martinelli, Matteo and Pietri, Marcello and Rossini, Enrico and Picone, Marco and Mamei, Marco},
  booktitle={2024 32nd International Conference on Enabling Technologies: Infrastructure for Collaborative Enterprises (WETICE)}, 
  title={Digital Twin Driven Collaboration in Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={104-109},
  abstract={This paper explores the integration of Digital Twins (DTs) in Industry 4.0 and 5.0, highlighting their role in enhancing intelligent, collaborative industrial ecosystems. By representing processes, machinery, operators, and products, DTs enable comprehensive life-cycle support and improved shop-floor operations. Intelligent applications and services can harness DTs as structured and interoperable virtual replicas, entrusted with the responsibility of interfacing with the physical world and facilitating access and mediation of interactions therein. Our study proposes structured DT modeling in industrial ecosystems to demonstrate how DTs enable an effective decoupling of responsibilities and capabilities supporting precise monitoring and data synthesis, optimizing production workflows and maintenance. We discuss DTs’ potential in industrial quality control, highlighting efficiency gains and operational improvements in electric motor production through case studies.},
  keywords={Ecosystems;Redundancy;Collaboration;Production;Quality control;Data models;Digital twins;Mediation;Monitoring;Predictive maintenance;Digital Twin;Industrial Internet of Things;Industry 4.0;Industry 5.0;DT collaboration;DT specialization},
  doi={10.1109/WETICE64632.2024.00027},
  ISSN={},
  month={June},}@INPROCEEDINGS{10874931,
  author={Nahar, Priyanka and Ghuraiya, Avdhesh and Voronkov, Ilia Mikhailovich and Kharlamov, Alexander Alexandrovich},
  booktitle={2024 8th International Conference on Information, Control, and Communication Technologies (ICCT)}, 
  title={IoT System Architecture for a Smart City}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Industry 5.0 has transformed manufacturing with smart factories as a key component. This report reviews the latest research on smart factories and industrial data management. Focusing on automation, AI, machine learning, big data and virtualization Technologies such as IoT and crowd sensing enable continuous data collection for real-time decision making and human-machine collaboration. We present a smart factory architecture that combines edge computing for local processing and cloud analytics with various communication technologies. To increase safety, efficiency, and connectivity in modern factories},
  keywords={Cloud computing;Machine learning;Computer architecture;Real-time systems;Production facilities;Communications technology;Fifth Industrial Revolution;Virtualization;Smart manufacturing;Edge computing;Cloud Computing;System Architecture;Machine Learning;Edge Computing;Industry 5.0},
  doi={10.1109/ICCT62929.2024.10874931},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10867215,
  author={Wadhwa, Sheela Narang and Bhardwaj, Garima and Pratap Srivastava, Arun},
  booktitle={2024 1st International Conference on Sustainable Computing and Integrated Communication in Changing Landscape of AI (ICSCAI)}, 
  title={Analysis of Techniques to Ensure Data Security and Employee Privacy in E-HRM Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper analyses the data security and privacy concerns in electronic Human Resource Management (E-HRM) systems, focusing on the challenges introduced by digitalization and how to deal with such issues. Using an exploratory research approach based on secondary data, the study explores the landscape of cyber threats, including external attacks and insider risks, faced by organizations relying on E-HRM systems. Findings reveal the importance of balancing advanced data management capabilities with robust data protection measures to mitigate risks. The study emphasizes the need for a proactive approach to cybersecurity, combining technological solutions with organizational policies. It underscores the significance of ongoing employee education and training on data security best practices and the necessity for organizations to stay abreast of legal and regulatory changes in data protection. This research serves as a valuable resource for HR professionals and organizational leaders seeking to enhance the security and integrity of their e-HRM systems amidst the evolving digital landscape.},
  keywords={Training;Law;Data security;Data protection;Focusing;Organizations;Human resource management;Computer security;Artificial intelligence;Best practices;E-HRM;Data Security;Employee Privacy;Industry 5.0},
  doi={10.1109/ICSCAI61790.2024.10867215},
  ISSN={},
  month={July},}
