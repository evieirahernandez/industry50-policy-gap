  author={Wu, Fan and Li, Xiong and Kumari, Saru and Alenazi, Mohammed J. F. and Chen, Chien-Ming},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={CFDAS: A Customer-Centric and Fault-Tolerant Data Aggregation Scheme for Smart Grid in 6G Networks Keeping Unlinkability Under the Conception Industry 5.0}, 
  year={2025},
  volume={71},
  number={2},
  pages={4359-4367},
  abstract={For Industry 5.0, people collaborate with artificial intelligence machines and robots, where the aim is beyond productivity. With customer-centric services, the smart grid evolves with the promotion of 6G and Industry 5.0. Data aggregation is necessary for analyzing accumulated consumption, adjusting demand and response, and predicting the trend. A host of data aggregation schemes for the smart grid considering security have been proposed. However, the hazard of information leaking still exists. Security features like fault-tolerance and unlinkability in aggregation schemes are hot problems that require discussions. In this paper, we propose our data aggregation scheme CFDAS for the smart grid with blockchain assistance in 6G networks under the concept of Industry 5.0. By employing a traditional three-layer structure, the aggregation process can be executed based on different consumption categories at fog nodes and control center. Formal verification proves that our scheme exhibits resistance to forgery attacks. Also, it satisfies usual security features like unlinkability and fault-tolerance. Compared to several recent schemes, ours performs well in time and communication overhead and is practical for 6G networks.},
  keywords={Data aggregation;Smart grids;Fifth Industrial Revolution;Smart meters;6G mobile communication;Security;Fault tolerant systems;Fault tolerance;Public key;Blockchains;Unlinkability;customer-centricity;formal proof;fault-tolerance;data aggregation},
  doi={10.1109/TCE.2024.3509437},
  ISSN={1558-4127},
  month={May},}@ARTICLE{10768909,
  author={Marcon, Érico and Marodin, Giuliano Almeida and Frank, Alejandro G.},
  journal={IEEE Transactions on Engineering Management}, 
  title={Combining Organizational and Social Factors to Support Industry 4.0 Implementation: A Sociotechnical and Configurational Analysis of Technology Adopters}, 
  year={2025},
  volume={72},
  number={},
  pages={146-160},
  abstract={Industry 4.0 has been conceived to enhance factory productivity, significantly impacting social aspects such as hierarchical structures, workers' skills, and operational routines. As digital technologies reshape factory activities, the need to support workers and their social environment has become crucial. This article discusses the importance of viewing Industry 4.0 as a sociotechnical system where human and technological elements interact. Despite the recognition of sociotechnical factors in the existing literature, a key gap remains: the interrelation of these factors is often overlooked. We propose using the configurational view, which considers different patterns of sociotechnical configurations within organizations. We analyze 132 manufacturing companies, identifying four distinct sociotechnical configurations. The results indicate that companies combining both social and organizational factors—termed “sociotechnical masters”—achieve the highest performance levels. We contribute to the literature by demonstrating how the integration of sociotechnical and configurational theories offers a more comprehensive framework for interpreting and guiding Industry 4.0 implementation. From a practical standpoint, we provide a detailed list of organizational and social factors to assist managers in establishing a balanced sociotechnical system that supports the successful adoption of Industry 4.0 technologies. In addition, we show how the combination of these factors can improve operational performance metrics.},
  keywords={Fourth Industrial Revolution;Companies;Production facilities;Sociotechnical systems;Social factors;Productivity;Safety;Production systems;Fifth Industrial Revolution;Telephone sets;Industry 4.0;Industry 5.0;manufacturing;sociotechnical systems;workers},
  doi={10.1109/TEM.2024.3506991},
