address = {New York, NY, USA},
url = {https://doi.org/10.1145/3672758.3672891},
doi = {10.1145/3672758.3672891},
abstract = {This research focuses on the significance of proactive interaction in L3 autonomous vehicles, aiming to enhance driving safety and user experience through innovative methods. Leveraging existing automotive industry hardware and software technologies, we have developed an innovative proactive interaction model and approach, which has been validated in specific project environments. This study intelligently adjusts driver tasks, significantly reducing driving risks and enabling efficient and smooth interaction between drivers and vehicles. The successful application in Dongfeng Motor Corporation not only provides a valuable reference for the development of autonomous driving technology but also demonstrates the remarkable effectiveness of proactive interaction in improving safety and user experience in L3 autonomous driving. These findings will offer precious guidance and insights for future related research, driving continuous advancements in autonomous driving technology.},
booktitle = {Proceedings of the 3rd International Conference on Computer, Artificial Intelligence and Control Engineering},
pages = {802–810},
