numpages = {7}
}

@inproceedings{10.1145/3704657.3704690,
author = {Liu, Chunhui and He, Yunli},
title = {Performance analysis of energy cascade management strategy for thermal management system of new energy vehicles},
year = {2024},
isbn = {9798400710667},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3704657.3704690},
doi = {10.1145/3704657.3704690},
abstract = {With the worsening of energy crisis and environmental pollution, as well as the introduction of the national "dual carbon" policy, new energy vehicles have experienced rapid development. The thermal management system of new energy vehicles plays a crucial role in ensuring vehicle performance, extending range, and improving energy efficiency. The energy cascade management strategy, as an innovative thermal management method, effectively improves the thermal management efficiency of new energy vehicles through rational planning and optimization of energy use and recovery. The main problem currently faced is that the winter heating mode of new energy vehicles consumes a large amount of electricity and has a complex system architecture, resulting in low heating efficiency and difficulty in heating at low temperatures. According to the development trend of new energy vehicles, continuously improve the energy efficiency of the thermal management system of new energy vehicles, and propose a multi heat source vehicle thermal management system that utilizes waste heat cascade recovery and utilization. Verify the performance of the thermal management system in the analysis of various systems of new energy vehicles, and simulate the temperature of the passenger compartment, battery, and motor under different conditions under constant speed conditions and NEDC, WLTC, CLTC variable speed conditions. The research results will provide theoretical basis and technical support for the optimization design of thermal management systems for new energy vehicles and the formulation of control strategies, which will help promote the sustainable development of the new energy vehicle industry. In the future, the energy cascade management strategy will play a more important role in the thermal management system of new energy vehicles, making significant contributions to promoting the achievement of China's carbon peak and carbon neutrality goals.},
booktitle = {Proceedings of the 2024 International Conference on Intelligent Driving and Smart Transportation},
pages = {191–197},
numpages = {7},
keywords = {Energy cascade management, Simulation modeling, Thermal management system, control strategy},
location = {
},
series = {IDST '24}
}

@inproceedings{10.1145/3452144.3453758,
author = {Nugroho, Listyanto Aji and Sariyatun and Ediyono, Suryo},
