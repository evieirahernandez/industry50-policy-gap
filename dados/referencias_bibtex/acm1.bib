doi = {10.1145/3656650.3656717},
abstract = {Industry 5.0 rethinks the role of human operators in production processes with the final goal to promote societal well-being. To achieve such a goal, novel computational approaches reshaping human-machine collaboration are needed. This paper presents a computational framework, stemmed from Cognitive Sciences, to enable human operators and machines to share a cognitive common ground in co-working hybrid processes.},
