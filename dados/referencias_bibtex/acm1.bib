doi = {10.1145/3746175.3746206},
abstract = {The research presented here aims to support the development of practices of engineers responsible for designing automatic assembly machines within the context of Industry 5.0. As part of a PhD in ergonomics with a manufacturing company, we are studying the interest of the enabling situations (ESD) model to support engineers in developing human-centred design. We will thus study how design choices can be oriented so that work situations are more favourable to the human operator.},
booktitle = {Proceedings of the 36th Annual Conference of the European Association of Cognitive Ergonomics},
articleno = {39},
