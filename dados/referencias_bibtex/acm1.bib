@inproceedings{10.1145/3656650.3656717,
author = {Varni, Giovanna and Volpe, Gualtiero},
title = {A Segmentation Framework based on Cognitive Sciences for Empowering Hybrid Co-Working in Industry 5.0},
year = {2024},
isbn = {9798400717642},
publisher = {Association for Computing Machinery},
