  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The aim of the article is to propose a mathematical model related to the impact of AI on the need and the actual number of employees in SMEs. The study was conducted based on indicators such as: implementation of AI over time, need for human resources and actual number of employees. The results obtained show that there is a tendency to decrease the need for human resources and, respectively, the actual number of employees. The rapid penetration of AI into human resources management, the risks of automation and the need for staff adaptation, as well as the new skills of the future and the role of employees are just some of the factors that determine the relevance of the topic. Industry 5.0 cannot replace people, but it will make them transform their skills and attitudes to work in a new environment.},
  keywords={Training;Humanities;Transforms;Organizations;Mathematical models;Multilingual;Resource management;Fifth Industrial Revolution;Artificial intelligence;Optimization;Industry 5.0;artificial intelligence;human resources;transformation},
  doi={10.1109/ISMSIT67332.2025.11268246},
  ISSN={2770-7962},
  month={Nov},}@INPROCEEDINGS{11267834,
  author={Cornejo, Jose},
  booktitle={2025 9th International Symposium on Multidisciplinary Studies and Innovative Technologies (ISMSIT)}, 
  title={Industrial, Collaborative, and Mobile Robotics in Aerospace Manufacturing: Technical Review focused on Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a comprehensive technical review of the transformative role of industrial, collaborative, and mobile robotics in modern aerospace manufacturing, aligned with the principles of Industry 5.0. Faced with low production volumes, high product complexity, and strict regulatory demands, the aerospace sector is increasingly integrating reconfigurable robotic systems to enhance productivity, safety, and flexibility. Industrial robots, enhanced with vision and AI, deliver sub-millimeter precision in drilling, riveting, and inspection tasks, while collaborative robots (cobots) operate safely alongside humans, reducing ergonomic strain and improving process adaptability. Mobile manipulators further expand automation to large-scale and spatially distributed assemblies, eliminating the need for fixed fixtures and enabling autonomous, multi-function operations. Central to this shift is the Digital Factory paradigm, which incorporates Discrete Event Simulation (DES), digital twins, and predictive algorithms like ANFIS and SVM to optimize real-time decision-making and quality control. Augmented and virtual reality tools, along with Human Digital Twins, improve operator interaction and training, while AI-powered inspection systems ensure traceability and defect detection with micron-level accuracy. The convergence of cyber-physical systems, human-robot collaboration, and intelligent automation is redefining aerospace manufacturing as a resilient, sustainable, and human-centered ecosystem, paving the way for a fully adaptive, cognitive, and ethically aligned Industry 5.0 production model.},
  keywords={Training;Service robots;Reviews;Collaborative robots;Virtual reality;Inspection;Digital twins;Virtual manufacturing;Fifth Industrial Revolution;Aerospace industry;mechatronics;robotics;manufacturing;industry 5.0;aerospace},
  doi={10.1109/ISMSIT67332.2025.11267834},
  ISSN={2770-7962},
  month={Nov},}@ARTICLE{11278184,
  author={Le, Tuan-Vinh},
  journal={IEEE Transactions on Vehicular Technology}, 
  title={AQCSA: Anti-Quantum Cross-Server Authentication Protocol for the Industrial Internet of Drones}, 
  year={2025},
  volume={},
  number={},
  pages={1-15},
  abstract={With the advent of Industry 5.0, humans will again take center stage in decision-making processes, fully supported by artificial intelligence (AI). Drone technology has been adopted in the industry to permit efficient monitoring, detection, and avoidance of hazardous regions during industrial processes. It gives rise to a network architecture, namely industrial internet of drones (IIoD), that is controlled and managed by human expertise. Collaborative IIoD services are conducted by two or more parties in different domains, e.g., mining, construction, etc. Since the communications are carried out via public network channels, privacy and security issues, especially the risks of quantum computing, are of utmost importance. Existing cryptographic approaches encounter several disadvantages, e.g., security vulnerabilities, poor usability, etc. Moreover, no user authentication mechanisms in the literature could provide a countermeasure to quantum attacks for the above communication. Based on lattice-based cryptography (LBC), this paper proposes an anti-quantum cross-server authentication (AQCSA) protocol for securing cross-domain communication of the collaborative services. Our work is designed with a multi-factor authentication mechanism to protect cross-server user-to-user (CS-U2U) and cross-server user-to-drone (CS-U2D) communications. We conduct some practical implementations and experiments to evaluate the security and efficiency of the AQCSA. It is proven that the protocol can withstand various attacks while achieving a reasonable implementation cost in CS-IIoD environments.},
  keywords={Authentication;Protocols;Security;Drones;Cryptography;Artificial intelligence;Quantum computing;Smart cards;Proposals;Industrial Internet of Things;Industry 5.0;Industrial Internet of Drones (IIoD);Cross-Domain Communication;Collaborative Services;Lattice-Based Cryptography (LBC);Lightweight Computation;Multi-Factor Authentication},
