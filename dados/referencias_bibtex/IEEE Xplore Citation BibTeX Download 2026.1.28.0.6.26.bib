  ISSN={},
  month={Sep.},}@ARTICLE{11300931,
  author={Maurya, Poonam and Hazra, Abhishek and Kalita, Alakesh},
  journal={IEEE Engineering Management Review}, 
  title={Unleashing the Potential of Industrial IoT and Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-13},
  abstract={The transition to Industry 5.0 emphasizes the need and importance of human–machine collaboration, driving the demand for intelligent Internet of Things (IoT) and communication protocols. This paper examines the essential prerequisites for Industry 5.0, evaluates the existing constraints of IoT communication protocols, and highlights the requirements for industrial convergence. Specifically, the article focuses on and discusses the role of IoT protocols and standards in realizing the key objectives of Industry 5.0 over Industry 4.0. In addition, it outlines a human-centric Industry 5.0 reference architecture designed to support managers and decision-makers through real-time data visibility, predictive maintenance insights, and resource optimization. To this end, we introduce an edge-enabled Industry 5.0 reference architecture and use cases, particularly emphasizing the enhancement of human–machine interaction. This paper also examines the 6TiSCH (IPv6 over the Time-Slotted Channel Hopping mode of IEEE 802.15.4e) wireless network protocol, focusing on its performance evaluation, prospective advantages, and upcoming advancements. Finally, several open research challenges and managerial implications are discussed to achieve Industry 5.0 resolution.},
  keywords={Fifth Industrial Revolution;Protocols;Fourth Industrial Revolution;Collaboration;Industries;Decision making;Creativity;Robots;Resilience;Industrial Internet of Things;Industry 5.0;Internet of Things;standards & protocols},
  doi={10.1109/EMR.2025.3644409},
  ISSN={1937-4178},
  month={},}@INPROCEEDINGS{11279887,
  author={Demidova, Galina and Poliakov, Nikolai and Lukichev, Dmitry and Lovlin, Sergei and Tsvetkova, Madina and Anuchin, Alecksey},
  booktitle={2025 60th International Universities Power Engineering Conference (UPEC)}, 
  title={Development and Implementation of an Online Master’s Program in Electric Drive Engineering: Meeting Industry 5.0 Educational Needs}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents the development and implementation of an online master’s program in Electric Drive Engineering, designed for engineers specializing in electrical, power engineering, and robotics. The study contributes to the ongoing discussions on digital transformation and the role of education in the Industry 5.0 era by demonstrating how online engineering programs can effectively address the evolving needs of professionals in a rapidly advancing technological landscape. The focus of this paper is on both the theoretical and practical aspects of designing and implementing the program in a real educational setting. The structure of the program and the content of its courses are detailed, with particular attention given to how remote education can be effectively delivered to engineers. Additionally, the paper analyzes the target audience—engineers seeking advanced knowledge in drive systems engineering—and explores the challenges and opportunities of providing high-quality online engineering education. Intermediate learning outcomes showcase the program’s success in enhancing students' theoretical understanding and practical skills. Student feedback, gathered through surveys and course evaluations, highlights positive aspects such as flexibility, accessibility, and the comprehensive nature of the course content.},
  keywords={Training;Surveys;Knowledge engineering;Power engineering;Technological innovation;Electronic learning;Service robots;Engineering profession;Fifth Industrial Revolution;Modeling;online learning;digital transformation;electrical engineering education;e-learning;curriculum design;hands-on training;distance learning;learning outcomes},
  doi={10.1109/UPEC65436.2025.11279887},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11274971,
  author={Caleya-Sanchez, Julia and Muñoz, Pablo and Sánchez-Garrido, Jorge and Florentín, Emilio and Delgado-Ferro, Felix and Rodriguez-Martin, Pablo and Ameigeiras, Pablo},
  booktitle={2025 IEEE 36th International Symposium on Personal, Indoor and Mobile Radio Communications (PIMRC)}, 
  title={Empirical Evaluation of a 5G Transparent Clock for Time Synchronization in a TSN-5G Network}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Time synchronization is essential for industrial IoT and Industry 4.0/5.0 applications, but achieving high synchronization accuracy in Time-Sensitive Networking (TSN)-5G networks is challenging due to jitter and asymmetric delays. 3GPP TS 23.501 defines three 5G synchronization modes: time-aware system, boundary clock (BC), and transparent clock (TC), where TC offers a promising solution. However, to the best of our knowledge, there is no empirical evaluation of TC in a TSN5G network. This paper empirically evaluates an 5G end-to-end TC in a TSN-5G network, implemented on commercial TSN switches with a single clock. For TC development, we compute the residence time in 5G and recover the clock domain at the slave node. We deploy a TSN-5G testbed with commercial equipment for synchronization evaluation by modifying the Precision Timing Protocol (PTP) message transmission rates. Experimental results show a peak-to-peak synchronization of 500 ns, meeting the industrial requirement of ≤1 µs, with minimal synchronization offsets for specific PTP message transmission rates.},
  keywords={Knowledge engineering;Industries;Accuracy;Protocols;5G mobile communication;Telecommunication traffic;Jitter;Synchronization;Clocks;Land mobile radio;Transparent Clock;Time Synchronization;5G;Time-Sensitive Networking},
  doi={10.1109/PIMRC62392.2025.11274971},
  ISSN={2166-9589},
  month={Sep.},}@INPROCEEDINGS{11278865,
  author={Wei, Tianze and Fu, Shutong and Hu, Zhiwen and Zhang, Haoyue and Zhang, Chi},
  booktitle={2025 21st IEEE International Conference on Mechatronic and Embedded Systems and Applications (MESA)}, 
  title={UIB-Enhanced Micro-Pose Network for Multi-Target Workpiece Localization and Dimensional Measurement in Industrial Scenes}, 
  year={2025},
  volume={},
  number={},
  pages={78-83},
  abstract={Applying computer vision for workpiece-dimension measurement is a pivotal task in Industry 5.0. Existing pose-estimation models exhibit markedly degraded accuracy upon transfer to tiny-target metrology tasks such as inspection of industrial-parts. This paper introduces Micro-Pose, a two-stage RTMPose-m variant that replaces the CSPNext backbone with UIB search blocks. This redesign markedly boosts tiny-target detection accuracy while drastically compressing parameter count, achieving a superior accuracy-speed trade-off. Plugged into an industrial inspection framework, Micro-Pose enables end-to-end workpiece positioning and metrology in real time. Furthermore, we introduce an error-evaluation algorithm tailored to multi-target scenes, which employs a divide-and-conquer strategy to resolve spatial-constraint problems. To validate our model, we released a dataset comprising 7420 hex-bolt images annotated with keypoint labels. In the COCO AP metric, our method reduces the parameter count by 37% and outperforms the original RTMPose-s and RTMPose-m by 0.7% and 2.0%, respectively, while maintaining the same inference speed as RTMPose-s. Under multi-target conditions, the dimensional accuracy reaches 1mm.},
  keywords={Location awareness;Measurement;Accuracy;Mechatronics;Inspection;Metrology;Robustness;Real-time systems;Spatial resolution;Fifth Industrial Revolution},
  doi={10.1109/MESA68091.2025.11278865},
  ISSN={2835-902X},
  month={Nov},}@INPROCEEDINGS{11278883,
  author={Hou, Jiachen and Liang, Xiaolong and Guo, Ao and Wang, Fei-Yue},
  booktitle={2025 21st IEEE International Conference on Mechatronic and Embedded Systems and Applications (MESA)}, 
  title={Content-Addressed Subscription: A Scalable Matching Mechanism for DAO-Governed Industrial Data Market}, 
  year={2025},
  volume={},
  number={},
  pages={53-58},
  abstract={The realization of Industry 5.0 depends on the effective utilization of high-quality, context-rich, long-tail data. Existing centralized data markets are inefficient due to high operational costs and persistent data silos. As a novel autonomous paradigm based on block-chain and smart contracts, Decentralized Autonomous Organization (DAO) offers a superior governance framework to address these issues. However, DAO natively lacks efficient data discovery mechanisms. The prevailing pull-based query model is economically unviable for large-scale, fine-grained demands due to excessive on-chain costs. To tackle this challenge, this paper introduces Content-Addressed Subscription, a novel data discovery mechanism operating within a DAO-governed industrial data market. This mechanism builds upon the classic publish/subscribe model, algorithmically generating a unique topic identifier from the semantic content, thereby circumventing the reliance on predefined topic lists and transforming the data discovery process from inefficient pull-based queries to event-driven push notifications. The paper presents the complete architecture of the proposed solution and validates its feasibility through an industrial case study.},
  keywords={Costs;Mechatronics;Heavily-tailed distribution;Embedded systems;Decentralized autonomous organization;Smart contracts;Semantics;Data models;Fifth Industrial Revolution;Decentralized Autonomous Organization (DAO);Content-Addressed Subscription;Data Matching;Industrial Data Market;Publish/Subscribe Model},
  doi={10.1109/MESA68091.2025.11278883},
  ISSN={2835-902X},
  month={Nov},}@INPROCEEDINGS{11277964,
  author={Bayleyegn, Abebu Ademe and Njoku, Buniechukwu and Nande, Swaraj Shekhar and Sekavcnik, Simon and Bassoli, Riccardo and Fitzek, Frank H.P.},
  booktitle={2025 IEEE 14th International Conference on Consumer Electronics - Berlin (ICCE-Berlin)}, 
  title={Design Tradeoffs for Quantum Time Synchronization in Future Industrial Networks under Classical Channel Latency and Security}, 
  year={2025},
  volume={},
  number={},
  pages={211-216},
  abstract={Next-generation industrial automation in Industry 5.0 demands sub-nanosecond time synchronization to enable advanced human-machine collaboration and real-time control systems. Quantum Time Synchronization (QTS), enabled by entangled photon-based quantum networks, offers ultra-precise clock alignment across distributed nodes. However, practical deployment requires an authenticated classical communication channel to exchange timestamped data and extract synchronization offsets. This paper investigates the core tradeoffs between classical channel latency and achievable QTS precision in hybrid quantum-classical networks. Using a discrete-event simulator, we evaluate the impact of various classical network protocols, each with distinct latency characteristics, on QTS performance. Our results demonstrate that even modest latency increases result in degraded synchronization accuracy and increased synchronization jitter, particularly in time-critical industrial contexts. To address these challenges, we propose a combined approach that integrates low-overhead authentication, low-latency communication protocols, and predictive clock drift compensation. Our findings provide actionable guidance for balancing latency, security, and synchronization accuracy in QTS services for future networks.},
  keywords={Protocols;Accuracy;Quantum entanglement;Jitter;Real-time systems;Synchronization;Time factors;Quantum networks;Fifth Industrial Revolution;Clocks;Latency;QTS;Synchronization jitter;Network Security;Industry 5.0},
  doi={10.1109/ICCE-Berlin67488.2025.11277964},
  ISSN={2166-6822},
  month={Sep.},}@ARTICLE{11283043,
  author={Sbaragli, Andrea and Nardello, Matteo},
  journal={IEEE Access}, 
  title={From Sensing to Segmentation: Transformer-Based Worker Activity Recognition for Industrial Assembly}, 
  year={2025},
  volume={13},
  number={},
  pages={207475-207487},
  abstract={Human operators still provide strategic, value-added contributions to modern manufacturing systems, despite the widespread adoption of automation. This paper presents a cyber-physical system designed to perform fine-grained Worker Activity Recognition (WAR) and segment manual operations in human-centric assembly environments. The proposed system includes a modular and low-intrusion IoT acquisition layer that digitizes worker movements using Inertial Measurement Units (IMUs) and a radio frequency-based smart glove. While the IMUs track hand and back motion, the glove captures process interactions such as picking and depositing components. These multimodal data streams are processed by a cyber layer that performs time- and frequency-domain feature extraction and feeds the data into a Transformer-based neural network to classify five common assembly tasks. The results are post-processed by a Decision Support System to generate interpretable task segments and provide key performance indicators for industrial supervisors. The system is validated through a real-world deployment involving three workers assembling a vertical centrifugal pump, resulting in over 7 hours of annotated data. The Transformer model achieves an F1-score of 82% on this dataset. Thanks to its unobtrusive sensors, low deployment cost, and robustness to occlusions, the proposed solution offers a practical and scalable approach to enhancing visibility and traceability in manual industrial operations.},
  keywords={Assembly;Accuracy;Activity recognition;Feature extraction;Transformers;Sensors;Manufacturing;Hands;Decision support systems;Motion segmentation;Human-centric manufacturing;industry 5.0;IoT;CPS;machine learning;worker activity recognition},
  doi={10.1109/ACCESS.2025.3641299},
  ISSN={2169-3536},
  month={},}@ARTICLE{11285496,
  author={Qin, Shujin and Feng, Yujie and Wang, Jiacun and Liu, Shixin and Guo, Xiwang and Qi, Liang},
  journal={IEEE Transactions on Computational Social Systems}, 
  title={Optimization of Circular Disassembly Lines With Human-Assisted Robotic Workstations Using Two-Stage Greedy PPO Algorithm}, 
  year={2025},
  volume={},
  number={},
  pages={1-13},
  abstract={Disassembly is a critical step in the recycling and reusing of end-of-life products. As Industry 5.0 emerges, manufacturing is shifting from a system-oriented approach to a human-centered paradigm, advancing human–robot collaboration to a new stage. However, existing studies on human–robot collaboration in disassembly lines generally overlook the mobility of workers. To fill the research gap, this work proposes a novel human–robot collaboration mode that considers both the mobility of workers during disassembly and the flexibility of collaboration time in human–robot interaction. Based on this model, this work proposes the human-assisted robotic circular disassembly line balancing problem and establishes a profit-oriented spatiotemporal decomposition mixed-integer programming model. A two-stage greedy proximal policy optimization algorithm is designed to solve it. To validate the effectiveness of the proposed model and algorithm, ten sets of benchmark instances are generated with different scales based on real product structure data. Comparative experiments with reinforcement learning algorithms and classical heuristic methods demonstrate the feasibility and significant superiority of the proposed algorithm in solving this type of problem.},
  keywords={Collaboration;Workstations;Optimization;Heuristic algorithms;Recycling;Service robots;Mathematical models;Electronic waste;Spatiotemporal phenomena;Production;Circular disassembly line;human-assisted robotic disassembly;spatiotemporal decomposition method;two-stage greedy PPO (TSG-PPO) algorithm},
  doi={10.1109/TCSS.2025.3620906},
