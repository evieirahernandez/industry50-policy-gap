@INPROCEEDINGS{11348447,
  author={Meenakshi, S. and Ganai, Aaquib Hussain and Saravanan, T P and George, A Shaji and Raj, Murugananth Gopal and S, Reshma and Bhutani, Monica},
  booktitle={2025 International Conference on Communication and Smart Devices (ICCoSD)}, 
  title={AI-Driven Predictive Maintenance in Smart Manufacturing Using Cyber-Physical Systems and Industrial IoT}, 
  year={2025},
  volume={1},
  number={},
  pages={1-6},
  abstract={The combined role of Artificial Intelligence (AI), Cyber-Physical Systems (CPS), and the Industrial Internet of Things (IIoT) is transforming smart manufacturing changing paradigms of its operations into the proactive mode. The common maintenance approaches result in unplanned outage, and subsequent downfalls in operation expenses. The proposed paper discusses the latest methods of predictive maintenance (PdM) that is driven by AI with a particular emphasis on CPS and IIoT structures to obtain real-time data and make intelligent decisions. It presents comparative methods of the mentioned techniques, using their efficiency in fault diagnosis, identification of anomalies, and residual useful life (RUL) estimation procedures. To reinforce the contributions of the paper to more than a review, a mathematical model and parametric research are provided which shows how predictive models (e.g LSTM based regression) react to changes in training size, model complexity and sensor noise. The results indicate that a quantifiable increase in the accuracy of the predictions and latency in comparison with benchmark approaches can be achieved. Other important issues that are addressed in the paper refer to model interpretability, data quality, and interoperability, as well as to the upcoming directions, which are explainable AI, adaptive learning, and sustainable PdM frameworks. The described observations should assist scholars and business representatives in developing high-quality, effective, and environmentally-friendly PdM systems in line with Industry 4.0 and Industry 5.0 objectives.},
  keywords={Fault diagnosis;Training;Reviews;Predictive models;Mathematical models;Artificial intelligence;Interoperability;Industrial Internet of Things;Smart manufacturing;Predictive maintenance;Artificial Intelligence;Predictive Maintenance;Smart Manufacturing;Cyber-Physical Systems;Industrial Internet of Things;Machine Learning;Deep Learning;Digital Twin},
  doi={10.1109/ICCoSD66074.2025.11348447},
  ISSN={},
  month={July},}@INPROCEEDINGS{11348203,
  author={Firme, Bernardo and Restivo, Maria Teresa and Urbano, Diana and Vieira, Susana},
  booktitle={2025 7th Experiment@ International Conference (exp.at'25)}, 
  title={Impact of Augmented Reality Across Different Engineering Education and Training Levels}, 
  year={2025},
  volume={},
  number={},
  pages={399-404},
  abstract={Supported by different activities and examples inte-grating augmented reality (AR) technology and associated results in engineering education and training, this study pretends to highlight the benefits and potential advantages of this approach. By its use in different teaching and learning dimensions, AR can positively influence informal education, serve as a beneficial tool with promising perspectives, and be used in degree and at the graduation projects to provide insights into labor environments. This work emphasizes the relevance of AR in shaping perceptions for future professionals, enhancing their learning experi-ences and preparing them for their future in modern professional environments. It includes various examples illustrating the perspectives tested across different scopes, based on the teaching activities of the last three authors and the first author's experience as a PhD student. These experiences were tested at different levels of mechanical engineering education: pre-university programs, undergraduate, master's, and post-graduate levels.},
  keywords={Training;Industries;Costs;Refining;Engineering education;Mechanical engineering;Fifth Industrial Revolution;Augmented reality;Augmented reality;Informal Education;Engi-neering Education and Training;Industry 5.0;Smart Manufac-turing},
  doi={10.1109/exp.at2565440.2025.11348203},
  ISSN={2376-6328},
  month={Sep.},}@INPROCEEDINGS{11348213,
  author={Firme, Bernardo and Restivo, Maria Teresa and Sousa, João M. C. and Vieira, Susana},
  booktitle={2025 7th Experiment@ International Conference (exp.at'25)}, 
  title={Industry 5.0 and Smart Scheduling: Operation Concept of PlanARa}, 
  year={2025},
  volume={},
  number={},
  pages={268-270},
  abstract={This paper introduces PlanARa, a multi-agent system designed for intelligent and adaptive scheduling in an industrial setting. The system leverages agent-based modeling and simulation to dynamically optimize resource allocation, production flows, and task execution while incorporating real-time adaptability to disruptions. The proposed system is designed for seamless integration into real-world manufacturing environments, facilitating dynamic and intelligent scheduling in real-time. Through a simulation-driven approach, the system enables risk-free scenario testing, allowing manufacturers to analyze different scheduling strategies before real-life deployment. Moreover, this system enhances real-time adaptability by dynamically adjusting schedules in response to unforeseen disruptions, thus improving system resilience. The successful implementation of such systems requires careful management of complexity, communication overhead, and integration challenges to ensure scalability and real world applicability. This work showcases how MAS can enhance scheduling efficiency, improve responsiveness to changing demands, and support human-machine collaboration in modern smart manufacturing ecosystems, driving greater flexibility, resilience and efficiency in industrial operations.},
  keywords={Job shop scheduling;Scalability;Ecosystems;Dynamic scheduling;Real-time systems;Resource management;Fifth Industrial Revolution;Smart manufacturing;Resilience;Multi-agent systems;Industry 5.0;Multi-Agents Systems;Dynamic Scheduling;Simulation;Smart Manufacturing},
  doi={10.1109/exp.at2565440.2025.11348213},
  ISSN={2376-6328},
  month={Sep.},}@INPROCEEDINGS{11348329,
  author={Kormiltsyn, Aleksandr and Mironova, Olga},
  booktitle={2025 7th Experiment@ International Conference (exp.at'25)}, 
  title={Improving the Curriculum of IT Foundations Course for Estonian and International Non-IT Students at Tallinn University of Technology}, 
  year={2025},
  volume={},
  number={},
  pages={74-79},
  abstract={Computer technologies are now widely accessible. Individuals encounter information technologies (IT) from a young age. Consequently, the importance of computer science and its impactful teaching is increasing. At Tallinn University of Technology (Tal Tech11https://taltech.ee/), the Study Center for IT Foundations emphasizes imparting IT fundamentals to first-year non-IT students, both local and from abroad. A key aspect of the course is the initial assessment, which tests students' prior knowledge in the IT field. The preliminary quizzes provided to students include both practical and theoretical questions based on the course curriculum. The course instructors use these results to assess each student's knowledge level and to define for them an individual learning path. However, the information technologies (IT) industry is rapidly changing nowadays. New technologies such as artificial intelligence, blockchain, internet of things (loT), extended reality, digital twins, etc. provide new services for our daily life every year. In such a continuously changing context, the IT Foundations course does not cover all cutting-edge technologies, focusing on the previously defined course curriculum. Also, educators of the course have limited resources to continuously monitor cutting-edge technologies and add them to the course program. In this paper, we provide the integration of AI and blockchain technologies into the educational process for the IT Foundations course. AI enables continuous alignment of the course program with the evolving IT landscape with technologies arriving in the IT industry, while blockchain, in combination with gamification, aims to increase the motivation of the non-IT students during the course. The approach is aligned with Education 5.0 principles and enables agile course adjustments while enhancing student engagement.},
  keywords={Industries;Extended reality;Education;Focusing;Blockchains;Digital twins;Internet of Things;Artificial intelligence;Information technology;Monitoring;IT Foundations;Education 5.0;AI;Blockchain;non-IT students},
  doi={10.1109/exp.at2565440.2025.11348329},
  ISSN={2376-6328},
  month={Sep.},}@INPROCEEDINGS{11344077,
  author={Almonte, Jomar Thomas and Boominathan, Santhosh Anitha and Nascimento, Nathalia},
  booktitle={2025 IEEE International Conference on Collaborative Advances in Software and COmputiNg (CASCON)}, 
  title={Automated Non-Functional Requirements Generation in Software Engineering with Large Language Models: A Comparative Study}, 
  year={2025},
  volume={},
  number={},
  pages={474-483},
  abstract={Neglecting non-functional requirements (NFRs) early in software development can lead to critical challenges. Despite their importance, NFRs are often overlooked or difficult to identify, impacting software quality. To support requirements engineers in eliciting NFRs, we developed a framework that leverages Large Language Models (LLMs) to derive qualitydriven NFRs from functional requirements (FRs). Using a custom prompting technique within a Deno-based pipeline, the system identifies relevant quality attributes for each functional requirement and generates corresponding NFRs, aiding systematic integration. A crucial aspect of this framework is evaluating the quality and suitability of these generated requirements. Can LLMs produce high-quality NFR suggestions? Using 34 functional require-ments—selected as a representative subset of 3,964 FRs—the LLMs inferred applicable attributes based on the ISO/IEC 25010:2023 standard, generating 1,593 NFRs. A horizontal evaluation covered three dimensions: NFR validity, applicability of quality attributes, and classification precision. Ten industry software quality evaluators, averaging 13 years of experience, assessed a subset for relevance and quality. The evaluation showed strong alignment between LLM-generated NFRs and expert assessments, with median validity and applicability scores of 5.0 (means: 4.63 and 4.59, respectively) on a $1-5$ scale. In the classification task, 80.4% of LLM-assigned attributes matched expert choices, with 8.3% near misses and 11.3% mismatches. A comparative analysis of eight LLMs highlighted variations in performance, with gemini-1.5-pro exhibiting the highest attribute accuracy, while llama-3.3-70B achieved slightly higher validity and applicability scores. These findings provide insights into the feasibility of using LLMs for automated NFR generation and lay the foundation for further exploration of AIassisted requirements engineering.},
  keywords={Industries;Accuracy;Large language models;ISO Standards;Pipelines;Transfer learning;Software quality;Requirements engineering;IEC Standards;Standards;Non-Functional Requirements;Large Language Models;Requirements Elicitation;ISO/IEC 25010;Automated Requirements Engineering},
  doi={10.1109/CASCON66301.2025.00077},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11349462,
  author={Ciampi, Francesco Giuseppe and Diallo, Thierno M. L. and Mhenni, Faida and Patalano, Stanislao and Choley, Jean-Yves},
  booktitle={2025 15th France-Japan & 13th Europe-Asia Congress on Mechatronics (MECATRONICS) / 23rd International Conference on Research and Education in Mechatronics (REM)}, 
  title={Design and Implementation of a Mixed Reality Architecture for Human-Guided Reconfiguration of Cyber-Physical Production Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Nowadays, production systems increasingly need to be reconfigured to cope with unforeseen disruptions in workflows or supply chains, dynamic market requirements and mass personalisation. Industry 4.0 technologies, through Cyber-Physical Production Systems (CPPS), offer opportunities to address these challenges by enabling real-time monitoring and adaptive control to manage dynamic environments and requirements. With the advent of Industry 5.0, which emphasizes human-centric production, Human-Cyber-Physical Systems (HCPS) integrate operators into decision-making loops, enhancing flexibility, resilience, and responsiveness. A key requirement for these systems is reconfigurability, which involves identifying reconfiguration needs, planning actions, and executing them. Although the initial two steps are occasionally automated to some extent, the execution phase is predominantly manual, leading to inefficiencies, higher workloads, and increased risk of errors. Enabling technologies of Industry 5.0, such as Extended Reality, offer new opportunities to overcome these challenges. This work, therefore, introduces a Mixed Reality-based framework that guides and assists operators in performing industrial tasks. The framework is developed following established guidelines from the literature and relevant industrial standards, and it adopts a modular and expandable architecture that facilitates the integration of new functionalities and use cases. The approach is implemented and validated through a case study on the execution of the reconfiguration process in a real-world production line within a research platform. A preliminary evaluation using the NASA-TLX indicates that the MR application reduces workload, mainly through improved performance and lower frustration.},
  keywords={Production systems;Mechatronics;Navigation;Decision making;Supply chains;Mixed reality;Real-time systems;Fifth Industrial Revolution;Standards;Resilience;Mixed Reality;Operator guidance;Humancentric design;Reconfiguration;CPPS},
  doi={10.1109/MECATRONICS-REM67547.2025.11349462},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11349508,
  author={Naimi, Rahma and Dridi, Issam and Diallo, Thierno and Penas, Olivia and Yahia, Noureddine Ben},
  booktitle={2025 15th France-Japan & 13th Europe-Asia Congress on Mechatronics (MECATRONICS) / 23rd International Conference on Research and Education in Mechatronics (REM)}, 
  title={Human-Centric Competency Maturity Modeling in Industry 5.0 Using Optimized Neural Networks and Ergonomic Assessment Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The transition from Industry 4.0 to Industry 5.0 underscores the demand for human-centric frameworks that integrate cognitive and ergonomic dimensions of workforce management. While Industry 4.0 prioritized automation via cyberphysical systems, Industry 5.0 re-centers humans, emphasizing well-being, creativity, and AI collaboration. This paper enhances a neural network (NN2) architecture for assessing human competency maturity in Industry 4.0, achieving a validation mean squared error (VMSE) of 0.008 -a $33 \%$ improvement over the baseline (0.012)-through optimized structure and training. Additionally, a gesture analysis pipeline is introduced, combining OpenPose-based 3D keypoint extraction with a convolutional neural network (CNN) for ergonomic posture classification using REBA and OWAS standards, attaining $92 \%$ validation accuracy. The components enable accurate cognitive and physical competency evaluation. Preliminary hybrid integration supports holistic assessment, with full validation planned as future work. This framework provides a robust decision-support tool for humancentric workforce development in Industry 5.0.},
  keywords={Training;Mechatronics;Accuracy;Three-dimensional displays;Ergonomics;Pipelines;Fourth Industrial Revolution;Convolutional neural networks;Fifth Industrial Revolution;Standards;Industry 4.0;Industry 5.0;Neural Networks;Human Competencies;Maturity Levels;Ergonomics;Gesture Analysis;Convolutional Neural Networks;Human Resource Management},
  doi={10.1109/MECATRONICS-REM67547.2025.11349508},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11338873,
  author={Erdogan, Bilgenur and Dang, Quang-Vinh and Mohammadi, Mehrdad and Adan, Ivo},
  booktitle={2025 Winter Simulation Conference (WSC)}, 
  title={From Coordination to Efficiency: Boosting Smart Robot Use Via Hybrid Intralogistics Concepts}, 
  year={2025},
  volume={},
  number={},
  pages={1408-1419},
  abstract={Automated guided vehicles (AGVs) and Autonomous mobile robots (AMRs) are widely used in intralogistics for material delivery and product transport. As manufacturing evolves with Industry 5.0, the integration of autonomous systems, particularly in complex shop floor layouts, plays a crucial role in improving efficiency and reducing human intervention. This study explores various intralogistics concepts for AGVs and AMRs collaborating on an assembly line. We define an online dispatching rule for AGVs and benchmark it against previous implementations on high-mix-low-volume production. All proposed concept-related decisions are analyzed via a simulation model under a real-world case study, with sensitivity analyses varying system parameters. We observe an improvement of up to 51% in the hourly throughput rate and a significant drop in AGV utilization rates of up to 88% compared to benchmark instances. The results also show that pooling AGV/AMR resources achieves a higher throughput rate, and consequently reduces investment costs.},
  keywords={Service robots;Robot kinematics;System performance;Collaboration;Benchmark testing;Throughput;Dispatching;Fifth Industrial Revolution;Assembly;Investment},
  doi={10.1109/WSC68292.2025.11338873},
  ISSN={1558-4305},
  month={Dec},}@INPROCEEDINGS{11338549,
  author={Rondón-Usma, Angie Valeria and Camacho-Muñoz, Guillermo A. and Álvarez-Martínez, David},
  booktitle={2025 27th Symposium on Virtual and Augmented Reality (SVR)}, 
  title={Augmented Reality-Assisted Manual Packing Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={98-107},
  abstract={The process of packing—organizing products within a container to optimize available space—is often performed manually without technological assistance, which can lead to inconsistent efficiency and occasional errors. While augmented reality (AR) has been explored to support packing tasks, prior research has largely relied on static final-pose overlays and has rarely integrated advanced packing optimization algorithms. This paper presents OPTAR, a novel packing assistance system that combines a 3D packing optimization algorithm with trajectory-based AR pose guidance, deployed on the Microsoft HoloLens 2. We describe the system's design, implementation, and evaluation through experiments comparing two methods: a packing operation with and without OPTAR. Results indicate that OPTAR assistance significantly improves space utilization and eliminates misplaced items, though with longer task completion times during initial use. To strengthen the generalizability of our findings to industrial applications, future work will extend testing to real industrial environments, involve professional packing operators, and larger sample sizes.},
  keywords={Three-dimensional displays;Manuals;Containers;Fifth Industrial Revolution;Optimization;Augmented reality;System analysis and design;Testing;Packing Optimization;Augmented Reality;HoloLens 2;Manual Packing;Space Utilization;Industry 5.0},
  doi={10.1109/SVR67689.2025.00024},
  ISSN={2833-0609},
  month={Sep.},}@INPROCEEDINGS{11336553,
  author={Shirke, Harshal S. and Gavankar, Nitin L.},
  booktitle={2025 International Conference on Future Technologies (ICFT)}, 
  title={Periodic Review on Decentralized Framework in Edge Computing}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Decentralized frameworks in edge computing have become essential for addressing the limitations of centralized cloud systems, such as latency, bandwidth constraints, and privacy vulnerabilities. This systematic review explores the gradual progress and technological improvements of these frameworks over the period from 1988 to 2025. By categorizing the literature into six distinct temporal phases, the study delineates the transition from early distributed systems to the advanced AI-driven edge architectures. Key findings reveal significant advancements, including the formalization of mobile edge computing, the emergence of fog computing paradigms and the integration of Edge. These advancements collectively enhanced system scalability, security and real-time performance. The review also identifies thematic trends, such as resource scheduling and Industry 5.0 applications, that underscore the field's inter disciplinary growth. These insights highlight the transformative potential of decentralized edge computing which supports next- generation applications, from smart cities to human-centric manufacturing. Looking forward, the study encourages for research into lightweight AI models, secure federated learning, and 5G/6G integration to further advanced autonomous and resilient edge ecosystems.},
  keywords={Smart cities;Scalability;Ecosystems;Computer architecture;Market research;Real-time systems;Security;Fifth Industrial Revolution;Edge computing;Systematic literature review;Edge computing;decentralized framework;dis tributed tracking;serverless systems;IoT;sensor networks;real time systems},
  doi={10.1109/ICFT66708.2025.11336553},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11337609,
  author={Arya, Anju and Malik, Amita},
  booktitle={2025 2nd International Conference on Computational Intelligence and Computing Applications (ICCICA)}, 
  title={Role of Blockchain and Genomics in Tackling Pandemic Situation}, 
  year={2025},
  volume={},
  number={},
  pages={591-597},
  abstract={The rapid evolution of healthcare system driven by technological innovations and advanced treatment methodologies enables holistic analysis of medical conditions. Pandemics like COVID-19 are unexpected and uncontrollable, impact society at both physical and mental level, underscored the critical need for innovative solutions. Different emerging technologies played a crucial role in fighting against the pandemic situation. This study explores two transformative technologies, namely genomics and blockchain in combating pandemic scenarios. Genomics provides insights into disease mechanisms and personalized healthcare, while Blockchain ensures secure and efficient data management. These technologies collectively align with Industry 5.0's vision of smart and sustainable computing systems. This paper discusses their integration into healthcare frameworks, focusing on secure genomic data handling, personalized treatment, and optimized healthcare delivery systems. This comprehensive study reveals their contribution to pandemic mitigation for various aspects requiring urgent attention and solution.},
  keywords={COVID-19;Technological innovation;Pandemics;Genomics;Medical services;Blockchains;Bioinformatics;Fifth Industrial Revolution;Sustainable development;Diseases;Blockchain;Genomics;Smart Computing;COVID-19;Healthcare Innovation},
  doi={10.1109/ICCICA67008.2025.11337609},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11336844,
  author={Li, Xulong and Zhang, Xiaoying and Xu, Xinyi and Gao, Kaiqiang and Huo, Jiahao},
  booktitle={2025 3rd International Conference on Ubiquitous Communication (Ucom)}, 
  title={Achieving Ultra-Low Latency in Industrial PONs: A SAC Reinforcement Learning Approach}, 
  year={2025},
  volume={},
  number={},
  pages={159-163},
  abstract={Industry 5.0 has become the next chapter in the evolution of manufacturing and technology as the intelligent manufacturing and artificial intelligence (AI) technology development. Industrial passive optical network (PON) has received a lot of attention due to its advantage of high speed rate, strong scalability and low cost. The low latency requirement for communication between optical network unit (ONU) and internet of things (IoT) devices is also a key point of concern. In this study, we utilize the soft actor-critic (SAC) algorithm for constructing the policy and critic networks. The optimization process focuses on both the data's age of information (AoI) and fairness concurrently. To address security concerns, an interfering ONU is incorporated into the system. The performance of the SAC algorithm is evaluated by simulations. The results indicate that the SAC algorithm exhibits superior performance in achieving a balance between minimizing AoI and maximizing fairness when compared to other baseline methods.},
  keywords={Simulation;Scalability;Information age;Optical network units;Passive optical networks;Manufacturing;Internet of Things;Security;Low latency communication;Artificial intelligence;industrial passive optical network (PON);optical network unit (ONU);internet of things (IoT);age of information (AoI);deep reinforcement learning (DRL)},
  doi={10.1109/Ucom67224.2025.11336844},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11325631,
  author={Durga, G. and Umamaheswari, D.},
  booktitle={2025 IEEE 7th International Conference on Computing, Communication and Automation (ICCCA)}, 
  title={AI Based Predictive Analysis of Factors Driving Farmers to Middlemen in Agricultural Marketing Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The agricultural sector is the backbone of many economies worldwide and plays a crucial role in ensuring food security, promoting rural livelihoods, and driving sustainable development. In recent years, the agricultural sector has faced numerous challenges, including climate change, resource depletion, urbanization, and a growing demand for food due to population growth. However, these challenges have also spurred opportunities for transformation through the adoption of modern technologies, sustainable farming practices, and innovative policies. Farmers and middlemen in agriculture are pivotal to the functioning of agricultural markets and supply chains. Middlemen act as intermediaries between farmers and consumers or larger market entities, playing roles such as aggregating produce, providing market access, and ensuring the efficient flow of goods. However, this relationship is often complex, with both positive and negative implications. For this purpose, we collect data from 210 farmers from two villages in the Thanjavur district; these farmers are said to obtain only 10% of their profit because of middlemen’s involvement. We addressed this by identifying and analyzing the main socioeconomic, logistical, and informational aspects that lead farmers to rely on intermediaries using AI-based predictive modeling tools. More precise predictions and focused actions to lessen exploitative dependencies are made possible by the combination of AI and soft computing in this situation. Policymakers, agribusiness stakeholders, and technology developers seeking to establish more transparent and fair agricultural selling mechanisms in line with Industry 5.0.},
  keywords={Vegetable oils;Urban areas;Supply chains;Pricing;Predictive models;Raw materials;Stakeholders;Artificial intelligence;Sustainable development;Socioeconomics;agriculture;middlemen;farmers;AI},
  doi={10.1109/ICCCA66364.2025.11325631},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11325192,
  author={Rajalingam, A. and Pandi, V.Samuthira and Awwad, Hebatullah and Ravi, Navyatha and Karthikeyan, G. and M, Pavithra},
  booktitle={2025 IEEE 7th International Conference on Computing, Communication and Automation (ICCCA)}, 
  title={Improve the Real-Time Industrial Inspection and Maintenance: Intelligent Recognition with AI-Powered Object Detection in Augmented Reality (AR) Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The importance of inspection and maintenance for operational safety, asset lifetime, and minimal downtime in areas as diverse as manufacturing, energy or transportation is difficult to overestimate. Conventional inspection techniques are slow, error-prone, and dependent on human expertise. To meet rising requirements for accuracy, efficiency and real-time control, the integration of Augmented Reality (AR) and Artificial Intelligence (AI) comes up as a disruptive solution. In this paper presenting an AI-backed intelligent object detection system, deployed in AR-space, to facilitate real-time inspection and maintenance activities. The presented system combines computer vision methods, object recognition using deep learning and AR visualization, so that the technicians can recognize the components, find anomalies and receive context-aware instructions during inspection. Based on the existing advanced models, such as YOLOv8, Vision Transformers, etc., the framework is then designed for training activities detecting already known defects such as the part of the equipment, rust, cracks, leakage points and other operations defects. When problems are identified, they are then superimposed in real time via AR headsets/ or mobile devices so users can view the detailed diagnostics, repair instructions, along with safety alerts — all without interruption of workflow. The architecture has four layers such as Data acquisition (smart cameras, IoT sensors), AI based processing (edge, cloud), AR based user interaction, and Feedback Mechanism (real time decision support). One major bright spot is that the system can self-learn to have adaptation to the ambient and lighting changes and thus the ability to retain the high accuracy of detection under different industrial scenes, achieved by transfer learning and context recognition. Furthermore, with real-time synchronization, detected anomalies are logged and transmitted to cloud dashboards for monitoring, auditing, and predictive maintenance analytics. We evaluate our method on industrial datasets such as turbine inspection imagery and pipeline monitoring video feeds and achieve accuracy above 92% with under 250 ms average latency for overlay rendering. AI and AR combined together has led to huge time savings, increased safety by removing the need for on-site technicians and decision-making benefits with guided diagnostics. Furthermore, the system promotes teamwork by providing live visual flow remote experts for reference, which effectively simplifies the maintenance process. This work shows that object detection in AR-enabled environments, based on AI, is a strong driver for intelligent industrial maintenance. "Combining situational awareness with machine intelligence, the method presented is scalable, efficient and holistic for industrial inspection. It is an essential step towards Industry 5.0, where human knowledge is enhanced by intelligent systems in real-time to make better decisions.},
  keywords={Accuracy;Object detection;Inspection;Real-time systems;Maintenance;Safety;Object recognition;Artificial intelligence;Monitoring;Predictive maintenance;Industrial Inspection;Object Detection;Predictive Maintenance;Artificial Intelligence (AI);Computer Vision;Real-Time Monitoring;Deep Learning},
  doi={10.1109/ICCCA66364.2025.11325192},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11325651,
  author={P, Rathnavel},
  booktitle={2025 IEEE 7th International Conference on Computing, Communication and Automation (ICCCA)}, 
  title={Symbiotic Artificial Intelligence Twin Framework for Circular Manufacturing: A Sustainability-Led Industry 5.0 Framework}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Industry 5.0 or the fifth industrial revolution is a natural transition from industrial paradigms that are automation-centric towards symbiotic human-machine systems, which focus on sustainability, social purpose, and resilience within industrial ecosystems. In this paper, a Symbiotic AI-Twin Framework (SATF) is proposed for circular manufacturing systems to align intelligent automation with sustainability. SATF combines one or more cognitive digital twins for the real-time mirroring of systems with edge artificial intelligence (AI) employing federated learning for distributed decision-making, while involving a human-in-the-loop (HITL) to provide interactivity and adaptability to human stakeholders. Essentially, SATF demonstrates that the use of bio-inspired optimization methods in combination with supply chain mapping will help prevent the loss of materials and waste, while the scheduling methods informed by external sources with carbon-awareness will ensure that operational practices are sustainable given associated environmental limits and renewable energy sources. SATF was simulated as virtual factory environments with significant sustainability outcomes, including measurable sustainability reports containing, on one instance, a 65% increase in material reuse contributions to the bottom line to values upwards of 91% energy efficiency, to examples of reducing products carbon footprint sourcing from 0.52 kg CO₂e units to .23 kg per product unit. These findings represent SATFs modelling and conceptual function given the parallels of other next generation green manufacturing systems and the legacy associated with industry 5.0 framework with a circular economy lens.},
  keywords={Symbiosis;Ethics;Job shop scheduling;Human-machine systems;Human in the loop;Real-time systems;Digital twins;Sustainable development;Fifth Industrial Revolution;Resilience;Industry 5.0;Circular Manufacturing;Digital Twin;Sustainability;Edge AI;Human-in-the-loop;Carbon-aware Scheduling;Bio-inspired Optimization},
  doi={10.1109/ICCCA66364.2025.11325651},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11325432,
  author={Verma, Deepti and Singhal, Ritesh and Pandita, Sarjue and Garg, Ankit and Singh, Akash and M, Anirudh N},
  booktitle={2025 IEEE 7th International Conference on Computing, Communication and Automation (ICCCA)}, 
  title={Exploring AI-Driven Supply Chain Innovations from Industry 4.0 to 6.0: A Comprehensive Review}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The following study looks at how supply chains are changing because of artificial intelligence (AI) as businesses across the globe shift from Industry 4.0 to Industry 6.0. It emphasizes the ways in which AI improves greater human-machine collaboration, increases productivity, and facilitates environmentally friendly behavior. The study utilized research from 2010 to 2023 drawn from peer-reviewed databases such as Web of Science, Scopus, IEEE Xplore, Google Scholar, and ScienceDirect with systematic review methodology (PRISMA). Atlas.ti software was employed by the authors in order to identify noteworthy trends in employing AI within supply chain management after choosing the most pertinent papers. The study provides insights into how AI is significantly contributing to vital functions like inventory management, demand planning, and data-driven, timely decision-making. Supply chains are becoming more responsive and tailored because Industry 5.0 is increasingly focusing on human-AI collaboration. AI also contributes to the environment by assisting companies in utilizing AI resources more efficiently and minimizing waste. There are nonetheless issues, including safeguarding employees from such change and making systems cyber proof. Overall, the study offers good insight into how to best incorporate AI into smart, sustainable, and future-proof supply chains for researchers and practitioners.},
  keywords={Technological innovation;Supply chain management;Supply chains;Collaboration;Software;Fourth Industrial Revolution;Artificial intelligence;Fifth Industrial Revolution;Sustainable development;Systematic literature review;Sustainability;Industry 4.0;Industry 5.0;Supply Chain Management (SCM);and Artificial Intelligence (AI)},
  doi={10.1109/ICCCA66364.2025.11325432},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11325199,
  author={Dhatterwal, Jagjit Singh and Chahar, Suman and Malik, Kiran},
  booktitle={2025 IEEE 7th International Conference on Computing, Communication and Automation (ICCCA)}, 
  title={Multi-Objective Optimization and Cyber-Physical Integration for Sustainable Manufacturing in Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Furthermore, the development of manufacturing from Industry 4.0 to Industry 5.0, requires paradigm changes towards sustainable, resilient and human-centered industrial ecosystems. In this paper, a methodology is proposed with the aim of designing a holistic framework for the integration between MOO and CPS to render sustainable manufacturing in a way that is congruent with Industry 5.0 principles. Using a system-theories point of view and data-driven intelligence, we will cope with trade-offs of contradicting objectives (productivity, energy efficiency, environmental impact, or well-being of workers) in the dynamic factory context. Our approach is based on real-time sensor data, digital twins and machine learning for decision support throughout the product lifecycle. We introduce an optimization framework which integrates Pareto-based evolutionary algorithms and reinforcement learning for adaptive control in complex CPS. In addition, we introduce human-in-the-loop-design to guarantee transparency, to empower workers, and to improve system resilience in the face of uncertainty. Taking case studies in smart manufacturing, our framework realizes remarkable energy efficient (up to 27%), carbon footprint decreased (by 18%), and worker satisfaction score improvement, verifying its practicality in human-cyber-physical coordination. We also discuss policy implications and ethical issues related to responsible technology implementation. This work adds to growing debate on Industry 5.0 by bridging computational techniques with social technical viewpoints. It offers a flexible, integrated model for future-fit manufacturing systems which are based on commitment to sustainability, resilience and human well-being. The approach provides theoretical understanding as well as practical instruments for engineers, researchers and policy makers to create a balanced, post-industrial manufacturing system.},
  keywords={Productivity;Ethics;Technological innovation;Uncertainty;Ecosystems;Evolutionary computation;Energy efficiency;Fifth Industrial Revolution;Sustainable development;Optimization;multi-objective optimization;cyber-physical systems;evolutionary algorithms;Industry 5.0},
  doi={10.1109/ICCCA66364.2025.11325199},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11330622,
  author={Keary, Alphonsus and Amer, Nehal and Emam, Masoud and Dunne, Alan and Torres, Javier and O'Riordan, Kate and Walsh, Michael and O'Flynn, Brendan},
  booktitle={2025 IEEE SENSORS}, 
  title={Edge Accelerated AI for Robotic Teleoperation}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper presents a body of work on the development of edge accelerated AI hardware and software components related to robotic teleoperations. In particular, the paper proposes a system based architecture incorporating teleoperations communications layers in the form of a local to remote edge based stack, along with a Time of Flight (ToF) sensor layer, delivering user controls via real time hand and gesture signals for robotic teleoperations. Typical use cases include, remote skills delivery, precision robot manipulation, factory of the future, dangerous work environments and many other Industry 4.0/5.0 scenarios.},
  keywords={Industries;Hands;Service robots;Robot sensing systems;Software;Real-time systems;Production facilities;Hardware;Fourth Industrial Revolution;Artificial intelligence;Industrial Automation;Artificial Intelligence;Industry 4.0;Industry 5.0;Edge Computing;PLCs;Profinet;RapID},
  doi={10.1109/SENSORS59705.2025.11330622},
  ISSN={2168-9229},
  month={Oct},}@INPROCEEDINGS{11330553,
  author={Bandraupalli, Srihari and Gajera, Mihir and Saifee, Ali Asgar and Parwar, Anupam},
  booktitle={2025 5th International Conference on AI-ML-Systems (AIMLSystems)}, 
  title={VLMs-in-the-Wild: Bridging the Gap Between Academic Benchmarks and Enterprise Reality}, 
  year={2025},
  volume={},
  number={},
  pages={299-311},
  abstract={Open-source Vision-Language Models show immense promise for enterprise applications, yet a critical disconnect exists between academic evaluation and enterprise deployment requirements. Current benchmarks rely heavily on multiple-choice questions and synthetic data, failing to capture the complexity of real-world business applications like social media content analysis. This paper introduces VLM-in-the-Wild (ViLD), a comprehensive framework to bridge this gap by evaluating VLMs on operational enterprise requirements. We define ten business-critical tasks: logo detection, OCR, object detection, human presence and demographic analysis, human activity and appearance analysis, scene detection, camera perspective and media quality assessment, dominant colors, comprehensive description, and NSFW detection. To this framework, we bring an innovative BlockWeaver Algorithm that solves the challenging problem of comparing unordered, variably-grouped OCR outputs from VLMs without relying on embeddings or LLMs, achieving remarkable speed and reliability. Besides, ViLD's methodology avoids traditional bounding boxes, which are ill-suited for generative VLMs, in favour of a novel spatial-temporal grid system that captures localisation information effectively for both images and videos. To demonstrate efficacy of ViLD, we constructed a new benchmark dataset of $\mathbf{7, 5 0 0}$ diverse samples, carefully stratified from a corpus of one million real-world images and videos. ViLD provides actionable insights by combining semantic matching (both embedding-based and LLM-as-a-judge approaches), traditional metrics, and novel methods to measure the completeness and faithfulness of descriptive outputs. By benchmarking leading open-source VLMs (Qwen, MIMO, and InternVL) against a powerful proprietary baseline as per ViLD framework, we provide one of the first industry-grounded, task-driven assessment of VLMs capabilities, offering actionable insights for their deployment in enterprise environments.},
  keywords={Analytical models;Content management;Social networking (online);Optical character recognition;Semantics;Benchmark testing;Quality assessment;Reliability;Videos;Synthetic data;Vision-Language Models;Enterprise AI;Multimodal Benchmarking;OCR Evaluation;Generative Models;Content Analysis;Scene Understanding},
  doi={10.1109/AIMLSystems67835.2025.11330553},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11321708,
  author={Ali, Marwa Ben and Rauch, Erwin},
  booktitle={2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={Integrating ISO 50001:2018 into Engineering Education: Advancing Energy skills for Industry 4.0 and 5.0}, 
  year={2025},
  volume={1},
  number={},
  pages={2817-2822},
  abstract={The present paper explores the integration of ISO 50001 energy management standards into engineering education in Europe, aiming to align academic training with the demands of Industry 4.0 (I4.0) and Industry 5.0 (I5.0), as well as the evolving technologies and regulations. It underscores the strategic importance of equipping future engineers with the competencies necessary for energy efficiency, sustainability reporting, and smart sustainable industrial practices. By embedding ISO 50001 into curricula, students can acquire essential skills that enhance their employability, innovation potential, and readiness to contribute to modern energy management systems. The paper also discusses the mutual benefits for companies, including smoother implementation of energy strategies and a workforce better prepared for sustainability-driven transformation. Despite its potential, ISO 50001 adoption remains limited, with many companies still hesitant, highlighting the need for stronger educational-industry collaboration and curriculum reform. However, this approach of academia-industry collaboration could serve as a starting point for initiating the internal audit towards external certification.},
  keywords={Technological innovation;ISO Standards;Collaboration;Companies;Energy efficiency;Fourth Industrial Revolution;Engineering education;Fifth Industrial Revolution;Sustainable development;Standards;ISO50001;Industry 4.0;Industry 5.0;Education 5.0;Energy Management;Energy Efficiency;Engineering Education},
  doi={10.1109/CoDIT66093.2025.11321708},
  ISSN={2576-3555},
  month={July},}@INPROCEEDINGS{11321635,
  author={Tousert, Nikolaos and Lipitakis, Anastasia Dimitra and Giannakopoulos, Thanos and Ntalaperas, Dimitris and Kiourtis, Athanasios and Mavrogiorgou, Argyro and Papageorgiou, Xanthi S.},
  booktitle={2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={Human-Centric AI-Enabled Extended Reality Reference Architecture for Industry 5.0}, 
  year={2025},
  volume={1},
  number={},
  pages={966-971},
  abstract={Industry 5.0 improves human-machine collaboration by integrating Artificial Intelligence (AI) and Extended Reality (XR) into industrial environments. This paper presents a structured Reference Architecture for a system that addresses industrial environments within the Industry 5.0 paradigm, iteratively refined based on evolving business and technical requirements. Designed for scalability, interoperability, and flexibility, it enables seamless interaction between XR applications, AI-powered decision support tools, and industrial systems. The architecture incorporates an enterprise architecture perspective that addresses industry-driven use cases and user scenarios from six pilot applications. Key components, including XR applications, AI recognition models, digital twins (DTs), and an orchestration hub, are outlined. The business layer is built on user stories that reflect real-world industrial needs from various sectors, and future directions for extending the architecture within Industry 5.0 ecosystems are discussed.},
  keywords={Technical requirements;Extended reality;Scalability;Ecosystems;Digital twins;Fifth Industrial Revolution;Artificial intelligence;Information technology;Interoperability;Business},
  doi={10.1109/CoDIT66093.2025.11321635},
  ISSN={2576-3555},
  month={July},}@INPROCEEDINGS{11321576,
  author={Cui, Yaheng and Diarrassouba, Ibrahima and Wang, Chenghao},
  booktitle={2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={Dual-Resource Allocation Problem in a Flow Shop under Human Behavior Uncertainties}, 
  year={2025},
  volume={1},
  number={},
  pages={532-537},
  abstract={Industry 5.0 emphasizes human-centered production environments, promoting collaboration between humans and smart machines. This shift introduces new scheduling challenges due to the stochastic nature of human behavior—challenges that traditional deterministic models cannot adequately address. This paper studies a stochastic dual-resource allocation problem in a flow shop setting, where worker behavior impacts production outcomes through random breaks. We model worker states using Markov chains and apply a Sample Average Approximation method to minimize the expected makespan for a given number of jobs. Numerical experiments demonstrate the effectiveness of our approach. We also study the impact of the behavior of the workers on the overall production performance.},
  keywords={Job shop scheduling;Uncertainty;Stochastic processes;Programming;Mathematical models;Behavioral sciences;Numerical models;Resource management;Fifth Industrial Revolution;Manufacturing systems;Industry 5.0;stochastic programming;production scheduling;human-centric manufacturing systems},
  doi={10.1109/CoDIT66093.2025.11321576},
  ISSN={2576-3555},
  month={July},}@INPROCEEDINGS{11321535,
  author={Romeo, L. and Patruno, C. and Cicirelli, G. and D’Orazio, T.},
  booktitle={2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={Deep Learning Methods with Iterative-Boosting for performing Human Action Recognition in Manufacturing Scenarios}, 
  year={2025},
  volume={1},
  number={},
  pages={835-840},
  abstract={The physical and cognitive behavior of humans working in manufacturing environments is an issue that is becoming increasingly important with the advent of Industry 5.0. In this context, the need to monitor operators performing specific tasks is fundamental, particularly when such operators work alongside robots. In fact, guaranteeing the well-being of human workers in industrial scenarios may consistently help in reducing risky and harmful situations. In this work, the HA4M dataset is used to assess human action recognition in a manufacturing environment, where operators perform assembly actions. More specifically, the study has been focused on training a deep learning architecture, namely the MS-TCN++, on RGB data extracted from a specific user, aiming to allow the action recognition model to properly adjust at the selected subject. The RGB data are elaborated using the Inflated 3D model, and the upcoming features have been sorted considering matrix-wise and array-wise dimensions. Furthermore, a 10-stage iterative-boosting technique has been developed, in which the model is iteratively trained by focusing on misclassified samples. It has been proved that the iterative methods allow a faster and more reliable training of the network, reaching an Accuracy, Precision, Recall, and F-score of 70.39%, 74.24%, 68.70%, and 65.73%, respectively, when training using array-wise features. Such results show the effectiveness of the proposed system, laying the foundation for further studies for detecting the operators’ actions in the challenging context of Human-Robot Collaboration.},
  keywords={Training;Deep learning;Service robots;Focusing;Boosting;Feature extraction;Data models;Iterative methods;Assembly;Sorting},
  doi={10.1109/CoDIT66093.2025.11321535},
  ISSN={2576-3555},
  month={July},}@INPROCEEDINGS{11321794,
  author={Venturino, Antonello and Tedesco, Francesco and Casavola, Alessandro and Franzè, Giuseppe},
  booktitle={2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={A receding horizon control for multi-robot navigation under LiDAR-driven graph updates}, 
  year={2025},
  volume={1},
  number={},
  pages={131-136},
  abstract={In the context of Industry 5.0, where environments are subject to unpredictable changes, achieving real-time adaptability and robust collision avoidance is essential for safe navigation and timely task execution. This paper introduces a Robust Grid-Based Receding Horizon Control scheme tailored for multi-robot logistics, designed to address dynamic obstacles and bounded multiplicative disturbances in unicycle-type robots. The method employs a single grid graph, continuously updated in real time using LiDAR data. A distributed robust set-theoretic model predictive control strategy leverages the grid graph to ensure safe and efficient navigation. The proposed approach is validated through realistic simulations in ROS/Gazebo, demonstrating its effectiveness in complex and dynamic scenarios.},
  keywords={Laser radar;Navigation;Service robots;Simulation;Wheels;Real-time systems;Collision avoidance;Fifth Industrial Revolution;Logistics;Predictive control},
  doi={10.1109/CoDIT66093.2025.11321794},
  ISSN={2576-3555},
  month={July},}@INPROCEEDINGS{11326664,
  author={Wang, Yanghui and Zhou, Yong and Hu, Kaixiong and Li, Weidong and Nee, Andrew Yeh-Ching and Ong, Soh Khim},
  booktitle={2025 6th International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering (ICBAIE)}, 
  title={Multi-Agent Proximal Policy Optimization for Dynamic Planning in Human-Robot Collaborative Disassembly}, 
  year={2025},
  volume={},
  number={},
  pages={256-260},
  abstract={With the rapid development of remanufacturing technology, human-robot collaborative disassembly (HRCD) has become a key solution for improving production efficiency. However, operators performing high-cognitive-load tasks for long periods of time can experience mental fatigue, which poses safety risks and is inconsistent with the human-centered values of Industry 5.0. To improve operator well-being, this study proposes a dynamic planning approach for HRCD tasks that take operator mental fatigue into account. This approach considers humanrobot combinatorial task strategy with the multi-agent proximity policy optimization algorithm to perform real-time planning of disassembly tasks. The experimental results show that the proposed approach can achieve efficient disassembly while ensuring that the operator’s mental fatigue level remains within a safe range, providing a new approach and reference for achieving human-centered HRCD.},
  keywords={Heuristic algorithms;Collaboration;Reinforcement learning;Production;Fatigue;Real-time systems;Planning;Safety;Internet of Things;Optimization;human-robot collaborative disassembly;disassembly planning;reinforcement learning},
  doi={10.1109/ICBAIE66852.2025.11326664},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11322972,
  author={Tong, Juncheng and Zhao, Bo and An, Yang},
  booktitle={2025 IEEE 31th International Conference on Parallel and Distributed Systems (ICPADS)}, 
  title={A Trust-Enhanced Proof of Useful Work for Blockchain-Based Cloud Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={In recent years, key technologies supporting Industry 5.0 have progressed rapidly, especially the convergence of blockchain and cloud manufacturing. Exploiting the decentralized structure and transparent record-keeping of blockchain technology enables trustworthy management of resource services among stakeholders in cloud manufacturing. However, existing blockchain-based cloud manufacturing (BCM) frameworks face two challenges: (i) both PoW consensus and the solution of cloud service-composition consume considerable computation; and (ii) chain forks and other network attacks undermine practicality. To address deeper trust concerns in BCM, this paper proposes TPoUW-BCM, a trust-enhanced proof of useful work mechanism for BCM. First, we design a mining process driven by cloud manufacturing service-composition to substantially reduce the useless work of PoW. Second, we develop a secure incentive mechanism with diversity-based evaluation and selection, which allocates rewards in a work-proportional manner while discouraging forks and improving system reliability. The scheme further mitigates the risks posed by Sybil and replay attacks under dynamics in service scale and constraints. Numerical experiments under cloud-manufacturing scenarios validate the effectiveness of the TPoUW-BCM, demonstrating strong potential for practical deployment.},
  keywords={Manufacturing;Consensus protocol;Reliability;Stakeholders;Security;Fifth Industrial Revolution;Faces;Convergence;cloud manufacturing;blockchain;consensus mechanisms;reliability;security},
  doi={10.1109/ICPADS67057.2025.11322972},
  ISSN={2690-5965},
  month={Dec},}@INPROCEEDINGS{11324982,
  author={Krasteva, Neviana},
  booktitle={2025 International Conference Automatics and Informatics (ICAI)}, 
  title={Industry 5.0 - the use of new business models and artificial intelligence in tourism in Bulgaria}, 
  year={2025},
  volume={},
  number={},
  pages={885-890},
  abstract={The report is dedicated to exploring possible business approaches in tourism in the context of AI and Industry 5.0, a new production model that focuses on human-machine collaboration. The main objective of the research is to clarify the general directions of change in business approaches and marketing in tourism in the age of AI and Industry 5.0. The primary research question is: "How does AI affect the customer experience in tourism and how can these technologies be applied to improve the tourism sector in Bulgaria?" Research methods include a desk study and content analysis as well as questions asked to ChatGPT. Currently, the tourism sector demonstrates the capacity to generate a wide range of diverse products. Conclusions will be drawn about the need to change strategies for tourism business and staff training through the knowledge of new technologies and their use. This necessitates the development of qualitatively new training programs in universities and specialized schools.},
  keywords={Training;Content management;Human-machine systems;Collaboration;Production;Artificial intelligence;Fifth Industrial Revolution;Informatics;Business;Context modeling;AI;Industry 5.0;Tourism},
  doi={10.1109/ICAI67591.2025.11324982},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11328427,
  author={Balart, Trini and Shryock, Kristi J.},
  booktitle={2025 IEEE Frontiers in Education Conference (FIE)}, 
  title={Pre-Conference Workshop: Artificial General Intelligence Integration into Engineering Education, a Framework That Balances Technology with Human-Centered Skill Development}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={As engineering education advances in alignment with Industry 5.0, institutions face increasing pressure to adapt their curricula to emerging technologies without compromising foundational competencies such as creativity, ethical reasoning, and adaptability. This workshop introduces the Artificial General Intelligence Integration into Engineering Education (AGIIEE) Framework, a structured approach to support educators in effectively incorporating AI-driven tools while preserving and enhancing human-centered skills. The workshop equips participants with actionable strategies, ethical frameworks, and practical tools for leveraging AI to personalize learning, support interdisciplinary collaboration, and maintain inclusive, human-centric pedagogies. Through interactive activities, case-based discussions, and structured feedback sessions, attendees will co-develop innovative approaches to AI integration.},
  keywords={Ethics;Educational programs;Conferences;Artificial general intelligence;Curriculum development;Educational technology;Engineering education;Fifth Industrial Revolution;Faces;Creativity;Engineering education;Artificial intelligence;Educational technology;Faculty development;Adaptive learning;Career development;Educational programs;Curriculum development},
  doi={10.1109/FIE63693.2025.11328427},
  ISSN={2377-634X},
  month={Nov},}@INPROCEEDINGS{11328335,
  author={Minami, Mario and Kurashima, Celso S. and Gazziro, Mario and Ferreira, Wallace G. and Arantes, Camila C. and de Paiva, Cláudia F. E. and Malmonge, Sônia M. and Celestino, Claudia Celeste and Bittencourt, Vitor},
  booktitle={2025 IEEE Frontiers in Education Conference (FIE)}, 
  title={WIP: Building a Bridge to the Future: Connecting Engineering Students with Alumni, Industry, and the Community Through an Innovative Outreach Program}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This University Outreach curriculum program engaged 700 interdisciplinary engineering students in an Engineering Innovation course, fostering essential skills aligned with Society 5.0 principles. Through hands-on experiences, students honed collaborative problem-solving, human-centered design, and real-world data analysis. Unique to this initiative is the large-scale, integrated application of Design Thinking, Critical Thinking, and Agile methodology within a comprehensive university-to-industry outreach framework. The capstone “Engineering Innovations” event provided a vital platform, connecting students with alumni, innovation agencies, and investors for project evaluation and broader university extension. Diverse feedback strategies were instrumental in structuring group activities across Design Thinking phases and significantly enhancing Critical Thinking, even as application varied across classes. Challenges encountered during development were effectively reframed as valuable learning opportunities. Future analysis of in-depth participant interviews will offer a comprehensive assessment of the program's enduring impact on student development and innovation readiness.},
  keywords={Industries;Technological innovation;Data analysis;Statistical analysis;Instruments;Buildings;Teamwork;Problem-solving;Engineering students;Interviews;Engineering Education;Design Thinking;Critical Thinking;Real-World Problem Solving;Collaborative Teamwork;University Outreach;Empathy in Engineering;Society 5.0},
  doi={10.1109/FIE63693.2025.11328335},
  ISSN={2377-634X},
  month={Nov},}@INPROCEEDINGS{11336015,
  author={Fahmi, Fahmi and Panjaitan, Sihar and Munadi, Khairul},
  booktitle={2025 9th International Conference on Electrical, Telecommunication and Computer Engineering (ELTICOM)}, 
  title={Digital Maturity Index in Higher Education Indonesia: Indicators for Digital Transformation Readiness}, 
  year={2025},
  volume={},
  number={},
  pages={274-280},
  abstract={The digital transformation of higher education is a strategic foundation towards Golden Indonesia 2045, where universities are required not only to adopt technology, but also to build a comprehensive digital ecosystem that includes ICT infrastructure, integration of academic-administrative information systems, online and hybrid learning based on LMS/MOOC, data management with big data analytics, and strengthening the digital culture and competencies of the academic community. The Digital Maturity Index for Higher Education (Indeks Kematangan Digital Perguruan Tinggi/IKD-PT) serves as an evaluation instrument to assess each institution's position, focusing on readiness in internet, devices, data security, learning flexibility, and technology adoption among lecturers and students. The implementation of IKD-PT nationally will accelerate the formulation of data-based policies, encourage equitable infrastructure investment, and strengthen synergy between the government, universities, and industry in producing superior, innovative, and globally competitive human resources. With a targeted strategy and mature digital governance, Indonesian universities can become the driving force of innovation and pillars of national intelligence in the era of the Industrial Revolution 4.0 and Society 5.0.},
  keywords={Technological innovation;Systematics;Digital transformation;Instruments;Education;Ecosystems;Planning;Indexes;Monitoring;Investment;Digital maturity index;Higher Education;Digital Transformation},
  doi={10.1109/ELTICOM67568.2025.11336015},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11324536,
  author={Foong, Kai Quan and Sivakumar, Saaveethya and Lim, King Hann and Lim, Chye Ing and Chew, Ing Ming and Fui, Siew Eng},
  booktitle={2025 International Conference on Green Energy, Computing and Sustainable Technology (GECOST)}, 
  title={Large Language Model-based defect detection in context of industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The transition from manual labor to automation, driven by Industry 4.0 and the emerging Industry 5.0, has significantly transformed manufacturing. However, defects are still unavoidable in manufacturing, especially in the metal domain. To avoid substantial economic and reputational losses, defect detection is a must to guarantee long-term quality and durability of metal products. Despite high accuracy in defect detection, advanced Artificial Intelligence (AI) models like Large Language Models (LLMs) and Multimodal Large Language Models (MLLMs) can optimize production processes, improve efficiency, and lower operational costs. This drives the emergence of AI agents, which are autonomous systems powered by advanced AI models to efficiently perform complex tasks. Thus, this paper is aimed to address the question of how LLMs and MLLMs can enhance defect detection efficiency and interpretability in Industry 5.0 manufacturing systems. To achieve this, a comparative and conceptual analysis is conducted among the studies applying LLMs and MLLMs in a workflow, in terms of data collection, models, and evaluation metrics. In addition, this paper also further studies the practical applications and limitations encountered among the studies.},
  keywords={Training;Accuracy;Costs;Biological system modeling;Large language models;Steel industry;Real-time systems;Steel;Fifth Industrial Revolution;Defect detection;Large Language Model;Defect Detection;Multimodal;Artificial Intelligence;Deep Learning;AI Agent;Industry 5.0},
  doi={10.1109/GECOST66002.2025.11324536},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11321983,
  author={Kihel, Yousra El and Bouyahrouzi, El Mahdi and Embarki, Soufiane and Sehli, Lotfi and Kihel, Bachir El},
  booktitle={2025 IEEE 13th International Conference on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications (IDAACS)}, 
  title={Harnessing Lean and Industry 4.0 for Sustainable and Zero-Waste Warehousing: A Conceptual Framework Toward Lean 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1456-1461},
  abstract={The fast expansion of Industry 4.0 technologies creates new opportunity to reinvent traditional warehousing practices, yet the difficulty of removing systematic waste persists. Although Lean Manufacturing has long been acknowledged as a key to waste reduction, its integration with I4.0 technologies remains unexplored in the context of smart warehouses. This article provides a dynamic conceptual framework that combines Industry 4.0 technology and Lean principles to create sustainable, zero-waste storage, paving the path for Lean 5.0. The proposed framework addresses both overt wastes-such as overproduction and excess inventory-and more subtle inefficiencies, such as energy losses and process variability, by incorporating real-time data analytics, RFID and barcode, and automated decisionmaking and storage into Lean methodologies such as Value Stream Mapping and Just-In-Time. A case study done at a Moroccan beverage bottling facility revealed a 30% decrease in inventory-related waste and a $25 \%$ increase in operational throughput achieved by IoT-enabled inventory monitoring and AI-driven demand forecasting, respectively. Furthermore, the application of Machine Learning algorithms strengthens Lean’s kaizen concept by allowing for proactive waste detection and detailed root cause investigation. This scalable, technology-agnostic paradigm combines the theoretical goals of Lean with the practical needs of Industry 4.0, laying the groundwork for a new age of Lean 5.0 centered on sustainability and zero waste.},
  keywords={Waste reduction;Systematics;Zero waste;Warehousing;Throughput;Real-time systems;Fourth Industrial Revolution;Sustainable development;Monitoring;Radiofrequency identification;Industry 4.0;Lean 5.0;Lean Manufacturing;Zero-Waste;Sustainable Development, Smart Warehouse},
  doi={10.1109/IDAACS68557.2025.11321983},
  ISSN={2770-4254},
  month={Sep.},}@INPROCEEDINGS{11326181,
  author={Colombi, Lorenzo and Caro, Edoardo Di and Dahdal, Simon and Poltronieri, Filippo and Tabanelli, Filippo and Tortonesi, Mauro and Stefanelli, Cesare and Vignoli, Massimiliano},
  booktitle={2025 IEEE Symposium on Computers and Communications (ISCC)}, 
  title={FedEdge-Learn: a Semi-Supervised Federated Learning Framework for Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent advancements in Machine Learning (ML) and MLOps for Industry 5.0 have significantly boosted productivity in manufacturing by enabling predictive maintenance and optimizing industrial workflows. However, implementing ML applications in real-world industrial environments presents several challenges, including limited access to labeled data, stringent privacy requirements, and the decentralized nature of industrial data. An effective solution for distributed learning with unlabeled data is essential to address these issues. In this paper, we introduce FedEdge-Learn, a novel Federated Learning framework tailored for Industry 5.0 applications. It focuses on unsupervised K-means clustering enhanced by globally shared data. Our approach safeguards data privacy other than accelerating the onboarding of new machines by leveraging the globally trained model. We validate our framework using both public datasets and real-world industrial data, demonstrating its effectiveness in real-world scenarios. The results show how, with our framework, the K-means algorithm is effective in federated settings, without a significant performance decrease compared to the centralized case.},
  keywords={Productivity;Data privacy;Computer aided instruction;Federated learning;Distance learning;Heuristic algorithms;Refining;Semisupervised learning;Servers;Fifth Industrial Revolution;Federated Learning;Industry 5.0;SemiSupervised Learning;Distributed Learning},
  doi={10.1109/ISCC65549.2025.11326181},
  ISSN={2642-7389},
  month={July},}@INPROCEEDINGS{11325976,
  author={Colombi, Lorenzo and Boleac, Ion and Brina, Matteo and Dahdal, Simon and Tortonesi, Mauro and Vignoli, Massimiliano and Stefanelli, Cesare},
  booktitle={2025 IEEE Symposium on Computers and Communications (ISCC)}, 
  title={Multi-Cluster MLOps Platform for Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Machine Learning (ML) is becoming increasingly vital in various Big Data applications within Industry 5.0, such as predictive maintenance, zero-defect manufacturing, and process or supply chain optimization. However, the dynamic and high-stakes nature of manufacturing necessitates continuous monitoring, periodic reevaluation, and potential retraining of ML models to ensure they remain accurate and aligned with the evolving operational context. This paper presents a Machine Learning Operations (MLOps) platform tailored for Industry 5.0 applications, taking advantage of the whole Compute Continuum, from the edge to the cloud, designed to be scalable and resource-efficient. Built on Kubernetes and the Kubeflow framework, the platform enables seamless management of the entire ML lifecycle, from model development to deployment, across multi-cluster environments. Using Bonfiglioli’s real-world anomaly detection use case, the platform demonstrated its ability to support robust, low-latency ML inference services under varying workloads, even on resource-constrained edge devices. Experimental results confirm the platform’s efficiency, scalability, and practical applicability in addressing zero-defect and zero-waste manufacturing requirements.},
  keywords={Image edge detection;Computational modeling;Scalability;Supply chains;Machine learning;Manufacturing;Fifth Industrial Revolution;Optimization;Monitoring;Predictive maintenance;Industry 5.0;Machine Learning;Machine Learning Operations;MLOps;Service Management;Compute Continuum},
  doi={10.1109/ISCC65549.2025.11325976},
  ISSN={2642-7389},
  month={July},}@INPROCEEDINGS{11320651,
  author={Garg, Ankit and Pandita, Sarjue and Das, Sanghamitra and Kaushik, Rashmi and Tarkar, Preeti and Dhamija, Aarav},
  booktitle={2025 International Conference on Digital Innovations for Sustainable Solutions (ICDISS)}, 
  title={Integrating Blockchain and Industry 5.0 for Sustainability in Ready-Made Garment (RMG) Industries: A Hybrid ISM and Fuzzy DEMATEL Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In this research, a basic framework will be proposed so that RMG can achieve sustainable growth with integration with the principles of $\mathbf{I 5. 0}$ in incorporating the principles of BT. For this research, 14 critical synergies were taken for consideration in order to promote sustainability, where Fuzzy DEMATEL and ISM were used. Fuzzy DEMATEL identified the impact of these synergies in a direct and indirect way, which identified a hierarchical structure and interdependency in ISM. Also, this research proved how critical technology such as a digital twin can simulate and promote sustainability in modeling with digital twin capabilities, which can make a vital role in achieving sustainability in parameters such as minimizing wastage and using eco-compatible packaging. Several SDGs include cultivating consumption behavior, reduction of climate change, and utilization of renewable energy resources. Hence, the integration of both technologies is an absolute necessity in this case. Integration of technology promotes very critical parameters such as traceability, efficiency, and transparency in operations. At this point, it can be said that pointing out the most critical part of this research is being not limited in nature to the RMG industry. The integration strategy of both technologies will make way for scaling up a strategy in order to have sustainability projects in other industries.},
  keywords={Industries;Technological innovation;Renewable energy sources;Green products;Clothing;Packaging;Digital twins;Blockchains;Sustainable development;Fifth Industrial Revolution;Industry 5.0;Blockchain Technology;Sustainability;the Ready-Made Garment (RMG) Sector;Fuzzy DEMATEL;ISM},
  doi={10.1109/ICDISS68238.2025.11320651},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11318185,
  author={Iyer, Rajesh Sivaraman and Patil, Sanjaykumar L. and Chaskar, Uttam M. and Pachghare, Vinod K.},
  booktitle={2025 International Conference on Computational Intelligence and Knowledge Economy (ICCIKE)}, 
  title={Next-Generation Predictive Maintenance: Transforming Oil & Gas with Iot-Driven Deep Learning and Industry 5.0 Innovations}, 
  year={2025},
  volume={},
  number={},
  pages={512-517},
  abstract={Unplanned equipment downtime in the oil and gas sector - for example, unexpected gas turbine shutdowns on offshore platforms - costs hundreds of thousands of dollars and poses safety hazards. To counteract this, we propose a nextgeneration predictive maintenance strategy that utilizes IoT sensor streams and deep learning (DL) analytics in an Industry 5.0 paradigm. We have proposed a solution, which constantly monitors the condition monitoring data of the gas turbine and, at the same time, applies neural networks to identify anomalies and estimate the remaining useful life (RUL). In a case study, the system accurately predicted turbine failures up to 6 days ahead of time with $>$ 90% accuracy, initiating proactive maintenance that minimized unplanned downtime by about 30 % and increased mean time between failures. In addition, we demonstrate how the AI-powered forecasts can be integrated into a Computerized Maintenance Management System (CMMS) in order to generate automated work orders, optimizing turnaround planning and resource allocation. A revolutionary maintenance approach with autonomous intelligence blended with human expertise is proposed. This paper explains how maintenance in the oil and gas industry can be enhanced by the integration of IoT, innovative DL, and human-centric Industry 5.0, thereby ensuring improved safety and increased efficiency.},
  keywords={Deep learning;Accuracy;Offshore installations;Oils;Maintenance;Planning;Internet of Things;Fifth Industrial Revolution;Turbines;Predictive maintenance;Industry 5.0;Predictive Maintenance (PdM);Internet of Things (IoT);Oil and Gas;Deep Learning (DL)},
  doi={10.1109/ICCIKE67021.2025.11318185},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11320480,
  author={Vejjanugraha, Pikul and Pawasarn, Wuttipong},
  booktitle={2025 20th International Joint Symposium on Artificial Intelligence and Natural Language Processing (iSAI-NLP)}, 
  title={Technician Utilization-Based Analysis of Mean Time to Detect (MTTD) and Mean Time to Repair (MTTR) for a Strategic Approach in Failure Corrective Maintenance System (FCMS)}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={In Industry 4.0 and 5.0 environments, reliability and efficiency are vital to maintaining competitiveness, as unplanned downtime can cause severe operational losses. This study presents a technician utilization–based analysis of Mean Time to Detect (MTTD) and Mean Time to Repair (MTTR) within a Failure Corrective Maintenance System (FCMS). Results show that high technician utilization extends MTTR due to workload saturation, whereas low utilization delays MTTD because of limited inspections. A Pareto analysis reveals that 20% of technicians account for over 80% of total maintenance activities, indicating a significant imbalance in workload distribution. To address this, a strategic framework is proposed emphasizing balanced technician allocation, skill-based task assignment, and digital monitoring integration. The proposed approach aims to optimize workforce utilization, enhance responsiveness, and improve system reliability. The contribution of this work lies in offering actionable guidelines by define technician utilization thresholds at 55-75% as the optimal threshold for balanced workload for industries seeking to strengthen workforce efficiency, minimize downtime, and sustain resilience in advanced industrial ecosystems.},
  keywords={Industries;Accuracy;Time measurement;Maintenance;Resource management;Personnel;Pareto analysis;Monitoring;Preventive maintenance;Resilience;Technician Utilization;Failure Corrective Maintenance System;Mean Time to Detect;Mean Time to Repair;Technician Utilization Thresholds},
  doi={10.1109/iSAI-NLP66160.2025.11320480},
  ISSN={2831-4565},
  month={Nov},}@INPROCEEDINGS{11317725,
  author={Batho, George and Connor, Peter H. and Zou, Tianjie and Walker, Adam and Tweedy, Oliver and Huang, Hailin and Mifsud, Liam Portanier and Ren, Xiang and Gerada, Chris and Egger, Christian},
  booktitle={2025 28th International Conference on Electrical Machines and Systems (ICEMS)}, 
  title={Design of a Forced Air-Cooling System for an Automotive Axial Flux Traction Motor using Computational Fluid Dynamics}, 
  year={2025},
  volume={},
  number={},
  pages={659-663},
  abstract={The “Net Zero” emissions strategy has driven the automotive industry into electrification. Ambitious roadmaps outlining challenging machine performance requirements have motivated the exploration of more revolutionary technologies. Axial flux permanent magnet machines are a prime focus, as they can provide high power-densities with significant material and cost reduction. The trend of high-speed automotive traction machines creates a thermal challenge for the rotors, resulting in higher component and windage losses. Air-cooling is an effective technique for removing heat from the rotor. This can be further enhanced by utilising forced air-cooling methods, particularly in the airgap region where machine losses are concentrated. However, this increased heat transfer comes at the consequence of a higher windage loss. The trade-off between these two characteristics is essential, as poorly implemented cooling topologies can negatively impact machine performance. This study investigates the heat transfer and windage characteristics of forced air-cooling for the rotor of an axial flux permanent magnet machine. Computational fluid dynamics is utilised to simulate an inflow of ambient air through the airgap of the machine. The flow rates were varied alongside the rotational speed, which was executed at regular intervals up to $\mathbf{1 5, 0 0 0 r p m}$. The results were compared with existing rotating disc correlations. Implementing higher flow rates enabled a magnet temperature reduction of $\mathbf{5 0}^{\boldsymbol{\circ}} \mathbf{C}$ at maximum speed.},
  keywords={Permanent magnet machines;Magnetohydrodynamics;Cooling;Net zero;Air gaps;Velocity control;Rotors;Traction motors;Thermal management;Automotive engineering;Thermal management;conductors;rotors;rotating machines;traction motors},
  doi={10.23919/ICEMS66262.2025.11317725},
  ISSN={2642-5513},
  month={Nov},}@INPROCEEDINGS{11327760,
  author={Insinga, Giorgio and Anzoino, Francesco and Bella, Pietro and Bernardi, Paolo and Filippetti, Luca and Khattar, Reem},
  booktitle={2025 IEEE International Symposium on Emerging Metaverse (ISEMV)}, 
  title={ARBoard: Augmented Reality for PCB Operations in Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Industry 5.0 represents the next evolution in manufacturing, emphasizing human-centric approaches while lever-aging advanced technologies to create sustainable, resilient, and personalized production systems. Recent advancements in the Internet of Things, Cloud Computing, Machine Learning, Artificial Intelligence and Augmented Reality are starting to have significant effects in the manufacturing lifecycle thanks to the increase in the efficiency and productivity through automation and optimization while maintaining human expertise at the center of operations. Focusing on the electronic manufacturing world, these per-vasive new technologies continue to improve, and together with automation play a fundamental role in today's industrial pro-duction. Nevertheless, manual activities remain essential in the development lifecycle of electronic products and of their PCBs. Manual labor is necessary especially during the prototyping phase to debug the design and validate its correct behavior. For this purpose, test engineers have to constantly switch between PCB schematic and layout files in a process that is slow, error-prone and stressful. The inefficiency of this process leads to a bigger time-to-market and a cost increase as well as potentially impacting the final quality of the products. This paper presents ARBoard, an innovative smart glasses-ready Augmented Reality (AR) application to bring manual PCB operations to the Industry 5.0 era. In AR, the user visualizes useful information about the board under test such as datasheet, schematic and markers projected on the physical board. The markers are placed by the user that directly points at the schematics and chooses the components that they want to locate on the board. This feature eliminates the need for cross-referencing between multiple documents and the successive localization of the components on the physical board. The functionalities of the app are expanded by a local and private AI assistant. Users can ask questions about the board, and the AI assistant will answer taking information from the board's datasheet. The AI assistant also automatically highlights the relevant component as it answers to the user.},
  keywords={Productivity;Prototypes;Switches;Manuals;Cognitive load;Artificial intelligence;Fifth Industrial Revolution;Augmented reality;Assembly;Smart glasses;Augmented Reality;AI assistant;PCB debug;PCB validation;PCB assembly;PCB troubleshooting;Smart Glasses},
  doi={10.1109/ISEMV67326.2025.00014},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11323250,
  author={Yin-Belta Mbara, Jules Martial and Jaafar, Fehmi and Tardif, Pierre Martin},
  booktitle={2025 IEEE Conference on Dependable, Autonomic and Secure Computing (DASC)}, 
  title={A Decentralized Architecture for Industrial Data Interoperability Using Blockchain and IPFS}, 
  year={2025},
  volume={},
  number={},
  pages={40-49},
  abstract={Industry 5.0 demands real-time, secure, and decentralized interoperability between heterogeneous industrial systems. Existing frameworks, primarily developed for healthcare, lack the scalability and performance required for collaborative industrial environments. This paper proposes a hybrid architecture integrating the Corda permissioned blockchain with IPFS to enable traceable, content-addressed, and policy-based data exchange among autonomous actors. The system includes a modular integration layer supporting protocols like OPC UA, MQTT, and REST, and leverages specialized CorDapps for registry, access control, and auditability. Evaluated under realistic scenarios with 50,000 transactions and 2.7 GB of data, our framework outperforms centralized ESB systems, achieving a 40% reduction in data retrieval time, 99.8% availability under 30% node failure, and 37,543.4 TPS with 18.2 ms average latency, validated via Corda RPC and IPFS API logs. These results confirm the framework’s suitability for secure, resilient, and scalable data interoperability in Industry 5.0.},
  keywords={Protocols;Scalability;Collaboration;Computer architecture;Medical services;Data retrieval;Real-time systems;Blockchains;Fifth Industrial Revolution;Interoperability;Blockchain Corda;IPFS;Industrial Data;Decentralization;Interoperability;Distributed Storage;Industry 5.0},
  doi={10.1109/DASC68382.2025.00013},
  ISSN={2837-0740},
  month={Oct},}@INPROCEEDINGS{11279102,
  author={Korodi, Adrian and Vesa, Vlad-Cristian and Dontu, Raul-Andrei},
  booktitle={2025 IEEE 23rd International Conference on Industrial Informatics (INDIN)}, 
  title={Human Centered Industry 5.0 Data Representation in the context of Technology Driven Digital Transformation Interfacing}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Targeting efficiency increase means to approach digital transformation and to apply Industrial Internet of Things (IIoT) and Industry 4.0 concepts. The backbone of digital transformation is interfacing and connectivity. The ongoing battle with legacy protocols and solutions in the operational technology (OT) level is expanding with the necessity to cope and work with information technology (IT) level legacy systems that are presenting a completely different perspective. Industry 5.0 comes to consolidate previous advances with a societal vision, having a human centric apprehension as one of the main pillars. The current work is focusing on establishing a foundation for a single-source-of-truth human-oriented data representation in a context of a virtual unified space for digital transformation. The chosen transport protocol is Message Queue Telemetry Transport (MQTT) and data is transmitted in a structured and contextualized form using JSON and Sparkplug B. The physical objects from industrial processes contain graphic descriptors and defined templates that increase human perception, creative initiative and guiding capabilities, making him able to be in the center of decision making. The other two pillars of Industry 5.0, sustainability and resilience are also positively influenced by the improved representation and perception on all levels, including possibilities of decentralized decision making and AI guiding. The applicability of the solution can be both on the IT and OT levels, including the cloud, either in process control independent applications. The solution is tested successfully using Ignition environment set to function in the MQTT and Sparkplug configuration and an external software application that can be placed on any hierarchical level and set to interface using MQTT. The presented case-study considers an OT-IT integration with a SCADA node and an external Node-RED application that interfaces and integrates a complete user-defined data type template.},
  keywords={Transport protocols;Decision making;Data visualization;Ignition;Software;Telemetry;Fifth Industrial Revolution;Sustainable development;Industrial Internet of Things;Resilience;digital transformation;Industry 5.0;industrial protocols;interoperability;OT-IT connection;unified virtual space;MQTT;Sparkplug B;Node-RED;Ignition SCADA},
  doi={10.1109/INDIN64977.2025.11279102},
  ISSN={2378-363X},
  month={July},}@INPROCEEDINGS{11279428,
  author={Tang, Hao and Jiang, Guoqian and He, Qun and Xie, Ping},
  booktitle={2025 IEEE 23rd International Conference on Industrial Informatics (INDIN)}, 
  title={Causal Factorization Graph Network for Interpretable and Scalable Fault Diagnosis of Multiple Wind Turbines}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent advances in data-driven methods have significantly improved wind turbine (WT) fault diagnosis using SCADA data. However, existing methods predominantly suffer from two critical limitations: correlation-based models lack causal interpretability, and isolated turbine modeling hinders industrial scalability. We propose a Causal Factorization Graph Network (CFGN) that jointly models multiple turbines through adaptive causal graph learning. CFGN dynamically infers sensor causality via attention-guided edge pruning (e.g., blade angle→generator power), disentangles fault-related causal features from turbine-specific biases via dual GNN branches, and enforces domain-invariant fault detection through a hybrid loss function. Evaluated on four operational turbines, CFGN achieves 96.46% accuracy with 18% fewer false alarms, while maintaining 95.27% average F1 score across heterogeneous units. This framework bridges the gap between black-box AI and industrial needs for interpretable, cross-turbine diagnostics, offering a scalable solution for sustainable wind farm operations.},
  keywords={Fault diagnosis;Adaptation models;Technological innovation;Adaptive systems;Accuracy;Scalability;Wind farms;Wind turbines;Artificial intelligence;Fifth Industrial Revolution;Causal Factorization Graph Network;Industry 5.0;Wind Turbine;Fault Diagnosis;Interpretable AI},
  doi={10.1109/INDIN64977.2025.11279428},
  ISSN={2378-363X},
  month={July},}@INPROCEEDINGS{11315642,
  author={Hariharasudhan, S. and Rajeshwari, S. and Priyadharshini, S. V. and K, Vishnu Priya and Santhoshkumar, S. P. and S, Gajalakshmi},
  booktitle={2025 6th International Conference on IoT Based Control Networks and Intelligent Systems (ICICNIS)}, 
  title={Beyond Signature-based Defense: Deep Learning Frameworks for Concealed Cyber Exploit Detection}, 
  year={2025},
  volume={},
  number={},
  pages={868-874},
  abstract={The emergence of intelligent manufacturing due to Industry 4.0 and 5.0 frameworks increased the exposure to dependence on deep learning systems, which are ideal targets of advanced cyber-attacks. Traditional cybersecurity techniques are becoming insufficient to deal with the emerging trends, including covert attacks like backdoor attacks that interfere with the model integrity during the training of the model and interfere with outputs. A new, multi-layered smart cyber defence framework demanding a combination of threat modelling, data protection, and model protection has been presented in this paper to protect deep learning concept. The framework model is a permutation of both statistical and intelligent methods to avoid data privacy and confidentiality and extends structural measures of security management in terms of policies and procedures. It also presents ways of improving the sturdiness of models alongside attacks with the help of an adaptive threat model to identify the vulnerable points and implement countermeasures efficiently. An overview of back door attacks and defence mechanisms to back door attacks is given and a qualitative comparison of strategies in existence has been made. Last but not least, the paper identifies the future research directions to enhance exploit detection in deep learning by providing detailed suggestions on how the research can be taken further to promote research in resilient cyber defence towards the smart manufacturing systems.},
  keywords={Deep learning;Threat modeling;Training;Adaptation models;Data protection;Data models;Fourth Industrial Revolution;Telemetry;Resilience;Smart manufacturing;Cybersecurity Framework;Backdoor Attacks;Threat Modeling;Smart Cyber Defence;Exploit Detection;Resilient Systems},
  doi={10.1109/ICICNIS66685.2025.11315642},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11313358,
  author={El Idrissi, Ayoub and Haidine, Abdelfatteh and Hanine, Mohamed},
  booktitle={2025 12th International Conference on Wireless Networks and Mobile Communications (WINCOM)}, 
  title={A Bibliometric Analysis of Machine Learning in Maritime Industry as Part of Industry 4.0/5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Machine learning technologies are increasingly integrated into maritime operations, transforming management practices. They optimize fleet management, enhance safety, and improve efficiency, particularly within Industry 4.0/5.0. This study analyzes publication and citation patterns of deep learning in maritime operations from 2015 to 2024, focusing on leading authors, countries, active journals, and years with the highest output. Data were extracted from the Web of Science (WoS) through a detailed search and analyzed with VOSviewer, resulting in 822 documents. The year 2024 recorded the highest number of studies $(n=188)$, with China as the top contributor and Elsevier as the leading publisher. This work provides the first complete bibliometric evaluation combining productivity and citation metrics to map machine learning research in the maritime industry.},
  keywords={Industries;Productivity;Measurement;Deep learning;Wireless networks;Bibliometrics;Focusing;Mobile communication;Safety;Fourth Industrial Revolution;Maritime industry;bibliometric analysis;Industry 4.0 / 5.0;machine learning;WoS database},
  doi={10.1109/WINCOM65874.2025.11313358},
  ISSN={2769-9994},
  month={Nov},}@INPROCEEDINGS{11307487,
  author={Joshi, Archana and Pandey, Dhruv and Bisht, Deepa and Kumar, Rakesh and Bhandari, Kalpana},
  booktitle={2025 2nd International Conference on Electronic Circuits and Signaling Technologies (ICECST)}, 
  title={A Sequential Roadmap of Industry 5.0: Exploring Challenges and Opportunities}, 
  year={2025},
  volume={},
  number={},
  pages={77-81},
  abstract={Technology is changing significantly over the period of time. This research provides the roadmap of industry 5.0 for business perspective. Industry 1.0, 2.0, 3.0, and 4.0 have significantly impacted the manufacturing industry. Industry 1.0 focused on mechanical infrastructures, In contrast, Industry 2.0 brought assembly lines and electricity. The goal of Industry 4.0 was to use new technology to increase mass production and productivity. Industry 5.0 combines human expertise with efficient machines, promoting mass personalization and increasing manufacturing efficiency. This paper offers greener solutions and real-time data collaboration. Industry 5.0 focus on to optimize manufacturing through human know-how and efficient machines, incorporating technologies like Cobots, Internet of everything cloud manufacturing, supply chain management, edge computing, digital twins, IoT, blockchain, and 6G networks. This paper discusses research challenges and opportunities for achieving Industry 5.0. This also examines the impact of digital technologies, including artificial intelligence, on society, commercial operations, educational systems, and public administration. The research provide insightful for professional and scholars.},
  keywords={Productivity;Cloud computing;Collaborative robots;Blockchains;Digital twins;Internet of Things;Fifth Industrial Revolution;Artificial intelligence;Edge computing;Business;Cloud computing;Internet of Thing;Edge computing;Digital Twins;Blockchain;Artificial Intelligence},
  doi={10.1109/ICECST66106.2025.11307487},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11315391,
  author={Kok, Chiang Liang and Heng, Jovan Bowen and Lizheng, Nicholas Tan and Tang, Howard and Teo, Tee Hui},
  booktitle={2025 IEEE International Conference on Recent Advances in Systems Science and Engineering (RASSE)}, 
  title={Autonomous Systems in Industry 5.0 Revolutionizing Efficiency, Collaboration and Sustainability}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Autonomous systems are becoming the cornerstone of Industry 5.0, enabling industries to merge the precision and scalability of automation with human-centric and sustainable practices. These systems integrate advanced artificial intelligence (AI), machine learning (ML), robotics, and the Internet of Things (IoT) to optimize operations, enhance decision-making, and foster collaborative work environments. This paper delves into the transformative potential of autonomous systems in diverse sectors such as logistics, manufacturing, healthcare, and urban planning. It further addresses key challenges, including regulatory barriers, societal acceptance, and technical limitations, while proposing innovative solutions. Additionally, the interplay between semiautonomous systems and fully autonomous solutions is explored, offering insights into future applications and the ethical considerations required for responsible deployment. Relevant realworld case studies, emerging technologies, and available research references are included to provide a holistic understanding of the field.},
  keywords={Industries;Technological innovation;Ethics;Autonomous systems;Decision making;Urban planning;Collaboration;Medical services;Internet of Things;Fifth Industrial Revolution},
  doi={10.1109/RASSE64831.2025.11315391},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11315344,
  author={Parthiban, Prabakar},
  booktitle={2025 IEEE International Conference on Recent Advances in Systems Science and Engineering (RASSE)}, 
  title={Feasibility, Applicability, and Training of Generative Artificial Intelligence (Gen-AI) for Fixed RAIN (UHF) RFID Antenna Systems Integration}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The success of the Fourth Industrial Revolution, known as Industry 4.0, has driven the adoption of Generative Artificial Intelligence (Gen-AI) in industrial applications that are dangerous, monotonous, or physically demanding. This transition has led to the emergence of Industry 5.0, characterized by the integration of robots and smart machines. This paper examines the feasibility and applicability of Gen-AI in enhancing Automatic Identification and Data Capture (AIDC) technologies, particularly through the integration of Ultra High Frequency (UHF) Radio Frequency Identification (RFID), also known as RAIN RFID fixed antenna systems. We discuss the nuances, challenges, and difficulties associated with implementing fixed RFID systems while evaluating the Gen-AI model, Chat-GPT, to assess its accuracy and usability from an SI’s standpoint. Results are critically reviewed against peerreviewed journals, and where Gen-AI failed, training methods, areas for exploration, and learning are also suggested.Furthermore, antenna selection based on the RFID application, analyzing and utilizing the varied performance between far-field and near-field fixed RFID reader antennas, nuances related to enabling an efficient RFID reader front-end, and characterizing and optimizing the RFID tag performance in situ are also discussed. Potential for a Gen-AI trained smart middleware algorithm for real-time beamforming using passive antennas, beam scanning, field switching, and creating polarization diversity is also discussed with a view to opening doors towards seamless Industry 5.0 integration.},
  keywords={Training;Rain;Accuracy;Generative AI;System integration;UHF antennas;Fourth Industrial Revolution;Fifth Industrial Revolution;Usability;Radiofrequency identification;Antenna;AI;AIDC;Chat-GPT;Deep Seek;Gemini;Gen-AI;IoT;RAIN;RFID;RFID system;Sensors;Tags;and UHF RFID},
  doi={10.1109/RASSE64831.2025.11315344},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11315197,
  author={Parthiban, Prabakar},
  booktitle={2025 IEEE International Conference on Recent Advances in Systems Science and Engineering (RASSE)}, 
  title={Smart RFID Reader Antennas: A Review of Disconnects Between the Commercials and State-of-the-Art}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The integration of robots and smart machines characterizes the emergence of Industry $\mathbf{5. 0}$. Industry $\mathbf{4. 0}$ has been a huge success due to the adoption of Generative Artificial Intelligence (Gen-AI) in industrial applications that are monotonous, physically demanding, or dangerous. Smart antennas have expanded their footprint into the consumer market, particularly on the Internet of Things (IoT) and its Automatic Identification and Data Capture (AIDC) subsets. Smart antennas have evolved in almost all wireless communications industries where tracking, scanning, and beamforming are the new normal. The UHF RFID industry, however, is still living in the 2000 s with passive antennas enabling RFID read points. The RFID industry has attempted to design smart antennas, but their definition of ‘smartness’ and the antenna designs are not state-of-the-art. The academia, on the other hand, has been investing in and researching designs that are not commercially viable. This short paper reviews the smart antenna designs presented by commercial and academic researchers specific to Fixed Ultra High Frequency (UHF) Radio Frequency Identification (RFID) applications. It concludes by discussing the disconnects between the two and how RFID systems integrators could benefit if academic researchers attempt to bridge the gap.},
  keywords={Phased arrays;Industries;Wireless communication;Reviews;Service robots;Design methodology;UHF antennas;Internet of Things;Passive RFID tags;Radiofrequency identification;UHF;RFID;Phased Array;Smart Antennas;Hub;Reader Antenna;Integrated Reader Antenna;Beam Scan;Beam Sweep;Beam Steer},
  doi={10.1109/RASSE64831.2025.11315197},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11307684,
  author={Zhou, Yi},
  booktitle={2025 IEEE 8th International Conference on Information Systems and Computer Aided Education (ICISCAE)}, 
  title={Fundamentals of Analog Filter Design and Circuit Realization}, 
  year={2025},
  volume={},
  number={},
  pages={120-124},
  abstract={Analog filters are fundamental components in signal processing systems. They serve crucial roles in conditioning, processing and preparing signals for conversion into other forms of digital and analog representations. This work provides the comprehensive design, simulation and analysis of a 3rd-order high-pass Butterworth filter with Sallen-Key unity gain configuration in an analog circuitry format. Based on a given application scenario (passband of 200 Hz, stopband of 50 Hz and stopband attenuation of 30 dB), the third-order section was computed using a mathematical expression followed using appropriate component values that ensure that the resulting circuit provides a Butterworth response. The resulting filter circuit uses two cascade stages — one first-order section and one second-order section realized with two units each of OP07 operational amplifier. The complete design was verified via simulations in LTspice and it resulted in a cutoff frequency (${-}\text{3 ~ d B}$) of $\text{2 0 0. 0 4 ~ H z}$ and a very large stopband ripple of more than $\text{7 8 ~ d B}$ at $\text{5 0 ~ H z}$ (stopband attenuation). This was above the original simulated specification and further transient test analyses of the circuit within both passband and stopband were done. This kind of filter can be directly used for different applications in educational institutions where high performance specifications are required or they might have potential use for industry implementations for more sophisticated ones. It is believed that this study will present practical understanding on analog filters and offer a clear insight to learners and practitioners seeking precise analog transfer characteristics.},
  keywords={Operational amplifiers;Industries;Filters;Cutoff frequency;Attenuation;Solids;Passband;Transient analysis;Gain;Information systems;filter;simulation;Sallen-Key},
  doi={10.1109/ICISCAE66104.2025.11307684},
  ISSN={2770-663X},
  month={Sep.},}@INPROCEEDINGS{11307441,
  author={Gu, Feng and Chen, Hongqi},
  booktitle={2025 IEEE 8th International Conference on Information Systems and Computer Aided Education (ICISCAE)}, 
  title={Design of Accounting Resource Sharing Platform Based on Data Mining and Cloud Computing}, 
  year={2025},
  volume={},
  number={},
  pages={924-929},
  abstract={This paper designs an accounting resource sharing platform based on data mining and cloud computing, and proposes a hybrid data protection algorithm based on homomorphic encryption and differential privacy. The experiment builds a simulation environment containing 8 cloud servers and 1,500 simulated users, and uses a company's 5-year real accounting data (a total of $\mathbf{1 5 0, 0 0 0}$ records) as the experimental data set. The algorithm in this paper is compared with the traditional homomorphic encryption algorithm and differential privacy algorithm. The results show that in terms of privacy protection, the algorithm in this paper reduces the risk of data leakage by 68 %, which is 52 % higher than the traditional homomorphic encryption algorithm and $\mathbf{4 3 \%}$ higher than the differential privacy algorithm; in terms of data processing efficiency, the encryption and decryption time is reduced by 61 %, and the data mining analysis speed is increased by 48 %. The platform performance test shows that the average response time for resource retrieval is 0.7 seconds, the data throughput reaches $135 \text{MB} / \mathrm{s}$, and it can support large-scale concurrent access. The experimental results verify the effectiveness of the platform and algorithm in ensuring the security of accounting data and improving resource sharing efficiency, and provide an innovative solution for the digital development of the accounting industry.},
  keywords={Differential privacy;Cloud computing;Data protection;Data processing;Throughput;Resource management;Time factors;Homomorphic encryption;Protection;Business;Data mining;cloud computing;accounting resource sharing platform;hybrid data protection algorithm;homomorphic encryption;differential privacy},
  doi={10.1109/ICISCAE66104.2025.11307441},
  ISSN={2770-663X},
  month={Sep.},}@INPROCEEDINGS{11309159,
  author={Rojas-Sanchez, Camilo E. and Antonio Paredes, Juan and Ferrer-Cid, Pau and Barcelo-Ordinas, Jose M. and Garcia-Vidal, Jorge},
  booktitle={2025 International Conference on Modeling, Analysis and Simulation of Wireless and Mobile Systems (MSWiM)}, 
  title={IoT-Based Digital Twin Model for Industrial Applications}, 
  year={2025},
  volume={},
  number={},
  pages={771-774},
  abstract={A digital twin (DT) is a virtual representation of a physical object or system created using data obtained through numerical simulation or sensor measurements from Internet of Things (IoT) technologies, among others. These measurements allow the virtual model to be specific to a particular object or system, enabling diagnosis, predictive, and prescriptive maintenance. In this paper, we present the development of a DT for an IoT monitoring network with applications in Industry 5.0. To achieve this, we employ reduced-order models (ROM) based on the proper orthogonality decomposition (POD) technique to reconstruct a field of interest, e.g., temperature in a cold room or on a pig livestock farming, from a reduced set of optimally placed sensors. The results demonstrate that optimal placement can achieve low reconstruction errors even when only a few sensors are deployed - for example, three or four.},
  keywords={Temperature sensors;Temperature measurement;Wireless communication;Wireless sensor networks;Temperature distribution;Pipelines;Livestock;Reduced order systems;Digital twins;Internet of Things;Digital twin;Proper Orthogonal Decomposition;Internet of Things;Sensor Location},
  doi={10.1109/MSWiM67937.2025.11309159},
  ISSN={},
  month={Oct},}@ARTICLE{11316655,
  author={Feng, Lei and Cao, Yalin and Yang, Zhixiang and Li, Ying and Zhang, Qiyang and Zhou, Fanqin and Zhou, Lijie and Wei, Lei},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={Co-Design of Control, Energy, and Buffer with Delay Determinism for Consumer Electronics in Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={The deployment of wireless control systems in consumer electronics (CEs) is one of the critical components in Industry 5.0 to enable real-time monitoring and control with efficiency, flexibility, and reliability. This paper presents a novel model for the co-design of control, energy, and buffer management with delay determinism for CEs in Industry 5.0. To tackle the non-convex problem of minimizing long-term average joint cost, we propose an efficient resource allocation mechanism based on Lyapunov optimization theory and alternating optimization, utilizing control state information feedback. Specifically, the long-term problem is equivalently converted into an instantaneous optimization problem, which is then decomposed into two iteratively solvable subproblems, namely the buffer allocation problem and the bandwidth allocation problem. The subproblems are solved by branch and bound method and the interior point method, respectively. Simulation results demonstrate that the proposed mechanism outperforms four baseline mechanisms, achieving a balance between delay determinism, control stability, and efficient resource utilization.},
  keywords={Delays;Control systems;Wireless communication;Resource management;Optimization;Costs;Stability analysis;Fifth Industrial Revolution;Bandwidth;Consumer electronics;Industry 5.0;Consumer electronics;Wireless control system;Lyapunov optimization},
  doi={10.1109/TCE.2025.3649084},
  ISSN={1558-4127},
  month={},}@INPROCEEDINGS{11300674,
  author={Yan, Ru and Su, Li and Du, Haitao and Wang, Ke},
  booktitle={2025 8th World Symposium on Communication Engineering (WSCE)}, 
  title={Efficient Data Encryption Scheme Based CP-ABE for Digital Twin Network in 6G}, 
  year={2025},
  volume={},
  number={},
  pages={113-118},
  abstract={The digital twin comprehensively utilizes technologies such as perception, computing, modeling, simulation, and communication to achieve real-time interaction between physical entities and virtual replicas, and is becoming an enabling technology for building next-generation mobile communication networks. In the 6G network, digital twin will be widely applied in fields such as automation, industry 5.0, utility management, healthcare, leading the entire society towards a “digital twin” world that combines virtual and reality. The 6G network will provide massive device connection services, and massive data will be collected and used in digital twin networks. It is necessary to design more efficient methods for secure interaction between physical entities and virtual replicas. In the paper, data encryption scheme based on attribute-based encryption in digital twin network was studied, which improves the efficiency of data collection and usage by reducing the number of data encryption and decryption, and provides fine-grained data access control capabilities. Finally, the performance of the proposed scheme was evaluated through experiments. As the data transmission volume increases, the efficiency improvement of the proposed scheme becomes more significant.},
  keywords={6G mobile communication;Performance evaluation;Medical services;Network security;Real-time systems;Digital twins;Encryption;Data communication;Protection;Next generation networking;Digital twin;6G;Security;Attribute encryption},
  doi={10.1109/WSCE68305.2025.11300674},
  ISSN={2835-3404},
  month={Nov},}@INPROCEEDINGS{11311726,
  author={Berke, Szilárd},
  booktitle={2025 IEEE 25th International Symposium on Computational Intelligence and Informatics (CINTI)}, 
  title={AI in the workplace from the perspective of Generations X, Y, and Z - a literature review}, 
  year={2025},
  volume={},
  number={},
  pages={497-502},
  abstract={The Industry 5.0 revolution and the rapid spread of generative artificial intelligence (AI) in the labor market present unprecedented organizational-, managerial-, and employee challenges. This study provides an integrative literature review of AI applications in workplace practices and employee attitudes, with particular focus on generational differences among Generation $X, Y$ and Z. For the time being, academic researchers have barely analyzed generational differences at work, in relation to AI, and when they have, the target group consists only of university students. Based on the results, it appears that research is still in its very early stages, and university students are currently the primary focus of academic research, presumably because they are easier to involve. There is already more generalist research, in which case the research sample population is general and does not analyze the extent to which the behavior of each generation is similar or different in relation to the factors examined. However, it is clear that Generation Z receives special attention, even though Generations Y and X are likely to face more challenges in terms of technological change and AI acceptance, as they have different psychometric and habitus characteristics than the members of Generation Z, who are “overpowered” and proficient in new technologies. Even though successful AI transformation from a managerial perspective is not only a technological but a human-strategic issue: mobilizing synergies between generations and creating an inclusive organizational culture is essential for ensuring long-term competitive advantage and better employee well-being. In sum, there is a significant market gap that has yet to be filled, so further research on this topic is warranted.},
  keywords={Generative AI;Employment;Millennials;Artificial intelligence;Informatics;Fifth Industrial Revolution;Faces;Computational intelligence;Systematic literature review;artificial intelligence;AI transformation;generations;workplace;organizational studies},
  doi={10.1109/CINTI67731.2025.11311726},
  ISSN={2471-9269},
  month={Nov},}@INPROCEEDINGS{11311792,
  author={Sansone, Francesco and Sanmartin, Chiara and Taglieri, Isabella and Tonacci, Alessandro and Venturi, Francesca},
  booktitle={2025 IEEE 25th International Symposium on Computational Intelligence and Informatics (CINTI)}, 
  title={Consumer Wearables in the Digital Health Ecosystem: Reliability and Bias in Biometric Measurements During Sensory Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={000109-000114},
  abstract={The proliferation of consumer-grade wearable devices has revolutionized personal health monitoring,enabling real-time tracking of biometric signals including heart rate,physical activity,and stress,with a minimum obtrusiveness for the end-users.However,despite their widespread adoption,questions remain regarding the reliability and agreement of measurements across different devices.In this study,we conduct a quantitative validation of biometric data collected simultaneously from two commercially available wearable devices,the first one being a wearable ECG sensor attached to a chest strap,previously validated against gold standard holter,and the second one represented by a smartband,focusing on their consistency and measurement bias.Using a dataset acquired during a structured session of sensory analysis,comprising paired measurements from both devices on the same population and at the same time points,we apply multiple agreement metrics including Pearson’s correlation coefficient,Lin’s concordance correlation coefficient (CCC),Bland-Altman analysis,and Deming regression.Results show good agreement between the two methods $(C C C=0.79)$,nevertheless with constant bias and a slight heart rate overestimation by the smartband.This work provides practical insights into the use of consumer wearables for clinical and research purposes,highlighting the importance of rigorous data validation in the digital health ecosystem.},
  keywords={Biometrics;Heart rate;Ecosystems;Time measurement;Real-time systems;Electronic healthcare;Reliability;Wearable devices;Biomedical monitoring;Stress measurement;affective computing;Industry 5.0;IoT;sensory analysis;smart wearables;well-being},
  doi={10.1109/CINTI67731.2025.11311792},
  ISSN={2471-9269},
  month={Nov},}@INPROCEEDINGS{11311828,
  author={Sansone, Francesco and Sanmartin, Chiara and Venturi, Francesca and Tonacci, Alessandro},
  booktitle={2025 IEEE 25th International Symposium on Computational Intelligence and Informatics (CINTI)}, 
  title={An Internet-of-Things platform for environmental monitoring of the workplace in winemaking industry: proof-of-concept for the Industry 5.0 framework}, 
  year={2025},
  volume={},
  number={},
  pages={407-412},
  abstract={In the wine industry, one of the main challenges is represented by environmental sustainability, not only limited to the preservation of the surrounding environment but also relying on good practices to make the working environment safe and sustainable for the employees. In such a framework, Industry 5.0 comes into help, leveraging Information and Communication Technology to enable the design and development of safe, secure workplaces, minimizing risks for the employees for both accidents and fatalities, and long-term consequences of exposure to pollutants. The present work encompasses this topic, by proposing an IoT-based solution, relying on a commercial device, Airthings View 2960, to continuously monitor the pollutants present at the cellar level within the winemaking industry. The paper revolves around a proposal for Internet-of-Things-based architecture, allowing a seamless data exchange between the device and a control center remotely placed, with a description of the use case scenario and potential room for future improvements and refinements.},
  keywords={Industries;Smart agriculture;Wine industry;Pollution;Employment;Green products;Information and communication technology;Proposals;Fifth Industrial Revolution;Informatics;environmental pollution;Industry 5.0;IoT;smart farming;well-being;winemaking},
  doi={10.1109/CINTI67731.2025.11311828},
  ISSN={2471-9269},
  month={Nov},}@INPROCEEDINGS{11304038,
  author={Demirova, Siyka and Ahmedova, Sibel and Ivanov, Mihail and Mihaylova, Zhulieta and Ali, Dzemal and Yankov, Yordan and Pavlova, Miglena and Atanasova, Desislava and Miteva, Viktoriya},
  booktitle={2025 33rd National Conference with International Participation (TELECOM)}, 
  title={Evaluation of the Strategic Role of Telecommunications in Human Resource Management within Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The report examines the strategic role of telecommunications technologies in human resources (HR) management in the context of Industry 5.0. The transformation from Industry 4.0 to 5.0 is characterised by a shift from automation and efficiency to a human-centric approach, sustainability and personalised solutions. In this process, the telecommunications sector provides the infrastructure for the integration of artificial intelligence, remote work, talent management and digital learning platforms. The report presents an analytical model for assessing the impact of telecommunications on human resource practices, based on quantitative and qualitative methods.},
  keywords={Training;Leadership;Companies;Production;Strategic planning;Remote working;Telecommunications;Fourth Industrial Revolution;Fifth Industrial Revolution;Sustainable development;Industry 5.0;human capital;telecommunications;digital human resource},
  doi={10.1109/TELECOM66943.2025.11304038},
  ISSN={2837-5246},
  month={Nov},}@INPROCEEDINGS{11304050,
  author={Daskalov, Stoyan and Asenov, Stanislav},
  booktitle={2025 33rd National Conference with International Participation (TELECOM)}, 
  title={Data-Driven Process Drift Detection in ICT Testing Using EWMA and CUSUM Methods}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper presents a lightweight data-driven framework for process drift detection in In-Circuit Testing (ICT) of electronic assemblies using Exponentially Weighted Moving Average (EWMA) and Cumulative Sum (CUSUM) control methods. The proposed solution is implemented in a fully open-source environment combining Bash scripting, Telegraf, InfluxDB 2.0, and Grafana. The architecture enables real-time anomaly detection and historical analysis of component-level measurements collected from ICT equipment. Experimental results show that the proposed approach effectively identifies gradual performance deviations before the process exceeds tolerance limits, providing a foundation for predictive maintenance and continuous process improvement in Industry 5.0 environments.},
  keywords={Process control;Quality control;Real-time systems;Telecommunications;Fifth Industrial Revolution;Monitoring;Assembly;Anomaly detection;Testing;Predictive maintenance;EWMA;CUSUM;ICT Testing;Predictive Maintenance;InfluxDB;Grafana;Industry 5.0},
  doi={10.1109/TELECOM66943.2025.11304050},
  ISSN={2837-5246},
  month={Nov},}@INPROCEEDINGS{11300109,
  author={Naydenova, Nina},
  booktitle={2025 6th International Conference on Communications, Information, Electronic and Energy Systems (CIEES)}, 
  title={A Conceptual Model for the Evolution from Automation to Lights-Out Production}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The paper aims to present a conceptual model for the evolution from automation to lights-out manufacturing, by combining engineering principles with organizational-behavioral approaches. It is based on the integration of existing theoretical frameworks, models and empirical data from industrial cases published in peer-reviewed journals and industrial reports. The basic idea is that automation is not a static process. The model describes five sequential and interconnected stages (mechanization, automation, digitalization, intelligent automation and lights-out manufacturing) that are rather spiral-like, as each subsequent phase builds on and refines the previous one through feedback loops. In this sense provides a basis for the analysis of real industrial practices that reflect different stages of this transition. The author aims to compare the model with empirical cases and discuss the critical factors for a successful transformation to autonomous production, and examines the practical experience of FANUC, Siemens Electronics Works and Tesla Gigafactory. The comparison of the developed model with the real industrial cases demonstrates a high degree of correspondence in terms of the phases, also the technological, organizational and human axes and the spiral evolution. However, a systematic discrepancy is observed in the social and ethical integration aspects. Most practices emphasize efficiency at the expense of the human-centric approach which requires additional research in the context of Industry 5.0. The application of the model to real cases confirms its validity and analytical value, while highlighting the areas in which the human factor remains crucial - creativity, interpretation and ethics.},
  keywords={Ethics;Technological innovation;Collaboration;Production;Human factors;Turning;Manufacturing;Fifth Industrial Revolution;Artificial intelligence;Creativity;lights-out manufacturing;autonomy (industrial autonomy);cyber-physical systems (CPS);human-machine interaction (HMI);hybrid intelligence;innovations},
  doi={10.1109/CIEES66347.2025.11300109},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11304376,
  author={Cepeda, Rebeca Mejía and Loza-Matovelle, David and R, Jimmy Zambrano},
  booktitle={2025 IEEE Ninth Ecuador Technical Chapters Meeting (ETCM)}, 
  title={Redesigning Mechatronics Education: A First Exploration with 4C/ID}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The transformation of engineering education driven by Industry 4.0 and the emerging Industry 5.0 requires instructional models that integrate interdisciplinarity, technological innovation, and authentic problem-solving. Mechatronics, as a transversal field, faces challenges in preparing professionals to design, analyze, and integrate complex systems in dynamic industrial contexts. This paper proposes the Four-Component Instructional Design model ($\mathbf{4 C}$ /ID), complemented by Cognitive Task Analysis, as a framework for redesigning mechatronics curricula. Existing approaches often emphasize fragmented knowledge or narrow technical training, whereas the proposed framework structures whole-task learning sequences that integrate mechanical, electronic, computational, and control-system knowledge. This fosters cognitive integration, transfer of expertise, and readiness for professional practice. Empirical evidence across STEM disciplines demonstrates the effectiveness and efficiency of this model. An instructional blueprint is presented to align mechatronics education with industry demands, while recognizing challenges of resource intensity and curricular adaptation. We argue that can enhance student performance, innovation capacity, and professional readiness for complex engineering environments.},
  keywords={Training;Industries;Technological innovation;Analytical models;Mechatronics;Computational modeling;Fourth Industrial Revolution;Problem-solving;Proposals;Task analysis;mechatronics engineering;instructional design;4C/ID model;cognitive task analysis;complex learning},
  doi={10.1109/ETCM67548.2025.11304376},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11299010,
  author={Mihaylova, Zhulieta and Dimitrakieva, Svetlana and Marinova-Stoyanova, Marina},
  booktitle={2025 17th Electrical Engineering Faculty Conference - Energetics and Efficiency (BulEF)}, 
  title={Transformation of the Bulgarian Electricity Sector in The Context of Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The use of artificial intelligence capabilities and close, sustainable cooperation between humans and machines are at the heart of the industrial transformation that is coming on a global scale and the main focus of Industry 5.0. The electricity sector in Bulgaria faces significant challenges related to the increasingly widespread use of renewable energy sources. It is predicted that the share of electricity production from renewable sources as a percentage of gross domestic consumption in 2050 will be 32%. The aim of the report is to systematize the opportunities and challenges that Industry 5.0 presents in the process of transforming energy companies in Bulgaria.},
  keywords={Electrical engineering;Renewable energy sources;Technological innovation;Electricity;Companies;Production;Fifth Industrial Revolution;Sustainable development;Artificial intelligence;Faces;energy sector;industry 5.0;transformation;human resources;technological development;artificial intelligence},
  doi={10.1109/BulEF66320.2025.11299010},
  ISSN={2831-5782},
  month={Sep.},}@INPROCEEDINGS{11302594,
  author={Rahman, Md Mashiur and Jin, Jiong and Palanisamy, Suresh and Winckel, Steve van and Jayaraman, Prem Prakash and Sardar, Asif Ahmed},
  booktitle={2025 IEEE 35th International Telecommunication Networks and Applications Conference (ITNAC)}, 
  title={Context-Aware Network Resource Allocation for Industry 5.0 Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Digital twins (DTs) have emerged as indispensable assets for monitoring and control within industrial environments, particularly in the context of human-centric smart manufacturing. The effectiveness of DTs relies on how accurately the virtual model reflects its physical counterpart, a challenge exacerbated by constrained network resources, unpredictable communication channels, and rapidly changing factory conditions. In this study, synchronisation fidelity is established as the primary objective for resource scheduling in an on-premises private 5 G network. Our approach applies a context-aware resource blocks (RBs) allocation mechanism that connects the communication demands of Industry 5.0 applications and real-time operational variability to the network behaviour. This work-in-progress paper presents a system architecture that employs dynamic prioritisation for resource allocation and lightweight extrapolation strategies to address data blind spots, thereby preserving digital twin fidelity as shop floor conditions evolve.},
  keywords={Job shop scheduling;Systems architecture;Real-time systems;Production facilities;Digital twins;Resource management;Synchronization;Fifth Industrial Revolution;Monitoring;Smart manufacturing;Industry 5.0;digital twins (DTs);application network profile;private 5G;network resource allocation;synchronisation},
  doi={10.1109/ITNAC66378.2025.11302594},
  ISSN={2474-154X},
  month={Nov},}@ARTICLE{11308079,
  author={Zheng, Dingyi and Fu, Xiuwen and Pace, Pasquale and Aloi, Gianluca and Fortino, Giancarlo},
  journal={IEEE Internet of Things Journal}, 
  title={Task-Oriented Network Reliability for Federated Learning-Enabled Industrial Internet of Things}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={With the rapid development of Industry 5.0, the Industrial Internet of Things (IIoT) plays an increasingly important role as a key information infrastructure supporting data collection, transmission, and decision-making. Federated Learning-enabled IIoT (FL-enabled IIoT) systems deploy artificial intelligence (AI) models at the network edge and utilize model aggregation mechanisms to facilitate efficient data processing and intelligent decision-making. However, anomalies occurring in local nodes can propagate through the aggregation process, leading to model contamination and performance degradation, thereby compromising overall system reliability. To address this issue, this paper proposes a reliability model for FL-enabled IIoT systems. In this model, we systematically describe the entire process of model performance degradation caused by node failures and its impact on system task reliability. This includes the effects of multiple functional failures induced by node faults (i.e., data loss, communication interruption, and computational resource degradation) on model performance, as well as the failure propagation process caused by model contamination and data quality deterioration. Additionally, to evaluate the impact of model performance variations on practical production tasks, a task-oriented reliability metric is proposed. Simulation and experimental results demonstrate that the proposed modeling approach effectively characterizes the model performance degradation process and task reliability under node failure conditions.},
  keywords={Reliability;Industrial Internet of Things;Computational modeling;Data models;Production;Degradation;Artificial intelligence;Collaboration;Sensors;Measurement;Federated Learning;Industrial Internet of Things;Reliability Modeling;Artificial Intelligence},
  doi={10.1109/JIOT.2025.3646666},
  ISSN={2327-4662},
  month={},}@INPROCEEDINGS{11297570,
  author={Colombi, Lorenzo and Tortonesi, Mauro},
  booktitle={2025 21st International Conference on Network and Service Management (CNSM)}, 
  title={Management of Safety-Critical AI Services in the Compute Continuum}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The increasing complexity and criticality of AIdriven services across the compute continuum, spanning from edge devices to cloud datacenters, necessitates resilient, intelligent, and explainable management strategies. This work addresses the challenges of deploying and orchestrating safetycritical AI services in dynamic and resource-constrained environments, such as Industry 5.0 and Human Assistance and Disaster Recovery (HADR). We present a suite of complementary solutions, including a cloud-native MLOps platform tailored for SMEs, a semi-supervised federated learning framework (FedEdge-Learn), and novel semantic communication mechanisms that optimize data transmission using LLM-driven embeddings. Furthermore, we introduce an intent-based Zerotouch Service Management (ZSM) architecture, leveraging neurosymbolic AI and collaborative intelligence to automate orchestration, model fine-tuning, and policy reasoning across federated Kubernetes clusters. These efforts pave the way for trustworthy, adaptive, and efficient AI service lifecycle management in environments characterized by disconnections, privacy constraints, and operational unpredictability. Future work focuses on extending the neuro-symbolic approach to support additional tasks, including dynamic node selection, optimized placement across the compute continuum with the goal of improving resilience and interpretability in distributed, resource-constrained environments like Industry 5.0 and HADR, while addressing challenges such as intermittent connectivity and evolving operational conditions.},
  keywords={Privacy;Disasters;Computer architecture;Dynamic scheduling;Semantic communication;Complexity theory;Data communication;Artificial intelligence;Fifth Industrial Revolution;Resilience;Zero-touch Service Management;MLOps;Industry 5.0},
  doi={10.23919/CNSM67658.2025.11297570},
  ISSN={2165-963X},
  month={Oct},}@INPROCEEDINGS{11288251,
  author={Hung, Po-Cheng and Wu, Po-Hsun and Chen, Sheng-Kai and Chang, Shin-Hung},
  booktitle={2025 International Automatic Control Conference (CACS)}, 
  title={An Assistant Cargo-Handling Robot with Vision-Based Following and Gesture-Based Control}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents an assistant cargo-handing robot for human-robot collaboration in Industry 5.0 environments. The system implements a vision-based following strategy, using a YOLOv8 model to detect an operator's helmet and a depth camera to maintain a safe distance. Operators can control the robot intuitively through MediaPipe-based hand gestures and a Mecanum wheel provides omnidirectional mobility in confined spaces. For safety, ultrasonic sensors enable active obstacle avoidance, and a human-machine interface displays real-time system status and video image. Experimental results demonstrate that the prototype can operate reliably and show a multi-modal system, which effectively reduces worker loading in industrial applications.},
  keywords={Service robots;Human-machine systems;Wheels;Sensor systems;Safety;Sensors;Reliability;Mobile robots;Usability;Videos},
  doi={10.1109/CACS67552.2025.11288251},
  ISSN={2473-7259},
  month={Nov},}@INPROCEEDINGS{11294294,
  author={Kaushik, M and A, Pavan Kumar and PN, Jayanthi},
  booktitle={2025 9th International Conference on Computational System and Information Technology for Sustainable Solutions (CSITSS)}, 
  title={Effective Path Planning and 3D Machine Vision Solution for Inline Adhesive Dispense}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Machine vision technology plays a pivotal role in industrial automation, which is progressing towards establishing smart digital factories. Trivial methods of quality control in industry rely heavily on manual inspection, which causes human error and increases inspection time. The Industry 5.0 standard illuminates smart robotics and machines. Advanced camera technology guides robots to achieve inline vision-guided robotic applications. One of the major industry challenges is the adaptive glue guidance and dispensing mechanism, which seems to be a major concern across the semiconductor and automotive industries. To simulate the adaptive glue guidance and dispense application, hand-eye calibration, path planning and inline inspection are the key aspects to be achieved. Handeye calibration helps achieve a global coordinate system, which is useful for realising the acquired data in a single cartesian plane. Adhesive path planning is in accordance with the planned dispense region; however, to achieve micro precision the tool point positioning of the robot needs to be validated, for which a path correction methodology is proposed using a linear regression approach. Once the path is optimised, glue dispense is initiated and inspected to ascertain the required quality checks with respect to volumetric analysis.},
  keywords={Industries;Semiconductor device measurement;Service robots;Navigation;Robot kinematics;Machine vision;Inspection;Calibration;Fifth Industrial Revolution;Robots;Industry 5.0;hand-eye calibration;adhesive guidance and dispense and inline inspection},
  doi={10.1109/CSITSS67709.2025.11294294},
  ISSN={2767-1097},
  month={Nov},}@INPROCEEDINGS{11294961,
  author={Kariyappagowda, Yuvaraja Boovanahalli and G, Manjunatha and Mahjabeen and T, Sabin T and Pramod and K, Prabhavathi},
  booktitle={2025 International Conference on Sustainability, Innovation & Technology (ICSIT)}, 
  title={Edge AI-Driven Vision Systems for Zero-Defect Manufacturing in 6G-Enabled Industry 5.0: The Factory of the Future}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={In the era of Industry 5.0, achieving zero-defect manufacturing is essential for enhancing production quality, minimizing waste, and ensuring operational efficiency. Traditional quality control systems—whether manual or cloud-based—face challenges such as high latency, limited scalability, and data security risks. This paper presents a novel Edge AIdriven vision system that leverages 6G connectivity to enable real-time defect detection on the manufacturing floor. The proposed solution integrates lightweight deep learning models and high-speed edge inference to eliminate the need for centralized processing, thereby reducing response times and energy consumption. Experimental validation using NVIDIA Jetson AGX Xavier demonstrates significant performance gains, including 99.2% defect detection accuracy, a 70% reduction in latency, and 40% lower energy consumption compared to conventional cloud-based approaches. These results underscore the system's potential to facilitate predictive maintenance, seamless human-AI collaboration, and real-time defect elimination—core principles of Industry 5.0. Despite these advancements, challenges such as model optimization for edge hardware, secure federated learning, and widespread 6G infrastructure adoption remain open research problems. Future work will focus on integrating neuromorphic computing and blockchain-enhanced AI for improved adaptability, security, and scalability. This research lays a strong foundation for intelligent, autonomous, and defect-free manufacturing in nextgeneration smart factories.},
  keywords={6G mobile communication;Energy consumption;Federated learning;Neuromorphic engineering;Image edge detection;Machine vision;Real-time systems;Fifth Industrial Revolution;Defect detection;Predictive maintenance;Edge AI;embedded vision systems;zero-defect manufacturing;6G communication;real-time defect detection;machine learning;industrial automation;predictive maintenance;federated learning;neuromorphic computing;energy-efficient AI;Industry 5.0},
  doi={10.1109/ICSIT65336.2025.11294961},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11282663,
  author={Zhou, Yihui and Chen, Yanfei and Yue, Tong},
  booktitle={2025 4th International Conference on Artificial Intelligence and Computer Information Technology (AICIT)}, 
  title={Insulator Defect Detection Based on Improved YOLOv8n}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={To address the issues of high computational complexity, limited detection types, and low detection accuracy inherent in existing insulator defect detection methods within the power industry, in this paper, a novel model for insulator defect detection is proposed. Based on the YOLOv8 model as the foundational architecture, for the neck network, we employ the Scale Sequence Fusion YOLO (ASF-YOLO) structure for optimization, thereby augmenting the model's anti-interference capability and feature extraction capacity. We replace the conventional convolutions in the C2f module with the Dynamic convolution (DynamicConv) module to accelerate the model's detection speed. Additionally, a small object detection head is appended to the detection head section to further strengthen the model's ability to detect small targets. The experimental outcomes clearly illustrate that our enhanced algorithm attains outstanding performance, with mean Average Precision (mAP) scores of 84% and 62.8% for mAP@0.5 and mAP@0.5-0.95, respectively, across various types of insulator defects. Moreover, the parameter count of the model is reduced by 17.3%, showcasing its efficiency and effectiveness in insulator defect detection tasks.},
  keywords={YOLO;Computational modeling;Computer architecture;Inspection;Insulators;Feature extraction;Power industry;Neck;Optimization;Defect detection;Insulator defect detection;YOLOv8n;Deep learning;Dynamic convolution;Small target detection layer},
