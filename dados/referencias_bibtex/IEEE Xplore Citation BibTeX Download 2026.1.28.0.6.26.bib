  number={},
  pages={1-7},
  abstract={The increasing adoption of wearable EEG technology is enabling the development of passive Brain-Computer Interface (pBCI) systems for real-world applications, in the near future, such as Industry 5.0. However, one major challenge in classifying electroencephalographic (EEG) signals in these settings is covariate shift, which occurs when the distribution of the data changes between training and testing sessions due to variations in EEG headset positioning. This study investigates the effectiveness of a linear transformation approach to mitigate the negative effect of covariate shift. Simulations were conducted by using different shift conditions (i.e. deviation of the headset position from the original one), to evaluate (i) the performance of the transformation function used for mitigating the covariate shift occurrence and (ii) the importance that the change of reference and/or channels has on the classification performance. Results show that normalizing covariate shift-affected data (i.e., target) using shift-free data as a template (i.e., source) helps mitigate the negative impact of covariate shift, leading to improved classification performanceThe accuracy loss drops from 14% to 6% in the worst configuration and from 5% to 4% in the best configuration. This improvement is more pronounced when the shift is larger, i.e., when both the reference and channels change between the control dataset and the test dataset. These findings have significant implications for the development of robust and reliable pBCI models for out-of-the-lab contexts.},
  keywords={Headphones;Training;Prevention and mitigation;Machine learning;Brain modeling;Electroencephalography;Brain-computer interfaces;Stability analysis;Reliability;Testing},
  doi={10.1109/EMBC58623.2025.11252974},
  ISSN={2694-0604},
  month={July},}@INPROCEEDINGS{11259146,
  author={Cai, Hongjie and Xiang, Leda and Xu, Kang and Luo, Yuqin and Zhang, Yupeng and Song, Binbin and Zhou, Jinyao and Cheng, Xin and Liu, Chang},
  booktitle={2025 18th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics (CISP-BMEI)}, 
  title={Safety Helmet Wearing Detection Algorithm Based on YOLO11s-BEA}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In the construction industry, safety helmet wearing detection is one of the key measures to keep workers safe. However, current models confront several challenges, including the limited diversity of training datasets, complex site environments, and the small size of the helmet targets, all of which adversely affect both accuracy and speed. To address these issues, a comprehensive enhancement strategy has been proposed. To address the limitations of the existing dataset, based on the publicly available Safety Helmet Wearing Dataset (SHWD), this paper adds 1796 new helmet images in complex scenes; moreover, it collects 1022 helmet images of uncommon colours through web searching and data crawling. In total, it constructs the MY_SHWD dataset that contains $\mathbf{1 0, 3 9 9}$ images. Subsequently, the YOLO11s-BEA model was developed from YOLO11s. Specifically, it integrates the Efficient Channel Attention (ECA) mechanism to enhance the detection of small targets, a Bidirectional Feature Pyramid Network (BiFPN) for multiscale feature fusion, and the ADown module to reduce computational demands. Experimental results indicate that YOLO11s-BEA surpasses YOLO11s in terms of detection performance by increasing Precision(P) from 91.6 % to $\mathbf{9 3. 3 \%}$, Recall(R) from 90.2% to 92.0%, mAP@0.5 from 94.6% to $\mathbf{9 5. 9 \%}$, and $\text{mAP} {@} 0.5: 0.95$ from 63.9 % to 65.4 %. These improvements effectively enhance the detection performance of the model. The optimized model is capable of meeting detection requirements in various scenarios and significantly improving safety management on construction sites.},
  keywords={Training;Adaptation models;Head;Accuracy;Safety management;Signal processing;Feature extraction;Robustness;Safety;Web search;Safety Helmet Wearing Detection;YOLO11s;Attention Mechanism;Feature Fusion},
  doi={10.1109/CISP-BMEI68103.2025.11259146},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11260244,
  author={Palaiologou, Ilias and Falekas, Georgios and Karlis, Athanasios},
  booktitle={2025 IEEE Energy Conversion Conference Congress and Exposition (ECCE)}, 
  title={Leveraging Expert Knowledge with Explainable Artificial Intelligence for Electric Machine Fault Diagnosis in Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Non-invasive vibration and stray flux sensors gain traction in electric machine diagnostics thanks to extensive fault coverage and simple installation. Technological and signal processing advancements increase measurements' effectiveness and grant access to diverse, high-volume data. Artificial intelligence is extensively studied with excellent experimental results but unrealized industrial adoption. Transparency, interpretability, robustness, and generalization persist as main challenges. This study introduces a smart diagnostic framework for multi-fault detection in rotating machinery, integrating deep learning, uncertainty quantification, and explainable AI. A structured Human-in-the-Loop rule-based analysis is proposed to evaluate and systematically incorporate operator expertise across three critical stages: guided feature selection, fault-based exclusion, and real-time relabeling of uncertain predictions. This approach not only improves classification performance but also enables resource-aware training and trustworthy decision-making under uncertainty. The framework is evaluated on two datasets-a comprehensive, public, benchmark dataset focusing on fault type detection, and an experimental test bench to detect rotor winding imbalance severity. Results indicate that the HITL-enhanced models outperform baseline counterparts in accuracy and computational efficiency, particularly under conditions of data scarcity or evolving machine behavior. The framework demonstrates its practical value by aligning AI decisions with operational knowledge, offering a robust and interpretable framework for condition monitoring in Industry 5.0.},
  keywords={Vibrations;Training;Uncertainty;Systematics;Windings;Signal processing;Feature extraction;Human in the loop;Artificial intelligence;Fifth Industrial Revolution;Explainable Artificial Intelligence;Electric Machine Diagnostics;Industry 5.0;Uncertainty Quantification;Predictive Maintenance;Human-in-the-loop},
  doi={10.1109/ECCE58356.2025.11260244},
  ISSN={2329-3748},
  month={Oct},}@INPROCEEDINGS{11258340,
  author={Mulongo, Ndala Yves},
  booktitle={2025 3rd International Conference on Business Analytics for Technology and Security (ICBATS)}, 
  title={Investigating the Current State of Industry 5.0 Adoption in the South African Manufacturing Sector: A Dematel Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The pace of modern technological development and cultivation undoubtedly differs among different manufacturing industries. Technology is continually advancing, and manufacturing needs to change accordingly to remain relevant. Although Industry 4.0 remains the predominant transition for several industry executives, it is essential to anticipate future developments. Industry 4.0 (I4.0) is a transformative production revolution in the manufacturing industry that revolutionises production through the integration of new technologies, such as artificial intelligence, for automation and data integration. Nonetheless, research in I4.0 neglects human elements, which are essential for developing systems that improve well-being, trust, motivation, and performance. In response, multinational organisations have implemented Industry 5.0, seeking to harmonise technical progress with the welfare of people. Understanding present human-technology interaction is key for transitioning towards this vision. This research built a DEMATEL model to critically identify the key hurdles to the adoption and implementation of Industry 5.0 in the South African manufacturing sector. The study identified Nine hurdles, with lack of financial support is the most significant challenge to the industry 5.0 in the South African manufacturing sector.},
  keywords={Manufacturing industries;Profitability;Data integration;Production;Fourth Industrial Revolution;Stakeholders;Security;Fifth Industrial Revolution;Artificial intelligence;Business;Industry 5.0;Manufacturing Industry},
  doi={10.1109/ICBATS66542.2025.11258340},
  ISSN={},
  month={May},}@INPROCEEDINGS{11261139,
  author={Tasić, Milica and Ćirić, Ivan and Ćirić, Milica and Milić, Miljana and Predić, Bratislav},
  booktitle={2025 IEEE 34th International Conference on Microelectronics (MIEL)}, 
  title={Predictive Modeling of Irregular Time Series: Explainability and Edge Optimization Aligned with Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Due to the increasing prevalence of irregular sampling across various scientific disciplines, the analysis and forecasting of irregular time series has gained growing importance in contemporary research. Unlike regular time series, irregularly sampled data introduces specific challenges, including temporal misalignment, missing values, variable-length observations, and data sparsity. Recent literature presents a wide range of methodologies developed to address these challenges, with particular emphasis on the use of Explainable Artificial Intelligence (XAI). The aim of this paper is to identify and analyze XAI models that explicitly address irregularities in time series, including those capable of combining interpretability with the capacity to learn from sparse, temporally inconsistent, and nonlinear data. Furthermore, we discuss the importance of optimizing these models for deployment on edge devices in line with Industry 5.0 principles, emphasizing human-centric and transparent decision-making processes.},
  keywords={Explainable AI;Computational modeling;Time series analysis;Predictive models;Data models;Real-time systems;Fifth Industrial Revolution;Forecasting;Optimization;Edge computing;irregular time series;explainable artificial intelligence (XAI);forecasting;edge computing;industry 5.0;model interpretability},
  doi={10.1109/MIEL66332.2025.11261139},
  ISSN={2159-1679},
  month={Oct},}@INPROCEEDINGS{11257889,
  author={Celestino Lopes, William Aparecido and Ruggero, Sergio Miele and Vendrametto, Oduvaldo and Okano, Marcelo Tsuguio},
  booktitle={2025 International Conference on Electrical, Communication and Computer Engineering (ICECCE)}, 
  title={Augmented Reality in Industry 5.0: Customizing Production to Optimize Operational Processes and Technical Training of Operators}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This study presents the development and evaluation of ARTechGuide, an Augmented Reality (AR)-based application designed for technical training of operators in an automotive industrial environment. The research was conducted using the Design Science Research (DSR) methodology, with application and validation in a real factory setting. The system uses mobile devices and visual recognition to provide audiovisual instructions in five critical operational scenarios. Compared to traditional methods, a 57 % reduction in setup time, a 25 % increase in execution accuracy, and a 75 % decrease in requests for help were observed. The system achieved an average of 9.25 on the User Experience (UX) scale and 4.5 on nine technical indicators evaluated by experts. Unlike commercial AR platforms, the solution adopts a local architecture, independent of constant connectivity, facilitating its adoption in environments with operational constraints. These benefits are aligned with the Industry 5.0 proposal, which values customization according to human needs.},
  keywords={Visualization;Protocols;Standardization;User experience;Production facilities;Robustness;Safety;Fifth Industrial Revolution;Augmented reality;Qualifications;Industry 5.0;Augmented Reality;Personalized Manufacturing;Mobile Application;User Experience Design},
  doi={10.1109/ICECCE67514.2025.11257889},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11256538,
  author={Goyal, Abhishek and Gupta, Sandeep},
  booktitle={2025 IEEE Madhya Pradesh Section Conference (MPCON)}, 
  title={Accelerating Project Delivery Through Agile Scrum and 5G-Enhanced Scaled Agile Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The advent and widespread usage of agile methodologies in software development have facilitated the rapid iteration and release of ever-more-complex software applications. The development process must take into account the delivery of high-quality software, as software products are crucial components in the rescue of human lives. The first step in developing them is to identify a precise set of product requirements. Software development, integration of 5G technology, and Agile methodology have demonstrated great potential for high-speed change of both processes in the fast lane of digital. This study examines the transformative impact of integrating 5G technology into Agile Scrum principles and the Scaled Agile Framework (SAFe) to accelerate project delivery in large-scale industrial environments. The paper describes how team coordination, cooperation, and continuous integration are enhanced by 5G's real-time data processing, high bandwidth, and ultra-low latency. Using a mixed-methods approach grounded in the Technology-Organization-Environment (TOE) framework, case studies and simulations evaluate the effects of 5G on sprint cycles, delivery speed, and team productivity. Performance metrics such as response, resilience, and recovery reveal that data acquisition management leads with a 98% response rate, emphasising the role of advanced technologies in enhancing operational efficiency. The research proves how 5G technology enhances Agile project management which delivers Industry 5.0 benefits through increased scalability and resilience and better results.},
  keywords={Productivity;5G mobile communication;Scalability;Agile project management;Performance metrics;Data processing;Software;Real-time systems;Fifth Industrial Revolution;Resilience;Agile Scrum;5G Technology;Scaled Agile Framework (SAFe);Project Delivery Acceleration;Agile Project Management;5G-Enhanced Frameworks;Agile Transformation},
  doi={10.1109/MPCON66082.2025.11256538},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11256477,
  author={Vitalli, Rogério Adas Pereira and De Leles, Andréia Damasio and Cardoso, José Roberto},
  booktitle={2025 World Engineering Education Forum - Global Engineering Deans Council (WEEF-GEDC)}, 
  title={STEM Technologies in Society 5.0: Interdisciplinary Approaches to Improving Quality of Life}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents a future educational paradigm linked to a vision of engineering education characterized by a need for continuous evolution, as a consequence of a challenging search for a more sustainable and supportive future. In a way, this next evolution emanates from very relevant advances in engineering education achieved in recent decades and from a vision inspired by the sustainable development goals. In addition, it surpasses current emerging approaches and innovation trends, linked to supporting the expansion and application of Industry 4.0 technologies and principles. Engineering Education in Society 5.0 transcends the development and application of technology and enters the realm of ethics and humanism, as key aspects for a new generation of engineers. Ideally, engineers trained in this new educational paradigm and the insertion of Artificial Intelligence should be able to lead and guide the approach to technological singularity, defined as a future point in time when technological growth becomes uncontrollable and irreversible, leading to an unpredictable impact on human civilization, while guaranteeing human rights and focusing on building a more sustainable and egalitarian global society. We examined the details of the Japanese concept of Society 5.0 and its relationship with Artificial Intelligence (AI). The “superintelligent society” model presented by the Japanese aims to enable everyone to live a fulfilling and prosperous life. The result was a case study applicable in a Brazilian IES to map indicators and metrics related to Education in Engineering teaching. Furthermore, this case study model was validated with the use of AI and aims to create a more livable Brazilian society, minimizing negative effects such as unemployment. It is a very important approach in terms of meeting the needs of all engineering students in a timely manner. This study constitutes an interesting contribution to the understanding of how institutional factors directly impact the achievement of key competencies in graduates of engineering programs, aligned with global standards such as the Washington Agreement. Through a two-phase methodological approach-Delphi and structural equation modeling (SEM)-it is possible to identify and correlate variables such as institutional leadership, teaching development, curricular alignment, quality assurance and student support with competencies such as ethics, teamwork, use of engineering tools, communication and lifelong learning.},
  keywords={Knowledge engineering;Ethics;Technological innovation;Leadership;Quality assurance;Market research;Mathematical models;Teamwork;Engineering education;STEM;Society 5.0;STEM Technologies;Quality of Life},
  doi={10.1109/WEEF-GEDC66748.2025.11256477},
  ISSN={2837-5025},
  month={Sep.},}@INPROCEEDINGS{11256246,
  author={Segura, Pablo and Ramírez-Cedillo, Erick and Romero, David and Bradley, Russel and Rodriguez, Ciro A. and Anthony, Brian},
  booktitle={2025 World Engineering Education Forum - Global Engineering Deans Council (WEEF-GEDC)}, 
  title={Value Stream Mapping & Discrete Event Simulation in a Learning Factory: An Education 5.0 Approach to Teach Digital Lean Manufacturing Principles}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents an Education 5.0 strategy that integrates Value Stream Mapping and Discrete Event Simulation within a Learning Factory environment to enhance the teaching of Digital Lean Manufacturing principles. By analyzing the case of the FrED Factory, a dedicated learning factory to produce a custom low-cost extrusion system, students were able to simulate production processes, identify sources of waste, and evaluate system performance considering real-world issues. This approach fosters a holistic, digital, and data-driven mindset in engineering students, equipping them with the digital and analytical skills needed to manage modern manufacturing systems in alignment with Industry 5.0 objectives.},
  keywords={Technological innovation;System performance;Production facilities;Discrete event simulation;Fifth Industrial Revolution;Engineering students;Manufacturing systems;Higher Education;Learning Factory;Digital Skills;Discrete Event Simulation;Value Stream Mapping;Educational Innovation},
  doi={10.1109/WEEF-GEDC66748.2025.11256246},
  ISSN={2837-5025},
  month={Sep.},}@INPROCEEDINGS{11259194,
  author={Frías, Manuel Alejandro Páez and Manrique, Tatiana},
  booktitle={2025 IEEE 7th Colombian Conference on Automatic Control (CCAC)}, 
  title={Visual-Servoing Control Assessment for a 2DOF Flexible Joint Robot Based in LQR}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper assesses the integration of artificial vision into the real-time control loop of a two-degree-of-freedom flexible joint robot (FJR) from QUANSER®, emphasizing image processing and hardware-in-the-loop (HIL) control using an LQR strategy. The primary objective is to assess the viability and performance of a low-cost visual system when integrated into a robot's control loop. The assessment involves comparing the visual servoing system's performance against that of a traditional controller with encoders in the loop to validate precision and consistency. The camera employed represents only 11% of the encoders' cost, reinforcing its potential as a truly low-cost alter-native for avoiding technological obsolescence from the encoders. The evaluated visual-servoing system is tested experimentally using LQR for set-point tracking, parametric robustness, and disturbance rejection. The results indicate that while visual-servoing control enables real-time operation, it remains more susceptible to latency and disturbances than controllers with encoders in the loop. Nevertheless, the visual system demonstrates promising adaptability for industrial automation, particularly in dynamic production environments -a crucial characteristic of Industry 5.0.},
  keywords={Uncertainty;Service robots;System performance;Visual systems;Aging;Cameras;Real-time systems;Visual servoing;Hardware;Fifth Industrial Revolution;Visual-servoing;Flexible robotics;Hardware-in-the-loop;LQR;Flexible manufacturing},
  doi={10.1109/CCAC64704.2025.11259194},
  ISSN={2694-393X},
  month={Oct},}@INPROCEEDINGS{11262607,
  author={Lazarou, Lazaros and Pashiourtides, Costas and Marnerides, Angelos K.},
  booktitle={2025 IEEE 45th International Conference on Distributed Computing Systems Workshops (ICDCSW)}, 
  title={Detection of stealthy attack vectors in networked Industrial Control Systems using Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={75-80},
  abstract={Industrial Control Systems (ICS) having their physical processes dictated commonly by Programmable Logic Controllers (PLCs) underpin Critical Infrastructure Systems (CIS) that constitute the basis for a number of vital sectors of our society such as energy, utilities, manufacturing, defense and healthcare. ICS were traditionally isolated but in the last two decades are strongly defined by the convergence of Internet-enabled Information Technologies (IT) with Operational Technologies (OT) adhering to the vision of Industry 4.0 and more recently Industry 5.0. Evidently, this convergence triggers a new vulnerability spectrum that naturally exposes CIS to stealthy attack vectors as parts of Advanced Persistent Threats (APTs) acting as foundations for a variety of modern cybercrime or cyberwarfare operations. Hence, highlighting the weakness of existing defense mechanisms and the need to develop sophisticated detection systems to ensure higher security assurance. In this paper we propose a novel PLCcentric and Machine Learning (ML)-driven anomaly detection framework for detecting stealthy attack vectors in ICS. The introduced framework incorporates network packet payload analysis leveraging information-theoretic metrics to profile PLC communication behaviour and further employs a two-class Support Vector Machine (SVM) model to distinguish normal from abnormal network behaviour. Moreover, a one-class SVM (OCSVM) is utilised to address data imbalance and compared with the two-class SVM implementation. We evaluate our framework over simulated data replicating real-world Modbus/TCP communication of a PLC with a physical process, encompassing both normal operational behavior and stealthy attack vector scenarios adhering to industry cybersecurity practices. The conducted evaluation reveals that while the two-class SVM outperforms the OCSVM formulation in terms of overall accuracy, the OCSVM remains a viable option when labeled anomaly data are unavailable.},
  keywords={Support vector machines;Measurement;Accuracy;Programmable logic devices;Vectors;Reliability;Anomaly detection;Payloads;Information theory;Convergence;Cybersecurity;Industrial Control Systems;Anomaly Detection;Machine Learning;Programmable Logic Controllers},
  doi={10.1109/ICDCSW63273.2025.00019},
  ISSN={2332-5666},
  month={July},}@ARTICLE{11271248,
  author={Ishtiaq, Mariam and Won, Jongun},
  journal={IEEE Access}, 
  title={Glocal-HAD: Hybrid Attention Decoder for Reconstruction-Based Vision Anomaly Detection Framework}, 
  year={2025},
  volume={13},
  number={},
  pages={208681-208695},
  abstract={Industry 5.0 has garnered significant research interest to address ill-posed automation challenges, such as vision-based anomaly detection (VAD). This is largely because the heterogeneous nature of anomalies renders the development of multiclass and multiscale VAD challenging. Although models based on transformer architecture have delivered state-of-the-art (SOTA) performance, they struggle with broader context feature fusion and maintaining a balance between anomaly detection, localization and computation cost. To fill this research gap, we propose a reconstruction-based anomaly detection framework that utilizes a global and local attention driven hybrid attention decoder termed Glocal-HAD. The proposed pipeline uses: 1) DINOv2 encoder for feature extraction, 2) a regularized multilayer perceptron (MLP) for latent feature compression, and 3) Glocal-HAD. The proposed decoder applies linear attention (LA) with associative key-value (KV) aggregation for global context and masked self attention (SA) with a constant drop rate for efficient local context. Four variants of HAD with stacked and interleaved settings of SA and LA layers are evaluated using two benchmark datasets: MVTec-AD and VisA. Using extensive ablation experiments, we conclude that for VAD, global context must inform local refinement, since models with global attention first, perform better. The proposed pipeline with Glocal-HAD achieves 99.5% anomaly classification (I-AUROC) and 98.2% anomaly localization (P-AUROC) performance on MVTec-AD, and 98.5% each (I-AUROC and P-AUROC) on the more challenging VisA dataset. To evaluate the model’s balance between accuracy and efficiency, we propose a novel metric, performance evaluation score (PES). Additionally, we share interesting open research problems related to model parameterization and regularization.},
  keywords={Anomaly detection;Feature extraction;Image reconstruction;Decoding;Location awareness;Transformers;Computational modeling;Training;Costs;Computer architecture;Attention-guided localization;foundation model;hybrid attention;industrial anomaly detection;multiclass unified anomaly detection;multiscale feature fusion;reconstruction-based anomaly detection;unsupervised learning;vision anomaly detection},
  doi={10.1109/ACCESS.2025.3638411},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11253042,
  author={Phakdee, Nuttaporn and Pradubnak, Saisunee and Siraphatwongkorn, Aritath},
  booktitle={2025 IEEE/ACIS 29th International Conference on Software Engineering, Artificial Intelligence, Networking and Parallel/Distributed Computing (SNPD)}, 
  title={Exploratory Analysis of Software Engineering Skill in Thailand's Software Industry Using NLP Techniques}, 
  year={2025},
  volume={},
  number={},
  pages={418-423},
  abstract={The COVID-19 pandemic has contributed to digital transformation across industries, with the software sector in Thailand experiencing rapid growth. This research aims to identify the essential technical and soft skills required by the Thai software industry using natural language processing (NLP). The analysis shows that programming languages such as SQL, Java, and Python, as well as development tools such as Docker and Git, are essential for all roles. At the same time, soft skills such as communication, problem-solving, and analytical remain important. The findings highlight a significant skills gap that is depriving university graduates of meaningful career opportunities, emphasizing the need for an overhaul of higher education course content. This study gives empirical evidence to support curriculum redesign and workforce development policies so that future graduates are skillfully suited to Thailand's digital economy and the changing needs of Industry 5.0.},
  keywords={Industries;Structured Query Language;Java;Pandemics;Natural language processing;Software;Problem-solving;Fifth Industrial Revolution;Software engineering;Python;software engineering;technical skills;soft skills;natural language processing},
  doi={10.1109/SNPD65828.2025.11253042},
  ISSN={2693-8421},
  month={June},}@INPROCEEDINGS{11257756,
  author={Subhan, Md Raihan and Alam, Md Mahinur and Tanha, Kanita Jerin and Jun, Taesoo},
  booktitle={2025 International Conference on Mobile, Military, Maritime IT Convergence (ICMIC)}, 
  title={Lightweight Hybrid Deep Learning Model with Digital Twin for Industrial Energy Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={137-140},
  abstract={This paper introduces Energy-Twin, an integrated system that combines Digital Twin (DT) technology with Explainable Artificial Intelligence (XAI) to support energy prediction and optimization in industrial manufacturing environments. Using real-time data from the Gumi Industrial Complex, the system establishes a dynamic link between physical operations and their digital counterparts, enabling continuous monitoring and intelligent decision-making. At its core, the framework employs a hybrid deep learning architecture that integrates Convolutional Neural Networks (CNN), Gated Recurrent Units (GRU), and Bidirectional Long Short-Term Memory (BiLSTM) layers. This architecture is specifically designed to capture both spatial and temporal dependencies in energy consumption data, improving the accuracy of predictive modeling. The DT component simulates alternative operational scenarios in real time, identifying configurations that reduce energy usage without compromising production efficiency. XAI techniques are embedded to make the system's recommendations transparent and interpretable, fostering trust and usability for operators. Evaluation results show that Energy-Twin achieves a high prediction accuracy of 99.55% with low computational overhead, making it well-suited for deployment in resource-constrained industrial environments. The proposed approach offers a practical pathway to energy-efficient and intelligent manufacturing under the Industry 5.0 framework.},
  keywords={Deep learning;Adaptation models;Accuracy;Explainable AI;Computational modeling;Predictive models;Real-time systems;Digital twins;Manufacturing;Optimization;Digital twin;explainable AI;energy-twin;hybrid deep learning;real-time energy forecasting;edge-deployable AI model},
  doi={10.1109/ICMIC66299.2025.11257756},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11248435,
  author={Yang, Qingtian and Zhou, Dong and Zhao, Jinlong and Zhou, Qidi and Song, Zicheng and Zhang, Yan and Li, Yunbo},
  booktitle={2025 16th International Conference on Reliability, Maintainability and Safety (ICRMS)}, 
  title={Quantification Method of Operating Space Based on Convex Collision and Posture Comfort Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Industry 5.0 highlights human - centric and capability - enhanced maintenance demands. In complex industrial equipment repair, confined spaces and dense obstacles pose significant challenges to operating space. Current methods have limitations like qualitative descriptions, collision constraint neglect, and difficulty in integrating ergonomics. This paper proposes a quantitative method combining convex hull collisions and posture comfort. Using the CoACD algorithm for efficient preprocessing of complex obstacle environments, it generates feasible operational domains considering upper - limb joint constraints and inverse kinematics. The GJK algorithm handles collision penalties, and the RULA scoring system manages posture penalties. A normalized operator then provides a quantitative evaluation of the operating space. The core innovation lies in the normalized comprehensive evaluation model, which first unifies the quantitative expression of operational entity reachability, obstacle avoidance, and comfort. Experimental validation shows that this method effectively analyzes operating space characteristics, offering a standardized quantitative assessment tool to support human computer collaborative decision - making, optimize maintenance task planning and facility layout, and enhance operators' health and efficiency.},
  keywords={Technological innovation;Convex hulls;Ergonomics;Layout;Kinematics;Maintenance;Safety;Planning;Collision avoidance;Fifth Industrial Revolution;convex hull collision;operating space;ergonomic assessment;maintainability},
  doi={10.1109/ICRMS65480.2025.00139},
  ISSN={2575-2642},
  month={July},}@INPROCEEDINGS{11248351,
  author={Li, Yunbo and Zhou, Dong and Guo, Ziyue and Zhou, Qidi and Yang, Qingtian and Zhang, Yan},
  booktitle={2025 16th International Conference on Reliability, Maintainability and Safety (ICRMS)}, 
  title={A Computer-Aided Design Based Parametric Method for Maintainability Rapid Verification}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Industry 5.0 has imposed a human-centered transformation requirements for intelligent maintenance. For structurally complex large-scale equipment, the main obstacles hindering the transition include high cognitive and difficulties load on maintenance workers. Although current approaches can address some ergonomics issues by using virtual maintenance, two major bottlenecks still remain. First, heavy dependence on expert experience leads to design subjectivity and problem omissions. Second, substantial time investment is required in simulation animation production. Therefore, this paper proposes a Computer-Aided Design (CAD) based parametric method for reliability and maintainability rapid verification. First, knowledge engineering based parametric maintainability models are constructed to replace expertise to achieve rulebased reasoning control in CAD environments. Second, a rapid verification workflow for applying parametric models is defined, enabling computers to achieve rapid verification in CAD environments. Finally, the effectiveness of the method is validated by using an aircraft APU. This method provides a new paradigm for enhancing ergonomics performance and promotes the transition of equipment toward human-centered objectives.},
  keywords={Knowledge engineering;Solid modeling;Design automation;Computational modeling;Ergonomics;Production;Reliability engineering;Cognition;Maintenance;Fifth Industrial Revolution;reliability and maintainability verification;parametric design;computer-aided design;knowledge engineering},
  doi={10.1109/ICRMS65480.2025.00135},
  ISSN={2575-2642},
  month={July},}
