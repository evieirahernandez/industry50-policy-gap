@article{ WOS:001442385500001,
Author = {Alonso, Ruben and Sanchez, Tomas F. and Alfaro, Diego A. and Cruz,
   Yarens J. and Villalonga, Alberto and Castano, Fernando},
Title = {Automation and Robotics Pilot Lines in the Context of Industry 5.0},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2025},
Volume = {15},
Number = {5},
Month = {MAR},
Abstract = {Pilot lines have become a key element in modern industry. The demands
   for resilience, human-centricity, and sustainability in Industry 5.0,
   combined with technological innovations, highlight the critical role of
   these lines in the new industrial paradigm. Pilot lines facilitate the
   validation of processes and the reduction in uncertainties, making them
   essential tools for future industries. This article examines the current
   state of pilot lines and evaluates their alignment with Industry 5.0
   principles. As part of this analysis, the GAMHE 5.0 pilot line is
   presented as a line designed with a focus on automation and robotics,
   meeting the requirements of the industries of the future. This article
   also details a series of case studies conducted on the pilot line,
   demonstrating its flexibility and adaptability. Finally, the advantages
   and disadvantages of small-scale lines are analyzed within the context
   of Industry 5.0, emphasizing their importance in balancing technology,
   human factors, and sustainability.},
