@article{ WOS:001498223000001,
Author = {Mon, Bisni Fahad and Hayajneh, Mohammad and Abu Ali, Najah and Ullah,
   Farman and Ullah, Hikmat and Alkobaisi, Shayma},
Title = {Digital Twins in the IIoT: Current Practices and Future Directions
   Toward Industry 5.0},
