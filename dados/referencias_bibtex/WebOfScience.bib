@article{ WOS:001442379500001,
Author = {Fernandez-Moyano, Jon A. and Remolar, Inmaculada and Gomez-Cambronero,
   Agueda},
Title = {Augmented Reality's Impact in Industry-A Scoping Review},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2025},
Volume = {15},
Number = {5},
Month = {MAR},
Abstract = {This scoping review investigates the integration of augmented reality
   within Industry 4.0 and Industry 5.0, focusing on its applications
   across various industrial sectors. The study analyzes 74 relevant
   articles published since 2014, coinciding with the emergence of Industry
   4.0. Since the introduction of the Industry 5.0 concept in 2021, there
   has been a noticeable increase in publications, reflecting a shift
   toward applications that prioritize personalization, sustainability, and
   human-centric innovations. The findings highlight the versatility of
   augmented reality in enhancing productivity, efficiency, safety, and
   work quality across industries such as robotics, automotive, education,
   and construction. However, the implementation of artificial intelligence
   within augmented reality applications remains limited, revealing a
   significant opportunity for future research to optimize their
   integration and functionality. The review emphasizes the importance of
   developing augmented reality solutions tailored to specific industrial
   needs, aligned with the principles of Industry 5.0, and leveraging
   versatile, cost-effective hardware like mobile devices and smartglasses
   to ensure accessibility and scalability.},
