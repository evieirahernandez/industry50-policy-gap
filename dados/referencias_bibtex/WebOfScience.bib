@article{ WOS:001499583500001,
Author = {Singh, Kumari Amita and Patra, Falguni and Ghosh, Tabli and Mahnot,
   Nikhil Kumar and Dutta, Himjyoti and Duary, Raj Kumar},
Title = {Advancing food systems with industry 5.0: A systematic review of smart
   technologies, sustainability, and resource optimization},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {9},
Month = {JUN},
Abstract = {The advent of Industry 5.0 represents a transformative shift towards
   integrating advanced computational technologies-such as AI, IoT,
   robotics, and big data-with human-centric collaboration to achieve
   sustainable food production systems. This systematic review examines the
   link between Industry 5.0 and sustainability, focusing on computational
   innovations, resource management, and eco-friendly practices within food
   industries. The study addresses the pressing challenge of balancing
   industrial growth with environmental stewardship and identifies the
   untapped potential of Industry 5.0 to enhance food safety, reduce waste,
   and enable personalized food solutions. Using a qualitative methodology,
   the review synthesizes findings from scholarly articles, industry
   reports, and case studies to analyze applications of smart sensors,
   blockchain, and robotics in optimizing supply chains, precision farming,
   and vertical agriculture. Results indicate that Industry 5.0 facilitates
   real-time monitoring, predictive analytics, and adaptive production,
   improving resource efficiency and minimizing environmental impacts.
   Smart packaging, digital twins, and AR are highlighted as emerging tools
   for enhancing traceability, quality control, and consumer engagement.
   However, high implementation costs, data management challenges, and the
   need for policy frameworks emerge as critical barriers. The discussion
   emphasizes how these challenges can be mitigated through
   multidisciplinary research, cross-sector collaboration, and government
   incentives. Overall, Industry 5.0 offers a pathway to sustainable,
   efficient, and personalized food systems by leveraging cutting-edge
   technologies while fostering human-machine collaboration. Future
   research should focus on scalable applications, cost-effective
   solutions, and regulatory alignment to accelerate Industry 5.0 adoption
   in food sectors. This study underscores the urgency of advancing
   computational technologies to shape resilient and sustainable food
   production systems.},
