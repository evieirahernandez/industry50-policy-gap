@article{ WOS:001506939900009,
Author = {Herrera-Vidal, German and Coronado-Hernandez, Jairo R. and Maheut,
   Julien},
Title = {Complexity management challenges in the industry 4.0 era: A systematic
   review in production systems},
Journal = {RESULTS IN ENGINEERING},
Year = {2025},
Volume = {26},
Month = {JUN},
Abstract = {Operational complexity in production systems has grown significantly
   with the adoption of Industry 4.0 technologies. Managing it is a
   strategic challenge that conditions industrial efficiency, adaptability,
   and sustain-ability. This research aims to analyze how these
   technologies impact the management of complexity in manufacturing
   environments. Methodologically, a systematic literature review was
   conducted using the PRISMA protocol, filtering 61,360 publications to
   select 27 key studies. The findings indicate that IoT, AI and CPS
   optimize decision-making and personalization but also introduce new
   layers of technical, organizational, and human complexity. In
   particular, a critical lack of standardized metrics for measuring and
   managing complexity was identified. Furthermore, a weak connection to
   the emerging principles of Industry 5.0, centered on human-technology
   collaboration, is evident. Consequently, a classification of complexity
   factors (internal, external, static, and dynamic) is proposed, and
   future lines of research oriented towards the development of adaptive
   human-centered frameworks and sustainability are suggested.},
