@article{ WOS:001546754700002,
Author = {Sizan, Najmus Sakib and Dey, Diganta and Abu Layek, Md. and Uddin, Md
   Ashraf and Huh, Eui-Nam},
Title = {Evaluating blockchain platforms for IoT applications in Industry 5.0: A
   comprehensive review},
