Address = {125 London Wall, London, ENGLAND},
Type = {Review},
Language = {English},
Affiliation = {Liu, Y (Corresponding Author), Linkoping Univ, Dept Management \& Engn, SE-58183 Linkoping, Sweden.
   Zhang, YF (Corresponding Author), Northwestern Polytech Univ, Sch Mech Engn, Minist Ind \& Informat Technol, Key Lab Ind Engn \& Intelligent Mfg, Xian 710072, Peoples R China.
   Ma, Shuaiyin; Ding, Wei, Xian Univ Posts \& Telecommun, Sch Comp Sci \& Technol, Xian 710121, Peoples R China.
