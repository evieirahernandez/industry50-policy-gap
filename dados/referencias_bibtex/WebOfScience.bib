@article{ WOS:001604870300001,
Author = {Adithya, M. Ajay and Geetha, R. and Sundar, S. and Varghese, Mahima Anna
   and Velmurugan, Palanivel R.},
Title = {Bibliometric analysis of the evolution of smart factories and
   sustainable manufacturing in Industry 4.0},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {6},
Number = {1},
Month = {OCT 30},
Abstract = {This study presents a comprehensive bibliometric analysis of smart
   factory research published between 2014 and 2024, integrating
   technological, managerial, and sustainability perspectives within a
   single analytical framework. Using 1625 Scopus-indexed records,
   performance indicators and science mapping techniques, including
   co-citation, keyword co-occurrence, thematic mapping, and bibliographic
   coupling, were applied to address six research questions on publication
   trends, influential sources and authors, geographic distribution,
   intellectual structure, thematic evolution, and conceptual clustering.
   The results reveal sustained global growth in publications, with
   research output concentrated in industrially advanced nations, and
   thematic progression from foundational Industry 4.0 technologies toward
   Industry 5.0 priorities such as human-centricity, resilience, and
   environmental sustainability. Highly cited works form conceptual bridges
   between technology-focused and sustainability-oriented streams, while
   emerging themes include blockchain-enabled supply chains, AI-driven
   optimization, and circular manufacturing models. Gaps persist in the
   integration of social and managerial dimensions, geographic inclusivity,
   and empirical validation of thematic clusters. This study offers a
   replicable methodological blueprint for bibliometric research in
   manufacturing, actionable insights for technology adoption and policy
   design, and a forward-looking agenda for advancing inclusive and
   sustainable smart factory ecosystems.},
