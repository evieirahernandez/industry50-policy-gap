Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Review},
Language = {English},
Affiliation = {Sagkriotis, A (Corresponding Author), Independent Consultant Real World Evidence \& Hlth, London, England.
