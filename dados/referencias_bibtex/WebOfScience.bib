
@article{ WOS:001599932400001,
Author = {Diaz-Martinez, Marco Antonio and Roman-Salinas, Reina Veronica and
   Rivera-Garcia, Guadalupe Esmeralda and Grande-Ramirez, Jose Roberto and
   Fuentes-Rubio, Yadira Aracely},
Title = {Quality management in industrial processes: Benefits and challenges of
   industry 4.0 and its projection towards industry 5.0 - A systematic
   review},
Journal = {COGENT ENGINEERING},
Year = {2025},
Volume = {12},
Number = {1},
Month = {DEC 31},
Abstract = {The adoption of Industry 4.0 technologies has revolutionized quality
   management, driving it towards a more human, sustainable, and
   data-driven approach. These innovations not only enable business leaders
   to make strategic decisions based on real-time information but also
   contribute to cost optimization, increased operational performance, and
   improved quality of life in the work environment. Thanks to the ability
   to collect and analyse data continuously, failures are anticipated,
   unscheduled maintenance is reduced, and the efficiency of processes is
   enhanced, consolidating a more resilient and competitive management
   model. This article presents a conceptual framework derived from a
   systematic review of more than 50 studies published between 2002 and
   2024 in renowned databases such as EBSCO Essential, Scopus, and MDPI.
   The fundamental concepts, as well as the benefits and challenges related
   to the continuous improvement of quality management in industrial
   processes, are explored. In particular, it highlights how the
   convergence of Industry 4.0 technologies with sustainability principles
   has significantly transformed these processes, generating positive
   impacts for both organizations and their employees. This approach
   promotes inclusive, ethical and flexible management, aligned with the
   demands of the digital 4.0 era and the challenges of sustainable
   development towards an industry 5.0 projection.},
