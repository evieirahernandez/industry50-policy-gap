@article{ WOS:000926402500001,
Author = {Alves, Joel and Lima, Tania M. and Gaspar, Pedro D. D.},
Title = {Is Industry 5.0 a Human-Centred Approach? A Systematic Review},
Journal = {PROCESSES},
Year = {2023},
Volume = {11},
Number = {1},
Month = {JAN},
Abstract = {Industry 5.0 presents itself as a strategy that puts the human factor at
   the centre of production, where the well-being of the worker is
   prioritized, as well as more sustainable and resilient production
   systems. For human centricity, it is necessary to empower human beings
   and, respectively, industrial operators, to improve their individual
   skills and competences in collaboration or cooperation with digital
   technologies. This research's main purpose and distinguishing point are
   to determine whether Industry 5.0 is truly human-oriented and how human
   centricity can be created with Industry 5.0 technologies. For that, this
   systematic literature review article analyses and clarifies the concepts
   and ideologies of Industry 5.0 and its respective technologies
   (Artificial Intelligence, Robotics, Human-robot collaboration,
   Digitalization), as well as the strategies of human centricity, with the
   aim of achieving sustainable and resilient systems, especially for the
   worker.},
