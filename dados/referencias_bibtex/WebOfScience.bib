@article{ WOS:001649197000001,
Author = {Mohamed Hashim, Mohamed ashmel and Tlemsani, Issam and Tantry,
   Ansarullah and Li, Songdi},
Title = {Platform Business Model Innovation for Sustainability: A Framework for
   Industry 5.0 Integration},
Journal = {BUSINESS STRATEGY AND THE ENVIRONMENT},
Year = {2025},
Month = {2025 DEC 28},
Abstract = {A comprehensive framework is developed for adopting Platform Business
   Model Innovation (PBMI) to enhance sustainable performance in the
   Industry 5.0 (I5.0) era. While PBMI plays a growing role in corporate
   transformation, tensions persist between profit-driven objectives and
   broader sustainability imperatives. Drawing on interdisciplinary
   literature in PBMI, sustainability-oriented innovation, network theory,
   and stakeholder theory, the framework integrates key I5.0 enablers such
   as human-centric principles, adaptive robotics, Industrial IoT, and
   cognitive collaboration to balance the triple bottom line of economic,
   environmental, and social value. Using a critical literature review and
   abductive synthesis, 11 propositions and four policy statements are
   formulated to guide the adoption and experimentation of PBMI for
   sustainability. The findings show that effective PBMI requires
   integration of value networks, life cycle thinking, and product-service
   systems to address evolving sustainability challenges. The framework
   demonstrates the transformative potential of I5.0 technologies in
   reshaping PBMI to achieve systemic value creation and offers strategic
   insights for managers, policymakers, and researchers seeking to align
   digital transformation with sustainable innovation while providing a
   theoretical foundation for future empirical validation.},
