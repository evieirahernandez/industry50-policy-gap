@article{ WOS:001522172800001,
Author = {Cutad, Methene and Al-Marri, Mohammed J. and Kumar, Anand},
Title = {Direct transformation of Carbon Dioxide to aromatics as high-value
   liquid fuels via the modified fischer-Tropsch synthesis and
   Methanol-mediated routes},
Journal = {CATALYSIS REVIEWS-SCIENCE AND ENGINEERING},
Year = {2025},
Month = {2025 JUL 4},
Abstract = {The direct conversion of carbon dioxide (CO2) into aromatics offers a
   promising route for producing high-value liquid fuels, addressing both
   sustainability targets and rising petrochemical demand. This process is
   primarily pursued through two key pathways: modified fischer-Tropsch
   synthesis (CO2-FTS) and methanol (MeOH)-mediated conversion. Each
   pathway presents unique advantages and challenges, particularly in
   catalyst design, reaction mechanisms, and product selectivity. This
   study explores catalyst development for optimizing C5+ selectivity,
   focusing on reaction mechanisms, synthesis methods, parameter
   optimization, and advanced characterization techniques. The integration
   of bifunctional catalysts further enables precise control over product
   distribution, enhancing process efficiency. Despite progress, research
   gaps remain, particularly in tandem catalysis, where synergistic
   catalyst interactions can drive targeted product formation. Catalyst
   deactivation and durability also pose challenges, necessitating
   innovations in material design and regeneration strategies.
   Additionally, incorporating renewables and Industry 5.0 technologies,
   such as AI-driven process control and machine learning, can enhance
   system efficiency and sustainability. A major opportunity lies in
   combining CO2-FTS and MeOH-mediated pathways, leveraging the strengths
   of both processes through hybrid catalyst systems and multi-reactor
   configurations. This hybrid approach, coupled with strategic tail-gas
   recycling and co-feeding techniques, can maximize carbon utilization,
   improve product selectivity, and upscale CO2 hydrogenation processes for
   industrial application. Addressing these challenges and opportunities
   will be key to advancing CO2-based fuel production as a viable
   alternative to fossil-derived hydrocarbons.},
Publisher = {TAYLOR \& FRANCIS INC},
