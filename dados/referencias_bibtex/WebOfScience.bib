Type = {Review},
Language = {English},
Affiliation = {Andreiana, DS (Corresponding Author), IDENER, IT Dept, Seville 41300, Spain.
   del Real Torres, Alejandro, Univ Seville, Sch Engn ETSI, Syst \& Automat Dept, Seville 41092, Spain.
   Stefan Andreiana, Doru; Ojeda Roldan, Alvaro; Hernandez Bustos, Alfonso; Acevedo Galicia, Luis Enrique, IDENER, IT Dept, Seville 41300, Spain.},
