@INPROCEEDINGS{11163116,
  author={Kaewdook, Don and Jaingam, Therdsak and Chimklin, Kitisak},
  booktitle={2025 10th International Conference on Business and Industrial Research (ICBIR)}, 
  title={Optimization of Coordinate Measurement Machine Performance Through Measuring System Analysis and Full Factorial Design}, 
  year={2025},
  volume={},
  number={},
  pages={398-402},
  abstract={In the industry, a recurring issue has been identified wherein both machining part manufacturers and customer factories utilize Coordinate Measuring Machines (CMM) for dimensional inspection prior to product delivery and acceptance. The most frequent measurement discrepancy arises in hole size assessment. The root cause was found to be the difference in probe sizes used by the manufacturers and the customer’s CMMs, leading to inconsistencies in measurement results. This discrepancy raised concerns, prompting a research study to investigate the factors influencing hole size measurement accuracy in CMM systems. A Full Factorial Experimental Design and Measurement System Analysis (MSA) employing Gauge Repeatability and Reproducibility (GR&R) testing was performed to identify the primary factors affecting CMM measurement performance. The analysis revealed that all selected factors substantially affected measurement accuracy. The adjusted coefficient of determination (R-sq(adj)) was calculated to be 0.974, indicating a strong correlation between the specified variables and the measurement outcomes. The GR&R result was recorded at 0.76%, indicating it is within a good range and validating the measurement system's acceptability. The ideal measurement settings were determined by experimental design and response optimization as follows: (1) a probe diameter of 4.0 mm, (2) measurement points established at five locations, (3) a square probing trajectory, (4) a measurement depth of 5.0 mm, and (5) a counterclockwise probing orientation. Five repeated measurements were made using the optimal factor levels to support the experimental findings. The results showed an extremely low error rate of 0.0036%, demonstrating exceptional accuracy and dependability. By successfully establishing the enhanced parameters as a standard in CMM measurement processes, industrial applications can benefit from increased measurement accuracy and consistency.},
  keywords={Accuracy;Coordinate measuring machines;Correlation;Systematics;Size measurement;Reproducibility of results;Trajectory;Probes;Optimization;System analysis and design;CMM;MSA;Full Factorial Experimental Design;GR&R;Measurement Optimization},
  doi={10.1109/ICBIR65229.2025.11163116},
  ISSN={},
  month={May},}@INPROCEEDINGS{11155798,
  author={Peeris, Maria Patricia and Baryannis, George},
  booktitle={2025 International Conference on Software, Knowledge, Information Management & Applications (SKIMA)}, 
  title={Artificial Intelligence for Supply Chain Sustainability: A Research Roadmap}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In recent years, there has been an increasingly strong interest in improving supply chain sustainability to deal with wide-ranging impacts, from climate change to global trade uncertainty. While Artificial Intelligence has been identified as a key Industry 5.0 technology, its significant potential in the context of sustainability has not yet been harnessed. In this paper, we first present the results of a systematic literature review to both clarify the potential of AI for supply chain sustainability and understand which particular AI technologies have been utilised and for which application. Through insights drawn from this literature survey, we propose a research roadmap centred around four leading-edge AI approaches: generative AI, knowledge graphs, neurosymbolic AI and causal machine learning, and provide indicative suggestions for leveraging these approaches to help supply chain stakeholders meets sustainability targets.},
  keywords={Surveys;Uncertainty;Generative AI;Supply chains;Decision making;Knowledge graphs;Stakeholders;Artificial intelligence;Sustainable development;Systematic literature review;Climate change;Artificial intelligence;Supply chains;Sustainable development;Decision making;Reviews},
  doi={10.1109/SKIMA66621.2025.11155798},
  ISSN={},
  month={June},}@INPROCEEDINGS{11152950,
  author={Kumari, Aparna and Raval, Nikhil and Shah, Rushi and Assaad, Mohamad},
  booktitle={IEEE INFOCOM 2025 - IEEE Conference on Computer Communications Workshops (INFOCOM WKSHPS)}, 
  title={Meta-VLF:A Virtual Learning Framework in Industry 5.0 using Metaverse and 5G-uRLLC}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In Industry 5.0, we introduce Meta-VLF, a metaverse-based virtual learning system utilizing web services in a 5G network to facilitate next-generation learning. The system plays two important roles: first, a virtual classroom where instructors and student avatars interact like a real classroom, taking advantage of ultra-reliable low-latency communication (5G-uRLLC). Second, it allows for digital content creation in a metaverse space, where educational materials are stored using nonfungible tokens. Content is stored off-chain technology, i.e., in the Interplanetary File System (IPFS), with blockchain storing content hash references for security and integrity. Based on a Web 3.0 platform, the architecture includes AI-based knowledge augmentation for customized learning experiences. The deployment utilizes a simulated metaverse environment, with avatars created through Blender. Performance analysis shows significant enhancements, such as a 43.12% improvement in user bandwidth, a 26.32% reduction in jitter rate, and a rendering time improvement ranging between 50% and 57.14%, justifying its practicality in real-world applications of Education in Industry 5.0.},
  keywords={Semantic Web;Electronic learning;Metaverse;Avatars;Ultra reliable low latency communication;Rendering (computer graphics);Service-oriented architecture;InterPlanetary File System;Security;Fifth Industrial Revolution;Industry 5.0;Virtual Classrooms;Online content creation;Metaverse;Federated Learning;Blockchain},
  doi={10.1109/INFOCOMWKSHPS65812.2025.11152950},
  ISSN={2833-0587},
  month={May},}@INPROCEEDINGS{11153022,
  author={Risdianto, Aris Cahyadi and Mohan, Purnima Murali and Pei, Yiyang and Rezende, Pedro Henrique Amorim and Wihardja, Kartono},
  booktitle={IEEE INFOCOM 2025 - IEEE Conference on Computer Communications Workshops (INFOCOM WKSHPS)}, 
  title={Validating Evil Twin Attacks in 5G/6G Networks based on MITRE FiGHT}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The global deployment of 5G and beyond represents significant advancements in wireless networks — with applications spanning from remote healthcare, smart drones, and industry 5.0 over the tactile Internet. Despite its potential, the adoption of 5G introduces unique security challenges that are not yet widely understood by end-users and enterprises, thereby increasing the likelihood of exploitation. This paper addresses this gap by analyzing the security vulnerabilities inherent in 5G networks and exploring potential attack vectors. Specifically, we present a detailed emulation of a 5G evil twin attack within a controlled private 5G network testbed. Utilizing specialized hardware to emulate the frequency band of 5G NR, we demonstrate the feasibility of intercepting and manipulating data communication. The specialized hardware includes USRP SDR kit as radio unit, and programmable 5G SIM card that allows UE connect to the evil twin network built upon open source radio and core network. The attack scenario use cases includes redirection of DNS requests and extraction of sensitive user UE information. The evil twin can redirect HTTP traffic to the legitimate web server from the UE into fake web server, and could steal victim’s credential information. Additionally, the evil twin can also extract UE’s critical information during UE registration and PDU establishment. We validate these findings against the MITRE FiGHT framework to provide critical insights to understand attack TTPs and develop early warning or countermeasures to enhance the security of 5G and ultimately 6G.},
  keywords={Tactile Internet;5G mobile communication;Wireless networks;SIM card;Medical services;Hardware;Web servers;Vectors;HTTP;Data mining;5G/6G security;5G testbed;threat hunting;evil twin;DNS redirection},
  doi={10.1109/INFOCOMWKSHPS65812.2025.11153022},
  ISSN={2833-0587},
  month={May},}@ARTICLE{11155044,
  author={Taneja, Ashu and Alqahtani, Nayef and Alqahtani, Ali},
  journal={IEEE Access}, 
  title={Optimized IRS-Aided UAV Communication for 6G Networks With Phase and User Association Control}, 
  year={2025},
  volume={13},
  number={},
  pages={161311-161319},
  abstract={Industry 5.0 relies on advanced automation, high speed connectivity, improved real-time communication support and efficient collaboration to foster an industry ecosystem that is sustainable, innovative and competitive. To promote human-machine collaboration and to support massive machine type communication (mMTC) in Industry 5.0, advanced sixth generation (6G) and uncrewed aerial vehicles (UAVs) technology play an important role. They offer capabilities of enhanced coverage, improved connectivity, remote monitoring, efficient data collection and advanced automation. This paper presents a 6G powered framework for UAV network assisted with intelligent reflecting surfaces (IRSs). The IRS-aided UAV communication exploits the IRS beamforming capabilities with UAV mobility. An optimal phase control strategy of IRS is presented considering the total power consumption at the IRS and UAV. Further, an association scheme is proposed that smartly assigns users to the specific IRSs for maximum line-of-sight (LoS) channel power gain with optimal phase control. The impact of transmit power  $p_{max}$ , number of time slots and number of IRS elements N on the average sum rate is evaluated under the proposed association and phase control. It is observed that the proposed association scheme promises an average sum rate of 12.8 bps/Hz with  $N = 500$ . Also, the sum rate further improves by 6.49% with optimal phase control. colorblackIn the end, the system incorporating random association scheme is compared with conventional system with no association introduced.},
  keywords={Autonomous aerial vehicles;6G mobile communication;Fifth Industrial Revolution;Phase control;Power demand;Resource management;Real-time systems;NOMA;Thermal sensors;Reflection;6G;IRS;UAV;industry 5.0;phase control;user association},
  doi={10.1109/ACCESS.2025.3608235},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11148984,
  author={Mi, Shanghua and Zheng, Hao and Fan, Guoliang and Chen, Weihai and Gao, Geming and Xiao, Chaoqun},
  booktitle={2025 IEEE 20th Conference on Industrial Electronics and Applications (ICIEA)}, 
  title={Consensus-Decoupling Based Task Planning: A Positive Synergy Approach for a Human-In-the-loop Collaboration System}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Human-In-the-loop collaborative systems constitute a critical focus area in Industry 5.0, where the rationality of task planning and collaborative allocation in front-end processes directly impacts the quality-efficiency level of human-machine coupling collaboration. Current research has paid limited attention to the global optimization decomposition of complex human-machine collaborative tasks, thereby constraining the optimization space for subsequent collaborative allocation. This study proposes a human-machine collaborative coupling task partitioning method based on multi-view consensus decoupling computation. Integrating perspectives of human-machine responsibility decomposition optimization and robustness under uncertain task environments, we establish a decoupling criterion comprising three dimensions: interaction dependency, quality-efficiency correlation, and adaptability of granularity. A robust matrix factorization with spectral embedding method considering multi-view perspectives is employed to optimize the consensus clustering partitioning scheme. The proposed methodology is validated through human-machine collaborative task scenarios in wind turbine cluster maintenance operations under mountainous environments, demonstrating its feasibility and effectiveness.},
  keywords={Couplings;Correlation;Human-machine systems;Collaboration;Human in the loop;Wind turbines;Planning;Maintenance;Resource management;Optimization;human-machine collaboration;task decoupling;consensus clustering},
  doi={10.1109/ICIEA65512.2025.11148984},
  ISSN={2158-2297},
  month={Aug},}@ARTICLE{11154899,
  author={Angrisani, Leopoldo and Arpaia, Pasquale and De Benedetto, Egidio and D’Iorio, Matteo and Duraccio, Luigi and Regio, Fabrizio Lo and Tedesco, Annarita},
  journal={IEEE Sensors Journal}, 
  title={An Open Steady-State Visually Evoked Potentials Dataset for Augmented Reality-Based Brain–Computer Interfaces}, 
  year={2025},
  volume={25},
  number={20},
  pages={38957-38965},
  abstract={This article presents an open benchmark dataset related to steady-state visually evoked potential (SSVEP) signals elicited by means of an augmented reality (AR) device. In addition to being the first open dataset that combines SSVEP elicited through AR, another important novelty is the fact that this dataset was designed with a metrology-driven approach, monitoring and/or controlling influence factors that can impair target recognition. The dataset consists of eight-channel electroencephalogram (EEG) data acquired from 30 healthy subjects (15 experienced) while they performed a cue-guided target selection task. The flickering frequencies ranged from 8 to 15 Hz with an interval of 1 Hz, while the phase difference between two adjacent flickers was set to  $\pi /{2}$ . The dataset comprises five acquisition cycles for each subject, with each cycle corresponding to signals recorded from all eight flickers, presented by the visual cues in a randomized order. The stimulation duration in each selection task was 5 s. To ensure the dataset’s trustworthiness, two crucial parameters for effective stimulus recognition were monitored and/or controlled, namely, the illuminance of the environment and the frames per second (fps) variation of the AR device, which are primary factors influencing the performance of AR-based SSVEP brain–computer interfaces (BCIs). Additionally, acceleration and angular velocity data related to the subjects’ head movements were acquired. In this way, the proposed dataset addresses the gap in the availability of public datasets for AR-based SSVEP BCIs, serving as a benchmark for comparing different algorithms in: 1) target identification and 2) motion artifact detection. This contribution is crucial for advancing the development of portable BCI systems aligned with the human-centric principles of the Industry 5.0 paradigm.},
  keywords={Visualization;Electroencephalography;Benchmark testing;Target recognition;Steady-state;Monitoring;Brain-computer interfaces;Biomedical monitoring;Signal to noise ratio;Performance evaluation;Augmented reality (AR);benchmark dataset;brain–computer interfaces (BCIs);human–machine interaction;Industry 5.0;instrumentation;measurement;steady-state visually evoked potentials (SSVEPs)},
  doi={10.1109/JSEN.2025.3605813},
  ISSN={1558-1748},
  month={Oct},}@ARTICLE{11153636,
  author={Enwereonye, Uchenna P. and Shahraki, Ahmad Salehi and Alavizadeh, Hooman and Kayes, A. S. M.},
  journal={IEEE Internet of Things Journal}, 
  title={Robust Multiuser Physical Layer Security for Grant-Free mMTC in Beyond 5G/6G Networks}, 
  year={2025},
  volume={12},
  number={23},
  pages={50110-50125},
  abstract={Industry 5.0 introduces human–machine collaboration and resilient automation, demanding secure, low-latency connectivity for ultradense industrial IoT (IIoT). Grant-free massive machine-type communications (mMTC) supports such connectivity but faces challenges including dense multiuser access, passive eavesdropping, and imperfect channel state information (CSI), which undermine physical layer security (PLS). This article proposes a robust and low-complexity multiuser PLS scheme tailored for grant-free mMTC under CSI uncertainty. The scheme leverages dynamic user clustering based on spatial correlation and real-time interference to enable scalable, interference-aware beamforming. Furthermore, a joint optimisation of receive beamforming and adaptive artificial noise injection is performed, and enhanced by a regularised minimum mean square error (MMSE) framework to mitigate bounded CSI errors. Simulation results show that the scheme consistently outperforms existing benchmarks across secrecy capacity, bit error rate, and secrecy outage probability under different channel models, together with analyses of SOP sensitivity to CSI error and scalability to dense users/eavesdroppers, confirms its robustness, efficiency, and applicability to large-scale, secure IIoT communications in beyond 5G/6G networks aligned with Industry 5.0 requirements.},
  keywords={Interference;Industrial Internet of Things;Array signal processing;Security;Scalability;Uncertainty;Robustness;Fifth Industrial Revolution;Dynamic scheduling;Channel estimation;Adaptive beamforming;beyond 5G (B5G) and 6G networks;grant-free massive machine-type communications (mMTC);Internet of Things security;multiuser communication;physical layer security (PLS)},
  doi={10.1109/JIOT.2025.3607493},
  ISSN={2327-4662},
  month={Dec},}@ARTICLE{11152311,
  author={Hostos, Héctor and Goepp, Virginie and Sondi, Patrick},
  journal={IEEE Transactions on Engineering Management}, 
  title={A Systematic Literature Review of Resilience Approaches in Production Systems}, 
  year={2025},
  volume={72},
  number={},
  pages={4094-4112},
  abstract={The digitalization of industrial production systems through the Industry 4.0 paradigm has led to significant gains in efficiency and customization. However, it introduces new vulnerabilities, including heightened cybersecurity risks and increased dependence on network connectivity. Therefore, resilience emerges as a critical capability for maintaining operations and ensuring the recovery of production systems in the face of disruptions. This article presents a systematic literature review on resilience approaches in production systems, crucial for navigating the challenges of Industry 4.0. It adopts a three-perspective framework to analyze existing literature: resilience phases, resilience strategy decision space, and manufacturing system life cycle. The literature is classified into general frameworks, architectures, and methods, providing a structured overview of the field. The analysis reveals several key gaps, such as the need for practical implementation of resilience frameworks, the development of proactive strategies regarding the readiness phase, the exploration of underutilized areas in the resilience strategy decision space and the introduction of alternative resilience representations. The findings underscore the need to consider resilience, beyond a reaction to specific risks, as a broader capability to ensure the recovery of the production systems, and to open the path to new research directions.},
  keywords={Resilience;Engineering management;Systematic literature review;Artificial intelligence;Fourth Industrial Revolution;Computer security;Computer architecture;Training;Data mining;Cloud computing;Industry 4.0;Industry 5.0;literature review;manufacturing;production system;resilience},
  doi={10.1109/TEM.2025.3606576},
  ISSN={1558-0040},
  month={},}@INPROCEEDINGS{11137033,
  author={Liu, Cong and Zhang, Xiaoning and Liang, Xiaojun and Luo, Weichao and He, Zhenyu},
  booktitle={2025 IEEE 26th China Conference on System Simulation Technology and its Applications (CCSSTA)}, 
  title={MR-MultiTwin: A Mixed Reality Platform for Multi-User Control of Industrial Digital Twins}, 
  year={2025},
  volume={},
  number={},
  pages={399-404},
  abstract={As Industry 5.0 accelerates, real-time, multi-user collaboration with digital twins (DTs) becomes increasingly essential. However, current systems struggle with spatial synchro-nization, collaborative execution, and natural interaction at scale. We introduce MR-MultiTwin, a mixed reality (MR) platform that addresses these gaps through three key innovations: (1) a shared-anchor-based spatial mapping method for aligning multi-user locations within a unified coordinate system; (2) a role-based collaboration framework that synchronizes task states, user identities, and control rights in real time; and (3) AI-powered multimodal interaction, integrating gesture, gaze, and voice for seamless DT control. Built on an edge-cloud architecture, MR-MultiTwin has been validated in smart manufacturing and inspection scenarios, showing notable gains in coordination effi-ciency, interaction usability, and deployment feasibility-paving the way for scalable industrial MR systems.},
  keywords={Technological innovation;Collaboration;Mixed reality;Virtual reality;Real-time systems;Digital twins;Systems simulation;Synchronization;Fifth Industrial Revolution;Usability;Mixed Reality;Digital Twin;Multi-User Collaboration;Industrial XR;Role-Based Interaction;Industry 5.0},
  doi={10.1109/IEEECONF65522.2025.11137033},
  ISSN={},
  month={July},}@ARTICLE{11150408,
  author={Zhao, Yue and Ullah, Farhan and Mahmood, Khalid and Ahmad, Jawad and Kashif Bashir, Ali and Alturki, Nazik},
  journal={IEEE Internet of Things Journal}, 
  title={TFedSec-HI: Transformer-Driven Federated Security for IoT-Enabled Healthcare Industry 5.0 on Non-IID Data}, 
  year={2025},
  volume={12},
  number={22},
  pages={46204-46214},
  abstract={The Internet of Things (IoT) enhances the healthcare industry 5.0 by enabling connected devices and data-driven treatments, but it also introduces cyber threats, such as data breaches, and unauthorized access. mobile-edge computing (MEC) improves security by reducing reliance on cloud transmissions. However, challenges such as nonindependent and identically distributed (Non-IID) data and device intermittency affect security models in healthcare that require real-time analytics and reliable automation. These limitations are crucial in sensitive medical applications that require real-time analytics and reliable automation. This article proposes TFedSec-HI, a transformer-driven federated learning (TFL) for improving threat detection in the healthcare industry 5.0. Network traffic data is converted to grayscale and multichannel RGB images using local binary patterns (LBP) and Sobel edge detection. A lightweight mobile vision transformer (ViT) is used for effective feature extraction on edge devices, reducing computational load while retaining high performance. The federated proximal (FedProx) algorithm is used during the model aggregation phase to address issues with non-IID data distribution, resulting in consistent and effective learning. The global model is then shared with clients for real-time threat classification. The proposed method is evaluated on two real-world datasets, CICIoT2023 and CICIoMT2024, resulting in exceptional classification accuracies of 99.18% and 99.74%, respectively. TFedSec-HI addresses the Non-IID data challenges in Industry 5.0 healthcare by utilizing TFL to enable private, and adaptive threat detection across medical IoT devices.},
  keywords={Security;Accuracy;Image edge detection;Data models;Medical services;Training;Threat assessment;Computational modeling;Data privacy;Transformers;Cybersecurity;federated learning;healthcare;industry 5.0;mobile-edge computing (MEC);threat detection;vision transformer (ViT)},
  doi={10.1109/JIOT.2025.3605756},
  ISSN={2327-4662},
  month={Nov},}@INPROCEEDINGS{11148347,
  author={Leong, Wai Yie},
  booktitle={International Conference on Applied System Innovation (ICASI 2025)}, 
  title={Robotic automation for sustainable and efficient egg poultry farming}, 
  year={2025},
  volume={2025},
  number={},
  pages={621-626},
  abstract={The integration of robotic automation in egg poultry farming has emerged as a transformative approach to enhancing productivity, sustainability, and animal welfare. This paper investigates the application of robotics in various aspects of egg poultry farming, including automated egg collection, sorting, health monitoring, environmental control, and feed management. By leveraging advanced robotics systems integrated with artificial intelligence (AI) and the Internet of Things (IoT), the proposed framework aims to optimize operational efficiency, minimize labor dependency, and enhance precision management in poultry farms. Key areas addressed include the development of autonomous robotic systems for continuous monitoring of environmental parameters such as temperature, humidity, and air quality, which are critical for maintaining optimal poultry health and egg production. The use of robotic manipulators for efficient and gentle egg collection and sorting minimizes breakage and ensures product quality. Machine learning algorithms embedded within robotic systems enable predictive maintenance and real-time decision-making, thus enhancing the resilience and robustness of poultry farming operations. This study explores the potential environmental benefits of robotic automation, particularly in reducing energy consumption, minimizing waste, and promoting ethical farming practices through improved animal welfare. Comparative analysis between traditional farming practices and robotic-assisted operations highlights substantial gains in productivity, precision, and sustainability. The findings highlight potential of robotics in modern poultry farming, advocating for further research and development to overcome existing challenges such as cost, scalability, and technological integration. This study provides a foundational basis for deploying robotic systems that contribute to the evolution of sustainable and efficient egg poultry farming under Industry 5.0 principles.},
  keywords={},
  doi={10.1049/icp.2025.2634},
  ISSN={},
  month={April},}@INPROCEEDINGS{11128617,
  author={Campagna, Giulio and Frommel, Christoph and Haase, Tobias and Gottardi, Alberto and Villagrossi, Enrico and Chrysostomou, Dimitrios and Rehm, Matthias},
  booktitle={2025 IEEE International Conference on Robotics and Automation (ICRA)}, 
  title={Fostering Trust Through Gesture and Voice-Controlled Robot Trajectories in Industrial Human-Robot Collaboration*}, 
  year={2025},
  volume={},
  number={},
  pages={11853-11859},
  abstract={In the Industry 5.0 era, the focus shifts from basic automation to fostering collaboration between humans and robots. Trust is crucial in this new paradigm, enabling smooth interaction, especially for users with limited robotics knowledge. This study presents a novel framework that uses human hand gestures and voice commands to control robot movements, aiming to enhance trust, reduce cognitive workload, and minimize task execution time-key for efficient manufacturing. In automated systems, swift completion of micromanagement tasks is essential to prevent process disruption. To evaluate this framework, we devised a testbed scenario within an automated carbon fiber transportation and draping process, focusing on a maintenance task as the micromanagement challenge. Participants inspected the gripper, guided the robot along a defined path, and performed maintenance, such as attaching cables. Two conditions were tested: gestures and voice commands versus a smartPAD. The results showed that gestures and voice commands increased trust, lowered cognitive load, and shortened execution times, improving overall manufacturing efficiency.},
  keywords={Hands;Robot motion;Service robots;Transportation;Speech recognition;Real-time systems;Manufacturing;Trajectory;Maintenance;Safety},
  doi={10.1109/ICRA55743.2025.11128617},
  ISSN={},
  month={May},}@ARTICLE{11145896,
  author={Sarkar, Indranil and Kakarla, J. H. Hemanth and Hazra, Abhishek and Gupta, Krishna and Kumari, Preti and Munusamy, Ambigavathi},
  journal={IEEE Internet of Things Journal}, 
  title={Machine Learning for Industry 5.0: A Survey}, 
  year={2025},
  volume={12},
  number={21},
  pages={44444-44467},
  abstract={Industry 5.0 represents a significant advancement from Industry 4.0, emphasizing improved cooperation between humans and machines, eco-friendly practices, and customized solutions in manufacturing. In contrast to earlier research on Industry 4.0, this survey provides a thorough examination of the function of machine learning (ML) in Industry 5.0 by examining the ways in which various learning paradigms facilitate sustainable production, human–machine cooperation, and customized industrial solutions. We first examine cutting-edge learning approaches, encompassing supervised, unsupervised, semi-supervised, and reinforcement learning methodologies, and their role in advancing Industry 5.0 objectives. Next, we emphasizes the incorporation of ML techniques to improve manufacturing productivity and optimize decision-making processes. Even with advancements, Industry 5.0 may suffer several challenges and limitations, such as intelligent decision-making, security, data privacy, etc. To address the challenges of Industry 5.0, it is crucial to comprehend its protocols, which this survey examines alongside relevant technologies. Therefore, our survey also explores the primary challenges encountered when incorporating ML into Industry 5.0, such as integrating data, ensuring interoperability, and maintaining sustainability. Furthermore, the study elaborates on how these techniques drives substantial progress in various emerging applications by enhancing operational procedures and enabling innovative capabilities. Finally, we discuss potential research routes to overcome these hurdles and achieve the practical implementation of Industry 5.0.},
  keywords={Fifth Industrial Revolution;Fourth Industrial Revolution;Industries;Surveys;Collaboration;Manufacturing;Internet of Things;Protocols;Production;Human-machine systems;Human–machine collaboration;industry 5.0;Internet of Things (IoT);machine learning (ML);sustainable manufacturing},
  doi={10.1109/JIOT.2025.3604413},
  ISSN={2327-4662},
  month={Nov},}@INPROCEEDINGS{11138175,
  author={Leong, Wai Yie},
  booktitle={2025 IEEE Symposium on Industrial Electronics & Applications (ISIEA)}, 
  title={Energy Harvesting Techniques for Self-Powered Industrial IoT Sensor Nodes}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid expansion of Industrial Internet of Things (IIoT) applications in harsh and remote industrial environments has driven the demand for self-powered, maintenance-free sensor nodes. This research explores advanced energy harvesting techniques tailored for selfsustaining Industrial IoT sensor nodes, enabling prolonged operational lifetimes and reduced dependency on wired power or frequent battery replacements. The study focuses on the integration of multi-source energy harvesting-comprising vibration-based piezoelectric harvesters, thermoelectric generators (TEGs) utilizing industrial heat gradients, RF energy scavenging from ambient signals, and indoor photovoltaic (PV) systems-to supply ultra-low power electronics in real-time monitoring systems. An adaptive power management unit (PMU) with maximum power point tracking (MPPT) and energy-aware scheduling algorithms is designed to optimize power utilization across variable load conditions. Performance evaluations in a simulated industrial setting demonstrate that hybrid energy harvesting systems can consistently deliver milliwatt-level power, sufficient to support sensing, processing, and short-range wireless communication (e.g., LoRa, ZigBee). The proposed framework significantly enhances sensor node autonomy, minimizes system downtime, and supports scalable deployment across Industry 4.0 and 5.0 infrastructures. This work provides a robust foundation for designing sustainable, smart manufacturing environments with minimal environmental and operational footprints.},
  keywords={Wireless communication;Photovoltaic systems;Power system management;Hybrid power systems;Real-time systems;Phasor measurement units;Sensors;Energy harvesting;Industrial Internet of Things;Smart manufacturing;Industrial Internet of Things (IIoT);energy harvesting;self-powered;process innovation},
  doi={10.1109/ISIEA65768.2025.11138175},
  ISSN={2472-7660},
  month={July},}@INPROCEEDINGS{11135835,
  author={S.Neha and Jebarani, W.Sylvia Lilly},
  booktitle={2025 4th International Conference on Advances in Computing, Communication, Embedded and Secure Systems (ACCESS)}, 
  title={Secure Integration of IoT and Digital Twin Technology for Sustainable Applications}, 
  year={2025},
  volume={},
  number={},
  pages={544-550},
  abstract={As the demand for Internet of Things (IoT) applications grows, innovative approaches are necessary to optimize effectiveness and sustainability in futuristic applications. This work explores the integration of IoT technology with Digital Twin systems to enhance three critical sectors Smart Farming, Industry 5.0 and Healthcare, specifically in the environment of Neonatal Intensive Care Units (NICUs). In Smart Farming, the Internet of Robotic Things (IoRT) enables real-time monitoring and control of environmental factors, easing precision agriculture through an intuitive DT interface. Industry 5.0 is addressed in the industrial sector by developing accessible platforms that use voice commands, ensuring inclusivity and support for users with disabilities through interactive guidebots. The healthcare application aims to enhance neonatal care through DT technology, allowing real-time monitoring and analysis of newborn health data in NICUs. This innovation also assists middle-class families in rural areas by addressing their financial challenges. This work underscores the transformative possibility of IoT and DT integration in improving these vital sectors functional capabilities and availability.},
  keywords={Smart agriculture;Technological innovation;Rural areas;Medical services;Real-time systems;Digital twins;Internet of Things;Fifth Industrial Revolution;Sustainable development;Robots;Internet of Things (IoT);Digital Twin (DT);Smart Farming;Agriculture 4.0;Industry 5.0;Internet of Robotic Things (IoRT);Healthcare;Neonatal Intensive Care Unit (NICU)},
  doi={10.1109/ACCESS65134.2025.11135835},
  ISSN={},
  month={June},}@INPROCEEDINGS{11130957,
  author={Pratap, Ayush and Sharma, Nidhi and Sardana, Neha and Husing, Pao-Ann},
  booktitle={2025 Seventh International Symposium on Computer, Consumer and Control (IS3C)}, 
  title={Harnessing Large Language Models for Sustainable Materials and Manufacturing: Frameworks, Applications & Innovations}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The integration of Large Language Models (LLMs) into materials and manufacturing offers a transformative approach to achieving ISO 9001 -compliant product quality, aligning with the goals of Industry 5.0. This work proposes MatManQ (Large Language Model in Material and Manufacturing for Product Quality and Control), a framework that leverages LLMs for quality control, assurance, and agentic AIdriven decision-making. A case study on alloy behavior using a self-curated dataset demonstrates the framework's capabilities. Five open-source LLMs-Mixtral-8x7B-327, TinyLlama-1.1B, deepset/roberta, Gemini, and FLAN-T5-were fine-tuned using a Retrieval-Augmented Generation (RAG) approach. Mixtral-8x7B-327 achieved the highest F1 score of $\mathbf{92.1\%}$, attributed to its sparse Mixture-of-Experts architecture, enabling precise and efficient reasoning. The study highlights the potential of LLMs to unify material and manufacturing insights for enhanced product quality, while outlining key challenges and future directions for industrial deployment.},
  keywords={Technological innovation;Large language models;Retrieval augmented generation;Metals;Quality control;Product design;Quality assessment;Fifth Industrial Revolution;Informatics;Smart manufacturing;Large Language Models;Agentic AI;Materials Informatics;Smart manufacturing;Industry 5.0;Trustworthy AI;Quality Control;IC Fabrication},
  doi={10.1109/IS3C65361.2025.11130957},
  ISSN={2770-0496},
  month={June},}@ARTICLE{11143187,
  author={Radwan, Ayman and Ran Chi, Hao and Rocha, Matilde and Sousa, Carolina and Kalinowski, Alessandra and André, Paulo S. and Jordão Alberto, Nélia and Fernando da Costa Antunes, Paulo and de Fátima Domingues, Maria},
  journal={IEEE Internet of Things Journal}, 
  title={Multiservice Noninvasive Solution for Home Monitoring Toward Healthcare Industry 5.0}, 
  year={2025},
  volume={12},
  number={22},
  pages={46193-46203},
  abstract={The transition toward Healthcare Industry 5.0 requires personalized, intelligent, and privacy-preserving solutions. Additionally, the proliferation of home monitoring in the current Healthcare 4.0 framework has been embracing the challenge for invasiveness/privacy issues brought by home monitoring sensors and devices, potentially forsaking the conceived human-centric attributes of Smart Healthcare Industry 5.0. At the intersection of Healthcare Industry 5.0 and secured home monitoring, we propose a multiservice noninvasive solution for distributed home monitoring. A new infrastructure based on fiber bragg grating (FBG) accelerometers is designed, realizing noninvasive/high-privacy distributed home monitoring by solely monitoring floor vibrations. To achieve home monitoring based on the low-dimensional data collected by FBG accelerometers, a multiclass hierarchical support vector machine (H-SVM)-based algorithm is proposed, which achieves simultaneous multiservice classification with FBG noise/interference mitigation. Moreover, an enhanced time difference of arrival (TDoA)-based algorithm (enhanced the TDoA-based algorithm) is proposed for real-time localization of users, with the enhanced accuracy specifically based on FBG-collected data. Experimental results show an overall accuracy of 93.62% for multiservice classification, with a low processing time of 4.1 ms, meanwhile comprising a localization accuracy of 0.715 m (sufficient for home monitoring multiservice delivery).},
  keywords={Monitoring;Fiber gratings;Sensors;Medical services;Accelerometers;Accuracy;Classification algorithms;Signal processing algorithms;Location awareness;Fifth Industrial Revolution;eHealth;home monitoring infrastructure;multiservice interface;sensing and signal processing},
  doi={10.1109/JIOT.2025.3603932},
  ISSN={2327-4662},
  month={Nov},}@INPROCEEDINGS{11130034,
  author={Ruiz-Villafranca, Sergio and García-Sáez, Luis Miguel and Roldán-Gómez, José and Carrillo-Mondéjar, Javier and Gómez, Juan Manuel Castelo and Martínez, Jose Luis},
  booktitle={2025 IEEE International Conference on Cyber Security and Resilience (CSR)}, 
  title={Adaptive Weighted Ensemble Learning for Intrusion Detection in Industrial IoT and Edge Computing}, 
  year={2025},
  volume={},
  number={},
  pages={248-253},
  abstract={The rapid adoption of Industry 4.0/5.0 and Industrial Internet of Things (IIoT) has introduced new cybersecurity vulnerabilities in industrial operations. IIoT devices, despite their widespread deployment, face resource constraints that make traditional security solutions ineffective. While Machine Learning (ML)-based Intrusion Detection Systems (IDS) have emerged as promising solutions, they often face limitations when dealing with industrial-scale data sets and multi-class attack detection scenarios. This paper proposes an enhanced weighted ensemble learning approach that overcomes these limitations while maintaining robust intrusion detection capabilities in IIoT and Edge Computing environments. Our solution features a weighted method that processes data into strategic subsets, creating an optimized ensemble of ML models. The model integrates data collection, preprocessing optimization, model training, and evaluation phases. Our approach, validated on the Edge-IIoTset public dataset, yielded impressive results: the TabPFN model achieved a $\mathbf{9 9. 8 1 \%}$ F1-Score, and all other implemented models demonstrated significant performance improvements over their respective baseline versions.},
  keywords={Training;Adaptation models;Computational modeling;Intrusion detection;Data models;Ensemble learning;Faces;Industrial Internet of Things;Edge computing;Resilience;Industrial Internet of Things;Intrusion Detec-tion System;Machine Learning;Ensemble Learning},
  doi={10.1109/CSR64739.2025.11130034},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11115543,
  author={Mannu and Rawat, Rohit and Nagal, Kritika and Sharma, Rakhee},
  booktitle={2025 12th International Conference on Computing for Sustainable Global Development (INDIACom)}, 
  title={Digital Twins as Enablers of Sustainable and Resilient Industry 5.0 Infrastructure: A Review}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The advent of Industry 5.0 heralds a paradigm shift toward human-centric, sustainable, and resilient industrial systems. Central to this transformation is the integration of Digital Twins (DTs), virtual replicas of physical entities that enable real-time monitoring, predictive analysis, and dynamic decision-making. This paper presents a comprehensive review of the current state and future potential of DTs in facilitating sustainable and resilient infrastructure within Industry 5.0. By synthesizing insights from 60 academic papers, the study explores key applications, including smart manufacturing, urban planning, and supply chain resilience, where DTs optimize resource usage, minimize environmental impact, and enhance operational efficiency. The convergence of enabling technologies such as IoT, AI, blockchain, and edge computing is discussed, highlighting their role in overcoming challenges like data integration, high implementation costs, and cybersecurity risks. Through an in-depth analysis, this paper identifies research gaps and proposes a conceptual framework to advance the adoption of DTs in Industry 5.0, emphasizing their potential to create a sustainable, human-centered industrial future.},
  keywords={Reviews;Urban planning;Supply chains;Real-time systems;Digital twins;Fifth Industrial Revolution;Sustainable development;Smart manufacturing;Edge computing;Resilience;Digital Twins;Industry 5.0;Edge computing;Sustainability;Smart manufacturing},
  doi={10.23919/INDIACom66777.2025.11115543},
  ISSN={},
  month={April},}@INPROCEEDINGS{11115432,
  author={Singh, Sugandha and S., China Ramu and Lalit, Ruchika},
  booktitle={2025 12th International Conference on Computing for Sustainable Global Development (INDIACom)}, 
  title={Evolution from Industry 4.0 to Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Integrating machinery, tools, and vehicles into IoT networks has enhanced the capabilities for developing digital replicas of equipment and products through computer systems powered by artificial intelligence. Today, both manual tasks and decision-making processes are supported by technology. Elements such as cloud services, simulation, the Internet of Things, data analytics, 3-D printing, robotics, augmented reality, and cybersecurity comprise Industry 4.0. Nonetheless, there is a general assumption that as automation grows, so does standardization, reducing human involvement. The pace of technological advancement is remarkably rapid. Consumers increasingly prefer customized products, which highlights the need for human involvement in Industry 4.0, leading to the emergence of Industry 5.0. The primary focus is on reintegrating people into the industrial framework. To enhance production efficiency, both machines and humans will collaborate. This is achieved using collaborative robots, known as cobots and bots. There is a frequent interaction between cognitive computing and human intelligence. Companies must prioritize developing sustainable methods to harness renewable energy and reduce waste.},
  keywords={Industries;Service robots;Human intelligence;Europe;Collaborative robots;Fourth Industrial Revolution;Internet of Things;Fifth Industrial Revolution;Sustainable development;Cognitive systems;Industry 4.0;Cobots;Industry 5.0;Robots;Human Intelligence;Cognitive Computing},
  doi={10.23919/INDIACom66777.2025.11115432},
  ISSN={},
  month={April},}@INPROCEEDINGS{11122832,
  author={Alguirat, Ibtissem and Zouari, Alaeddine and Lehyani, Fatma},
  booktitle={2025 16th International Conference on Logistics and Supply Chain Management (LOGISTIQUA)}, 
  title={Integrating Digital Twins and Lean Management for Sustainable Supply Chains in the Age of Industry 5.0: A Conceptual Framework}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={A major shift in manufacturing is marked by industry 5.0 focusing on people, sustainability and resilience. In this context, integrating digital twins with Lean management represents an strategic opportunity to optimize supply chains while meeting sustainability challenges. This paper proposes a theoretical model to integrate these technologies into Lean management in order to design a sustainable supply chain adapted to Industry 5.0. Through a revue of recent literature, the research develop develops a four-phase framework - physical system modeling, data integration, analysis/optimization, and implementation/monitoring - to link digital capabilities with lean principles. The results show that this integration improves operational efficiency, reduces environmental impact and promotes collaboration between humans and machines. This research makes a contribution to academic debate and practical applications providing organizations with roadmaps for moving towards Industry 5.0 while addressing sustainability issues.},
  keywords={Waste reduction;Human-machine systems;Supply chains;Collaboration;Predictive models;Real-time systems;Digital twins;Fifth Industrial Revolution;Sustainable development;Resilience;Industry 5.0;digital twins;Lean management;sustainable supply chains;human-machine collaboration},
  doi={10.1109/LOGISTIQUA66323.2025.11122832},
  ISSN={2166-7373},
  month={May},}@INPROCEEDINGS{11122712,
  author={HAFIDI, Nouhayla and RAMADANY, Mohamed and HAKMAOUI, Ilhame and BARKANY, Abdellah EL},
  booktitle={2025 16th International Conference on Logistics and Supply Chain Management (LOGISTIQUA)}, 
  title={Smart Supply Chain: Integrating Production and Maintenance for Agile and Resilient Manufacturing in Industry 4.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This article proposes a conceptual model to improve coordination between production and maintenance within the framework of Industry 4.0, in order to enhance the resilience of supply chains. Its four components are: real-time data collection, intelligent coordination, system interconnectivity and supply chain adaptability. By integrating technologies such as IoT, AI, digital twins and blockchain, it is possible to anticipate breakdowns, optimize decision-making and limit interruptions. This model offers high added value despite some implementation challenges, and paves the way for future research into its validation and evolution towards Industry 5.0.},
  keywords={Adaptation models;Supply chain management;Supply chains;Production;Real-time systems;Maintenance;Fourth Industrial Revolution;Artificial intelligence;Fifth Industrial Revolution;Resilience;production;maintenance;joint management;Smart supply chain;Industry 4.0;artificial intelligence},
  doi={10.1109/LOGISTIQUA66323.2025.11122712},
  ISSN={2166-7373},
  month={May},}@INPROCEEDINGS{11122861,
  author={Kamal, Najwa and Dachry, Wafaa and Gziri, Hassan},
  booktitle={2025 16th International Conference on Logistics and Supply Chain Management (LOGISTIQUA)}, 
  title={From Industry 4.0 to Industry 5.0: Bibliometric Analysis, Challenges and Enablers to Strengthen the Resilience of Smart Supply Chain}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Industry 5.0, the upcoming industrial revolution, is ushering in an innovative era of intelligent manufacturing systems, primarily characterized by the emergence of new paradigms, including human-centered approaches, resilience, and sustainability. Unlike its predecessor, the concept of the Fifth Industrial Revolution is still relatively underexplored in the literature. This research examines this novel paradigm through a literature analysis to identify the main enablers and challenges encountered in its implementation in intelligent manufacturing systems. We also conducted a bibliometric method to determine primary research trends and references that explore the digital transformation from Industry 4.0 towards Industry 5.0. The findings demonstrate that the interaction between Industry 5.0 and other principles, such as resilience, sustainability, and human-centricity, has gained more interest among researchers in the post-COVID period.},
  keywords={Supply chain management;Bibliometrics;Supply chains;Market research;Fourth Industrial Revolution;Fifth Industrial Revolution;Sustainable development;Intelligent manufacturing systems;Resilience;Smart manufacturing;Digital transition;Digitalization;Industry 4.0;Smart manufacturing system;Industry 5.0;Challenges;Enablers},
  doi={10.1109/LOGISTIQUA66323.2025.11122861},
  ISSN={2166-7373},
  month={May},}@INPROCEEDINGS{11122823,
  author={Elhidaoui, Sana and Hakmaoui, Ilhame and Elhanna, Rajaa},
  booktitle={2025 16th International Conference on Logistics and Supply Chain Management (LOGISTIQUA)}, 
  title={Outlining Expectations for Integrating Industry 5.0 Principles into Supply Chain Resilience Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This article explores the integration of Industry 5.0 principles into supply chain resilience strategies, emphasizing the synergy between advanced technologies—such as artificial intelligence (AI), the Internet of Things (IoT), blockchain, and collaborative robotics—and human-centric, sustainable approaches. Unlike Industry 4.0, which focused on automation and digitalization, Industry 5.0 introduces adaptability, ethical practices, and collaboration as core elements for managing disruptions. The study proposes a strategic framework built on three pillars: human-machine collaboration, sustainability, and predictive resilience, supported by technologies like digital twins, IoT, and blockchain. Real-world case studies in the textile and food industries demonstrate measurable improvements in agility, sustainability, and operational continuity. Despite challenges such as high implementation costs, resistance to change, and the need for specialized skills, Industry 5.0 offers a transformative pathway to building robust, adaptive, and socially responsible supply chains. The article concludes with future research directions, including cross-industry comparisons, regional adaptations, and longitudinal studies to further explore the long-term sustainability of Industry 5.0 integration.},
  keywords={Supply chain management;Supply chains;Collaboration;Blockchains;Internet of Things;Fifth Industrial Revolution;Sustainable development;Artificial intelligence;Resilience;Textiles;Industry5.0;Supply Chain Resilience;Sustainability;Case Studies;fsQCA},
  doi={10.1109/LOGISTIQUA66323.2025.11122823},
  ISSN={2166-7373},
  month={May},}@INPROCEEDINGS{11122675,
  author={Garti, Molk Oukili and Arif, Jabir and Jawab, Fouad and Jaouhari, Asmae El},
  booktitle={2025 16th International Conference on Logistics and Supply Chain Management (LOGISTIQUA)}, 
  title={Industry 5.0 and Sustainable Supply Chains: A Comparative Literature Review on Key Factors and Future Research Directions}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Incorporating Industry 5.0 into supply chain management systems presents transformative potential for advancing sustainability, however its implications remain underexplored in academic discourse. This study focuses on this gap through a systematic comparative literature review, analyzing six conceptual and theoretical frameworks to determine the key elements influencing sustainable supply chains in the context of Industry 5.0. By synthesizing current research, the paper highlights seven interconnected determinants: Industry 5.0 technologies, circular logistics, logistics innovation, sustainable supply chain practices, corporate managerial strategies, intellectual capital, and training. These factors collectively highlight the role of human-centric, eco-efficient, and resilient systems in achieving sustainability. The review reveals that while Industry 5.0 technologies enable resource optimization and real-time data transparency, their synergy with strategic governance and circular economy principles remains pivotal for long-term sustainability. Further, the study identifies an urgent need for empirical validation of these frameworks, especially in emerging economies and cross-industry contexts. By mapping these insights, the paper proposes future research directions, highlighting the urgency of multi-disciplinary perspectives to address socio-technical challenges, workforce upskilling, and regulatory alignment. This research not only consolidates foundational knowledge but also establishes a roadmap for scholars and managers to put sustainability into practice in supply networks powered by Industry 5.0.},
  keywords={Training;Technological innovation;Supply chain management;Systematics;Supply chains;Real-time systems;Sustainable development;Fifth Industrial Revolution;Systematic literature review;Resilience;supply chains;sustain ability;industry 5.0;sustainability factors;literature review},
  doi={10.1109/LOGISTIQUA66323.2025.11122675},
  ISSN={2166-7373},
  month={May},}@INPROCEEDINGS{11122713,
  author={Zaid, Oumaima and Arif, Jabir and Jawab, Fouad},
  booktitle={2025 16th International Conference on Logistics and Supply Chain Management (LOGISTIQUA)}, 
  title={Advanced Digital Technology's Impact, Highlights and Challenges in Supply Chain 5.0 Efficiency}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The Intelligent Supply Chain (ISC) seeks to enhance the overall understanding of SC dynamics. The philosophy behind Industry 5.0 aims to advance the most recent generation of industry. This concept of an “Intelligent Supply Chain,” also referred to as SC 5.0, is composed of three interconnected elements. The aim of this study is to explore the intelligent supply chain in depth. To align with this research initiative, it is essential to analyze the advantages and disadvantages of modern digital technologies employed in SC management within the context of Industry 5.0. This connection highlights the relationship between ISC and Industry 5.0. The study addresses both the potential and the constraints of ISC for thorough research. Consequently, a theoretical foundation has been established. Ultimately, the theoretical framework illustrates the relationship between ISC and Industry 5.0.},
  keywords={Industries;Technological innovation;Costs;Supply chain management;Supply and demand;Supply chains;Organizations;Fifth Industrial Revolution;Sustainable development;System analysis and design;Supply Chain 5.0;Intelligent supply chain;SC advanced digital technology},
  doi={10.1109/LOGISTIQUA66323.2025.11122713},
  ISSN={2166-7373},
  month={May},}@ARTICLE{11129656,
  author={Campagna, Giulio and Lagomarsino, Marta and Lorenzini, Marta and Chrysostomou, Dimitrios and Rehm, Matthias and Ajoudani, Arash},
  journal={IEEE Robotics and Automation Letters}, 
  title={Estimating Trust in Human-Robot Collaboration Through Behavioral Indicators and Explainability}, 
  year={2025},
  volume={10},
  number={10},
  pages={10218-10225},
  abstract={Industry 5.0 focuses on human-centric collaboration between humans and robots, prioritizing safety, comfort, and trust. This study introduces a data-driven framework to assess trust using behavioral indicators. The framework employs a Preference-Based Optimization algorithm to generate trust-enhancing trajectories based on operator feedback. This feedback serves as ground truth for training machine learning models to predict trust levels from behavioral indicators. The framework was tested in a chemical industry scenario where a robot assisted a human operator in mixing chemicals. Machine learning models classified trust with over 80% accuracy, with the Voting Classifier achieving 84.07% accuracy and an AUC-ROC score of 0.90. These findings underscore the effectiveness of data-driven methods in assessing trust within human-robot collaboration, emphasizing the valuable role behavioral indicators play in predicting the dynamics of human trust.},
  keywords={Robots;Robot kinematics;Service robots;Machine learning;End effectors;Human-robot interaction;Collaboration;Behavioral sciences;Adaptation models;Brain modeling;Human factors and human-in-the-loop;acceptability and trust;human-robot collaboration},
  doi={10.1109/LRA.2025.3600170},
  ISSN={2377-3766},
  month={Oct},}@INPROCEEDINGS{11124968,
  author={Colombathanthri, Anuradha and Jomaa, Walid and Chinniah, Yuvin},
  booktitle={2025 IEEE International Conference on Advanced Robotics and its Social Impacts (ARSO)}, 
  title={Towards Safe Human-Robot Empathic Cooperation Using a Cyber-Physical Manufacturing System}, 
  year={2025},
  volume={},
  number={},
  pages={341-348},
  abstract={With growing interest in smart manufacturing systems around the Industry 5.0 concept, the manufacturing industry is continuously seeking multi-parameter balancing between safety and productivity along with fewer trade-offs. These practices focus on keeping the human-in-loop physically and mentally secure, allowing an uninterrupted flow of human creativity and analytical reasoning into the system. In line with this approach, a novel controller for a Cyber-Physical System (CPS) has been developed. This controller is able to recognize the physiological requirement of the human operator and activates a mobile cobot to take over tasks until the operator goes through a scheduled break time. The mobile cobot is capable of collision avoidance path planning in real-time, which improves safe navigation control in dynamic environments. This entire system prioritizes human factors while maintaining productivity.},
  keywords={Productivity;Navigation;Decision making;Collaborative robots;Human factors;Real-time systems;Safety;Fifth Industrial Revolution;Monitoring;Smart manufacturing;Robots in the Smart Factory;The role of AI in the implementation of cognitive robots;Robotics for manufacturing},
  doi={10.1109/ARSO64737.2025.11124968},
  ISSN={2162-7576},
  month={July},}@INPROCEEDINGS{11122082,
  author={Paolini, Guerino Gianfranco and Nisi, Matteo and Casaccia, Sara and Amicucci, Federica and Cristalli, Cristina and Paone, Nicola},
  booktitle={2025 IEEE International Workshop on Metrology for Industry 4.0 & IoT (MetroInd4.0 & IoT)}, 
  title={Repeatability and Reproducibility Method of Hand-handle Laser Triangulation Profilometer}, 
  year={2025},
  volume={},
  number={},
  pages={40-44},
  abstract={This paper explores the use of a hand-held laser triangulation-based measurement system for gap and flush measurements in the automotive industry, focusing on operator variability. In modern manufacturing, especially with Industry 5.0, precise measurements are essential for quality and efficiency. While laser triangulation technology offers high accuracy, when the device is portable human factors influence performance. The study evaluates the U-Sense.IT srl G3F laser profilometer in two modes: manual and with a magnetic holder. Using Measurement System Analysis (MSA), the research assesses repeatability (Equipment Variation, EV) and reproducibility (Appraiser Variation, AV), determining the Gauge Repeatability and Reproducibility (GRR). Data were collected from three operators measuring three cars, with repeated measurements for both gap and flush. Results show that the holder technique has lower variability in both repeatability and reproducibility compared to the manual method. The GRR for the holder was $2,22 \%$ for flush and $2,32 \%$ for gap, while the manual technique showed $\mathbf{3, 1 3 \%}$ for flush and 3,66% for gap. Both systems had GRR values below the acceptable 10% threshold, with the magnetic holder system demonstrating greater precision due to better sensor positioning. This research highlights the effectiveness of support systems in reducing human error, even if it reduces flexibility, showing that while both methods are valid, the magnetic holder system aligns better with Industry $\mathbf{5. 0}$ principles by improving collaboration between humans and intelligent systems.},
  keywords={Industries;Performance evaluation;Measurement by laser beam;Manuals;Laser modes;Reproducibility of results;Manufacturing;Laser applications;Intelligent systems;System analysis and design;laser profilometer;gap and flush measurements;measurement system analysis},
  doi={10.1109/MetroInd4.0IoT66048.2025.11122082},
  ISSN={2837-0872},
  month={July},}@INPROCEEDINGS{11122046,
  author={Lone, Aaqib and Bujari, Armir},
  booktitle={2025 IEEE International Workshop on Metrology for Industry 4.0 & IoT (MetroInd4.0 & IoT)}, 
  title={Improving the Robustness of Data-Driven Pipelines via the Adaptive Neuro-Fuzzy Inference System: An Industrial Use Case}, 
  year={2025},
  volume={},
  number={},
  pages={456-461},
  abstract={Modern manufacturing is faced with challenges such as rapidly changing operations, real-time decision making, and uncertain data. As a result, the demand for accurate predictive analytics is becoming increasingly critical. This study presents an integrated Adaptive Neuro-Fuzzy Inference System (ANFIS), a data-driven pipeline that combines fuzzy rule systems with machine learning to improve defect prediction, enabling informed decision-making even in the presence of uncertainty and noisy data. The approach combines fuzzy logic to manage imprecise data, while machine learning enables adaptive learning from data. Applied to a real-world manufacturing case study, the proposed ANFIS model achieved an accuracy of $\mathbf{9 2 \%}$, precision of $\mathbf{8 7 \%}$, and F1-score of 84% in defect prediction, outperforming standalone fuzzy systems ($69 \%, 55 \%$, and 55%) and artificial neural networks ($\mathbf{8 8 \%, ~ 8 2 \%}$, and 79%). This approach contributes with an additional viable technique to an automated data-pipeline, proven to improve model accuracy and adaptability under certain criteria, supporting sustainable and intelligent decision making in line with Industry $\mathbf{5. 0}$ principles.},
  keywords={Fuzzy logic;Adaptation models;Adaptive systems;Accuracy;Uncertainty;Decision making;Pipelines;Machine learning;Artificial neural networks;Manufacturing;Fuzzy Logic;Supervised Learning;Artificial Neural Networks;Adaptive Neuro-Fuzzy Inference System;Adam optimizer},
  doi={10.1109/MetroInd4.0IoT66048.2025.11122046},
  ISSN={2837-0872},
  month={July},}@INPROCEEDINGS{11118594,
  author={Steinmetz, Charles and Rettberg, Achim and Pereira, Carlos Eduardo},
  booktitle={2025 IEEE Latin Conference on IoT (LCIoT)}, 
  title={An IoT-based environment for modeling and deploying semantic Digital Twins}, 
  year={2025},
  volume={},
  number={},
  pages={250-253},
  abstract={The Digital Twin (DT) has emerged as a crucial component for advancing Industry 4.0, Industry 5.0, and the Metaverse, attracting substantial interest from both academia and industry. By digitalizing real-world entities, DTs enable capabilities such as monitoring, simulation, prediction, and optimization. However, accurately modeling real-world systems remains challenging due to the diversity of asset representations and the differing perspectives of stakeholders. This paper presents an integrated framework with a unified language to align these perspectives across various system levels, from individual devices to complex workflows. It introduces a methodology for semantic DT models and outlines a 4-layer architecture to clearly define system responsibilities.},
  keywords={Industries;Metaverse;Scalability;Semantics;Digital twins;Fourth Industrial Revolution;Stakeholders;Standards;Optimization;Monitoring;digital twin;model;semantic;iot;industry4},
  doi={10.1109/LCIoT64881.2025.11118594},
  ISSN={},
  month={April},}@INPROCEEDINGS{11114130,
  author={Skakun, Marko and Vujičić, Vojislav and Todić, Veljko and Gordić, Zaviša and Knežević, Nikola and Jovanović, Kosta},
  booktitle={2025 12th International Conference on Electrical, Electronic and Computing Engineering (IcETRAN)}, 
  title={Advancing Human-Robot Collaboration Through Extended Reality - Assembly Use Case}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The evolution of Industry 5.0 introduces humancentric automation by integrating advanced technologies with user configurability and adaptability. In this context, the XR4HumanSERVE 5.0 was presented with a simplified neuroergonomic workstation that reduces the complex architecture of the previously developed platforms into a unified system combining an XR headset (HTC XR Elite) and a collaborative robot. The proposed solution replaces traditional multi-device setups (including PCs, EEG systems, external screens, and gesture sensors) with a single XR-based interface, saving essential functionalities such as task guidance, human-robot interaction (HRI), and mental focus assessment (MFA). The methodology involves the functional decomposition of traditional solution components and their reintegration into an immersive XR environment using Unity for virtual reality design and ROS for collaborative robot control. After virtual prototyping and validation through simulation, the system was physically implemented and tested in a laboratory setting using a Franka Emika Panda robot. The main contribution of this paper is the first functional prototype of a VR and cobot-supported neuroergonomic workstation. This paper demonstrates lightweight, human-centered and scalable industrial solutions aligned with the principles of Industry 5.0.},
  keywords={Headphones;Service robots;Extended reality;Human-robot interaction;Collaborative robots;Electroencephalography;Workstations;Sensors;Fifth Industrial Revolution;Assembly;Industry 5.0;Extended Reality (XR);collaborative robotics;human-centered automation},
  doi={10.1109/IcETRAN66854.2025.11114130},
  ISSN={},
  month={June},}@INPROCEEDINGS{11106797,
  author={Mulongo, Ndala Yves},
  booktitle={2025 International Conference on Smart Applications, Communications and Networking (SmartNets)}, 
  title={Societal Dimension Hurdle to the Adoption of Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This is the first of its kinds owing to the fact that it aimed at identifying key social dimension hurdles to the adoption of the new concept industry 5.0. To date, organisations face numerous challenges as globalisation reduces profit margins, while also being compelled to deliver premium goods and services. Streamlining routine chores guarantees that processes are executed promptly, without overlooking the deadline. Automation primarily assumes control of all labour-intensive jobs, enabling an organisation to significantly accelerate production with minimal mistakes. Improved efficacy leads to higher capacity, facilitating the scaling of operations as the business expands. Further, Industrial revolutions have consistently induced significant transformations in human existence. The Fourth Industrial Revolution has transformed manufacturing output via digitalisation and significantly affected service processes as well. Nonetheless, the Industry 4.0 technologies utilised within the framework of the fourth industrial revolution facilitate the attainment of new objectives that were not explicitly delineated in this paradigm: sustainability, resilience, and human-centricity. This article addresses the technology available for achieving sustainability, robustness, and human-centricity, as well as the primary research directions for developing a sustainable production and service environment. The research findings of this study identified Eight crucial societal challenges to the adoption of industry 5.0 among these the most major concern were Technology acceptance and trust as well as youth unemployment.},
  keywords={Technological innovation;Globalization;Production;Robustness;Fourth Industrial Revolution;Fifth Industrial Revolution;Sustainable development;Unemployment;Faces;Resilience;Industry 5.0;Manufacturing Industry},
  doi={10.1109/SmartNets65254.2025.11106797},
  ISSN={2837-4940},
  month={July},}@INPROCEEDINGS{11106893,
  author={Mulongo, Ndala Yves},
  booktitle={2025 International Conference on Smart Applications, Communications and Networking (SmartNets)}, 
  title={The Operationalisation of Determinants of Industry 5.0 for Smart Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Manufacturing sectors worldwide are poised for significant prospects that offer remarkable growth and change using intelligent goods and innovative manufacturing, facilitated by advanced technology innovation. Industrial industries market their products through intricate procedures including research, design, development, manufacture, and service. Each product production sector has distinct issues that cannot be addressed by a universal solution applicable to all needs. Industrial organisations consistently promote the advancement of science and technology and employ many strategies to innovate their operations, continually striving to enhance and differentiate themselves from rivals. Digitalisation has introduced a new paradigm in production, transforming facilities to be more contemporary and advanced. In response, multinational organisations have implemented Industry 5.0, seeking to harmonise technical progress with human well-being. To advance towards this vision, comprehending the present human-technology connection is crucial. Hence, this paper used a the cohesive fuzzy DEMATEL model with hesitant data to critically identified the key parameters behind the transitioning from manufacturing 4.0 to manufacturing 5.0. The research findings of this study demonstrate that Customization; Scalability; Deployment Speed; Security and Compliance; Maintenance and Upgrades; Innovation Potential; Customer Engagement; Flexibility and Adaptability; Data Analytics and Insight; Disaster Recovery and Business Continuity were the key determinants of industry 5.0 digitalisation success in the manufacturing sector.},
  keywords={Technological innovation;Data analysis;Scalability;Disasters;Data models;Manufacturing;Maintenance;Security;Business continuity;Fifth Industrial Revolution;Industry 5.0;Manufacturing industry;FuzzyDematel Approach},
  doi={10.1109/SmartNets65254.2025.11106893},
  ISSN={2837-4940},
  month={July},}@INPROCEEDINGS{11106863,
  author={Mulongo, Ndala Yves},
  booktitle={2025 International Conference on Smart Applications, Communications and Networking (SmartNets)}, 
  title={How South Africa as Emerging Economy are Leveraging Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This study aimed at measuring the impact of industry 5.0 on South African economy. This is the first of kinds due to the fact that it focused on analysing how South Africa as an emerging economy are leveraging the advent of industry 5.0. to date, Manufacturing is the largest contributor to the South African economy, generating employment and prosperity throughout the continent. From 2014 to 2024, the industrial sector consistently represented approximately 27% of South Africa's GDP, with manufacturing contributing roughly 11% of value to the economy. The South African industry is robust, yet it encounters persistent obstacles. It is intensely competitive, yet functions within an increasingly intricate globalised economy. It is a robust exporter, however it is vulnerable to a rapidly evolving geopolitical environment. It is efficient and economical, however susceptible to disruptions in extended value chains. For the sector to sustain profitability in South Africa, it must perpetually adapt to address these evolving issues. This continuous adaptation is achievable just through persistent innovation. Through innovation, South African industry may enhance its efficiency throughout various segments of the value chain, augment the adaptability of its production processes to meet the rapidly evolving expectations of global consumers, and maintain its status as a global benchmark for quality. Innovation will largely stem from the application of increasingly sophisticated digital technologies.},
  keywords={Manufacturing industries;Technological innovation;Renewable energy sources;Service robots;Manufacturing;Quality assessment;Fifth Industrial Revolution;Standards;Business;Resilience;Industry 5.0;Manufacturing Industry;South Africa},
  doi={10.1109/SmartNets65254.2025.11106863},
  ISSN={2837-4940},
  month={July},}@ARTICLE{11124581,
  author={Li, Xuguang and Dong, Zheng and Zhang, Haobin},
  journal={IEEE Signal Processing Letters}, 
  title={Time Series Anomaly Detection for Natural Gas Pipeline Leakage}, 
  year={2025},
  volume={32},
  number={},
  pages={3330-3334},
  abstract={Natural gas pipelines play a crucial role in energy transportation, so accurate detection of leak anomalies is vital for safety. Supervisory Control and Data Acquisition (SCADA) systems are widely utilized in the pipeline industry and store extensive historical data with time series characteristics. In this paper, we present a masked Transformer detection model to address the issue of sparse leak labels in SCADA systems and overcome the limitations of neural networks in modeling long-time series. The model incorporates an encoder-only Transformer with a masked mechanism. We validated its effectiveness using real natural gas pipeline data, and the results showed that it can accurately identify pipeline leak anomalies. In particular, compared to other models, the masked Transformer model has shown an improvement in accuracy, recall, precision, and F1 score by 1.4%, 2.5%, 0.3%, and 1.4%, respectively, in real pipeline scenarios. Overall, the masked Transformer model excels in detecting anomalies in natural gas pipeline leakage.},
  keywords={Pipelines;Transformers;Natural gas;Time series analysis;Data models;SCADA systems;Predictive models;Computational modeling;Self-supervised learning;Monitoring;Natural gas pipeline;leakage anomaly detection;time series;masked transformer},
  doi={10.1109/LSP.2025.3599012},
  ISSN={1558-2361},
  month={},}@ARTICLE{11125895,
  author={Zeydan, Engin and Mangues, Josep and Arslan, Suayb S. and Turk, Yekta and Hewa, Tharaka and Liyanage, Madhusanka and O'Mahony, Aidan},
  journal={IEEE Open Journal of the Computer Society}, 
  title={Reconfigurable Production Lines for Industrial 5.0 Automation: An Intent-Based Approach}, 
  year={2025},
  volume={6},
  number={},
  pages={1341-1352},
  abstract={Reconfigurable production lines empowered by an intent-based approach and next-generation wireless networks can be a cornerstone of the transformative Industry 5.0 paradigm. This article presents a novel framework for developing an intent-based reconfigurable production line enriched with blockchain technology. By using blockchain as an enabler for decentralization, the proposed approach aims to integrate security and efficiency into the fabric of industrial automation. Experimental evaluations confirm the effectiveness of the proposed approach (in terms of scalability and latency) and highlight its strengths and potential for improvement. To be more precise, the blockchain systems are 85 to 95 seconds faster than the cloud service for 50 simultaneous transactions and offer around 69% lower latency at maximum utilization with 10 000 events. Important challenges such as integration into the existing infrastructure, security, standardization and energy efficiency are highlighted and recommendations for overcoming these hurdles are also given at the end of the article.},
  keywords={Production;Blockchains;Fifth Industrial Revolution;Smart contracts;Manufacturing;Security;Real-time systems;Cloud computing;Manufacturing systems;Fourth Industrial Revolution;Architecture;industrial automation;intent-based networks;6G;production lines;blockchain;smart contracts},
  doi={10.1109/OJCS.2025.3599219},
  ISSN={2644-1268},
  month={},}@ARTICLE{11124284,
  author={Ahmed, Farooq and Zhou, Teng and Bilal, Hazrat and Ul Islam, Faiz and Ullah, Rizwan and Vasilakos, Athanasios V.},
  journal={IEEE Internet of Things Journal}, 
  title={Enhancing Healthcare Data Integrity and Access Control Using Blockchain and Industry 5.0}, 
  year={2025},
  volume={12},
  number={20},
  pages={43630-43643},
  abstract={The convergence of blockchain with Industry 5.0 technologies presents significant opportunities for healthcare data management; however, current systems face challenges related to scalability, privacy, and energy efficiency. This article introduces an innovative framework that leverages ciphertext-policy attribute-based encryption (CP-ABE), Ethereum smart contracts, and decentralized IPFS storage to address these challenges. The framework presents three main innovations: 1) a human-centric authentication system that ensures security without sacrificing cryptographic integrity; 2) post-quantum Kyber-786 algorithms paired with CP-ABE, which minimizes computational overhead by 27% while facilitating 32 ms key generation; and 3) an energy-efficient Proof of Stake (PoS) consensus mechanism that reduces energy consumption by 98% (0.05 kW/transaction) compared to traditional blockchain systems. Thorough testing demonstrates 99.5% resistance to man-in-the-middle attacks, a throughput of 15.6 MB/min at scale, and an emergency access latency of under 120 ms, which is essential for practical healthcare applications. By consolidating decentralized pseudo-identities for patient anonymity, secure audit logs, and GDPR/HIPAA-compliant data governance, this research establishes a new standard for secure, sustainable, and patient-focused health data ecosystems in the Industry 5.0 landscape.},
  keywords={Medical services;Security;Blockchains;Fifth Industrial Revolution;Access control;Authentication;Smart contracts;Real-time systems;Internet of Things;Encryption;Access control;blockchain;industry 5.0;Internet of Things (IoT);privacy;security},
  doi={10.1109/JIOT.2025.3598320},
  ISSN={2327-4662},
  month={Oct},}@INPROCEEDINGS{11106593,
  author={Villalonga, Alberto and Cruz, Yarens and Haber, Rodolfo and Bastida, Leire and Sillaurren, Sara and Castano, Fernando},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Edge-Computing Framework for Human-Robot Collaboration in Industry 5.0: Enhancing Operator Well-Being and Efficiency in Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={Industry 5.0 emphasizes human-centric automation, integrating advanced robotics and artificial intelligence to enhance operator well-being and manufacturing efficiency. This paper presents an edge-computing framework for human-robot collaboration, incorporating real-time physiological monitoring, machine learning-based fatigue prediction, and adaptive decision-making. The proposed system consists of two core modules: a fatigue monitor that continuously evaluates operator conditions and a decision-making system that dynamically adjusts task distribution. The framework optimises workload balancing by leveraging 10T-enabled sensors, artificial vision, and fuzzy logic-based decision-making while ensuring safety and productivity. Experimental validation in an industrial setting demonstrates significant improvements in reducing operator fatigue and enhancing production efficiency. Future research will focus on refining fatigue prediction models and expanding the system's applicability across various industrial domains.},
  keywords={Service robots;Decision making;Human-robot interaction;Fatigue;Real-time systems;Manufacturing;Sensors;Safety;Fifth Industrial Revolution;Monitoring;Industry 5.0;Human-Robot Collaboration;Edge Computing;Fatigue Monitoring;Adaptive Automation},
  doi={10.1109/ICE/ITMC65658.2025.11106593},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106630,
  author={Tzionis, Grigorios and Kougka, Georgia and Gialampoukidis, Ilias and Vrochidis, Stefanos and Kompatsiaris, Ioannis and Vlachopoulou, Maro and Afolaranmi, Samuel Olaiya and Martinez Lastra, Jose Luis},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={A Review on Digital Product Passports as Drivers of Digital Transformation in Industry}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={Digital Product Passports (DPPs) are emerging as pivotal tools driving the digital transformation across industries by providing standardized, interoperable, and detailed digital records of products. This enhances tracking, transparency, and lifecycle management, fostering sustainable and efficient digital ecosystems. While the potential of DPPs is recognized, existing reviews often lack a specific focus on their role as active enablers of industrial digital transformation. This paper addresses that gap by presenting a comprehensive review of the state-of-the-art in DPP research and applications, critically examining how they facilitate this transformation. We outline the methodology used to gather the literature, propose a taxonomy of DPP types based on technology and function (illustrated visually and summarized in a comparative table), present an evaluation framework with relevant metrics, and analyze their implications across various industrial sectors. Key contributions include this structured taxonomy, the evaluation framework, and a critical discussion of challenges (e.g., interoperability, standardization, readiness gaps) and opportunities, offering recommendations for leveraging DPPs effectively.},
  keywords={Industries;Measurement;Technological innovation;Circular economy;Taxonomy;Ecosystems;Sustainable development;Usability;Interoperability;Systematic literature review;Digital Product Passport;Digital Transformation;Industry 4.0;Industry 5.0;Circular Economy;Sustainability;Literature Review},
  doi={10.1109/ICE/ITMC65658.2025.11106630},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106673,
  author={Petropoulos, Alexandros and Apostolou, Georgia and Tsoumplekas, Georgios and Tziolas, George and Ntampakis, Nikolaos and Siniosoglou, Ilias and Argyriou, Vasileios and Sarigiannidis, Panagiotis and Gialampoukidis, Ilias and Vrochidis, Stefanos},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Enhancing Safety in Industry 5.0: Human-Computer Collaboration Benefits through a Dataset of Protective Equipment Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={This paper presents the development and implementation of a comprehensive dataset designed to enhance workplace safety in industrial environments through advanced computer vision technologies. The dataset focuses on the detection of essential protective equipment, such as helmets and vests, worn by workers in various industrial settings. Utilizing this dataset, a YOLOv8-based computer vision model is trained to achieve 82.1% mAP accuracy (70.5% for helmets, 93.7% for vests) in real-time identification of whether workers are equipped with the appropriate safety gear, demonstrating high reliability for safety compliance monitoring. This initiative is part of the European Research Project TALON, which aims to demonstrate the potential of collaborative efforts between humans and machines in achieving higher safety standards, through its 4th pilot. TALON system will enable automated, flexible, adaptable, programmable, explainable and energy-efficient edge Artificial Intelligence (AI) networking by developing complementary technologies such as AI orchestrator, blockchain, edge networking and digital twins (DTs) in an integrated and innovative way. The dataset, along with the developed predictive model, offers a significant contribution to the field of safety, showcasing how technological advancements can be leveraged to safeguard human lives in the workplace.},
  keywords={Computer vision;Technological innovation;Employment;Collaboration;Predictive models;Helmets;Real-time systems;Safety;Reliability;Standards;Terms-protective equipment;safety;computer vision;industry;human-robot collaboration;deep learning;CNN},
  doi={10.1109/ICE/ITMC65658.2025.11106673},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106606,
  author={Comella, Sergio and Milazzo, Delia and Cipolla, Salvatore and Aouedi, Ons and Bonura, Susanna},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={New Edge-to-Cloud Orchestrator for Intelligent Task Allocation and Efficiency Optimisation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Modern industrial systems face several challenges in resource allocation, operational efficiency, and scalability, driven by the need for real-time data processing, and sustainable automation. The integration of advanced technologies, including edge-to-cloud (E2C) Artificial Intelligence (AI), digital twins, and blockchain, has created opportunities for innovation while increasing the complexity of orchestration and task distribution. This paper presents a novel E2C orchestrator that optimises task distribution across hybrid infrastructures, addressing the limitations of existing solutions such as static resource allocation and energy inefficiency. By leveraging AI-driven dynamic policies, the orchestrator increases efficiency, reduces latency and ensures robust data protection, in line with Industry 5.0s paradigm which emphasises human-centric and sustainable industrial ecosystems. Key outcomes include improved scalability, adaptability to dynamic workloads, and integration of advanced technologies for real-time responsiveness and operational visibility.},
  keywords={Technological innovation;Scalability;Real-time systems;Energy efficiency;Complexity theory;Resource management;Artificial intelligence;Sustainable development;Fifth Industrial Revolution;Optimization;E2C Orchestrator;AI;Industry 5.0;scalability;resources optimisation;energy efficiency;sustainability},
  doi={10.1109/ICE/ITMC65658.2025.11106606},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106653,
  author={Matteri, Davide and Masiero, Sara and Dell'Oca, Samuele and Montini, Elias and Cutrona, Vincenzo and Canetta, Luca},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={A Protocol for Human-Centric Adaptive User Interfaces: From Static Interaction to Behaviour-Driven Adaptation}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={Manufacturing production systems widely employ Human Machine Interfaces to guide workers and enable interactions with machines. The design of such interfaces often prioritize technological capabilities over User Experience design principles, resulting in standardized interfaces that do not adequately address user needs and provide them with excessive information. Adaptive User Interfaces present significant opportunities for enhancing traditional interfaces and improving the interactions with automation systems. In this work, a novel protocol is proposed to guide the design of adaptive, user-centered interfaces tailored to manufacturing contexts, shifting traditional static User Interfaces to advanced interfaces capable of adapting to users' behavior and characteristics. The protocol was applied in a controlled laboratory environment simulating an industrial assembly task, and 40 participants completed assembly tasks with the support of static and adaptive interfaces. The results demonstrated the protocol's effectiveness, highlighting that adaptive interfaces significantly reduce assembly time variability and errors, while enhancing user satisfaction by personalizing interactions based on user behavior.},
  keywords={Productivity;Technological innovation;Protocols;Adaptive systems;Target tracking;Refining;User centered design;User experience;Usability;Assembly;Adaptive User Interface;Industry 5.0;Human-Machine Interaction;User Experience;Human-Centered Design},
  doi={10.1109/ICE/ITMC65658.2025.11106653},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106634,
  author={Zhou, Tianyu and Wan, Yuwei and Liu, Ying and Kumar, Maneesh},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Enabling Interactive AI in Industry 5.0 with RAG-Enhanced GenAI Chatbots}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={Industry 5.0 advances sustainable development through human-machine collaboration and personalised manufacturing. The increase in intelligent industrial equipment creates data scalability challenges for human workers who face difficulties in making decisions based on relevant data sources. Advanced interactive AI systems, capable of integrating diverse data sources and delivering real-time, context-aware insights, present promising solutions to the challenges of the industrial environment. This research introduces a retrieval-augmented generation (RAG)-enhanced Generative artificial intelligence (GenAI) chatbot to address these challenges. The system integrates a variety of information sources, including government reports, news websites, academic studies, and industry reports. This industry 5.0 chatbot aims to offer users extensive knowledge of the industrial sector through a Question-and-Answer interface. It provides relevant and accurate information through intuitive, context-aware interactions to reduce cognitive load for users, which improves decision-making efficiency and user experience. Through experimental evaluation, the RAG-enhanced GenAI chatbot significantly improves accuracy, relevance and user satisfaction, outperforming models like ChatGPT-4o. This system presents an innovative practical solution to tackle Industry 5.0 core issues particularly in enhancing human-machine collaboration and decision-making efficiency. This research contributes to the theoretical and practical development of RAG-enhanced AI systems, laying a foundation for future investigations of industrial AI interaction.},
  keywords={Accuracy;Generative AI;Human-machine systems;Soft sensors;Retrieval augmented generation;Decision making;Collaboration;Chatbots;Cognitive load;Fifth Industrial Revolution;Industry 5.0;Interactive AI;Retrieval-Augmented Generation;Generative AI;Human-Machine Collaboration;Knowledge Retrieval;Cognitive Load Reduction},
  doi={10.1109/ICE/ITMC65658.2025.11106634},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106641,
  author={Bussolan, Andrea and Avram, Oliver and Pignata, Andrea and Urgese, Gianvito and Baraldo, Stefano and Valente, Anna},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Personalized Mental State Evaluation in Human-Robot Interaction using Federated Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={With the advent of Industry 5.0, manufacturers are increasingly prioritizing worker well-being alongside mass customization. Stress-aware Human-Robot Collaboration (HRC) plays a crucial role in this paradigm, where robots must adapt their behavior to human mental states to improve collaboration fluency and safety. This paper presents a novel framework that integrates Federated Learning (FL) to enable personalized mental state evaluation while preserving user privacy. By leveraging physiological signals, including EEG, ECG, EDA, EMG, and respiration, a multimodal model predicts an operator's stress level, facilitating real-time robot adaptation. The FL-based approach allows distributed on-device training, ensuring data confidentiality while improving model generalization and individual customization. Results demonstrate that the deployment of an FL approach results in a global model with performance in stress prediction accuracy comparable to a centralized training approach. Moreover, FL allows for enhancing personalization, thereby optimizing human-robot interaction in industrial settings, while preserving data privacy. The proposed framework advances privacy-preserving, adaptive robotics to enhance workforce well-being in smart manufacturing.},
  keywords={Adaptation models;Data privacy;Accuracy;Federated learning;Service robots;Human-robot interaction;Human factors;Predictive models;Brain modeling;Physiology;Human-Robot Interaction (HRI);Federated Learning (FL);Personalization;Mental State Estimation;Data synchronization;Physiological Signals},
  doi={10.1109/ICE/ITMC65658.2025.11106641},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106571,
  author={Ferreira, José and Mateo-Casali, Miguel A. and Calado, Jorge and Boza, Andrés and Fraile, Francisco and Jardim-Gonçalves, Ricardo},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Harnessing AI for Sustainable Manufacturing: A Comprehensive Impact Assessment}, 
  year={2025},
  volume={},
  number={},
  pages={1-11},
  abstract={Europe is going through a phase of readaptation to the new global reality. Due to the excessive consumption of natural resources and high energy consumption, it is necessary to increase the reuse of materials and products, as well as reduce production. In this way, the AIDEAS11https://aideas-project.eu/ The project is developing solutions for the industry, specifically for industrial equipment, to extend the life cycle and increase the usage of industrial equipment. Due to this situation, the project developed a framework to evaluate the impact of the solutions implemented in the four pilots of the AIDEAS project. This structure was created to assess the different pilots from various perspectives, including technological, environmental, economic, and social aspects, as they are installed in the manufacturing processes for each phase of AIDEAS: Design, Manufacturing, Use and Recycling, Repair, and Reuse. This paper presents the ESTEIA framework developed within the project and its application in the pilots.},
  keywords={Natural resources;Technological innovation;Manufacturing processes;Production;Maintenance engineering;Recycling;Artificial intelligence;Sustainable development;Optimization;Smart manufacturing;Industry 5.0;Impact Assessment;Sustainability;Artificial Intelligence;Industrial Equipment Optimisation;Smart Manufacturing;Real Use Cases},
  doi={10.1109/ICE/ITMC65658.2025.11106571},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106544,
  author={Herkenrath, Clara and Hoeborn, Gerrit and Boos, Wolfgang and Bareuther, Stefanie and Linhoff, Jonas},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Driving Industry 5.0 Success: How Theory Meets Practice in Europe's Industrial Evolution}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={As industries move beyond the digital focus of Industry 4.0, Industry 5.0 emerges as a new paradigm prioritizing human-centricity, sustainability, and resilience in production processes. However, a significant gap remains in translating these theoretical advancements into practical implementation. This paper addresses this gap by combining a Systematic Literature Review of 879 articles with a two-round Delphi study involving 14 experts from diverse European sectors, including Consumer Goods, Life Sciences, and Heavy Industry. The resulting framework, organized around strategic objectives, triggers, and enablers, synthesizes theoretical insights with sector-specific perspectives. Through the Delphi process, 32 hypotheses were refined to 24 consensus-based findings, creating a robust, evidence-backed foundation. This research offers actionable insights for industry and academia, bridging theoretical and practical dimensions of Industry 5.0.},
  keywords={Industries;Biological system modeling;Europe;Collaboration;Life sciences;Sustainable development;Fifth Industrial Revolution;Faces;Systematic literature review;Resilience;Industry 5.0;Delphi Study;European Companies},
  doi={10.1109/ICE/ITMC65658.2025.11106544},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106542,
  author={Rossi, Ludovica and Pirotta, Marco and Canetta, Luca and Sorlini, Marzio},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Framework to Support Digital and Sustainable Manufacturing: From Research Environments to Industrial Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={This paper introduces a structured and replicable framework designed to support the transition towards digitally enabled sustainable manufacturing. Recognizing the persistent challenges faced by industrial stakeholders—such as lack of data integration, limited methodological guidance, and organizational resistance—the framework leverages controlled research environments, specifically Learning Factories, as experimental and validation platforms. These environments allow for the safe and iterative testing of digital solutions combined with sustainability assessment methodologies, bridging the gap between conceptual innovation and industrial applicability. The core innovation lies in the integration of real-time data acquisition systems with Life Cycle Assessment (LCA) tools, enabling dynamic environmental performance evaluations embedded directly within operational contexts. The framework guides users through sequential phases: from the identification of enabling technologies and sustainability goals, to the co-design, implementation, and validation of integrated solutions. A case study demonstrates its applicability, highlighting how digital infrastructures can be harmonized with sustainability assessment practices to support data-driven, adaptive decision-making. The proposed approach contributes not only to advancing academic discourse but also to equipping companies with actionable strategies for navigating the complex path toward Industry 5.0. It fosters interdisciplinary collaboration and provides a scalable model for aligning technological innovation with long-term sustainability objectives.},
  keywords={Life cycle assessment;Performance evaluation;Technological innovation;Green manufacturing;Navigation;Real-time systems;Production facilities;Sustainable development;Fifth Industrial Revolution;Testing;Sustainable production;Digital transformation;Advanced manufacturing technologies;Application framework;Living Laboratories;Industry 5.0},
  doi={10.1109/ICE/ITMC65658.2025.11106542},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{11106534,
  author={Caceres, Christopher and Galvez, Daniel and Gabriel, Alex and Delgado, Lorena and Santander, Pavlo and Camargo, Mauricio},
  booktitle={2025 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Methodology for Developing Inclusive Social Robots: A User-Centered Design Perspective}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={This article focuses on the development of robots for labor and social inclusion. These types of projects are complex not only due to their high-tech components but also because of their social, economic, and emotional impact on the people involved. For this reason, this research proposes a design and manufacturing methodology for social robots based on the Industry 5.0 framework. User participation in the robot design stage is essential and is further enhanced by the involvement of stakeholders who provide technical, operational, and medical perspectives. This methodology is applied to two case studies to analyze its benefits and future implementation challenges. As a key result, it is observed that considering the user and integrating these three perspectives in the design process optimizes development time and resource utilization, while also facilitating the robot's implementation in real-world environments.},
  keywords={Technological innovation;Service robots;Social robots;User centered design;Stakeholders;Resource management;Fifth Industrial Revolution;Socioeconomics;Robots;Testing;industry 5.0;social robot;cobot;Artificial Intelligence;lean startup},
  doi={10.1109/ICE/ITMC65658.2025.11106534},
  ISSN={2693-8855},
  month={June},}@ARTICLE{11123554,
  author={Dai, Cheng and Lu, ShouPeng and Wang, Peng and Yin, Hao and Wang, Yijing and Liu, Xianggen and Guo, Bing},
  journal={IEEE Transactions on Industrial Informatics}, 
  title={Client Selection in Federated Learning for Industry 5.0: A Heuristic-Guided Pointer Network Reinforcement Learning Approach}, 
  year={2025},
  volume={21},
  number={11},
  pages={8992-9002},
  abstract={Federated learning (FL) offers a promising distributed paradigm for managing massive data from Industry 5.0 devices while preserving privacy. However, significant challenges arise from inherent system heterogeneity and data heterogeneity across devices. These factors severely impede FL performance, leading to slow convergence and potential degradation of the global model’s accuracy. Random client selection strategies are often insufficient to mitigate these issues effectively. To address these limitations, we propose FedHRL: a heuristic-guided pointer network reinforcement learning framework for joint client selection and bandwidth allocation in FL. Specifically, our heuristic-guided soft actor–critic algorithm employs a transformer-based pointer network within its action network to tackle the combinatorial optimization problem of sequentially selecting clients and allocating bandwidth. This network identifies the optimal next client based on prior selections and available bandwidth constraints. Furthermore, to accelerate RL convergence and enhance policy effectiveness, we integrate a particle swarm optimization-based bandwidth reallocation strategy, which refines the RL agent’s bandwidth allocation decisions, feeding the optimization results back as an enhanced reward signal to expedite learning and improve overall performance. Experiments demonstrate that FedHRL accelerates FL training convergence while maintaining high model accuracy in heterogeneous environments.},
  keywords={Training;Computational modeling;Federated learning;Accuracy;Optimization;Fifth Industrial Revolution;Channel allocation;Bandwidth;Servers;Data models;Reinforcement learning;Client selection;federated learning (FL);Industry 5.0;pointer network (Ptr-Net);reinforcement learning},
  doi={10.1109/TII.2025.3593950},
  ISSN={1941-0050},
  month={Nov},}@INPROCEEDINGS{11107052,
  author={D'Alfonso, Luigi and Fedele, Giuseppe},
  booktitle={2025 IEEE International Workshop on Metrology for Living Environment (MetroLivEnv)}, 
  title={Advanced Matching Algorithms in Multi-Agent Systems for Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={209-213},
  abstract={Multi-agent systems are pivotal for Industry 5.0, facilitating the optimization of robotic system coordination to improve production efficiency. Task assignment to robots is accomplished through matching algorithms that consider capabilities and availability, thereby streamlining processes and reducing operational costs. This paper leverages existing research on the coordination of multiple swarms of agents to achieve consensus and adhere to predetermined motion profiles, adapting these findings to the Industry 5.0 context for the control and coordination of diverse robot types. This approach addresses issues of scalability, dynamic environments, and privacy. Experimental results illustrate the efficacy of this approach in optimizing robotic coordination and enhancing production efficiency.},
  keywords={Symbiosis;Costs;Service robots;Robot kinematics;Heuristic algorithms;Production;Synchronization;Fifth Industrial Revolution;Robots;Multi-agent systems;Multi-agent systems;Industry 5.0;Robotic coordination},
  doi={10.1109/MetroLivEnv64961.2025.11107052},
  ISSN={},
  month={June},}@INPROCEEDINGS{11099862,
  author={Karunamurthy, A. and Udhayakumar, V. and Rajapandian, P.},
  booktitle={2025 International Conference on Emerging Technologies in Engineering Applications (ICETEA)}, 
