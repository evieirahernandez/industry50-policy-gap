@INPROCEEDINGS{11255862,
  author={Leong, Wai Yie},
  booktitle={2025 IEEE International Conference on Computation, Big-Data and Engineering (ICCBE)}, 
  title={Technical and Vocational Education and Training Curriculum in Engineering Based on Digital Twin and Internet of Things Integration for Smart Industry}, 
  year={2025},
  volume={},
  number={},
  pages={937-942},
  abstract={The swift progression of Industry 5.0 technologies necessitates a significant re-evaluation of technical and vocational education and training (TVET), especially in engineering education. Therefore, it is necessary to investigate the integration of digital twin (DT) and Internet of Things (IoT) into TVET curricula in engineering to cultivate competencies for smart manufacturing, automation, and cyber-physical systems. Traditional engineering training models do not provide students with the skills required for modern industrial ecosystems, such as real-time system monitoring, predictive maintenance, and data-driven decision-making. By incorporating digital twin simulations and IoT-enabled infrastructure, students can gain immersive, hands-on experience in smart factories, energy grids, and intelligent transport systems. The curriculum model developed in this study emphasizes modular competency-based learning, live-data experimentation, and collaborative problem-solving. The model prepares graduates to excel in interconnected and automated environments, thereby enhancing student engagement, adaptability, and innovation. A case study was conducted to analyze the improved technical outcomes and readiness for Industry 5.0 based on the educational transformation. Strategic recommendations were proposed for policymakers, curriculum developers, and industry partners to institutionalize the TVET curriculum.},
  keywords={Industries;Training;Adaptation models;Technological innovation;Biological system modeling;Real-time systems;Digital twins;Internet of Things;Monitoring;Smart manufacturing;technical and vocational education and training (TVET);employability;curricula;sustainable manufacturing;artificial intelligence},
  doi={10.1109/ICCBE65177.2025.11255862},
  ISSN={},
  month={June},}@INPROCEEDINGS{11255769,
  author={Leong, Wai Yie},
  booktitle={2025 IEEE International Conference on Computation, Big-Data and Engineering (ICCBE)}, 
  title={Fostering Industry 5.0 through Engineering Innovation: A Framework for Enhancing Creativity, Problem-Solving, and Early-Stage Technical Competency in Future Engineers}, 
  year={2025},
  volume={},
  number={},
  pages={543-547},
  abstract={The global engineering landscape transitions toward Industry 5.0, characterized by human-centric automation, hyper-customization, and sustainable co-creation. Therefore, it is needed to reconfigure educational paradigms to educate engineers to be equipped with advanced creativity, transdisciplinary problem-solving, and foundational technical acumen. In this study, a framework was developed, leveraging design-driven engineering innovation platforms, such as structured design fairs, to embed Industry 5.0 principles into undergraduate and early-career engineering curricula. Anchored in cyber-physical frameworks integration, digital twin modeling, and human-machine collaborative intelligence, the framework operationalizes experiential learning cycles to promote ideation, rapid prototyping, and frameworkic validation under real-world constraints. The framework is grounded in established engineering epistemologies, incorporating Bloom’s revised taxonomy for cognitive development, TRIZ-based methodologies for creative problem-solving, and ABET-aligned frameworks for assessing technical competencies. Empirical validation of the framework was conducted through multi-site intervention studies involving 320 engineering students. Metrics were used to assess computational thinking, embedded frameworks design, sustainability heuristics, and collaborative intelligence in pre- and post-intervention. The results indicated significant improvements in students’ abilities to decompose complex problems, demonstrate proficiency in digital fabrication, and apply frameworks engineering principles effectively. The results also presented the potential of innovation-driven educational interventions for advancing Industry 5.0 readiness. Such interventions help to solve the cognitive and technical divide between academic instruction and industrial application. The developed framework integrates ethical, innovative, and human-centric competencies into the curricula, enhancing educational outcomes to meet industrial demands.},
  keywords={Measurement;Technological innovation;Taxonomy;Rapid prototyping;Problem-solving;Fifth Industrial Revolution;Sustainable development;Creativity;Collaborative intelligence;Next generation networking;engineering education;problem-solving;next generation of engineers;process innovation;artificial intelligence},
  doi={10.1109/ICCBE65177.2025.11255769},
  ISSN={},
  month={June},}@INPROCEEDINGS{11241889,
  author={De Souza, Raphael Odebrecht and Ferenhof, Helio Aisenberg and Bonamigo, Andrei and Frazzon, Enzo Morosini and Forcellini, Fernando Antônio},
  booktitle={2025 16th IEEE International Conference on Industry Applications (INDUSCON)}, 
  title={Motion Capture Technologies for Industrial Applications: A Systematic Literature Review and a Theoretical Framework for Process Improvement}, 
  year={2025},
  volume={},
  number={},
  pages={1040-1046},
  abstract={The objective of this paper is twofold. First, we aim to synthesize, evaluate, and discuss the main applications of Motion Capture Technologies (MOCAP) in industrial environments. Based on these results, we propose a theoretical framework that combines MOCAP technologies with the Value Stream Mapping (VSM) methodology from the Lean approach. A basic proof of concept is also presented. To accomplish the research objectives, a systematic literature review (SLR) was conducted. Data were collected in the Scopus database without time restriction. A total of 41 articles were selected to provide metadata that were analyzed and further used to propose the theoretical framework. Findings provide evidence that MOCAP technologies have the potential to revolutionize parameter and data acquisition in the manufacturing environment, as they are a human-centered type of sensing solution. Main application domains so far are ergonomic assessment, workplace design, and optimization of production systems. The proposed theoretical framework aims to initiate a debate on improving production processes in the Industry 4.0 and Industry 5.0 eras by combining MOCAP technologies and Lean concepts. The main limitations of this study are related to the defined query string and the databases, as some essential studies may have been left out. Furthermore, the proposed framework is theoretical, and only a proof of concept was developed, requiring further empirical evaluation in real industrial settings.},
  keywords={Production systems;Databases;Ergonomics;Real-time systems;Motion capture;Sensors;Fourth Industrial Revolution;Fifth Industrial Revolution;Optimization;Systematic literature review;Motion Capture Technologies;Industry 4.0;Industry 5.0;Lean;Value Stream Mapping},
  doi={10.1109/INDUSCON66435.2025.11241889},
  ISSN={2572-1445},
  month={Oct},}@INPROCEEDINGS{11241317,
  author={Romero, Marcos Lima and Suyama, Ricardo},
  booktitle={2025 16th IEEE International Conference on Industry Applications (INDUSCON)}, 
  title={Agentic AI for Intent-Based Industrial Automation}, 
  year={2025},
  volume={},
  number={},
  pages={437-444},
  abstract={The recent development of Agentic AI systems, empowered by autonomous large language models (LLMs) agents with planning and tool-usage capabilities, enables new possibilities for the evolution of industrial automation and reduces the complexity introduced by Industry 4.0. This work proposes a conceptual framework that integrates Agentic AI with the intent-based paradigm, originally developed in network research, to simplify human-machine interaction (HMI) and better align automation systems with the human-centric, sustainable, and resilient principles of Industry 5.0. Based on the intent-based processing, the framework allows human operators to express high-level business or operational goals in natural language, which are decomposed into actionable components. These intents are broken into expectations, conditions, targets, context, and information that guide sub-agents equipped with specialized tools to execute domain-specific tasks. A proof of concept was implemented using the CMAPSS dataset and Google Agent Developer Kit (ADK), demonstrating the feasibility of intent decomposition, agent orchestration, and autonomous decision-making in predictive maintenance scenarios. The results confirm the potential of this approach to reduce technical barriers and enable scalable, intent-driven automation, despite data quality and explainability concerns.},
  keywords={Technological innovation;Automation;Sensitivity;Data integrity;Natural languages;Planning;Fifth Industrial Revolution;Sustainable development;Business;Testing;agentic ai;intent-based;industry 5.0;manufacturing;automation},
  doi={10.1109/INDUSCON66435.2025.11241317},
  ISSN={2572-1445},
  month={Oct},}@INPROCEEDINGS{11247416,
  author={Liu, Daming and Li, Ye and Liu, Junchen and Wang, Ziqi and Zhao, Jie and Zhu, Yanhe},
  booktitle={2025 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)}, 
  title={Using Upper Limb Carrying Exoskeleton with Dual-Model Torque Control Strategy to Reduce Load Impact}, 
  year={2025},
  volume={},
  number={},
  pages={8224-8231},
  abstract={Exoskeleton technology holds significant promise within the human-centric paradigm of Industry 5.0 for mitigating work-related musculoskeletal disorders (WMSDs). However, existing systems often struggle with mismatched assistive torque and inefficient human-machine collaboration under dynamic loading conditions, largely due to insufficient motion intent recognition accuracy. This study proposes a dual-model-based multimodal fusion control strategy that integrates a bidirectional LSTM neural network (Bi-LSTM) with a transformer-based multi-task learning model (MTL) to enable real-time torque compensation and accurate prediction of dynamic load mass under varying conditions. The team developed a lightweight elbow joint exoskeleton prototype, leveraging multi-modal information to enhance assistive torque prediction accuracy. Experimental results show an 83.7% reduction in agonist muscle activation under a 3.5 kg load compared to conditions without the exoskeleton, underscoring its potential for industrial material handling scenarios.},
  keywords={Torque;Accuracy;Exoskeletons;Dynamics;Torque control;Neural networks;Prototypes;Predictive models;Transformers;Real-time systems},
  doi={10.1109/IROS60139.2025.11247416},
  ISSN={2153-0866},
  month={Oct},}@INPROCEEDINGS{11251582,
  author={Alqodri, Febrianto and Widiyaningtyas, Triyanna and Prasetya, Didik Dwi},
  booktitle={2025 9th International Conference On Electrical, Electronics And Information Engineering (ICEEIE)}, 
  title={Comparative Analysis of ARIMA, Random Forest, and BiLSTM for Dollar Index Prediction in the 21st Century}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This study compares Autoregressive Integrated Moving Average (ARIMA), Random Forest, and Bidirectional Long Short-Term Memory (BiLSTM) models for predicting the Dollar Index (DXY) close prices using data sourced from Yahoo Finance, spanning January 1, 2001, to February 10, 2025. The highly volatile, dynamic, and non-linear fluctuations of financial markets underscore the importance of accurate forecasting. Performance is evaluated using MAPE, RMSE, $\mathbf{R}^{\mathbf{2}}$, execution time, and memory usage on a test set of $\mathbf{1, 2 1 8}$ samples. BiLSTM outperforms with a MAPE of $6.914 \times 10^{-5}(0.006914 \%)$, RMSE of 0.007996, and $R^{2}$ of 0.9999998, but requires 12.900 seconds and 7.030 MB. Random Forest and ARIMA exhibit comparable accuracy (MAPE $\approx \mathbf{0 . 0 5 2 9}$), yet their negative $\mathbf{R}^{\mathbf{2}}$ values ($-\mathbf{0 . 0 0 3 1}$ and $\mathbf{- 0 . 0 0 6 1}$) indicate limited explanatory power. Random Forest is computationally efficient (0.563 seconds, 0.316 MB), while ARIMA demands 20.951 MB and 28.484 seconds. BiLSTM is optimal for high-accuracy DXY forecasting in resource-rich environments, with Random Forest as a faster alternative. These findings enable the public and industry to project future USD prices, mitigate risks, and capitalize on price differences. Moreover, this study serves as a foundation for predictive developers to assess the Dollar Index’s influence on currency pairs, such as in forex markets.},
  keywords={Accuracy;Computational modeling;Memory management;Bidirectional long short term memory;Predictive models;Data models;Computational efficiency;Indexes;Forecasting;Currencies;Dollar Index (DXY);Time Series Prediction;ARIMA;Random Forest;BiLSTM;Comparative Analysis},
  doi={10.1109/ICEEIE66203.2025.11251582},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11236661,
  author={Terabaru, Yudai and Kurniawan, Wendy Cahya and Yeoh, Wen Liang and Fukuda, Osamu},
  booktitle={2025 SICE Festival with Annual Conference (SICE FES)}, 
  title={The Effect of Human Task Interventions in Collaborative AI Robot and Human Assembly Lines}, 
  year={2025},
  volume={},
  number={},
  pages={970-975},
  abstract={Human-Robot Collaboration (HRC) is a key enabler for achieving Industry 5.0, where humans and robots work together on tasks with greater safety, productivity, and efficiency. However, human intervention can slow down the robot's work speed and reduce its productivity. This study conducts a preliminary investigation into the effects of human intervention in HRC workspace, focusing on a conveyor-driven production line with varying operational speeds. The experiment workspace consisted of human and robot sorted together strawberries into three different size. The work scenario was divided into three cases-human alone, robot alone, and HRC-each tested under two conveyor speeds: standard and high. The experimental results revealed that HRC achieved the highest accuracy among the three conditions, with 91.7% and 91.3% for the standard and high-speed conveyor settings, respectively. High identification accuracy was observed at higher speeds with reduced human workload through collaboration, allowing greater concentration on the task and minimizing false identifications.},
  keywords={Productivity;Accuracy;Service robots;Collaboration;Iron;Safety;Artificial intelligence;Standards;Assembly;Sorting;Human and robot collaboration;Task intervention;AI;Image classification;Assembly Lines},
  doi={10.23919/SICEFES67750.2025.11236661},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11238628,
  author={Enriquez, James and Delgado, Daniel Ricardo and Herrera, Cesar and Rincón-Guio, Cristian},
  booktitle={2025 IEEE Technology and Engineering Management Society (TEMSCON LATAM)}, 
  title={Eco-Innovation in Industry 5.0: Enablers, Barriers, and Future Directions for Sustainable Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The transition to Industry $\mathbf{5. 0}$ highlights the critical role of eco-innovation in achieving sustainable and resilient manufacturing systems. This study conducts a systematic literature review and bibliometric analysis to explore the integration of digitalisation, regulatory frameworks, and organisational capabilities in eco-innovation adoption. Findings indicate that knowledge management, strategic orientation, and stakeholder collaboration are key enablers, while financial barriers and inconsistent regulations hinder adoption, particularly for SMEs. Moreover, emerging technologies such as AI, IoT, and circular economy strategies are reshaping sustainability practices in manufacturing. Despite growing research in this domain, gaps persist in sectorspecific applications and the harmonisation of global policies. The study provides insights for policymakers and industry leaders, offering a roadmap for scaling sustainable innovations. Future research should address sector-specific challenges, the role of digital sustainability tools, and the impact of regulatory frameworks to accelerate the adoption of sustainable Industry 5.0 models.},
  keywords={Economics;Green manufacturing;Technological innovation;Circular economy;Biological system modeling;Collaboration;Regulation;Sustainable development;Fifth Industrial Revolution;Systematic literature review;innovation;Industry 5.0;Sustainable manufacturing;Digitalisation;Circular economy},
  doi={10.1109/TEMSCONLATAM65810.2025.11238628},
  ISSN={},
  month={June},}@INPROCEEDINGS{11233863,
  author={Yadavalli, Ramu and Sumeet, Anika},
  booktitle={2025 2nd International Conference on New Frontiers in Communication, Automation, Management and Security (ICCAMS)}, 
  title={Sustainable Industry 5.0 and Digital Transformation: Analytical Insights on Challenges, AI-Driven Strategies, Frameworks, and Future Directions}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Digital transformation has advanced beyond the automation-centric principles of Industry 4.0 to embrace the human-centric, AI-driven vision of Industry 5.0, which emphasizes adaptability, sustainability, and intelligent collaboration. This study conducts an in-depth literature review of 20 key research articles, synthesizing the current trends, methodologies, and challenges shaping the evolution of Industry 5.0. A comparative analysis is performed between traditional and AI-enhanced digital transformation approaches, highlighting innovations in AI-based decision-making, edge computing, IoT integration, and data interoperability. To address persistent challenges, a comprehensive framework is proposed for a sustainable Industry 5.0 ecosystem that leverages AI, energy-efficient infrastructure, and scalable digital technologies. The study identifies emerging themes such as ethical AI governance, real-time analytics, and the transition toward resilient, decentralized infrastructures. A significant contribution is the structured integration of AI-driven automation, sustainable digital frameworks, and Industry 5.0 readiness. The findings offer a strategic direction for future research, supporting innovation, policy alignment, and industrial adoption of next-generation digital transformation models.},
  keywords={Technological innovation;Ethics;Digital transformation;Real-time systems;Fifth Industrial Revolution;Artificial intelligence;Computer security;Sustainable development;Interoperability;Systematic literature review;AI-Driven Strategies;Industry 5.0;Digital Transformation;Sustainability;Data Interoperability},
  doi={10.1109/ICCAMS65118.2025.11233863},
  ISSN={},
  month={July},}@INPROCEEDINGS{11234068,
  author={E, Veera Boopathy and R, Lakshmi and J, Santhosh and S, Kannadhasan and A, Ambika and K K, Arun},
  booktitle={2025 2nd International Conference on New Frontiers in Communication, Automation, Management and Security (ICCAMS)}, 
  title={An Effective Methodology for Integrating Design Thinking Approach with Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={In this paper, research focuses on the approaches to implementing the design thinking approach in the environment that appeared at the newest stage of industrial growth, which is Industry 5.0. The purpose of this research is to explain the usage of design thinking in Industry 5.0, which is the contemporary plan of industrial revolution human-centered that is using robotics. Based on the empathy, iteration, and prototyping, the design thinking offers an operational framework to manage the complex issues aroused by Industry 5.0. The concept of design thinking fosters invention by involving deep understanding of customer needs and looking at the problem from the first person’s view as well as enabling integration of human and mechanical perspectives. Analyzing the cases and applying the theories of Industry 5.0 in this paper, it is possible to promote the use of design thinking in the development of Industry 5.0, which will help to consider a human-centric approach and flexibility in the industrial processes.},
  keywords={Technological innovation;Service robots;Design methodology;Security;Fifth Industrial Revolution;Design thinking;Industry 5.0;empathy;analyze;solution},
  doi={10.1109/ICCAMS65118.2025.11234068},
  ISSN={},
  month={July},}@INPROCEEDINGS{11250438,
  author={Mulongo, Ndala Yves and Bejaoui, Tarek},
  booktitle={2025 International Symposium on Networks, Computers and Communications (ISNCC)}, 
  title={Deployment Of key Determinants Of Industry 5.0 To Enhance The Production Sector}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Global competition, swiftly evolving technology, shortened product life cycles, price reductions, high-quality products, and discerning consumers are several factors that have compelled manufacturing businesses to seek innovative strategies for new product creation. The rapid economic growth and evolving demands necessitating adaptability are pivotal factors in the development of Industry 5.0, which, building upon the principles of Industry 4.0, emphasises meeting individual requirements and desires whilst fostering efficient workforce operations. This is particularly evident in sectors seeing rapid advancements in manufacturing methods, characterised by the integration of advanced information technology, data usage, digitsation, and the implementation of robotic machines that collaborate, referred to as “cobots.” The paper outlines the fundamental conditions for the formation and operation of Industry 5.0, as specified in European Union regulations and represented in academic literature. The research identified ten critical variables for the adoption of Industry 5.0, which is intended to improve the South African manufacturing sector.},
  keywords={Economics;Service robots;Buildings;Europe;Collaborative robots;Regulation;Fourth Industrial Revolution;Fifth Industrial Revolution;Information technology;Business;Industry 5.0;Manufacturing Industry},
  doi={10.1109/ISNCC66965.2025.11250438},
  ISSN={2768-0940},
  month={Oct},}@INPROCEEDINGS{11236394,
  author={Ghafoori, Miran and Premsankar, Gopika and Tu, Xinyi},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality Adjunct (ISMAR-Adjunct)}, 
  title={Are We Measuring What Matters? Reframing Evaluation of Extended Reality for Industry 5.0 Work Environments}, 
  year={2025},
  volume={},
  number={},
  pages={223-228},
  abstract={Current approaches to evaluating extended reality (XR) systems in industrial settings are narrowly focused on usability, device performance, or user experience, while overlooking broader systemic impacts. We argue that this limited scope is misaligned with the challenges and values of future workspaces. As XR technologies become more integrated into manufacturing and training environments, evaluation methods must expand to reflect the principles of Industry 5.0: human-centricity, sustainability, and resilience. In this position paper, we propose a multi-dimensional evaluation framework that incorporates task-technology fit alongside environmental, human, and operational criteria. The proposed framework enables structured, phase-specific assessment of XR systems to guide responsible deployment and adoption. We call on the XR research community to shift from fragmented metrics toward holistic evaluation practices that ensure XR contributes to more efficient, equitable, regenerative, and future-ready work environments.},
  keywords={Training;Performance evaluation;Extended reality;Metaverse;User experience;Manufacturing;Fifth Industrial Revolution;Sustainable development;Usability;Resilience;Extended Reality;Metaverse;Sustainability;Industry 5.0;Task-Technology Fit},
  doi={10.1109/ISMAR-Adjunct68609.2025.00050},
  ISSN={2771-1110},
  month={Oct},}@INPROCEEDINGS{11236136,
  author={ElSayed, Neven and Veas, Eduardo},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality Adjunct (ISMAR-Adjunct)}, 
  title={Beyond Visual Interfaces: Extended Reality for Collaborative Industrial Settings}, 
  year={2025},
  volume={},
  number={},
  pages={237-241},
  abstract={With the growing interest in Industry 4.0 and the transition toward Industry 5.0, the application of extended reality (XR) in industrial settings show significant potential. This potential arises from the strong alignment between industrial objectives and existing infrastructure. Drawing from our research with industrial partners, this paper examines the benefits of employing XR in such environments. We present an illustrated use case, which is expanded into a comprehensive list of opportunities and challenges. These insights aim to inform and guide the research community in developing XR adaptive systems that effectively leverage adaptive interfaces and remote collaboration.},
  keywords={Industries;Visualization;Adaptive systems;Extended reality;Collaboration;Fourth Industrial Revolution;Fifth Industrial Revolution;Augmented reality;Extended Reality;Remote Collaboration;Augmented Reality;Virtual Reality;Human-Machine Interaction;Industry;Industry 5.0;Immersive Environments},
  doi={10.1109/ISMAR-Adjunct68609.2025.00053},
  ISSN={2771-1110},
  month={Oct},}@INPROCEEDINGS{11236074,
  author={Gkoumas, Christos and Triantafyllidis, Eleftherios and Rouchitsas, Alexandros},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality Adjunct (ISMAR-Adjunct)}, 
  title={Toward a Human-Centered Framework for Standardization in eXtended Reality (XR): Development, Measurement, and Evaluation}, 
  year={2025},
  volume={},
  number={},
  pages={495-500},
  abstract={The rapid growth of eXtended Reality (XR) offers transformative potential but is hindered by fragmentation and a lack of standardization, particularly regarding human-centered factors. This limits interoperability, evaluation of effectiveness, and comparability across studies, ultimately affecting broader adoption. To address this, we propose a human-centered framework for standardization, focusing on three pillars: (i) XR development processes, (ii) human behavior measurement, and (iii) evaluation procedures. To demonstrate its applicability, we provide an example showing how the framework can guide the implementation of an Industry 5.0 VR training simulation. We hope the framework serves as a starting point for improving effectiveness, comparability, and trust in XR systems, fostering a more standardized and reliable XR ecosystem.},
  keywords={Training;Technological innovation;Extended reality;Ecosystems;Standardization;Reliability engineering;User experience;Motion measurement;Software measurement;Interoperability;Extended reality (XR);standardization;adoption;User Experience (UX);virtual worlds;human-centered design;HCI;development;measurement;evaluation;framework},
  doi={10.1109/ISMAR-Adjunct68609.2025.00100},
  ISSN={2771-1110},
  month={Oct},}@INPROCEEDINGS{11236362,
  author={Mittal, Raghav and Tiwari, Lokender and Bhardwaj, Satyam and Halder, Mritunjoy and Bhowmick, Brojeshwar},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality Adjunct (ISMAR-Adjunct)}, 
  title={InGenCo : Integrated In-Place 3D Scenario Generation and Collaboration}, 
  year={2025},
  volume={},
  number={},
  pages={781-782},
  abstract={Human-robot collaboration is essential in AI-powered Industry 5.0 and personal spaces, aiming to boost human creativity and efficiency. Traditional methods involve creating virtual scenarios in VR to simulate interactions, but they often rely on pre-defined 3D assets or procedural generation, which are time-consuming, expensive, and limited by restricted design options and the need for 3D expertise. Many systems are also desktop-based and lack intuitive interfaces, limiting interactive scenario creation and in-place testing. This paper presents an integrated XR-based system that combines GenAI based 3D scenario generation and human-robot collaboration in real-time. It allows users to create and modify virtual environments on-the-fly using voice and gesture inputs, and test collaborations directly in mixed reality, accelerating decision-making. The system, powered by Generative AI and XR, enables even non-experts to generate 3D assets, assemble them, configure robots, and perform collaborative tasks. It features an intuitive interface and multiple configuration options. Through experiments and ablations, the system’s effectiveness is validated, showing its potential for interactive 3D scenario creation and in-place collaboration in XR, with applications in robotics, gaming and other fields.},
  keywords={Three-dimensional displays;Procedural generation;Collaboration;Human-robot interaction;Virtual environments;Mixed reality;Real-time systems;Scenario generation;Robots;Testing;Human-Robot Collaboration;XR;GenAI},
  doi={10.1109/ISMAR-Adjunct68609.2025.00187},
  ISSN={2771-1110},
  month={Oct},}@INPROCEEDINGS{11236311,
  author={Pulcini, Valerio and Modoni, Gianfranco},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality Adjunct (ISMAR-Adjunct)}, 
  title={Hazardous Workplaces and the Role of VR in Stress Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={229-232},
  abstract={Workers in hazardous and extreme environments, such as confined spaces, offshore platforms, or isolated ICE (Isolated, Confined, and Extreme) settings, face significant physical, physiological, and psychological stressors that threaten performance, safety, and long-term well-being. This short survey, inspired by Industry 5.0’s human-centered principles, categorizes the main sources of strain in these workplaces and examines their immediate and lasting impacts on health and productivity. It then explores how Virtual Reality (VR) technologies can help mitigate these challenges through immersive simulations, targeted psychological training, and real-time remote support. By integrating VR into preparation and ongoing operations, organizations can foster safer, more supportive workplaces that prioritize both performance excellence and the dignity, mental health, and resilience of workers.},
  keywords={Training;Industries;Solid modeling;Employment;Transforms;Physiology;Safety;Fifth Industrial Revolution;Faces;Resilience;Workplace environment;Virtual Reality;Occupational health;Isolated Confined Environment;Industry 5.0},
  doi={10.1109/ISMAR-Adjunct68609.2025.00051},
  ISSN={2771-1110},
  month={Oct},}@INPROCEEDINGS{11235626,
  author={Wang, Chengjian and Zhong, Yangfan and Li, Xiaopeng and Xu, Yangyang and Tian, Wenbin and She, Lu and Yang, LiJie and Gong, Haifeng and Ahuja, Nishi},
  booktitle={2025 24th IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)}, 
  title={Experimental Investigation on Molding Isolation Process to Eliminate Liquid Leakage on Connection Areas of Liquid Cooling Cold Plate}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Data Centers (DCs) are critical infrastructures for data’s storage, processing and transmission. It has evolved significantly in the past decades to echo industrial continuous demand for higher computing capability and more efficient thermal management in terms of optimal performance per watt and Power Usage Effectiveness (PUE). With substantial increase on rack’s power density and DC’s power consumption, industry has been seeking for sustainable and reliable cooling solution for application. Therefore, advanced liquid cooling technologies have emerged and been adopted gradually for deployment in modern DCs. One typical advanced cooling technology is single-phase cold plate liquid cooling (1PCPLC) solution, which has been proved to be a viable and cost-effective approach to manage cooling requirements of modern DCs. However, one of the crucial challenges of 1PCPLC deployment is the possible liquid leakage which could result in short circuit and even damage on IT equipment as water-based liquid is generally used in the 1PCPLC solution as the coolant. Currently, industry has taken a few measures to mitigate this potential risk either by optimizing the manufacture process or adopting leakage detection wire sensor, which are still insufficient to provide effective protection on the areas of metal welding and liquid tube connection. To tackle this challenge, this article proposes an additional security mechanism to prevent possible leakage on the welding and tube connection areas with plastic sealing and molding isolation process. A few prototypes are also built to verify its technical feasibility and effectiveness of encapsulant materials. Meanwhile, critical test items are also defined and validated for long-term operation reliability, including factory sealing test with helium detection, thermal resistance test based on Intel Thermal Test Vehicle (TTV), 3x operation pressure reliability test under 9 bars as well as low and high temperature cycling reliability test within $\mathbf{1 0}^{\boldsymbol{\circ}} \mathbf{C} \boldsymbol{\sim} \mathbf{8 0}^{\boldsymbol{\circ}} \mathbf{C}$ for $\mathbf{5 0 0}$ hours duration. According to measurement data, it is proved to be workable to prevent liquid leakage on some connection areas by molding process with appropriate encapsulant material and suitable for 1PCPLC solution with cost competitiveness.},
  keywords={Temperature measurement;Industries;Data centers;Liquid cooling;Liquids;Cold plates;Welding;Thermal resistance;Reliability;Plastics;Data Center;Single-phase Cold Plate;Liquid Leakage;Plastic Sealing;Molding Isolation Process and Operation Reliability},
  doi={10.1109/ITherm55376.2025.11235626},
  ISSN={2694-2135},
  month={May},}@INPROCEEDINGS{11235803,
  author={Birkenmeyer, Jacey and Chhetri, Bijay and Bansal, Shubhra and Sotelo, Luz D.},
  booktitle={2025 24th IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)}, 
  title={Evaluating the Degradation of Thermal Interface Materials in Liquid Immersion Cooling Systems using Ultrasonic Methods}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Immersion cooling systems for data centers are significantly more energy efficient and use less water than traditional air- or water-cooled systems. However, the long-term mechanisms of degradation of Thermal Interface Materials (TIMs) and the effects of the interaction between coolant fluid and TIMs have not been thoroughly studied and there are currently no nondestructive/noninvasive approaches to monitor degradation. Ultrasonic nondestructive evaluation uses high-frequency sound waves to detect defects in a part and characterize its material properties. This paper will discuss the use of ultrasonic nondestructive evaluation to detect changes in material properties in coolant fluids and TIMs as well as scanning acoustic microscopy to map defects in the TIMs. For this purpose, combinations of various commercially available coolant fluids and TIMs were evaluated. TIM samples were placed in coolant fluid and heated at $\mathbf{1 0 0}^{\boldsymbol{\circ}} \mathbf{C}$ for $\mathbf{5 0 0}$ hours and $\mathbf{1 5 0}^{\boldsymbol{\circ}} \mathbf{C}$ for $\mathbf{1 0 0 0}$ hours (in accordance with JESD22-A103C test standard) to simulate an immersion cooling system in a data center. Then, sound wave speed and attenuation measurements were collected and compared with optical spectroscopy and visual inspection methods to identify the sound metrics most sensitive to material changes. While established chemical and physical experimental characterization was used to provide insight into the fundamental mechanisms of degradation for each TIM-coolant combination, ultrasonic approaches enable more rapid, accessible, and nondestructive characterization. This information may provide the industry with additional methods of degradation characterization which may be leveraged for periodic and/or continuous monitoring.},
  keywords={Degradation;Data centers;Immersion cooling;Attenuation measurement;Coolants;Optical imaging;Acoustics;Monitoring;Thermal degradation;Material properties;thermal interface materials;immersion cooling;ultrasonics;nondestructive evaluation},
  doi={10.1109/ITherm55376.2025.11235803},
  ISSN={2694-2135},
  month={May},}@INPROCEEDINGS{11234727,
  author={M, Shrusti and N, Soniya and S, Priyadarshini K. and P, Kanchana and M, Kiran Raj K.},
  booktitle={2025 3rd International Conference on Recent Advances in Information Technology for Sustainable Development (ICRAIS)}, 
  title={Leveraging AI for Cyber Threat Defence}, 
  year={2025},
  volume={},
  number={},
  pages={28-32},
  abstract={This paper gives a detailed analysis of threats and threat detection using Artificial Intelligence (AI) techniques, accenting new trends and prospects of threats and cybersecurity. AI, especially machine learning and deep learning, have greatly enhanced the ability to address cybersecurity threats, including but not limited to network intrusion, adversarial or zero-day attacks. The focus in the review is on the aspects of explainability and robustness of AI as critical characteristics defining its reliability in security related tasks. The research analysed includes several fields like Industry 5.0, IoT, 5G network, and self-driving cars, to show how AI deals with particular security concerns in those sectors. Currently, transformer-based models and federated learning in this area are implementing new and more reliable approaches to real-time or threat detection mechanisms, blockchain. However, there are a few limitations; massive amounts of data must be handled, and real-time analysis must be facilitated while guaranteeing anonymity and data security. In other words, significant progress has been made; however, further research and cooperation are needed to enhance the utilisation of artificial intelligence to strengthen digital environments.},
  keywords={Federated learning;5G mobile communication;Transformers;Threat assessment;Real-time systems;Blockchains;Internet of Things;Artificial intelligence;Fifth Industrial Revolution;Computer security;5G Networks;network intrusion detection;federated learning;blockchain;Internet of Things (IoT);adversarial attacks;Industry 5.0},
  doi={10.1109/ICRAIS66073.2025.11234727},
  ISSN={},
  month={Sep.},}@ARTICLE{11250626,
  author={Precup, Stefan-Alexandru and Pirvu, Bogdan-Constantin and Gellert, Arpad and Zamfirescu, Constantin-Bala},
  journal={IEEE Access}, 
  title={Cognitive Control Units in Smart Manufacturing: Insights From a Soar-Based Assistance System}, 
  year={2025},
  volume={13},
  number={},
  pages={196167-196180},
  abstract={The growing complexity of industrial assembly processes calls for innovative, user-centered solutions, and in recent years, the adoption of assistive systems to support manual assembly tasks has attracted increasing attention. This work investigates the use of Cognitive Control Units, powered by the Soar cognitive architecture, as assistive systems in smart manufacturing. The Cognitive Control Unit has been integrated into an assembly station that can adapt itself and its processes to the user currently utilizing the station. An experimental study was conducted to evaluate the station’s effectiveness by comparing it with a previous experiment in which no guidance was provided. The findings reveal both shorter mean completion times and higher-quality assembly performance. Furthermore, participants indicated that the use of the station had a positive influence on their emotional state.},
  keywords={Assembly;Robots;Training;Cognitive load;Smart manufacturing;Computer architecture;Service robots;Productivity;Europe;Complexity theory;Assistance systems;cognitive architecture;cognitive control unit;cognitive systems;human-centric manufacturing;industry 5.0;Soar},
  doi={10.1109/ACCESS.2025.3633609},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11233244,
  author={Ramal, P. Janaki and Anbalagan, E.},
  booktitle={2025 3rd World Conference on Communication & Computing (WCONF)}, 
  title={Edge-Cloud Synergized Digital Twin Framework for Real-Time Decision Intelligence in Industry 5.0-Driven Smart Cities}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Time-sensitive frameworks handling complex urban systems must exist to support the quick manufacturing expansion of Industry 5.0. The study creates an Edge-Cloud Synergized Digital Twin Framework which serves as its base to increase smart city operational performance by enhancing situational perception through this proposed method. The system expansion capabilities are enabled by its design features which allow real-time operation along with minimal reliance on web resources. This model demonstrates superior results in its primary operation aspects through precision and both latency and system update velocity according to established benchmarks. The model enables users to finish their tasks 22% faster during 145 ms processing time. The design outperforms existing models because it integrates advanced adaptability with optimized resource management capabilities which automatically receive updated systems. A practical deployment of the developed approach connects cyber-physical systems to serve as a smart urban administration platform that delivers efficient operation.},
  keywords={Adaptation models;Technological innovation;Smart cities;Computational modeling;Real-time systems;Digital twins;Resource management;Synchronization;Fifth Industrial Revolution;Edge computing;Digital Twin;Smart Cities;Edge Computing;Reinforcement Learning;Industry 5.0},
  doi={10.1109/WCONF64849.2025.11233244},
  ISSN={},
  month={July},}@INPROCEEDINGS{11234847,
  author={Tunwal, Bhawna and Kaur, Amandeep and Kumar, Sudesh},
  booktitle={2025 International Conference on Next Generation of Green Information and Emerging Technologies (GIET)}, 
  title={Advancing Industry 5.0 with IoT Transformations: Future Prospectives}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The recent convergence of the Internet of Things (IoT) and Industry 5.0 has resulted in a new paradigm in contemporary industrial and manufacturing systems. This paradigm emphasizes the seamless integration of cutting-edge technology with human talents. The IoT lays the framework for intelligent automation, connection, and real-time data collection. At the same time, Industry 5.0 strongly emphasizes people by prioritizing customization and resilience. This article aims to investigate the synergistic integration of the IoT with Industry 5.0, stressing IoT's critical role in Industry 5.0. The research investigates essential applications such as managing supply chains, monitoring health, developing novel educational practices, collaborating with humans and robots, and human-centric smart manufacturing. In addition, it discusses the challenges and presents a roadmap for future research directions in which technology will complement rather than replace the human workforce.},
  keywords={Service robots;Supply chains;Real-time systems;Internet of Things;Fifth Industrial Revolution;Artificial intelligence;Sustainable development;Next generation networking;Resilience;Smart manufacturing;IoT;Industry 5.0;Industry 4.0;Transformation;AI;human-centric manufacturing},
  doi={10.1109/GIET65294.2025.11234847},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11229546,
  author={Mbara, Jules Martial Yin-Belta and Jaafar, Fehmi and Tardif, Pierre Martin},
  booktitle={2025 7th International Conference on Blockchain Computing and Applications (BCCA)}, 
  title={TwinIpfsChain: Ensuring Decentralized Data Integrity in Real-Time Digital Twins for Industry 5.0 Using Blockchain and IPFS}, 
  year={2025},
  volume={},
  number={},
  pages={554-561},
  abstract={Digital twins have become essential to Industry 5.0, enabling continuous synchronization between physical systems and their digital counterparts. They support predictive maintenance, operational efficiency, and data-driven decision-making. Several solutions for ensuring integrity of static data are available. However, ensuring the integrity and trustworthiness of data exchanged in real time remains a major challenge, particularly in decentralized industrial environments prone to tampering, high latency, and performance bottlenecks. This paper presents TwinIpfsChain, a decentralized architecture that combines the Solana blockchain and IPFS to guarantee secure, verifiable, and scalable data management for digital twins. The proposed approach stores sensor data hashes on-chain, while the full data is preserved in InterPlanetary File System (IPFS). A smart contract manages automatic integrity verification and enforces access control.TwinIpfsChain ensures real-time synchronization of high-frequency sensor data for digital twins in Industry 5.0. We implemented and evaluated the system under varying transaction loads $(\mathbf{1, 0 0 0 - 1 0, 0 0 0})$ to assess performance across key metrics: latency, throughput, energy consumption, and security. Our results show that TwinIpfsChain achieves low latency (average 218 ms), high throughput (up to 26,457 TPS), low power usage (under 13 W), and $100 \%$ detection of tampering, hash manipulation & replay attacks. Transaction costs remain negligible 0.84 USD per 1,000 transactions making our solution viable for resource constrained industrial deployments. Compared to existing blockchain-based models, TwinIpfsChain offers stronger real-time guarantees, improved scalability, and robust protection against data integrity threats, positioning it as a practical and high-performance solution for digital twin applications in Industry 5.0.},
  keywords={Data integrity;Scalability;Smart contracts;Throughput;Real-time systems;Digital twins;Blockchains;InterPlanetary File System;Synchronization;Fifth Industrial Revolution;Digital Twin;Solana Blockchain;IPFS;Data Integrity;Industry 5.0;Smart Contract;Cybersecurity},
  doi={10.1109/BCCA66705.2025.11229546},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11233813,
  author={Garside, Annisa Kesy and Muhtazaruddin, Mohd Nabil and Ahmad, Robiah and Yusoff, Nelidya Md and Mad Kaidi, Hazilah and Sarip, Shamsul},
  booktitle={2025 IEEE 11th International Conference on Smart Instrumentation, Measurement and Applications (ICSIMA)}, 
  title={Integrating IoT Sensors and Data Analytics to Optimize the Sustainable Production Routing Problem in Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={74-79},
  abstract={This study presents a conceptual framework that integrates Internet of Things (IoT) sensors and data analytics into the Sustainable Production Routing Problem (SUPRP), aligning with Industry 5.0 principles. The framework enables real-time parameter estimation by processing sensor data through descriptive and predictive analytics, capturing dynamic conditions such as cost, emissions, and safety risks. These estimated parameters serve as inputs to a multi-objective optimization model solved using exact or metaheuristic methods. Compared to static approaches, the proposed architecture supports adaptive and sustainability-oriented decision-making across production and distribution planning. While implementation is left for future work, the framework provides a structured foundation for real-world applications in smart manufacturing and logistics.},
  keywords={Data analysis;Production;Sensor phenomena and characterization;Routing;Sensor systems and applications;Real-time systems;Safety;Fifth Industrial Revolution;Predictive analytics;Intelligent sensors;sustainable;production routing problem;IoT sensors;data analytics;multi-objective optimization;industry 5.0},
  doi={10.1109/ICSIMA66552.2025.11233813},
  ISSN={2640-6535},
  month={Sep.},}@INPROCEEDINGS{11230753,
  author={Çubukçu, Aykut and Çubukçu, Özlem},
  booktitle={2025 IEEE Conference on Standards for Communications and Networking (CSCN)}, 
  title={Designing Industrial Private Networks with 3GPP Slicing: Deployment Models for Dedicated and Shared Network Functions}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={The deployment of industrial private networks is essential for enabling Industry 5.0 applications, which require high reliability, low latency, and customized services. These requirements can be provided by network slicing which offers the ability to create multiple virtual networks on a single physical network infrastructure. This paper discusses the design aspects of 5G private networks through the lens of 3GPP network slicing, whether they are deployed on-premises or provided by Mobile Network Operators (MNOs). The paper focuses on how dedicated and shared network functions will be deployed within the slices. The proposed design provides standards-compliant guidelines for deploying flexible, slice-aware private 5G networks.},
  keywords={5G mobile communication;Network slicing;Process control;Ultra reliable low latency communication;Production facilities;3GPP;Time factors;Reliability;Standards;Lenses;Private networks;3GPP;Network Slicing},
  doi={10.1109/CSCN67557.2025.11230753},
  ISSN={2644-3252},
  month={Sep.},}@INPROCEEDINGS{11229060,
  author={Arazzi, Marco and Ligari, Davide and Nicolazzo, Serena and Nocera, Antonino},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Augmented Knowledge Graph Querying leveraging LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Adopting Knowledge Graphs (KGs) as a structured, semantic-oriented, data representation model has significantly improved data integration, reasoning, and querying capabilities across different domains. This is especially true in modern scenarios such as Industry 5.0, where the integration of data from humans, smart devices, and production processes is crucial, not only for industrial innovation, but also for supporting the digital transition of government administrations and organizations. However, the management, retrieval, and visualization of data from a KG using formal query languages can be difficult for non-expert users due to their technical complexity, thus limiting their usage inside industrial environments. For this reason, we introduce SparqLLM, a framework that utilizes a Retrieval-Augmented Generation (RAG) solution, to enhance the querying of Knowledge Graphs (KGs). SparqLLM executes the Extract, Transform, and Load (ETL) pipeline to construct KGs from raw data. It also features a natural language interface powered by Large Language Models (LLMs) to enable automatic SPARQL query generation. By integrating template-based methods as retrieved-context for the LLM, SparqLLM enhances query reliability and reduces semantic errors, ensuring more accurate and efficient KG interactions. Moreover, to improve usability, the system incorporates a dynamic visualization dashboard that adapts to the structure of the retrieved data, presenting the query results in an intuitive format. Rigorous experimental evaluations demonstrate that SparqLLM achieves high query accuracy, improved robustness, and user-friendly interaction with KGs, establishing it as a scalable solution to access semantic data.},
  keywords={Accuracy;Large language models;Semantics;Retrieval augmented generation;Pipelines;Government;Data visualization;Knowledge graphs;Question answering (information retrieval);Data models;Knowledge Graph;Question Answering;NLP;SPARQL Query Generation;Ontology-Driven Data Modeling},
  doi={10.1109/IJCNN64981.2025.11229060},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{11232222,
  author={Ahmed, Ahmed I. and Elshiemy, Mohamed A. and Said, Lobna A. and Madian, Ahmed H.},
  booktitle={2025 7th Novel Intelligent and Leading Emerging Sciences Conference (NILES)}, 
  title={A Scalable Over-the-Air Firmware Distribution Architecture for Industry 5.0 Based on SoC}, 
  year={2025},
  volume={},
  number={},
  pages={471-476},
  abstract={This paper proposes a scalable and reliable over-the-air architecture that enables cloud wireless distribution of new firmware updates on industrial production lines’ System-on-Chip (SoC) boards. The proposed architecture integrates remotely interconnected embedded and software systems, which maintain the operation of a bitstream file programming system over a Wi-Fi network. A software Joint Test Action Group (JTAG) protocol emulation is custom-developed on an Espressif ESP-32 Wi-Fi MCU for a target SoC board programming using Open On-Chip Debugger (OpenOCD) and GPIO Bit-Banging. Simulations are performed using Flutter Web, Android, and iOS applications to upload a bitstream file to Google Firebase Cloud Storage, yielding matching results according to the proposed architecture. Various experimental works are conducted on two Digilent Nexys 4 Artix-7 FPGA Trainer Boards, achieving efficient OTA updating speeds of 6.50s, 22.42s, 55s, and 80.10s for different bitstream file sizes of 370KB, 1.50MB, 3.68MB, and 5.36MB, respectively.},
  keywords={Protocols;Wireless networks;Emulation;System-on-chip;Software reliability;Fifth Industrial Revolution;Wireless fidelity;Field programmable gate arrays;Binary sequences;Microprogramming;OTA Firmware Distribution;Industry 5.0;ESP-32;System-on-Chip;Flutter Framework;Wi-Fi},
  doi={10.1109/NILES68063.2025.11232222},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11229912,
  author={Paudyal, Rajendra and Upadhyay, Rajendra and Emran, Al Nahian Bin and Wijesekera, Duminda},
  booktitle={2025 IEEE 30th International Workshop on Computer Aided Modeling and Design of Communication Links and Networks (CAMAD)}, 
  title={gNB-based Local Breakout for URLLC in industrial 5G}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Industrial URLLC workloads-coordinated robotics, automated guided vehicles, machine-vision collaboration require sub-5 ms latency and five-nines reliability. In standardized 5G Multicast/Broadcast Services, intra-cell group traffic remains anchored in the core using MB-SMF/MB-UPF, and the Application Function. This incurs a core network path and packet delay that is avoidable when data transmitters and receivers share a cell. We propose a gNB-local multicast breakout that pivots eligible uplink flows to a downlink point-to-multipoint bearer within the gNB, while maintaining authorization, membership, and policy in the 5G core. The design specifies an eligibility policy, configured-grant uplink. 3GPP security and compliance are preserved via unchanged control-plane anchors. A latency budget and simulation indicate that removing the backhaul/UPF/AF segment reduces end-to-end latency from ≈6.5–11.5 ms (anchored to the core) to ≈1.5–4.0 ms (local breakout), producing sub-2 ms averages and a stable gap ≈10 ms between group sizes. The approach offers a practical, standards-aligned path to deterministic intra-cell group dissemination in private 5G. We outline multi-cell and prototype validation as future work.},
  keywords={Remotely guided vehicles;5G mobile communication;Transmitters;Service robots;Prototypes;Receivers;Ultra reliable low latency communication;Security;Reliability;Uplink;5G;URLLC;NG-RAN;6G;multicast;MBS;Industry 4.0;Industry 5.0;private 5G;MB-UPF;local breakout},
  doi={10.1109/CAMAD67323.2025.11229912},
  ISSN={2378-4873},
  month={Oct},}@INPROCEEDINGS{11229913,
  author={Hofer, Florian and Venanzi, Riccardo},
  booktitle={2025 IEEE 30th International Workshop on Computer Aided Modeling and Design of Communication Links and Networks (CAMAD)}, 
  title={Beyond the Virtual PLC Networking Constraints: MACvLAN Approach in Industrial Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The convergence of Information Technology (IT) and Operational Technology (OT) in Industry 4/5.0 is driving the adoption of virtualized control systems capable of running on shared, flexible computing infrastructures. Containerized virtual Programmable Logic Controllers (vPLCs) offer scalability, simplified lifecycle management, and seamless integration with cloud–edge computing architectures; however, they must still meet the strict real-time communication constraints required by industrial Ethernet protocols. When multiple vPLCs share a physical network interface, software-based port sharing mechanisms— such as the Linux MACvLAN driver—can reduce hardware costs and complexity. Yet, their impact on deterministic communication remains insufficiently characterized. This paper evaluates the networking performance of containerized virtual Programmable Logic Controllers (vPLCs) communicating over ProfiNET RT when sharing a physical Ethernet interface via the Linux MACvLAN driver. We deploy two vPLCs on both embedded and general-purpose edge devices, with and without real-time kernel optimizations and CPU-pinning. Experimental results show that even unoptimized embedded platforms meet the jitter requirements for most ProfiNET RT classes, while optimized edge devices achieve sub-3 μs jitter and 1–2 μs additional delay, enabling their use in demanding RT Level 3 applications, such as motion control. These findings confirm that MACvLAN-based port sharing is a viable approach for scalable, cost-effective vPLC deployments, paving the way for broader adoption of containerized control in IT/OT convergent environments.},
  keywords={Performance evaluation;Protocols;Linux;Scalability;Programmable logic devices;Ethernet;Jitter;Real-time systems;Network interfaces;Optimization;Virtual PLC;Industry 4.0;IT/OT Integration;MACvLAN;ProfiNET;Jitter},
  doi={10.1109/CAMAD67323.2025.11229913},
  ISSN={2378-4873},
  month={Oct},}@INPROCEEDINGS{11229911,
  author={Colombi, Lorenzo and Belletti, Nicolas and Ferrari, Lucia and Tabanelli, Filippo and Dahdal, Simon and Ngatcha, Franck and Venanzi, Riccardo and Tortonesi, Mauro and Stefanelli, Cesare},
  booktitle={2025 IEEE 30th International Workshop on Computer Aided Modeling and Design of Communication Links and Networks (CAMAD)}, 
  title={Exploring Explainable and Causal AI for Feature Selection in Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent advances in Machine Learning (ML) are revolutionizing industrial processes, particularly in the context of Industry 5.0, which promotes sustainable and intelligent manufacturing practices such as Zero Waste Manufacturing. However, the application of ML in industrial settings is often constrained by limited labeled data and the high dimensionality of sensor inputs, which hinders both model performance and interpretability. This study addresses the challenges of high-dimensional industrial data by evaluating conventional Feature Selection and Feature Extraction methods, such as ANOVA, Mutual Information, and PCA, as well as more advanced techniques based on Explainable AI (XAI) and Causal AI. In addition to benchmarking traditional methods, we experiment with a novel hybrid feature selection approach that combines SHAP-based feature importance analysis with causal discovery techniques. Experimentation was conducted using a real-world dataset from Carpigiani, a leading manufacturer of ice cream production machines. We aim to predict mixture filling levels to prevent critical freezing events during production. Our results demonstrate that integrating XAI and Causal AI enables the development of more interpretable and reliable ML models, thereby enhancing computational efficiency and decision transparency, a key requirement in Industry 5.0 applications.},
  keywords={Explainable AI;Computational modeling;Production;Feature extraction;Ice;Manufacturing;Reliability;Fifth Industrial Revolution;Mutual information;Principal component analysis;Industry 5.0;Zero Waste Manufacturing;Machine Learning;Feature Selection;Explainable AI;Causal AI},
  doi={10.1109/CAMAD67323.2025.11229911},
  ISSN={2378-4873},
  month={Oct},}@INPROCEEDINGS{11229916,
  author={Tsegaye, Henok B. and Tshakwanda, Petro M. and Karukutla, Ashok and Almaayn, Raddad and Worku, Yonatan M. and Kumar, Harsh and Devetsikiotis, Michael},
  booktitle={2025 IEEE 30th International Workshop on Computer Aided Modeling and Design of Communication Links and Networks (CAMAD)}, 
  title={SDN-Integrated Cloud-Edge Digital Twin Framework for Real-Time Monitoring in Additive Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Emerging paradigms such as cloud-edge continuum, Software-Defined Networking (SDN), and Digital Twin (DT) technologies are transforming smart manufacturing systems by enabling intelligent automation, real-time monitoring, and scalable orchestration. These capabilities are particularly critical in additive manufacturing (AM), where latency-sensitive control and predictive maintenance are essential. However, current architectures often require dynamic network programmability, synchronized twin management, and secure telemetry pipelines. This paper presents an SDN-Integrated Cloud-Edge DT Framework tailored for real-time AM monitoring. The framework integrates KubeEdge’s DeviceTwin module for edge-local twin representation, a telemetry agent for structured data streaming, and SDN-controlled Open vSwitch (OVS) for adaptive traffic control. IoT-enabled AM devices, including 3D printers, CNC machines, and robotic arms, interface with the edge node for local state caching, while KubeEdge’s CloudCore aggregates device states for analytics, visualization, and policy enforcement. Experimental validation on a Kubernetes cluster demonstrates sub-100-ms twin synchronization, SDN enforcement under 312 ms, and streaming latency breakdowns across MQTT-Kafka stages. This work establishes a scalable, resilient, and programmable foundation for next-generation, Industry 5.0 manufacturing ecosystems.},
  keywords={Cloud computing;Traffic control;Three-dimensional printing;Real-time systems;Digital twins;Telemetry;Synchronization;Software defined networking;Fifth Industrial Revolution;Edge computing;Digital Twin;Additive Manufacturing;Software-Defined Networking;Real-Time Monitoring;Cloud-Edge Continuum;Industry 5.0},
  doi={10.1109/CAMAD67323.2025.11229916},
  ISSN={2378-4873},
  month={Oct},}@INPROCEEDINGS{11220391,
  author={Romano, Sara and Marangelli, Luana and Laviola, Enricoandrea and Uva, Antonio Emmanuele and Gattullo, Michele},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality (ISMAR)}, 
  title={Can AI Inspire Biophilic Design in Immersive Virtual Reality Workspaces to Enhance Well-Being?}, 
  year={2025},
  volume={},
  number={},
  pages={1575-1585},
  abstract={Due to the growing adoption of Immersive Virtual Reality (IVR) in various contexts, understanding how virtual workspaces impact humans and how they should be designed is crucial. Exploring optimal design strategies that can enhance well-being within IVR environments becomes important. In real contexts, biophilic design offers a way to improve well-being by introducing natural elements. IVR can go beyond real-world constraints for integrating biophilic elements, but this aspect is scarcely addressed in literature. A valuable assistance to support the design of IVR workspaces could be offered by generative Artificial Intelligence (AI), which is becoming increasingly integrated into everyday life. The aim of this work is twofold: (i) assessing if the biophilic design of IVR workspaces can improve human well-being and (ii) investigating if AI can inspire the biophilic design properly. Thus, we conducted a user study comparing psycho-physiological and subjective metrics in three conditions. A workspace without biophilia was used as a baseline. The same was enriched with two biophilic designs: one suggested by expert designers and another inspired by AI-generated graphics, simulating a not-expert developer. The findings showed that both biophilic designs significantly improved well-being; however, AI suggestions led to a reduced sense of presence in the IVR environment.},
  keywords={Measurement;Generative AI;Psychophysics;Fifth Industrial Revolution;Augmented reality;Biophilic Design;well-being;Virtual Reality;generative artificial intelligence;industry 5.0},
  doi={10.1109/ISMAR67309.2025.00161},
  ISSN={2473-0726},
  month={Oct},}@INPROCEEDINGS{11217093,
  author={Falceso, Jane Faith F. and Blancia, Garry Vanz V. and Fetalvero, Eddie G. and Catajay-Mani, Merian P. and Gacu, Jerome G.},
  booktitle={2025 Moratuwa Engineering Research Conference (MERCon)}, 
  title={Comparative Effects of Ground Calcium Carbonate and Marble Dust on Morphological and Yield Responses of Corn (Zea Mays) in Acidic Soils}, 
  year={2025},
  volume={},
  number={},
  pages={19-24},
  abstract={Acidic soil hinders crop production by limiting nutrient availability and plant growth; marble dust, a byproduct of the marble processing industry, can be a sustainable soil amendment. This study evaluated Ground Calcium Carbonate (GCC) and Marble Dust (MD) as soil amendments to improve soil pH and enhance corn growth. GCC, refined from MD using a ball mill roller, and MD, directly sourced from marble processing waste, were applied at five levels: 0 g (control), $125\ \mathrm{g}, 250\ \mathrm{g}, 375\ \mathrm{g}$, and 500 g per pot. Conducted in a screenhouse using a split-plot completely randomized design, the study assessed stalk diameter, plant height, corn weight, and soil pH. ANOVA and Tukey's HSD tests revealed significant improvements across treatments, with ${2 5 0 \mathrm{g}}$ and ${3 7 5 \mathrm{g}}$ applications achieving optimal results. Soil pH increased from 5.3 to over 8.0, and corn yield improved notably. However, higher application rates $(500\ \mathrm{g})$ offered no additional benefits, indicating diminishing returns. GCC consistently outperformed MD in enhancing growth. Both materials effectively ameliorate acidic soils, with optimal application rates between 250 g and 375 g per pot. Further field trials are recommended to validate these results on a larger scale.},
  keywords={Industries;Limiting;Process control;Crops;Production;Soil;Nutrients;Calcium compounds;Analysis of variance;acidic soils;soil ameliorants;marble dust;ground calcium carbonate;corn growth},
  doi={10.1109/MERCon67903.2025.11217093},
  ISSN={2691-364X},
  month={Aug},}@INPROCEEDINGS{11216981,
  author={Bandara, Amila and Thibbotuwawa, Amila and Perera, H. Niles},
  booktitle={2025 Moratuwa Engineering Research Conference (MERCon)}, 
  title={Redesigning Supply Chains for Industry 5.0 in Developing Economies: A Research Agenda}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Unlike the previous industry revolutions that were predominantly focused on enhancing the efficiency of industrial systems, Industry $\mathbf{5. 0}$ (I5.0) aims at transforming global industries to become more sustainable, resilient, and human-centric. This paper brings a much-needed developing economy perspective to the debate on the interplay between $\mathbf{5. 0}$ and supply chain (SC). A sample of 89 peer-reviewed journal articles was selected from SCOPUS and Web of Science databases through a systematic literature review. The network co-occurrence diagram revealed three prominent research clusters, namely: SC Process Improvement, SC Resilience, and SC Sustainability. Research gap analysis revealed several future research directions: Promoting the adoption of $\mathbf{1 5. 0}$ in Developing Economies, Human-centered SCs, Emerging technology applications Strategy roadmaps to adopt I5.0, and $\mathbf{I 5. 0}$ certification and compliance. These directions can be used by future researchers, industries and intergovernmental organizations to streamline their efforts to popularize $\mathbf{1 5. 0}$ in SCs operating at developing economies.},
  keywords={Industries;Graphical models;Databases;Supply chains;Organizations;Stakeholders;Sustainable development;Fifth Industrial Revolution;Systematic literature review;Resilience;industry 5.0;supply chain;developing economies;sustainability;resilience;human centricity},
  doi={10.1109/MERCon67903.2025.11216981},
  ISSN={2691-364X},
  month={Aug},}@INPROCEEDINGS{11224081,
  author={Belgada, Khira and El Abbadi, Laila},
  booktitle={2025 IEEE 8th Congress on Information Science and Technology (CiSt)}, 
  title={Exploring Industry 4.0 and 5.0 Technologies: a Systematic Review of Emerging Transitions and Applications}, 
  year={2025},
  volume={},
  number={},
  pages={635-640},
  abstract={With the emergence of Industry 4.0 and 5.0, industrial ecosystems are undergoing profound transformations. This study provides a systematic review of the literature to analyze the technological, human, and environmental dimensions of these paradigms. Using Kitchenham's methodological model and the VOSviewer bibliometric tool, 56 articles were examined. The results highlight the convergence of advanced technologies (digital twins, blockchain, augmented reality) with the challenges of sustainability and human-centered innovation. While Industry 4.0 emphasizes automation and intelligent systems, Industry 5.0 introduces a new dynamic based on human-machine collaboration and ethical values. This summary identifies key technologies and major challenges and proposes concrete avenues for future research.},
  keywords={Technological innovation;Supply chains;Collaboration;Production;Fourth Industrial Revolution;Digital twins;Blockchains;Fifth Industrial Revolution;Sustainable development;Systematic literature review;Industry 4.0;industry 5.0;reduction of non quality costs;advanced technologies;systematic literature review},
  doi={10.1109/CiSt65886.2025.11224081},
  ISSN={2327-1884},
  month={Oct},}@INPROCEEDINGS{11224172,
  author={Barros, Daniel S. and Da Cruz, António M. R. and Lopes, Sérgio Ivan},
  booktitle={2025 IEEE 8th Congress on Information Science and Technology (CiSt)}, 
  title={Industrial Communication Networks (ICNets) in the Industry 5.0 Era: A QoS-Centric Perspective}, 
  year={2025},
  volume={},
  number={},
  pages={244-249},
  abstract={Reshaping the industrial manufacturing landscape in the ongoing evolution of Industry 4.0 (I4.0), the Industry 5.0 (I5.0), focuses on human-machine collaboration, operator wellbeing and sustainable manufacturing practices. Their common foundation are the Industrial Communication Networks (ICNets) infrastructures that allow the interaction between humans and machines. This paper provides a perspective analysis of network architectures and communication protocols in I5.0 from a Quality-of-Service (QoS)-based perspective. The review explores the historical context, terminology, and concepts, addressing the challenges and opportunities in current ICNets. The adopted methodology focuses on a state-of-the-art review which selected and analyzed literature from the last 8 years, under the topic of QoS in ICNets, regarding the I4.0 and I5.0 application domains. Key findings from various works, frameworks, and technologies are categorized, highlighting metrics such as latency, packet loss, bandwidth, and throughput, among others. Despite the inconsistent use of terminology, these works align with industry requirements, showcasing the importance of low latency in decision-making processes. The literature analysis reveals a diverse range of technologies, including Wi-Fi, LoRaWAN, IEEE 802.15.13, and communication protocols such as Message Queuing Telemetry Transport (MQTT) and Constrained Application Protocol (CoAP). However, notably, the adoption of traditional TCP/IP standards in ICNets is accelerating at a fast pace. This prospective analysis also identifies the unique challenges posed by wireless communication in industrial environments. Final remarks include a synthesis of the main findings, highlighting the need for standardized terminology and the importance of latency as a critical QoS metric toward I5.0.},
  keywords={Wireless communication;Protocols;Terminology;Reviews;Quality of service;TCPIP;Throughput;Fifth Industrial Revolution;Standards;Wireless fidelity;Industry 5.0;Information Technology;Operational Networks;Quality of Service},
  doi={10.1109/CiSt65886.2025.11224172},
  ISSN={2327-1884},
  month={Oct},}@INPROCEEDINGS{11224082,
  author={Amorim, Ivan and Lopes, Sérgio Ivan},
  booktitle={2025 IEEE 8th Congress on Information Science and Technology (CiSt)}, 
  title={Cognitive Cells and Human-Robot Interaction in Industry 5.0: an Overview}, 
  year={2025},
  volume={},
  number={},
  pages={354-359},
  abstract={Industry 5.0 (I5.0) builds on the foundations of Industry 4.0 (I4.0) by placing greater emphasis on human centricity, collaboration, and adaptability within industrial systems. Although I4.0 has focused on efficiency and automation, it has often overlooked critical dimensions such as human well-being, creativity, and sustainability. I5.0 aims to bridge this gap by merging human capabilities with AI, IoT, and adaptive control to foster intelligent, responsive, and inclusive production environments. This paper makes two main contributions. First, it provides an overview of the current literature on cognitive cells and human-robot interaction in the context of Industry 5.0, identifying key trends, challenges, and enabling technologies. Second, it introduces the conceptual architecture for a human-aware cognitive cell that integrates perception, behavioral adaptation, ergonomic feedback, and collaborative robotic execution. This architecture aims to demonstrate how human-machine co-creation can be effectively supported in real-world manufacturing environments, contributing to the broader vision of a human-centric and resilient industrial future.},
  keywords={Adaptation models;Service robots;Human-robot interaction;Collaboration;Prototypes;Computer architecture;Real-time systems;Production facilities;Fifth Industrial Revolution;Artificial intelligence;Industry 5.0;Human-Centric Manufacturing;Cognitive Factories;Collaborative Robotics;Human-Robot Interaction (HMI);Computer Vision;ROS2.0},
  doi={10.1109/CiSt65886.2025.11224082},
  ISSN={2327-1884},
  month={Oct},}@INPROCEEDINGS{11221430,
  author={Abunike, Chiweta E. and Okoro, Ogbonnaya I. and Aphale, Sumeet S.},
  booktitle={IECON 2025 – 51st Annual Conference of the IEEE Industrial Electronics Society}, 
  title={A Sequential Optimization Strategy for Electric Machines Targeting Torque Ripple Reduction and Energy Efficiency in Industrial Drive Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a robust and scalable multiobjective optimization framework for Flux-Switching Wound Field Machines (FSWFMs), integrating Design for Six Sigma (DFSS), surrogate modeling via Response Surface Methodology (RSM), and a Multi-Objective Sequential Optimization Method (MSOM). The proposed framework simultaneously minimizes torque ripple, maximizes efficiency, and ensures robustness under uncertainty. Sensitivity analysis identified key design variables—including rotor outer diameter, tooth width, and excitation current—thereby reducing the design space dimensionality and enhancing computational efficiency. Finite Element Analysis (FEA) was employed to generate training data, while the surrogate models guided iterative refinement. The DFSS-MSOM method achieved 90.4% efficiency, average torque of 53.4 Nm, and significantly reduced torque ripple to 4.57%, compared to 9.86% in the deterministic baseline. Notably, the design achieved zero probability of failure (PoF = 0.00), confirming six-sigma quality and high manufacturing consistency. The final hypervolume convergence error was 3.59%, validating the effectiveness of the optimization trajectory. This approach achieved a 56.8% reduction in FEA calls and demonstrates high scalability and adaptability to industrial electric drive systems. Its alignment with Industry 5.0 goals makes it well-suited for next-generation smart grid, e-mobility, and energy-efficient propulsion applications.},
  keywords={Uncertainty;Torque;Sensitivity analysis;Wounds;Energy efficiency;Manufacturing;Smart grids;Torque measurement;Optimization;Six sigma;Robust Optimization;Flux-Switching Wound Field Machines;Design for Six Sigma;Heavy-Duty Machinery;Manufacturing Tolerances},
  doi={10.1109/IECON58223.2025.11221430},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11221035,
  author={Ouarab, Sarah and Garcia, David and Ragot, Nicolas and Dupuis, Yohan},
  booktitle={IECON 2025 – 51st Annual Conference of the IEEE Industrial Electronics Society}, 
  title={Improving Image-Based Tool Detection in Industrial Workstations using Data Augmentation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Within the framework of Industry 5.0, affordances enable intuitive and adaptive interactions between operators and their industrial work environments. Accurately perceiving these affordances enhances overall production performance, safety, and operator effectiveness. This paper focuses on the initial step of a larger affordance characterization pipeline: detecting tools used by operators during manual assembly tasks. To address the challenges of data scarcity and annotation effort in industrial contexts, we train a custom YOLOv9-based deep learning model on a data-augmented dataset combining real-world and synthetic images, automatically generated from a digital model of an industrial workstation in Unity3D. Through extensive experiments, we varied dataset sizes (50–300 images) and real-world data proportions in the data-augmented train datasets (0%–50%), to assess their impact on tool detection. Results show that only 10% of real-world data is sufficient to achieve strong performance across all data-augmented dataset sizes. A tool specific analysis reveals that visual characteristics such as size and shape influence detection. These findings highlight the effectiveness of combining synthetic and real data to reduce annotation effort while supporting robust tool detection for affordance characterization.},
  keywords={Deep learning;Visualization;Annotations;Affordances;Data augmentation;Data models;Workstations;Fifth Industrial Revolution;Assembly;Context modeling;Affordance;industry 5.0;industrial workstation;assembly process;object detection;deep learning;digital model;data augmentation},
  doi={10.1109/IECON58223.2025.11221035},
  ISSN={},
  month={Oct},}@ARTICLE{11226997,
  author={Ling, Qin and Kai, Cui and Wenyuan, Zhang},
  journal={IEEE Access}, 
  title={DCD-Net: Dense Component Detection Network for Printed Circuit Board Assembly Inspection}, 
  year={2025},
  volume={13},
  number={},
  pages={190491-190505},
  abstract={Electronic components in the printed circuit board assembly (PCBA) exhibit great diversities in categories, visual appearances and geometric dimensions. Efficient and precise detection for dense components is crucial and challenging for early quality inspection. Therefore, this paper proposes a novel dense component detection network (DCD-Net) established on a few improvements upon YOLO11-nano. First, a novel lighter GFConv block integrating Ghost convolution and a channel fusion operation is built to downsize the model, meanwhile enhancing the detection precision. Second, a creative C3DS module incorporating dynamic snake convolution is designed for excellent adaptability to diverse geometric forms and the large-scale variance of electronic components. Finally, FC-IoU loss involving the hard-easy sample distribution is proposed to facilitate the bounding box regression, boosting the positioning accuracy. The experiment results verify that the proposed DCD-Net achieves remarkable mean average precision of 91.6% (mAP@0.5) and 77.9% (mAP@0.5:0.95), exceeding 0.9% and 2.4% increments separately than YOLO11-nano. In addition, a 93 frames/s inference speed is achieved for inputs with  $640\times 640$  pixel resolution, demonstrating its notable potential to realize real-time industry applications. The code is available at https://github.com/lqin0818/DCD-Net/tree/master},
  keywords={Accuracy;Feature extraction;Inspection;Real-time systems;Convolution;Assembly;Genetic algorithms;Convolutional neural networks;Location awareness;Image matching;Dense PCBA component;deep learning;high-precision;real-time;regression loss},
  doi={10.1109/ACCESS.2025.3629085},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11220080,
  author={Xie, Weijun and Guo, Qing and Ru, Shenao and Chen, Botong},
  booktitle={2025 IEEE 2nd International Conference on Big Data Science and Engineering (ICBDSE)}, 
  title={Research on Camellia Seed Recognition and Classification Based on Improved ResNet Network}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Camellia oleifera is a unique woody oil crop in our country, and developing the camellia oil industry is an important way to practice the big food concept and alleviate the contradiction between grain and oil supply and demand. During the harvesting and processing of camellia oleifera, some natural and artificial impurities are introduced, and their identification and removal usually rely on manual work, which has strong subjectivity, high costs, and low efficiency. Aiming at the current gap in automatic impurity identification after camellia fruit dehulling, this study proposes a deep learning method for camellia seed impurity identification that integrates an attention mechanism. First, through transfer learning, the performance of six classic deep learning models on the camellia seed impurity dataset was compared, and ResNet50, which had the highest model performance, was selected as the base framework for subsequent improvements. Then, an attention mechanism was introduced into ResNet50 to obtain an improved model (PSA50), and the activation function of PSA50 was optimized. The results show that the PSA50 model with the Mish activation function performs the best, with an impurity identification accuracy, recall, specificity, precision, and identification rate of $\mathbf{9 8. 5 1 \%, 9 8. 4 8 \%, 9 9. 5 0 \%, 9 8. 5 5 \%, \text { and }}$ 92 per second, respectively. The camellia seed impurity identification method proposed in this study lays a technical foundation for precise and efficient impurity removal in the future camellia processing process, showing broad application prospects.},
  keywords={Deep learning;Attention mechanisms;Supply and demand;Impurities;Oils;Transfer learning;Seeds (agriculture);Petroleum industry;Optimization;Residual neural networks;Camellia seeds;attention mechanism;activation function optimization},
  doi={10.1109/ICBDSE65491.2025.11220080},
  ISSN={},
  month={June},}@INPROCEEDINGS{11217866,
  author={Fant-Male, James and Pieters, Roel},
  booktitle={2025 34th IEEE International Conference on Robot and Human Interactive Communication (RO-MAN)}, 
  title={A Review of Personalisation in Human-Robot Collaboration and Future Perspectives Towards Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={223-230},
  abstract={The shift in research focus from Industry 4.0 (I4.0) to Industry 5.0 (I5.0) promises a human-centric workplace, with social and well-being values at the centre of technological implementation. Human-Robot Collaboration (HRC) is a core aspect of I5.0 development, with an increase in adaptive and personalised interactions and behaviours. This review investigates recent advancements towards personalised HRC, where user-centric adaptation is key. There is a growing trend for adaptable HRC research, however there lacks a consistent and unified approach. The review highlights key research trends on which personal factors are considered, the design of human-robot interaction, and adaptive task completion. This raises various key considerations for future developments, particularly around the ethical and regulatory development of personalised systems, which are discussed in detail.},
  keywords={Ethics;Reviews;Service robots;Employment;Human-robot interaction;Collaboration;Market research;Fourth Industrial Revolution;Fifth Industrial Revolution},
  doi={10.1109/RO-MAN63969.2025.11217866},
  ISSN={1944-9437},
  month={Aug},}@INPROCEEDINGS{11211498,
  author={Andreev, Sergei and Herman, Krzysztof and Di Pietrantonio, Giovanni and Baade-Pedersen, Phillip Ferreira},
  booktitle={2025 IEEE BiCMOS and Compound Semiconductor Integrated Circuits and Technology Symposium (BCICTS)}, 
  title={IHP OpenPDK Initiative: Bringing Open Source to Analog and RF Design}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents an extended discussion of the analog and RF capabilities of the IHP-Open130-G2, a 130 nm SiGe:C BiCMOS open-source process design kit (PDK). The IHP-Open130-G2 provides an advanced platform for designing highperformance analog, mixed-signal, and RF integrated circuits, filling a crucial gap in the open-source silicon ecosystem. By leveraging high-speed heterojunction bipolar transistors (HBTs) with $\mathbf{f}_{T} / \mathbf{f}_{\text {max}}=\mathbf{3 5 0} / \mathbf{4 5 0 ~ G H z}$, as well as robust CMOS and passive elements, the PDK supports the development of next-generation RF and mm-wave applications. We also explore the key features, design flow integration, available components, and potential applications in academia and industry.},
  keywords={Radio frequency;Semiconductor device modeling;Industries;Technological innovation;Layout;BiCMOS integrated circuits;Silicon;Integrated circuit modeling;Next generation networking;Silicon germanium;open-source PDK;BiCMOS;RF design;SiGe HBT},
  doi={10.1109/BCICTS63111.2025.11211498},
  ISSN={2831-4999},
  month={Oct},}@ARTICLE{11222721,
  author={Li, Weihao and Shi, Mengji and Han, Chenglin and Lin, Boxian and Qin, Kaiyu},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={Neuroadaptive Fixed-Time Containment Tracking of Networked Agent Systems for Industry 5.0}, 
  year={2025},
  volume={71},
  number={4},
  pages={10294-10307},
  abstract={In the era of Industry 5.0, achieving rapid and robust coordination in networked agent systems (NASs) is essential for enabling intelligent collaborative autonomy. To this end, this paper investigates the distributed fixed-time containment tracking problem for NASs subject to input saturation and lumped uncertainties. A novel fixed-time extended state observer (FxTESO) is first proposed to estimate uncertain leader dynamics without requiring prior knowledge of system bounds. Then, a neural network-based adaptive estimator is developed to compensate for unknown model uncertainties and external disturbances affecting follower agents. To guarantee control feasibility under actuator limitations, an auxiliary dynamic system (ADS) is introduced to suppress control inputs while preserving fixed-time convergence. Rigorous Lyapunov-based analysis establishes the closed-loop stability and provides an explicit, initial-condition-independent bound on the settling time. Simulation results validate the effectiveness of the proposed control scheme. Comparative studies further demonstrate that, in contrast to existing fixed-time controllers, the proposed approach improves tracking accuracy and ensures input constraint compliance, thereby enhancing robustness and practical implementability. To sum up, this distributed control scheme addresses the fixed-time coordination problem of NASs, enhancing cooperative control robustness in networked multiple quadrotors or large-scale robot groups in engineering applications for Industry 5.0.},
  keywords={Uncertainty;Convergence;Fifth Industrial Revolution;Actuators;Robustness;Convex hulls;Protocols;Adaptive systems;Accuracy;Safety;Containment tracking;network agent systems;fixed-time convergence;lumped uncertainties;input saturation},
  doi={10.1109/TCE.2025.3626981},
  ISSN={1558-4127},
  month={Nov},}@ARTICLE{11222670,
  author={Romano, André Luiz and Henrique Dos Santos, Carlos and Koch, Christoph and Lourenço Ubeda, Cristina and Rorato Fogaça, Diego and César Almada Santos, Fernando and Freitas, Vérica},
  journal={IEEE Access}, 
  title={Startups in the Era of Industry 4.0 and 5.0: Technologies, Decisions, Framing, and Competences}, 
  year={2025},
  volume={13},
  number={},
  pages={187042-187057},
  abstract={This article investigates the evolving domain of Startup 4.0/5.0, which leverages advanced Industry 4.0 and 5.0 technologies to support startups’ processes and activities. As startups face increasing complexity and competitiveness, understanding how digital innovations and emerging approaches contribute to improved performance, agility, and innovation becomes essential. Through a systematic literature review of peer-reviewed articles published up to December 2024, this study maps the current research landscape. The review responds to key research questions related to business sectors, applied tools, decision objectives, conceptual framings, and required skills and competences. Findings reveal a growing yet still underexplored field, with multidisciplinary relevance and a concentration of research in countries like Brazil and Germany, spanning sectors such as Advanced Manufacturing, Agrotech, Healthcare, and Education. Most reviewed works emphasize technical, managerial, and market-oriented perspectives, focusing on productivity and competitiveness, while elements central to Industry 5.0, such as sustainability, human-centric design, and resilience, remain marginal, appearing in few studies. Decision objectives were classified into key areas, including innovation, sustainability, digital transformation, and interinstitutional collaboration, highlighting the strategic role of digital technologies in business model redesign and ecosystem development. Moreover, the review identifies critical competences required for professionals in Startup 4.0/5.0 contexts, organizing several core competences into personal, social, and cultural categories and linking them to specific technologies, aiming to inform workforce training and behavioral change. By synthesizing these insights, the article contributes to a deeper theoretical understanding of Startup 4.0/5.0 and offers practical implications for this field.},
  keywords={Fourth Industrial Revolution;Systematic literature review;Business;Fifth Industrial Revolution;Technological innovation;Resilience;Planning;Sustainable development;Ecosystems;Databases;Industry 4.0;Industry 5.0;startup;systematic literature review},
  doi={10.1109/ACCESS.2025.3627113},
  ISSN={2169-3536},
  month={},}@ARTICLE{11222569,
  author={Barbieri, Giacomo and Zapata, Freddy},
  journal={IEEE Access}, 
  title={From Silos to Synergy: A Serious Game for Cross-Functional Collaboration in Human-Centric Asset Management}, 
  year={2025},
  volume={13},
  number={},
  pages={188907-188928},
  abstract={Asset Management (AM) is an integrative discipline that relies on expert knowledge from diverse functions to develop holistic and coordinated solutions. However, the necessary division of responsibilities within and across organizations often leads to the formation of silos—isolated departments or teams that hinder communication and collaboration, ultimately undermining AM’s integrative nature. To address this challenge, a Serious Game (SG), From Silos to Synergy, was developed in this work. Guided by a Research through Design approach—where knowledge develops through iterative experimentation and the creation of artifacts—the SG aims to foster reflection on the relational and organizational dimensions of AM, thereby enabling the definition of cross-functional collaboration as a foundation of Human-Centric Asset Management (HuCAM). Grounded in a family finance analogy, the game integrates frameworks from AM, Industry 5.0, and game-based learning, underwent three design iterations, and was tested with 31 master’s students and 119 practitioners. The results indicate that the SG generated two main outcomes. On the one hand, it led to the creation of a Maturity Model for Cross-Functional Collaboration in HuCAM, offering a structured framework to evaluate and guide the transition toward more collaborative and human-centric AM practices. On the other hand, it fostered cultural awareness in cross-functional collaboration by challenging silo thinking and enhancing players’ understanding of the strategic and collaborative dimensions of AM. By promoting long-term value creation and human-centric thinking, From Silos to Synergy provides a practical and engaging pathway for developing the mindset and capabilities needed to tackle the complex, dynamic, and interdependent challenges of sustainability and resilience in modern asset systems.},
  keywords={Collaboration;Asset management;Organizations;Maintenance;Cultural differences;Stakeholders;Serious games;Fifth Industrial Revolution;Sustainable development;Resilience;Asset management;Industry 5.0;cross-functional collaboration;research through design;design thinking;analogy;serious game;game-based learning;change management},
  doi={10.1109/ACCESS.2025.3626989},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11212485,
  author={Gayathri, G. and Fathima, G.},
  booktitle={2025 6th International Conference on Electronics and Sustainable Communication Systems (ICESC)}, 
  title={Adaptive Digital Twin Systems with AR Interaction for Resilient and Sustainable Industrial Operations}, 
  year={2025},
  volume={},
  number={},
  pages={1230-1237},
  abstract={The integration of Augmented Reality (AR) with Digital Twin (DT) technology is increasingly recognized as a transformative approach for achieving resilient and sustainable industrial operations. This research presents an Adaptive Digital Twin (DT) framework integrated with Augmented Reality (AR) to enhance resilience, predictive intelligence, and sustainability in industrial operations. The proposed Immersive Sensing Digital Twin (ImmersiSense-Twin) algorithm combines real-time 3D point cloud acquisition, multimodal sensor fusion, and edge-deployed artificial intelligence to deliver immersive, context-aware operational insights. The system architecture leverages low-latency edge processing and AR-based visualization to facilitate rapid anomaly detection, predictive maintenance, and resource optimization in dynamic industrial environments. Simulation experiments were conducted using industrial time-series datasets in a controlled digital twin simulation testbed. Performance was evaluated against three benchmark algorithms: Deep Embedded Clustering (DEC), LSTM-Autoencoder for Industrial Time-Series (LSTM-AE), and Federated Learning-Based Predictive Maintenance Model (FedPM). The comparison was based on prediction accuracy, anomaly detection rate, latency, resource utilization efficiency, and AR rendering time. The ImmersiSense-Twin algorithm achieved notable improvements, including up to 9.3% higher prediction accuracy, 12.5% faster anomaly detection, and 14.8% better resource utilization efficiency compared to the best-performing baseline. The results validate the suitability of the proposed framework for Industry 4.0 and emerging Industry 5.0 environments, offering a pathway toward more resilient, intelligent, and sustainable industrial ecosystems. The findings demonstrate that the integration of adaptive DT systems with immersive AR interaction provides significant operational advantages, enabling proactive decision-making and reducing downtime in mission-critical industrial applications.},
  keywords={Accuracy;Adaptive systems;Three-dimensional displays;Edge AI;Prediction algorithms;Digital twins;Resource management;Anomaly detection;Augmented reality;Predictive maintenance;adaptive digital twin;anomaly detection;augmented reality;edge ai;immersisense-twin;industry 4.0;predictive maintenance;resilient operations;sustainable manufacturing},
  doi={10.1109/ICESC65114.2025.11212485},
  ISSN={2996-5357},
  month={Sep.},}@INPROCEEDINGS{11212451,
  author={Kumari, Burri Vijaya and Tejaswi, Varagani and Mendu, Mohana Prasad and Ashok, D.V. and Manogna, Devalla and Srinivas, Dulla},
  booktitle={2025 6th International Conference on Electronics and Sustainable Communication Systems (ICESC)}, 
  title={CNN-Powered Early Detection of Mango Leaf Diseases for Sustainable Fruit Farming}, 
  year={2025},
  volume={},
  number={},
  pages={1955-1961},
  abstract={Fruit cultivation contributes significantly to addressing global food problems and nutritional needs. However, plant diseases are pretty common in tropical South Asia, which ultimately decreases the yield radically, causing huge losses to the farmers. Under such circumstances, early detection of leaf diseases is essential for sustaining healthy crops. Here in, a Convolutional neural network- based method is presented using leaf images for identifying seven common mango diseases by Mango Scan. The model was trained with the help of a special dataset of locally sourced photos on the pattern of mango diseases in India. As a result, it can correctly categorise practically all prevalent mango illnesses. This gave extraordinary performance in $\mathbf{5}$-fold cross-validation evaluations with averages of $\mathbf{9 8. 5 5 \%, ~} \mathbf{9 9. 5 0 8 \%, ~} \mathbf{9 9. 4 5 \%, ~} \mathbf{9 9. 4 7 \%}$, and $\mathbf{9 9. 8 7 8 \%}$ in that order, outperforming the leading industry models such as VGG16 and AlexNet. Eventually, Mango Scan will help in the identification of early indications of illness and thus can be used for improving mango production that would develop and improve the economy of the country.},
  keywords={Productivity;Precision agriculture;Plant diseases;Transfer learning;Crops;Robustness;Real-time systems;Convolutional neural networks;Tuning;Smart phones;Mango leaf disease;Deep learning;Precision agriculture;CNN (Convolution Neural Network);Plant disease detection;Image classification;5-fold cross-validation},
  doi={10.1109/ICESC65114.2025.11212451},
  ISSN={2996-5357},
  month={Sep.},}@INPROCEEDINGS{11205706,
  author={Chacón, Edgar and Cruz Salazar, Luis Alberto and Cruz, Ernesto Monroy and Valdez-Cervantes, Libis and Sánchez-Gómez, Juan Sebastián and Larrondo-Petrie, Maria Mercedes},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={Towards a Digital Twin-Based Evaluation Framework for Cyber-Physical Production Systems: Latin America SMEs Guideline}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The evaluation of Cyber-Physical Production Systems (CPPS) using Digital Twin (DT) architectures and Asset Administration Shells (AAS) is critical for advancing flexible, autonomous, and human-centric manufacturing environments. However, small and medium-sized enterprises (SMEs), particularly in Latin America, face significant barriers to adopting and evaluating these technologies due to resource limitations, complexity, and lack of standardized frameworks. This paper proposes a scalable and modular evaluation framework specifically designed for SMEs, integrating DTs for real-time simulation and monitoring, AAS for semantic interoperability, and simulation-based assessment methods to measure CPPS autonomy, flexibility, and resilience. A comprehensive review of recent approaches, trends, challenges, and research gaps highlights the urgent need for dynamic, standardized, and cognitive-enabled evaluation methodologies. The proposed framework addresses these needs by formalizing production knowledge through ontologies, synchronizing physical systems with digital models, and enabling systematic performance evaluation across diverse production scenarios. A case study conducted in a Latin American manufacturing SME demonstrates the practical application of the framework, showing improvements in production efficiency, decision transparency, and system adaptability. The results underline the framework’s potential to democratize access to advanced Industry 4.0 solutions for SMEs, fostering more resilient and intelligent manufacturing ecosystems. By bridging current technological gaps, this work contributes to accelerating the digital transformation of SMEs and supports the broader goals of Industry 5.0. Future research will explore the integration of explainable AI techniques and expand the framework’s applicability to multi-site production networks.},
  keywords={Explainable AI;Scalability;Semantics;Ecosystems;Real-time systems;Fourth Industrial Revolution;Digital twins;Complexity theory;Interoperability;Resilience;Industry 4.0;Performance;Cyber-Physical Systems;Digital Twins;Engineering Education},
  doi={10.1109/ETFA65518.2025.11205706},
  ISSN={1946-0759},
  month={Sep.},}@ARTICLE{11219255,
  author={Li, Peizheng and Lin, Xinyi and Aijaz, Adnan},
  journal={IEEE Communications Standards Magazine}, 
  title={Rethinking Networked Robotics in the 6G Era With Generative AI-in-the-Loop}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Networked robotics continues to be a key component of various industrial systems. 6G will empower networked robotics with the envisaged capabilities like hyper-reliable and low-latency connectivity and in-network intelligence. While communication and control techniques have been widely investigated; co-design and AI-based solutions for autonomy and reasoning are still emerging. In this article, we propose a generative AI-in-the-Loop (GITL) framework for the control and coordination of networked robotic systems. The generative AI (GAI) agent oversees three interrelated loops: the communication loop, the robot control loop, and the AI model control loop, making holistic decisions by interpreting task requirements, network status, and robotic operations. Acting as a high-level cross-domain coordinator, the GAI agent leverages background knowledge of AI models, robot behaviors, and network policies, ensuring seamless interplay across different operational scenarios. This approach ultimately enables a highly autonomous networked robotic system capable of handling complex tasks with minimal human intervention. We anticipate that the GITL paradigm will play a pivotal role in unlocking the full potential of networked robotic systems, enabling enhanced autonomy, adaptability, and coordination in the emerging 6G and Industry 5.0 era.},
  keywords={Robots;Robot kinematics;Artificial intelligence;Gas insulated transmission lines;Adaptation models;6G mobile communication;Service robots;Robot sensing systems;Real-time systems;Robot control},
  doi={10.1109/MCOMSTD.2025.3620856},
  ISSN={2471-2833},
  month={},}@ARTICLE{11217281,
  author={Poniatowski, Adrian and Gentner, Natalie and Barusco, Manuel and Pezze, Davide Dalle and Salti, Samuele and Susto, Gian Antonio},
  journal={IEEE Transactions on Automation Science and Engineering}, 
  title={Domain Adaptation for Image Classification of Defects in Semiconductor Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={In the semiconductor sector, due to high demand but also strong and increasing competition, time to market and quality are key factors in securing significant market share in various application areas. Thanks to the success of deep learning methods in recent years in the computer vision domain, Industry 4.0 and 5.0 applications, such as defect classification, have achieved remarkable success. In particular, Domain Adaptation (DA) has proven highly effective since it focuses on using the knowledge learned on a (source) domain to adapt and perform effectively on a different but related (target) domain. By improving robustness and scalability, DA minimizes the need for extensive manual re-labeling or retraining of models. This not only reduces computational and resource costs but also allows human experts to focus on high-value tasks. Therefore, we tested the efficacy of DA techniques in semi-supervised and unsupervised settings within the context of the semiconductor field. Moreover, we propose the DBACS approach, a CycleGAN-inspired model enhanced with additional loss terms to improve performance. All the approaches are studied and validated on real-world Electron Microscope images, considering the unsupervised and semi-supervised settings, proving the usefulness of our method in advancing DA techniques for the semiconductor field.},
  keywords={Adaptation models;Scanning electron microscopy;Semiconductor device manufacture;Image classification;Deep learning;Feature extraction;Data models;Production;Fourth Industrial Revolution;Translation;Computer Vision;Convolutional Neural Network;Deep Learning;Defect Classification;Domain Adaptation;Industry 4.0;Pseudo Labeling;Scanning Electron Microscope Images},
  doi={10.1109/TASE.2025.3621854},
  ISSN={1558-3783},
  month={},}@INPROCEEDINGS{11198554,
  author={Sharma, Ravi and Kunwar, Harshvardhan},
  booktitle={2025 International Conference on Technology Enabled Economic Changes (InTech)}, 
  title={Technology Embedded Transformative Potential in Sustainability Reporting: Business Impacts and Innovations}, 
  year={2025},
  volume={},
  number={},
  pages={240-246},
  abstract={This study conducts a systematic literature review based on the PRISMA technique to investigate the transformation of technology on sustainability practices, disclosures and reporting. The documents were collected from Scopus and Web of Science research databases. The results highlighted Blockchain, Artificial Intelligence (AI), and Industry 5.0. Through secure and auditable data trails, particularly in the context of supply chain management, Blockchain makes data more reliable and transparent. Data collection and realtime reporting are automated, with AI and machine learning driving the materiality assessments. In addition to the Industry 4.0 practices, Industry 5.0 principles would enhance individual and real-time ESG reporting by making it customisable and cost-efficient, promoting greater stakeholder participation, and allowing more meaningful inter-company comparability. Using a structured literature review approach and integrating with empirical analysis like principal component analysis and K-mean clustering using Ward's method, the results and discussion outline technological advances that aim to solve essential sustainability reporting-related challenges by providing uniform methods and fostering stakeholder confidence. These research findings have implications for practitioners and policymakers on leveraging technologies effectively to enhance sustainability reporting.},
  keywords={Technological innovation;Supply chains;Data collection;Real-time systems;Blockchains;Stakeholders;Reliability;Sustainable development;Fifth Industrial Revolution;Systematic literature review;Technology Adoption;Sustainability Reporting;ESG Disclosures;Emerging Technologies;Technology Impact},
  doi={10.1109/InTech64186.2025.11198554},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11198355,
  author={Prathiba, Sahaya Beni and R., Dhanalakshmi and Kumar, Suraj and Kumar, Sawan and Kumar, Abhishek},
  booktitle={2025 International Conference on Technology Enabled Economic Changes (InTech)}, 
  title={Enhancing Industrial Processes Through Digital Twin Technology in the Era of Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={126-132},
  abstract={Industry 5.0 broadens the scope of digital twins' application beyond performance and production augmenting as it demands advanced human-machine interface symbiosis with AI, Cyber Physical Systems, augmented reality, and sustainable resilient technologies. It seeks to evaluate the effectiveness of DT technology on industrial manufacturing constructs with real-time process performance evaluation, error identification, and correction at its core. The study investigates the major modeling techniques, active uses, and the role of DT in the acceleration of automated real-time process monitoring and error supervision and correction for achieving greater efficiencies and lower operational costs in industrial manufacturing. It seeks to demonstrate the ability of Industry 5.0 technologies to fundamentally change industrial practices and processes, enhance productivity, flexibility, operational efficiency, and resilience through humancentered manufacturing practice with digital twins. This will demonstrate the ability of DT to transform the next stage of industrial revolution endeavors.},
  keywords={Symbiosis;Technological innovation;Human-machine systems;Real-time systems;Digital twins;Manufacturing;Fifth Industrial Revolution;Artificial intelligence;Sustainable development;Resilience;Human-centric;Digital Twin;Industry 5.0;Augmentation;CPS},
  doi={10.1109/InTech64186.2025.11198355},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11205794,
  author={Esposito, Marco and Raggiunto, Sara and Napoletano, Paolo and Belli, Alberto and Sciarroni, Monica Marconi and Storti, Emanuele and Pierleoni, Paola},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={A Lightweight CNN-Based Solution for Inertial Gesture Recognition on Tiny Edge Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The use of wearable devices with inertial sensors for gesture recognition is becoming increasingly common in extended reality and remote control applications. Fast and accurate gesture recognition is critical for real-time services such as industrial control and thus drives the shift of computation toward edge computing. This work aims to optimize deep learning models for direct integration into real-world edge devices. In this context, several models based on convolutional neural networks with different configurations are developed and tested through standard performance benchmarks (accuracy and Macro F1 Score). Moreover, in order to decrease models’ size with minimal accuracy loss, they were quantized using full-integer quantization. Non-quantized and quantized models have been tested on different boards through the STM32 Edge AI Developer Cloud, as an additional benchmark to verify that the proposed models meet speed and accuracy requirements also on low-cost, low-power edge nodes. The results show that the best lightweight configuration with post-training quantization achieves an inference time of 17.31 ms on the STM32L4R9I-DISCO board, while maintaining an accuracy of 95.95 % ± 0.31 %, competitive against the state of the art and making it suitable for integration into industrial control frameworks.},
  keywords={Performance evaluation;Accuracy;Quantization (signal);Computational modeling;Industrial control;Gesture recognition;Benchmark testing;Wearable devices;Fifth Industrial Revolution;Wearable sensors;edge computing;gesture recognition;wearable sensors;Industry 5.0;Inertial Measurement Unit;human-machine interaction},
  doi={10.1109/ETFA65518.2025.11205794},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11205550,
  author={Nguyen, Quang-Duy and Suri, Kunal and Sidibe, Guéréguin Der Sylvestre},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={Towards Engineering Product Digital Twins for Industry 5.0: Definition and Modeling Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The vision of Industry 5.0 builds upon the advanced technologies of Industry 4.0, aligning its emerging concepts with three key pillars: human-centricity, sustainability, and resilience. In this context, the idea of the Product Digital Twin (PDT), first introduced in 2002, which has further matured (and refined) by the Asset Administration Shell (AAS) standard, must continue evolving to integrate the vision of Digital Product Passport (DPP) as promoted via several initiatives from the European Commission. Moreover, positioning PDT correctly within this broader context of Industry 5.0 is crucial, as it involves the modeling and implementation of PDT instances, which then significantly influence manufacturing applications. To address this need, this paper first harmonizes different PDT definitions and then proposes a modeling and deployment approach appropriate to the new concept of PDT information models.},
  keywords={Europe;Digital twins;Fourth Industrial Revolution;Fifth Industrial Revolution;Sustainable development;Standards;Manufacturing automation;Resilience;Context modeling;Manufacturing;Digital Passport Product;CSS;PPR;Asset Administration Shell},
  doi={10.1109/ETFA65518.2025.11205550},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11205771,
  author={Arazzi, Marco and Belli, Alberto and Cusano, Claudio and Esposito, Marco and Facchinetti, Tullio and Ferretti, Marco and Galimberti, Gabriele and Sciarroni, Monica Marconi and Napoletano, Paolo and Nocera, Antonino and Pierleoni, Paola and Storti, Emanuele and Ursino, Domenico},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={An IoE-based Framework Supporting Human-Centric Industry}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Industry 5.0 envisions manufacturing systems that are human-centric, sustainable, and resilient. In this context, the Internet of Everything (IoE) enables integration of devices, people, and processes into a unified digital ecosystem. This paper presents a modular, semantically enriched framework that supports this transition by managing heterogeneous data sources—such as IoT sensors, wearable devices, and smart objects—through a layered architecture. The platform enables real-time data stream processing, semantic interoperability, and secure, context-aware access. Anomaly detection is enabled through a privacy-preserving mechanism based on behavioral fingerprinting and federated learning. The platform supports immersive human-machine interaction via gesture recognition, empowering workers to control and interact with industrial systems. Use cases demonstrate the system’s ability to support gesture-based control and intelligent monitoring, highlighting its potential to enhance adaptability, security, and worker empowerment in Industry 5.0 environments.},
  keywords={Human computer interaction;Semantics;Real-time systems;Internet of Things;Security;Fifth Industrial Revolution;Wearable devices;Anomaly detection;Wearable sensors;Monitoring;Data Stream;Big Data;Knowledge graphs;Metadata;Industry 5.0;IoT;Internet of Everything;Anomaly detection;Human-machine interaction},
  doi={10.1109/ETFA65518.2025.11205771},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11205765,
  author={Arazzi, Marco and Cihangiroglu, Mert and Nicolazzo, Serena and Nocera, Antonino},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={A Privacy-Preserving and Biometric-Aware Tasks Reallocation Strategy in Industry 5.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Industry 5.0 represents an emerging industrial paradigm that emphasizes seamless collaboration between human workers, collaborative robots (cobots), and smart objects. Its goal is to enable intelligent, adaptive manufacturing environments that not only boost operational efficiency and ensure regulatory compliance but also enhance workplace safety. In this context, we designed a complete framework based on a Reinforcement Learning (RL) strategy for intelligent and privacy-preserving task reallocation. Central to our vision is the prioritization of human well-being ensuring that both worker safety and privacy are protected, while the performance and reliability of machines and devices are optimized to support a truly human-centric manufacturing system. Our solution monitors workers’ physiological states and detects signs of fatigue, stress, or overload, ensuring that tasks can be dynamically reallocated to another worker or cobot to promote well-being without manual intervention. Moreover, by ensuring biometric data remains local to the worker’s device, the system respects data sovereignty and avoids unnecessary sharing of sensitive health information, guaranteeing compliance with regulations like GDPR. Our solution can adapt dynamically to the changing conditions and needs of human operators creating a privacy-preserving, safe, and efficient collaborative environment between people and machines. A comprehensive experimental analysis assesses the accuracy and performance of the proposed approach.},
  keywords={Biometrics;Performance evaluation;Privacy;Collaborative robots;Reinforcement learning;Fatigue;Safety;Fifth Industrial Revolution;Biomedical monitoring;Stress;Reinforcement Learning;Task Reallocation;Privacy;IoE;Industrial IoT;Optimization;Industry 5.0},
  doi={10.1109/ETFA65518.2025.11205765},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11205674,
  author={Facchinetti, Tullio and Nocera, Antonino},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={Modular Digital Twin for Human Activity Simulation based on Finite-State Machines}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Human Activity Recognition (HAR) is becoming a key component in contemporary settings like Industry 5.0 and advanced smart home systems. In this study, we propose the use of a time-triggered, probabilistic Extended Finite-State Machine (EFSM) to build a modular Digital Twin (DT) of the system made by a moving person and the corresponding environment - including the sensors for their monitoring - to realistically reproduce the daily activities of the person and the signals generated by the sensors. The use of an EFSM allows to model the details of user’s behaviors and to easily address the trade-off between accuracy and complexity of the model. In particular, the probabilistic nature of the EFSM allows to introduce variability in the simulations while maintaining the model simple. Simulations performed using the DT generate accurate extended data that can be used to feed and train HAR algorithms, while the corresponding ground truth is used to label the data for the evaluation of the algorithms. The empirical analysis of the generated patterns shows that closely capture the behavior of the occupants in a simulated indoor environment. Moreover, a simple model based on a Long-Short Term Memory (LSTM) neural network was devised to show the usage of the synthetic dataset in the inference of a person’s position based on motion sensor signals.},
  keywords={Accuracy;Automata;Probabilistic logic;Sensor systems;Inference algorithms;Digital twins;Human activity recognition;Feeds;Fifth Industrial Revolution;Long short term memory;Human Activity Recognition;Digital Twin;Modeling;Finite State Machine;LSTM},
  doi={10.1109/ETFA65518.2025.11205674},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11205645,
  author={Arazzi, Marco and Sciarroni, Monica Marconi and Nicolazzo, Serena and Nocera, Antonino and Storti, Emanuele},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={Securing IoE Environments with Semantic Data Stream Analysis and Behavioral Fingerprinting}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={In the landscape of Industry 5.0, Internet of Everything (IoE) networks are emerging as crucial components for connecting diverse industrial sensors and devices, expanding beyond traditional IoT boundaries to integrate people, processes, and data. However, this increased connectivity raises significant security concerns, as the growing complexity of IoE environments introduces new attack vectors and privacy risks. Additionally, the integration of heterogeneous devices and data sources presents both technical and semantic interoperability challenges, requiring robust mechanisms for meaningful data interpretation and secure exchange. This paper, developed within the HOMEY project, presents an architecture for gathering and monitoring semantic data streams in IoE environments, addressing both interoperability and security challenges. Our approach leverages Knowledge Graphs to represent sensor metadata, locations, access rights, and operational contexts, enabling dynamic stream monitoring and data querying. An approach based on Federated Learning allows distributed behavioral fingerprinting of IoE devices, which is exploited on top of the platform to perform anomaly detection from real-time data streams. The approach enhances reliable, privacy-preserving anomaly detection, contributing to the security and resilience of next-generation industrial IoE ecosystems.},
  keywords={Semantics;Ecosystems;Knowledge graphs;Fingerprint recognition;Real-time systems;Internet of Things;Fifth Industrial Revolution;Anomaly detection;Monitoring;Interoperability;Stream management;Big Data Applications;Anomaly detection;Knowledge Graphs;Industry 5.0;Internet of Everything;IoT},
  doi={10.1109/ETFA65518.2025.11205645},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11200386,
  author={Zawi, Mohammad Alif Hakimi Mohd and Kazim, Mohd Nor Fakhzan Mohd and Yeon, Ahmad Shakaff Ali and Zakaria, Ammar and Zakaria, Syed Muhammad Mamduh Syed and Kamarudin, Latifah Munirah and Ubaidah, Shamsudin Abu},
  booktitle={2025 9th International Conference on Man-Machine Systems (ICoMMS)}, 
  title={Comparative Analysis of YOLO-Based Deep Learning Models for Defect Detection in Product Packaging}, 
  year={2025},
  volume={},
  number={},
  pages={392-397},
  abstract={In alignment with the goals of Industry 5.0, which emphasize intelligent, human-centric, and sustainable manufacturing, the integration of advanced quality control (QC) systems has become increasingly critical. This study presents a comprehensive comparative analysis of eight state-of-the-art YOLO based deep learning models, YOLOv3u, YOLOv5mu, YOLOv6m, YOLOv8m, YOLOv9m, YOLOv10m, YOLOv11m, and YOLOv12m for automated defect detection in product packaging. Using the Red Bull Can Appearance Defects Synthetic Dataset, each model was trained and tested under consistent conditions and assessed across key metrics mAP@0.5, $\text{m A P} {@} 0.5: 0.95$, precision, recall, F1-score, parameter count, FLOPs, frames per second (FPS), and latency. With the fastest inference (6.3 ms), highest FPS (158.7), and shortest training time (0.664 h), YOLOv5mu proved to be the ideal option for time-sensitive deployments. It also maintained high accuracy $(\text{mAP} {@} 0.5=0.950, \mathrm{F} 1=0.95)$. YOLOv9m had the best mAP@0.5:0.95 (0.599), precision (0.951), and a high F1-score (0.94) for tasks that required accuracy. The most balanced trade-off was provided by YOLOv10m, which combined effective resource use with high mAP@0.5 (0.952), F1-score (0.95), and low latency (7.0 ms). Despite YOLOv12m's incorporation of sophisticated modules like R-ELAN and FlashAttention, the current dataset did not significantly improve. This study provides a reference for the automatic recognition of defects in product packaging.},
  keywords={Deep learning;Training;YOLO;Analytical models;Accuracy;Computational modeling;Quality control;Packaging;Fifth Industrial Revolution;Defect detection;yolo;defect detection;deep learning;industry 5.0;computer vision;quality control;model efficiency},
  doi={10.1109/ICoMMS66553.2025.11200386},
  ISSN={},
  month={Aug},}@ARTICLE{11207697,
  author={Li, Haiyuan and Madhukumar, Hari and Methley, Nicholas and Chen, Xuewen and Wu, Yulei and Parra-Ullauri, Juan and Sharma, Vishnu and Lee, Jeongran and Koblitz, Arndt Ryo and Andrews, Matthew and Liu, Sige and Deng, Yansha and Kolawole, Oluwatayo Y. and Tassi, Andrea and Simeonidou, Dimitra},
  journal={IEEE Internet of Things Journal}, 
  title={Future Factories with 6G: Agentic AI and Cyber-Physical Digital Twins}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={Industry 5.0 envisions a cyber-physical future where humans and robots collaborate harmoniously, empowered by 6G connectivity and intelligent automation. Central to this vision is the ability to autonomously configure complex production pipelines based on diverse and evolving human intents. Existing orchestration technologies exhibit critical shortcomings in terms of self-learning, validation, error diagnosis, and rectification capabilities. To this end, we propose an Agentic AI orchestration framework that interprets human intents and dynamically assembles optimal technology pipelines using a self-improving, retrieval-augmented Large Language Model (LLM) and a Bayesian contextual-bandit selector. This enables dynamic adaptation in unpredictable factory environments. Our solution is validated in a cyber-physical testbed integrating Digital Twins (DTs), distributed AI, robotics, and real-world network infrastructure. Compared to baseline LLMs, our system reduces orchestration iterations by over 94% for a given intent and by around 90% for an unseen intent, showing rapid convergence and strong generalization. Real-world deployments mirror DT results, confirming both the fidelity of the simulation and the practical value of intent-driven orchestration for human-centric manufacturing.},
  keywords={Pipelines;Robots;Production facilities;Artificial intelligence;6G mobile communication;Smart manufacturing;Drones;Videos;Optimization;Monitoring;Smart factory;Agentic AI;network system automation;large language model;retrieval augmented generation;digital twin},
  doi={10.1109/JIOT.2025.3623075},
  ISSN={2327-4662},
  month={},}@INPROCEEDINGS{11201528,
  author={Genovés, Vicente and Xu, Tingzhong and Tumolin, Rodrigo and Gómez, Tomás},
  booktitle={2025 IEEE International Ultrasonics Symposium (IUS)}, 
  title={Non-Contact Ultrasonic Inspection of Filtration Membranes Using Air-Coupled PMUT}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Industry 5.0 emphasizes smart, connected systems, integrating MEMS-based sensors, IoT, and AI to enable advanced, real-time monitoring solutions. In this study, we present a non-contact, non-destructive ultrasonic inspection method for filtration membranes using air-coupled piezoelectric micromachined ultrasonic transducers (PMUTs) suitable to be deployed in the fabrication line for in-line and real time testing of the production. Filtration membranes play a critical role in respiratory protection and ventilation systems, where ensuring consistent performance—measured via particle filtration efficiency (PFE) and pressure resistance—is essential. We designed and fabricated a novel 200 kHz PMUT array optimized for air-coupled through-transmission measurements of porous materials. Experimental validation was performed on different meltblown polypropylene membranes.. The PMUT results were benchmarked against a broadband air-coupled ultrasonic transducer. The transmission coefficient measured by the PMUT array demonstrated sensitivity sufficient to distinguish between membranes with different filtration properties. These findings suggest the feasibility of using PMUTs for rapid, high-precision quality assessment of filtration materials.},
  keywords={Fabrication;Ultrasonic transducers;Filtration;Atmospheric measurements;Ultrasonic variables measurement;Production;Inspection;Particle measurements;Acoustics;Real-time systems;PMUT;NDT;Air-Coupled Ultrasound;Filtration Membranes;Material Characterization},
  doi={10.1109/IUS62464.2025.11201528},
  ISSN={1948-5727},
  month={Sep.},}@INPROCEEDINGS{11201474,
  author={Genovés, Vicente and Xu, Tingzhong and Tumolin, Rodrigo and Gómez, Tomás},
  booktitle={2025 IEEE International Ultrasonics Symposium (IUS)}, 
  title={PMUT-Based Non-Contact Ultrasonic Characterization of Li-ion Battery Separators}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The rapid evolution of Industry 5.0 is driving the need for advanced sensing technologies capable of supporting new production paradigms, including the Internet of Things, big data, and AI training. In this context, the lithium-ion battery sector is experiencing significant growth, accompanied by increasing demands from industry and regulators for improved safety and performance. Separator membranes are critical to battery function, influencing both safety and efficiency through properties such as porosity and thickness. This work explores the use of piezoelectric micromachined ultrasonic transducers (PMUTs) for the non-contact, non-destructive inspection of battery separators. A novel air-coupled PMUT array operating at 200 kHz was designed, fabricated, and tested for high-precision through-transmission measurements of commercial separator membranes. A PMUT cell design based on the cantilever operation mode is proposed to achieve high enough sensitivity to cope with the relatively large insertion loss of separator membranes. Results demonstrate the feasibility of using the transmission coefficient to infer key membrane properties such as porosity and thickness.},
  keywords={Lithium-ion batteries;Ultrasonic transducers;Ultrasonic imaging;Ultrasonic variables measurement;Particle separators;Production;Inspection;Acoustics;Battery charge measurement;Safety;PMUT;NDT;Air-Coupled Ultrasound;Li-ion batteries;Battery separators;Material Characterization},
  doi={10.1109/IUS62464.2025.11201474},
  ISSN={1948-5727},
  month={Sep.},}@INPROCEEDINGS{11200706,
  author={Kovács, Karolina Eszter and Őrsi, Balázs and Csukonyi, Csilla and Neamah, Husam A. and Papp, Dávid and Korondi, Péter},
  booktitle={2025 IEEE 16th International Conference on Cognitive Infocommunications (CogInfoCom)}, 
  title={A Systematic Review of Emotion Recognition and Non-Verbal Communication in Human-Robot Interaction}, 
  year={2025},
  volume={},
  number={},
  pages={000183-000190},
  abstract={This study aims to systematically examine prior research on non-verbal communication patterns within human-robot interaction (HRI), including methodological approaches, study characteristics, and context-specific findings. As robotics continues to evolve, there is a growing emphasis on equipping robots with capabilities for social and emotional engagement. Despite their widespread application, many mobile robots - especially non-anthropomorphic ones - are limited in their ability to convey affective signals due to their lack of facial expressiveness. This constraint poses significant challenges for creating intuitive and natural interactions between humans and robots. To address this issue, the present review follows PRISMA guidelines in conducting a structured analysis of the literature. The systematic search, conducted via the EBSCO Discovery Service, initially yielded 114 publications. After a rigorous selection process, six studies were deemed relevant and included in the final synthesis. These studies reveal that robots’ physical gestures can be as interpretable as those of humans, underscoring the critical role of non-verbal cues in HRI. Moreover, the ability of users to accurately perceive robotic emotions appears to be influenced by individual personality traits, with notable effects related to confidence and emotional valence. The results point to the necessity of designing robotic systems that not only communicate emotions effectively but also reinforce user trust in their interpretations. In light of Industry 5.0’s emphasis on human-centric automation, enhancing non-verbal expressivity in robots could be pivotal. Moving forward, research should prioritize underexplored aspects of emotional perception and user diversity to foster more adaptive and socially responsive robotic systems.},
  keywords={Industries;Emotion recognition;Systematics;Service robots;Human-robot interaction;Psychology;User experience;Mobile robots;Robots;Systematic literature review;user experience;human-robot interaction;robot psychology;non-verbal communication;systematic review},
  doi={10.1109/CogInfoCom66819.2025.11200706},
  ISSN={2473-5671},
  month={Sep.},}@ARTICLE{11205844,
  author={Mehta, Naval Kishore and Arvind and Prasad, Shyam Sunder and Saurav, Sumeet and Singh, Sanjay},
  journal={IEEE Transactions on Automation Science and Engineering}, 
  title={Optimizing Multitask Industrial Processes With Predictive Action Guidance}, 
  year={2025},
  volume={22},
  number={},
  pages={22833-22844},
  abstract={Monitoring complex assembly processes is critical for maintaining productivity and ensuring compliance with assembly standards. However, variability in human actions and subjective task preferences complicate accurate task anticipation and guidance. To address these challenges, we introduce the Multi-Modal Transformer Fusion and Recurrent Units (MMTF-RU) Network for egocentric activity anticipation, utilizing multi-modal fusion to improve prediction accuracy. Integrated with the Operator Action Monitoring Unit (OAMU), the system provides proactive operator guidance, preventing deviations in the assembly process. OAMU employs two strategies: 1) Top-5 MMTF-RU predictions, combined with a reference graph and an action dictionary, for next-step recommendations and 2) Top-1 MMTF-RU predictions, integrated with a reference graph, for detecting sequence deviations and predicting anomaly scores via an entropy-informed confidence mechanism. We also introduce Time-Weighted Sequence Accuracy (TWSA) to evaluate operator efficiency and ensure timely task completion. Our approach is validated on the industrial Meccano dataset and the large-scale EPIC-Kitchens-55 dataset, demonstrating its effectiveness in dynamic environments. Note to Practitioners—Manual assembly remains crucial in industries that require human dexterity and adaptability for tasks that are too complex, customized, or low-volume for full automation. We propose a system to enhance the accuracy of these processes by predicting operator actions and providing real-time guidance through multi-modal data. Its primary function is to ensure that tasks are completed in the correct sequence, thereby reducing human error and boosting productivity. The system is particularly suited for industries like automotive and electronics manufacturing, where precision and flexibility are critical to maintaining high product quality. In addition to providing real-time feedback, the system continuously monitors the sequence and timing of operator actions using multi-modal data. It detects anomalies such as delays, repeated attempts, or missed steps, flags them as bottlenecks, and provides immediate corrective guidance. Such functionality helps operators stay aligned with the expected task flow, minimizes inefficiencies, and reduces cycle time, thereby reducing the need for corrective measures and post-process inspections while delivering immediate operational benefits. This solution offers significant potential for transforming manual assembly workflows, improving accuracy, efficiency, and consistency, while proactively addressing inefficiencies. It represents a key step toward creating smarter, human-centric manufacturing environments that align with the goals of Industry 5.0.},
  keywords={Assembly;Transformers;Real-time systems;Monitoring;Accuracy;Productivity;Predictive models;Decoding;Visualization;Semantics;Action anticipation;egocentric vision;industrial activity monitoring;intelligent manufacturing;neural networks},
  doi={10.1109/TASE.2025.3621005},
  ISSN={1558-3783},
  month={},}@ARTICLE{11205495,
  author={Bi, KeJun and Liu, ChuanJie and Dai, Cheng and Guo, Bing and Politis, Ilias},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={An Improved Hybrid Approach for Proactive Healthcare Industry Risk Prediction: Integrating Graph Weighted Fusion, RF and RW-GCN}, 
  year={2025},
  volume={},
  number={},
  pages={1-14},
  abstract={Risk prediction in healthcare industrial chains is critical for ensuring operational resilience and systemic stability. Traditional methods often focus on supply chain topology while overlooking enterprise-level indicators and the complex interdependencies among participants. To address these limitations, we propose IA-GWRG, a hybrid framework that integrates multi-relational graph modeling, key indicator selection, and subgraph-level learning for fine-grained enterprise risk prediction. Designed to align with emerging 6G-enabled intelligent infrastructures, IA-GWRG leverages ultra-low latency and ubiquitous sensing to enable real-time risk awareness. First, we introduce a salient graph feature extraction method that transforms a multi-relational industrial chain graph into a homogeneous structure using weighted fusion based on “competition–supply” meta-paths. A local-global-positional scheme is then applied to capture multi-scale structural features. Second, a key indicator identification module constructs a domain-specific 26-dimensional risk system and employs a random forest algorithm to select the most informative micro-level indicators, enhancing interpretability and reducing feature noise. Third, a node risk assessment method combines selected indicators and structural embeddings via subgraph-level random walk sampling and GCN-based learning, enabling precise and context-aware risk prediction. Extensive experiments on real-world healthcare industry chain datasets demonstrate that IA-GWRG consistently outperforms state-of-the-art baselines across multiple metrics. The results confirm its effectiveness and robustness in both predictive accuracy and 6G-oriented deployment scenarios.},
  keywords={Medical services;Feature extraction;Random forests;Risk management;Supply chains;Industries;6G mobile communication;Real-time systems;Graph neural networks;Bioinformatics;Healthcare Industry 5.0;Risk assessment;Heterogeneous graph;Graph neural network (GNN);Random forest;Meta-path;Industrial chain resilience},
  doi={10.1109/JBHI.2025.3621281},
  ISSN={2168-2208},
  month={},}@ARTICLE{11205883,
  author={Leal-Junior, Arnaldo and Nedoma, Jan and Martinek, Radek},
