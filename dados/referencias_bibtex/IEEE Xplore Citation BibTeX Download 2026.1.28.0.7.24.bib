  number={},
  pages={1-7},
  abstract={In the context of the global transition towards Society 5.0, the integration of Artificial Intelligence (AI) is crucial for advancing Indonesia's innovation and education sectors. This study aims to comprehensively analyze the opportunities and challenges inherent in the adoption of AI within these critical domains. Utilizing a mixed-methodology approach, the research gathers quantitative data through structured surveys and qualitative insights from expert interviews, case studies, and literature analysis. The findings reveal a growing recognition of AI's transformative potential among stakeholders but also expose significant barriers, including infrastructural deficits, a skilled labor gap, and the absence of a comprehensive policy framework. Regression analysis confirms that technological accessibility and institutional support are key determinants of successful AI integration. This study concludes that a concerted, strategic effort involving government, industry, and academia is necessary to overcome these obstacles. It offers a tactical framework and actionable recommendations designed to foster an inclusive AI ecosystem, thereby enabling Indonesia to leverage technology for sustainable growth and to enhance its competitive position in the global digital economy.},
  keywords={Industries;Training;Surveys;Technological innovation;Ethics;Government;Regression analysis;Stakeholders;Artificial intelligence;Standards;Artificial Intelligence;Education;Innovation;Society 5.0;Indonesia},
  doi={10.1109/ICCIT65724.2025.11167011},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11163964,
  author={Liu, Zhixin and Feng, Yixiong and Lou, Shanhe and Lu, Chengyu and Tan, Jianrong},
  booktitle={2025 IEEE 21st International Conference on Automation Science and Engineering (CASE)}, 
  title={More Attention for Human: A Multimodal Data-Driven Human Intention Identification Method*}, 
  year={2025},
  volume={},
  number={},
  pages={656-662},
  abstract={"Human-Machine Symbiosis" is a defining characteristic of Industry 5.0, where human-centric manufacturing paradigms emphasize the integration of advanced production tools with intrinsically human problem-solving capabilities. While product manufacturing is inherently inseparable from product design, and conceptual design influences the cost during subsequent manufacturing stages. Current assistive manufacturing software is limited to passive command execution during interactions, lacking the ability to recognize human intent, which leads to barriers in human-machine collaboration. To address this limitation, a multimodal data-driven human intention identification method is proposed. This methodology employs 3D spatial modeling and verbal analysis to capture multimodal data generated during collaborative manufacturing processes. A novel Transformer architecture integrating T2T-ViT and Bert (TB-Multiformer) is developed to identify human intention. The multimodal features of data are extracted by inter-modal attention module and intra-modal self-attention module. A coordinated manufacture case involving two types of mechanism structures is utilized to verify the feasibility and viability of proposed method.},
  keywords={Symbiosis;Manufacturing processes;Intent recognition;Human-machine systems;Collaboration;Feature extraction;Software;Real-time systems;Manufacturing;Fifth Industrial Revolution},
  doi={10.1109/CASE58245.2025.11163964},
  ISSN={2161-8089},
  month={Aug},}@INPROCEEDINGS{11164155,
  author={Deng, Yang},
  booktitle={2025 IEEE 21st International Conference on Automation Science and Engineering (CASE)}, 
  title={Multi-products production control and human-autonomous truck distribution planning with the use of collaborative multi-agent reinforcement learning}, 
  year={2025},
  volume={},
  number={},
  pages={369-374},
  abstract={In the era of Industry 5.0, the integration of human-centric values with advanced automation is pivotal. This paper addresses a complex distribution planning problem that necessitates the collaboration of human distributors and autonomous trucks within a manufacturing setting. We formulate the problem as a Partially Observable Markov Decision Process (POMDP) and propose a hierarchical multi-agent reinforcement learning (MARL) framework that unifies production control with distributor planning. At the upper level, two different agents determine production quantities for both preordered and on-time products, while concurrently planning appropriate distribution channels based on fluctuating market conditions. At the lower level, a decentralized execution strategy enables human and robotic distributors to dynamically fulfill customer demands. Key to this approach is a communication-based centralized learning scheme that leverages differentiable inter-agent learning to coordinate decisions, ensuring that autonomous operations do not undermine the human workforce, which is a core tenet of Industry 5.0. Computational experiments demonstrate that the proposed MARL framework outperforms traditional heuristic algorithms and conventional RL methods, achieving superior performance through improved coordination and adaptability. The results highlight not only the efficiency gains from automation but also the essential balance maintained between technological advancement and human involvement.},
  keywords={Service robots;Markov decision processes;Robot kinematics;Collaboration;Production control;Reinforcement learning;Real-time systems;Planning;Fifth Industrial Revolution;Autonomous vehicles;Multi-agent reinforcement learning;Partially observable Markov decision processes;production control;distribution planning;Industry 5.0},
  doi={10.1109/CASE58245.2025.11164155},
  ISSN={2161-8089},
  month={Aug},}@INPROCEEDINGS{11163767,
  author={Korodi, Adrian and Vesa, Vlad-Cristian and Dontu, Raul-Andrei},
  booktitle={2025 IEEE 21st International Conference on Automation Science and Engineering (CASE)}, 
  title={Efficient and Human Centered Industry 5.0 Data Propagation on the Operational Technology Level. Case Study with OPC UA Interfacing, Node-RED and Ignition}, 
  year={2025},
  volume={},
  number={},
  pages={292-297},
  abstract={Industry 5.0 is focused on human centricity, sustainability and resilience, but in the meantime it is relying on Industry 4.0 main objective that refers to efficiency increase. The operational technology (OT) level usually lacks data structuring and context, these steps being attributed to the middleware interfacing with the information technology (IT), or higher SCADA levels. Higher the hierarchical level, lower the technological process related knowledge becomes, and therefore representations may not be optimal. Also, various supervisory control and data acquisition (SCADA) solutions development targeting the same controlled process lead to different perspectives, higher costs, larger development times, and a more difficult maintenance. Considering both legacy systems and technological progress, the current paper proposes a solution that assures efficient and human centered structured, contextualized, and graphically sustained data propagation on the OT level. The work approaches and builds upon industry adopted environments and protocols in order to assure a fast adoption and a large impact of the solution. A Node-RED and Ignition based case study is presented, representing the PLC to SCADA data integration levels. The structured and graphically depicted data transfer and representation using Open Platform Communication Unified Architecture (OPC UA) protocol is showing good results, without the need of additional developments on the SCADA levels.},
  keywords={Protocols;SCADA systems;Process control;Ignition;Maintenance;Fifth Industrial Revolution;Sustainable development;Middleware;Information technology;Resilience},
  doi={10.1109/CASE58245.2025.11163767},
  ISSN={2161-8089},
  month={Aug},}@INPROCEEDINGS{11164092,
  author={Han, Yujie and Sun, Kexin and Zhao, Zhiheng and Huang, Geroge Q.},
  booktitle={2025 IEEE 21st International Conference on Automation Science and Engineering (CASE)}, 
  title={Out-of-Distribution Modular Hospital Fit-Out Scheduling via Memory-augmented Deep Reinforcement Learning*}, 
  year={2025},
  volume={},
  number={},
  pages={1292-1297},
  abstract={The transition from Industry 4.0 to Industry 5.0 has highlighted the critical role of Modular Integrated Construction (MiC), particularly in rapidly deployable modular hospitals that address urgent healthcare demands. As the final stage before delivery, fit-out directly impacts both project speed and healthcare quality. However, scheduling in this phase faces challenges from dynamic labor allocation and worker fatigue, which traditional methods struggle to handle in out-of-distribution (OOD) settings. To tackle this, we reformulate the problem as a Flexible Job-shop Scheduling Problem with Workload Constraints (WL-FJSP) and propose a memory-augmented framework that models worker-task dynamics. By incorporating adaptive gating mechanisms, the model captures fatigue variations and jointly optimizes medical task fulfillment and fit-out efficiency. Experiments show improved performance over traditional and state-of-the-art methods, with strong generalization across varying instance scales.},
  keywords={Adaptation models;Microwave integrated circuits;Job shop scheduling;Hospitals;Dynamic scheduling;Fatigue;Deep reinforcement learning;Robustness;Fourth Industrial Revolution;Resource management;Modular Hospital Fit-out Scheduling;Flexible Job Shop Scheduling Problem (FJSP);Memory-awareness;Deep Reinforcement Learning},
  doi={10.1109/CASE58245.2025.11164092},
  ISSN={2161-8089},
  month={Aug},}@INPROCEEDINGS{11166108,
  author={El Saer, Andreas and Tsakiris, George and Valavanis, Leonidas and Zafeiropoulou, Aristea M. and Loupos, Konstantinos and Argyropoulos, George and Tsampiras, Petros},
  booktitle={2025 6th International Conference in Electronic Engineering & Information Technology (EEITE)}, 
  title={WELD-E: Enhanced-XR Human-Robot Interactive Collaboration for Welding Operations}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Industry 5.0 drives the evolution of manufacturing by demanding enhanced efficiency, versatility, and safety in increasingly complex digital environments. This paper aims to address critical challenges in the welding industry, where the lack of effective, interactive guidance during robotic operations and real-time monitoring has hindered productivity and safety. In this work, we introduce WELD-E, an innovative, end-to-end solution that integrates Artificial Intelligence and Extended Reality technologies to facilitate intuitive human-robot collaboration. WELD-E leverages a multimodal interface combining voice commands, spatial awareness, and automated decision-making, supported by a Microsoft HoloLens-based XR environment and a ROS2-driven robotic manipulator. At its core the system incorporates deep learning models, including Automatic Speech Recognition, Neural Machine Translation, a domain-specific Welding Large Language Model and a Visual Language model to refine and execute welding commands with high precision and safety. The proposed framework allows multilingual, context-aware interactions while improving the overall operational efficiency and safety in hazardous industrial settings. Through rigorous validation in simulated real-world scenarios, WELD-E demonstrates its potential to significantly reduce setup times, training requirements, and error rates, while promoting a safer and more responsive welding environment. This work paves the way for broader adoption of AI-driven, XR-enhanced solutions in modern manufacturing, aligning with the transformative objectives of Industry 5.0.},
  keywords={Service robots;Extended reality;Welding;Large language models;Neural machine translation;Human-robot interaction;Real-time systems;Safety;Manufacturing;Fifth Industrial Revolution;Industry 5.0;Robotic Welding;AI;Extended Reality (XR);Human-Robot Collaboration;Voice-Driven Interfaces;Automatic Speech Recognition (ASR);Neural Machine Translation (NMT);Welding Large Language Model (WeLLM);Real-Time Safety Monitoring;Computer Vision;Multimodal Interaction},
  doi={10.1109/EEITE65381.2025.11166108},
  ISSN={},
  month={June},}@INPROCEEDINGS{11158133,
  author={Kumar, Kiran and Nayak, Mahima and Kumar, K Jeevan and V, Kiran B and Kavyashree},
  booktitle={2025 International Conference on Computing Technologies & Data Communication (ICCTDC)}, 
  title={Wireless Networks and Cloud: a New Era of Connectivity}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The fusion of wireless networks with cloud computing has redefined modern communication, offering highspeed, low-latency, and scalable network solutions. Together with developments in edge computing, Open Radio Access Network (ORAN), and software-defined networking (SDN), technologies like 5G and soon-to-be 6 G networks greatly improve data transfer, resource management, and network efficiency. These developments open the door for real-time applications with incredibly dependable performance by enabling smooth connectivity and automation in smart cities, Industry 5.0, and the Internet of Senses (IoS). However, the growing complexity of cloud-integrated wireless systems presents challenges related to security, energy consumption, and network scalability. Ensuring interoperability between diverse architectures while maintaining efficiency and data privacy remains a major research focus. Solutions such as AI-driven network optimization, intelligent edge computing, and energy-efficient protocols are actively being explored to address these issues. This paper offers an in-depth examination of the emerging wireless-cloud paradigm, emphasizing its technological progress, current limitations, and future developments. By using cloud-native architectures and smarter wireless strategies, newgeneration networks focus on creating a sustain capable, adaptive, and highly responsive digital environment.},
  keywords={Cloud computing;Energy consumption;Wireless networks;Scalability;Computer architecture;Security;Software defined networking;Low latency communication;Optimization;Edge computing;Wireless Networks;Cloud Computing;5G/6G;Edge Computing;ORAN;Software-Defined Networking},
  doi={10.1109/ICCTDC64446.2025.11158133},
  ISSN={},
  month={July},}@ARTICLE{11173633,
  author={Huang, Bo and Zhou, Chongshan and Wu, Junqi and Liu, Jun and Yan, Yang},
  journal={IEEE Access}, 
  title={Copper and Aluminum Scrap Detection Model Based on Improved YOLOv11n}, 
  year={2025},
  volume={13},
  number={},
  pages={165860-165872},
  abstract={With the development of global industry, the recycling of waste copper and aluminium metals from end-of-life vehicles holds significant economic and environmental value. Machine vision technology plays a crucial role in scrap metal recycling, where accurate identification of waste metals has consistently been a key focus in this field. To address issues such as missed detections, false positives, and low detection accuracy caused by complex backgrounds in copper and aluminium scrap detection, along with the need for lightweight deployment, an improved YOLOv11n-based detection model for copper and aluminium scraps is proposed. The C3k2_Star_CAA module was designed to replace the original C3K2 module, improving feature extraction and target recognition in complex environments. The FPNSC module was introduced in place of the original SPPF module to capture finer features while keeping the model lightweight. A Feature Focus Diffusion Pyramid Network (FDPN) was adopted to substitute the original feature pyramid network, enhancing multi-scale feature fusion through FocusFeature modules and a diffusion mechanism. Additionally, a Dynamic Detection Head (DyHead) was incorporated to replace the original detection head, integrating multi-scale features to improve detection accuracy for objects of different sizes. Experimental results demonstrate that the improved model achieved a 9% increase in mAP@0.5, a 6.5% improvement in mAP@0.5:0.95, along with 3.9% higher Precision, 12.4% better Recall, and 8.2% greater F1-Score on the dataset, while also showing significant improvements in both parameter count and detection speed, making it more suitable for copper and aluminium scrap detection tasks. Furthermore, generalisation experiments using public datasets confirmed that the model exhibits strong generalisation capabilities.},
  keywords={Feature extraction;Metals;Copper;Aluminum;Accuracy;Recycling;Sorting;Real-time systems;Eddy currents;Computer architecture;Machine vision;metal recycling;non-ferrous metals;object detection;YOLOv11},
  doi={10.1109/ACCESS.2025.3612144},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11163130,
  author={Lovato, Alessio and Piccina, Alberto and Bertoni, Massimiliano and Michieletto, Giulia},
  booktitle={2025 European Conference on Mobile Robots (ECMR)}, 
  title={Human-Guided Autonomous Mobile Manipulator in Dynamic Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Human-robot interaction plays a pivotal role in the Industry 5.0 paradigm, where robots increasingly collaborate with human operators to augment their capabilities while alleviating them from burdensome and repetitive tasks and creating more efficient and safer work environments. In this context, this work focuses on the use of an autonomous mobile manipulator to assist a human operator in transporting items within a dynamic working environment. In the proposed framework, the manipulator’s behavior is guided by human gestures during different phases of the task, while autonomous navigation, including payload transport and dynamic obstacle avoidance, is achieved through the integration of the robot’s onboard sensing and actuation capabilities with an external camera network. The outlined control architecture is validated through a proof-of-concept implementation using the LoCoBot platform, demonstrating promising results.},
  keywords={Navigation;Service robots;Scalability;Robot vision systems;Gesture recognition;Cameras;Sensors;Collision avoidance;Manipulator dynamics;Payloads},
  doi={10.1109/ECMR65884.2025.11163130},
  ISSN={2767-8733},
  month={Sep.},}@ARTICLE{11168856,
  author={Haseeb, Khalid and Rehman, Amjad and Singh, Sushil Kumar and Shafique, Ayesha and Mirdad, Abeer Rashad and Jiang, Weiwei},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={PSDEEN: Predictive and Secured Decentralized Energy-Efficient 6G Edge Networks for Industrial Consumer Applications}, 
  year={2025},
  volume={71},
  number={4},
  pages={11044-11051},
  abstract={In smart cities, the Internet of Things (IoT) has increased the development and expansion of communication processes for Industry 5.0. With the integration of edge computing, 6G networks offer dynamic and low-cost services for consumer-centric applications to improve problem-solving abilities. However, heterogeneous services face issues controlling massive traffic on restricted systems and transmission delays. Moreover, due to the limitations of advanced technologies for various constraints, embedded applications experience data management issues and consume additional energy for associated services. In this research, we proposed a predictive distributed energy-efficient edge protocol for consumer industrial systems with the support of trusted communication over the 6G networks. It improved the computation outcomes using intelligent and lightweight power resources for integrated devices. Furthermore, it offers traffic-aware and reliable green energy systems for mobile services, particularly in rural areas. By leveraging the 6G technology for high bandwidth and low latency, edge computing provides consumer data processing closer to IoT devices, enabling on-time, real-time decision-making. It includes load-balancing functionality and increases the sustainability level for industrial applications. Using simulations, significant improvement has been revealed to highlight the potential of the proposed protocol and support the demands of Industry 5.0 for round-trip time by 33%, energy consumption by 39%, end-to-end delay by 41%, and complexity detection 30% than existing work.},
  keywords={Internet of Things;6G mobile communication;Energy efficiency;Real-time systems;Energy consumption;Security;Routing protocols;Costs;Edge computing;Wireless sensor networks;6G networks;technological development;energy efficiency;industrial development;information security},
  doi={10.1109/TCE.2025.3611275},
  ISSN={1558-4127},
  month={Nov},}@ARTICLE{11168851,
  author={Mallick, Debjani and Das, Ashok Kumar and Wazid, Mohammad and Park, Youngho},
  journal={IEEE Internet of Things Journal}, 
  title={Authenticated Certificateless Verifiable Searchable Public Key Encryption Scheme With Big Data Analytics for IoT-Based Healthcare}, 
  year={2025},
  volume={12},
  number={23},
  pages={50978-50996},
  abstract={The emerging concept of Internet of Things (IoT)-based Healthcare Industry 5.0 emphasizes the integration of human intelligence with cutting-edge technologies, such as artificial intelligence (AI), blockchain, IoT, big data analytics (BDA), and machine learning (ML) models to revolutionize healthcare delivery. However, alongside the immense potential and opportunities of Healthcare 5.0, the rapid expansion of sensitive medical data within the cloud-based healthcare systems also brings significant challenges related to data security, privacy, and resource requirements. Since most healthcare infrastructures depend on semi-trusted centralized cloud storage, it then becomes crucial to store medical records in encrypted form in order to ensure confidentiality and privacy of the data. At the same time, these systems must provide seamless and efficient search capabilities for authorized medical personnel in the healthcare system. To address these concerns and enable cost-effective, secure access and data management, we propose a novel authenticated certificateless verifiable searchable public key encryption scheme (ACLV-SPKE) that emerges as a robust and promising solution for securing healthcare data. The proposed framework not only resists diverse adversarial attacks but also ensures efficiency in terms of communication and computation costs while offering improved functionality over recent state-of-the-art solutions presented in the literature. The proposed scheme effectively resists both inside and outside keyword guessing attacks (KGAs), achieving strong security guarantees such as ciphertext indistinguishability (CT-IND) and trapdoor indistinguishability (TP-IND), which are proved in the random oracle models. In addition, we applied BDA on a real healthcare dataset to evaluate the performance metrics, and the outcomes are presented in this article.},
  keywords={Medical services;Security;Encryption;Big Data;Authentication;Internet of Things;Public key;Cloud computing;Data models;Biometrics;Big data analytics (BDA);certificateless searchable public key encryption;ciphertext indistinguishability (CT-IND);Healthcare Industry 5.0;Internet of Things (IoT);security;trapdoor indistinguishability (TP-IND)},
  doi={10.1109/JIOT.2025.3611228},
  ISSN={2327-4662},
  month={Dec},}@INPROCEEDINGS{11154360,
  author={Chawla, Rashmi and Pupo, Francesco and Fortino, Giancarlo},
  booktitle={2025 IEEE 5th International Conference on Human-Machine Systems (ICHMS)}, 
  title={Exploring Multi-Agent Human-Robot Teaming Dynamics in a Musical Orchestral Context}, 
  year={2025},
  volume={},
  number={},
  pages={356-361},
  abstract={The traversing of Human Robot Interaction (HRI) to Human Robot Teaming (HRT) has seen huge transformation from human-robots working in collaboration to working as teammates. The progress in automation, network connectivity and HRI represent a transformative shift to embrace Industry 5.0 by integrating advanced technologies like AI, robotics and IoT to create a symbiotic ecosystem where human ingenuity and machine intelligence converge. This paper outlines a conceptual review, to provide a well-defined understanding of Multi-Agent HRT that paves a new path from simple HRI to more evolved HRC and emergence of HRT in the subsets of well-defined 4C's combining multi modal communication, multitudinous sensory modalities viz. visual, auditory, and tactile inputs as a part of HRI systems. This study also explores the onset of MA-HRT framework for a musical orchestra system workflow to demonstrate key features such as coexistence, collaboration, control and cooperation.},
  keywords={Symbiosis;Visualization;Service robots;Reviews;Human-robot interaction;Robot sensing systems;Rhythm;Teamwork;Fifth Industrial Revolution;Robots;Human-robot interaction (HRI);Human robot partnerships},
  doi={10.1109/ICHMS65439.2025.11154360},
  ISSN={},
  month={May},}@INPROCEEDINGS{11154334,
  author={Kheirabadi, Mahboobe and Ghorbani, Elham and Keivanpour, Samira},
  booktitle={2025 IEEE 5th International Conference on Human-Machine Systems (ICHMS)}, 
  title={LLM-Powered Operator Advisor for Human-Robot Collaboration in Sustainable Assembly-Disassembly Cells}, 
  year={2025},
  volume={},
  number={},
  pages={19-22},
  abstract={In response to the manufacturing shift toward customization and human-centered approaches in Industry 5.0, this paper presents a conceptual framework for a virtual operator advisor based on the Large Language Model (LLM). The LLM-powered advisor processes real-time data from the assembly or disassembly line, classifying it into operational efficiency, ergonomics, and sustainability metrics to deliver context-aware, adaptive guidance tailored to each task. It is achieved by cross-referencing these data with domain knowledge stored in the database and LLM capabilities. The Advisor recommends actions toward operations optimization, potential cognitive and physical strains, and environmental responsibility. As a framework that promotes workflow adaptability, sustainability, and worker well-being, it can contribute to the evolution of human-robot collaboration in modern manufacturing.},
  keywords={Measurement;Ergonomics;Large language models;Human-machine systems;Human-robot interaction;Real-time systems;Sustainable development;Fifth Industrial Revolution;Optimization;Strain;Large Language Model (LLM);HumanMachine Interaction;Human-centered System;Sustainable Manufacturing},
  doi={10.1109/ICHMS65439.2025.11154334},
  ISSN={},
  month={May},}@INPROCEEDINGS{11154278,
  author={Lou, Shanhe and Tan, Runjia and Zhou, Mengchu and Lv, Chen},
  booktitle={2025 IEEE 5th International Conference on Human-Machine Systems (ICHMS)}, 
  title={A Cognitive Digital Twin for Industry 5.0 Based on a Large Language Model Agent}, 
  year={2025},
  volume={},
  number={},
  pages={223-228},
  abstract={While digital twins have made significant strides in creating digital replicas of physical manufacturing systems, their cognitive capabilities remain inadequate to address the dynamic complexities in manufacturing, including process variations, environmental fluctuations, and human interactions. These limitations hinder their applicability in Industry 5.0, which emphasizes Self-X cognitive capabilities. This work proposes an improved five-dimensional framework for developing a cognitive digital twin (CDT) that adopts a Large Language Model (LLM) agent at its core. The LLM agent enhances domain-specific tasksolving capabilities through retrieval-augmented generation (RAG) and in-context learning. RAG compensates for the general LLM's limitations by utilizing external tool libraries and industrial knowledge graphs to establish context awareness, retrieve domain-specific knowledge, and convert human commands into sequential task plans via function calls. Incontext learning further enables the LLM agent to learn specific tasks based on contextual examples without retraining. It empowers CDT to address domain-specific challenges with efficiency, flexibility, and cost-effectiveness. The effectiveness of the proposed CDT is demonstrated in a lab-scale manufacturing unit, highlighting its ability to perform valid task planning and handle dynamic incidents, paving the way for more resilient manufacturing systems aligned with Industry 5.0 objectives.},
  keywords={Simultaneous localization and mapping;Large language models;Retrieval augmented generation;Knowledge graphs;Context awareness;Real-time systems;Digital twins;Planning;Fifth Industrial Revolution;Manufacturing systems;Cognitive digital twin;Large language model agent;Industrial knowledge graph;Retrieval-augmented generation;Task planning},
  doi={10.1109/ICHMS65439.2025.11154278},
  ISSN={},
  month={May},}@INPROCEEDINGS{11158627,
  author={Dutta, Debanwita and Raut, Anjana and Samantaray, Swati and Roy, Aviroop},
  booktitle={2025 International Conference on Advancements in Smart, Secure and Intelligent Computing (ASSIC)}, 
  title={Speech Recognition Systems in Healthcare: A Journey Towards Transformation}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The Industry 5.0 has the potential to leverage human-technology collaboration in fields like bionic and medical innovations, and is centered on developing completely automated, intelligent production systems that require little to no human involvement. The medical system may gain a great deal from the combination of sustainability, anti-fragile objectives, and digitization. Google Assistant, Amazon Alexa and Apple's Siri are the globally popular voice assistant software applications capable of integrating with AI powered smart devices. All these AI-modulated programs follow the basics of intelligent speech recognition. With the use of technology, we may now converse with an electronic computer or other equipment that will decode, interpret, and answer to our commands or questions. These artificial intelligence-modulated voice-controlled assistants have an extended past of growth and invention. However, it was their outsourcing into the voice recognition industry that fundamentally altered the way that technology is used in the twenty-first century. Digital assistants are rapidly replacing human help in many areas of life, so it is important for us to comprehend their capabilities and the many ways in which they can benefit individuals as well as organizations. The paper discusses the way Industry 5.0 seeks to transform healthcare by fusing state-of-the-art technology with sustainable practices, ultimately enhancing treatment outcomes and patient care.},
  keywords={Industries;Technological innovation;Standards organizations;Speech recognition;Medical services;Transforms;Software;Fifth Industrial Revolution;Artificial intelligence;Sustainable development;AI digital assistants;healthcare;Industry 5.0;internet of things;voice recognition},
  doi={10.1109/ASSIC64892.2025.11158627},
  ISSN={},
  month={May},}@INPROCEEDINGS{11158454,
  author={Meher, Anil Kumar and Mishra, Deepti and Nandini, Girija and Singh, Tulika and Sahoo, Abhaya Kumar},
  booktitle={2025 International Conference on Advancements in Smart, Secure and Intelligent Computing (ASSIC)}, 
  title={Role of AI in Shaping Industry 5.0: A Transformative Journey}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Artificial intelligence is accelerating into a megatrend that is changing industries, societies and the standard we are living and working. The organizations which are creating very powerful data and AI foundations will be desirable positioned to resurrect, participate and reach new levels of dispatch. Facebook's family of services, that incorporates Messenger, Instagram, WhatsApp, accepts almost 2.5 billion daily logins. Facebook right now used to collect data as users browse, message, like and click, which it then packages for advertisers. AI services on AWS require no machine learning experience. Another service is IBM Consulting Services, which works with clients and partners around the world to shape the future of AI. Using AI, we can quickly and reliably build and scale AI and automation solutions across our business. We are excited by the transformative power of AI and its innovative applications. From research that expands possibilities, to integrating products that make everyday tasks easier, to using intelligence to transform the lives of those who need it most, we are committed to creating innovations and technologies that benefit humanity. Thus, our goal in this article is to highlight the high level of AI services often provided by most popular companies to fulfill the process of data selection, collection and pre-processing just like filtering, categorization as well as feature extraction for the sizable quantity of data processed by industries.},
  keywords={Industries;Technological innovation;Data analysis;Social networking (online);Standards organizations;Finance;Transforms;Manufacturing;Artificial intelligence;Fifth Industrial Revolution;AWS;Artificial Intelligence;Chatbot;Deep Learning;Facebook;IBM;Industry 5.0;Machine Learning;Robots;Service Agents},
  doi={10.1109/ASSIC64892.2025.11158454},
  ISSN={},
  month={May},}@ARTICLE{11165027,
  author={Dang, Songya and Zhang, Xuqing and Ding, Qing and Zhang, Chengyao and Chen, Feng and Wang, Longyu},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={CBGW-YOLOv8: An Improved Model for Intelligent Monitoring of Construction Projects in Remote Sensing Images}, 
  year={2025},
  volume={18},
  number={},
  pages={26283-26294},
  abstract={Effective project monitoring has become crucial as the construction industry expands and the number of projects increases. Current monitoring methods, primarily relying on manual labor and traditional remote sensing techniques, face challenges such as insufficient image resolution and low processing speed. This study addresses these issues by applying deep convolutional neural networks to high-resolution remote sensing image recognition and developing an intelligent monitoring model based on YOLOv8 (CBGW-YOLOv8) for identifying various construction project stages. A dataset named “Construction Site,” containing different construction stages, was created using preprocessed remote sensing data from Jilin-1. An improved YOLOv8 architecture was adopted, with modifications to the network structure and loss function to enhance learning capability for construction features. The model’s effectiveness in improving monitoring efficiency and accuracy was validated through actual deployment. Experimental results demonstrate that the CBGW-YOLOv8 model outperforms traditional methods and the original model in construction project detection, achieving a 2.9% increase in mAP0.5 and a 2.6% increase in mAP0.5:0.95, while exhibiting higher accuracy and faster processing speed.},
  keywords={Remote sensing;Monitoring;Accuracy;Urban areas;Satellite images;Deep learning;Computational modeling;YOLO;Training;Excavation;Construction project;deep learning;satellite imagery;supervision},
  doi={10.1109/JSTARS.2025.3610197},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{11155340,
  author={Wang, Hao-Yi and Cheng, Chao-Tse and Lin, Hsiao-Fan and Su, Kuo-Wei},
  booktitle={2025 IEEE Gaming, Entertainment, and Media Conference (GEM)}, 
  title={Design and Usability Evaluation of Augmented Reality Assistance System in Warehouse Operation for Industry 5.0}, 
  year={2025},
  volume={},
