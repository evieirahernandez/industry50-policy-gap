@INPROCEEDINGS{10866482,
  author={Bhardwaj, Garima and Kaur, Baljit and Garg, Vikas},
  booktitle={2024 1st International Conference on Sustainable Computing and Integrated Communication in Changing Landscape of AI (ICSCAI)}, 
  title={Quantitative Analysis on Impact of Technology on Employee Acumen in IT Industry}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper examines the quantitative aspects of workplace acumen and employee acumen. It investigates how artificial intelligence affects employee mental health, particularly within the tech industry. Previous research has shown a psychological impact in workplaces due to increased use of machines, yet many studies have overlooked detailed findings. The study employs a quantitative methodology, distributing a well-structured questionnaire to technology sector. Data collected was analysed using SPSS software. Results confirm a detrimental effect of artificial intelligence on mental health. The paper suggests organizations should take proactive measures to support employees in navigating technological challenges. Implementing participatory practices in technology adoption can help employees adjust and reduce mental health issues. This paper emphasizing on the impact of technological advancement on employee psychological health and give perspective on employee state regarding technology adoption and implementation.},
  keywords={Industries;Statistical analysis;Navigation;Atmospheric measurements;Employment;Mental health;Organizations;Particle measurements;Software;Artificial intelligence;Employee acumen;Technology;Artificial intelligence;disconnect;Depression;Job insecurity;Industry 5.0},
  doi={10.1109/ICSCAI61790.2024.10866482},
  ISSN={},
  month={July},}@INPROCEEDINGS{10869173,
  author={Huang, Mengzhen and Li, Lao and Hu, Huanjun and Liu, Yifan and Yao, Yuting and Song, Rui},
  booktitle={2024 IEEE International Conference on Signal, Information and Data Processing (ICSIDP)}, 
  title={IAT-YOLO: A black pig detection model for use in low-light environments}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={In the large-scale intelligent pig farming industry, it is crucial to achieve real-time and accurate identification and positioning of each pig. However, the existing mainstream pig detection algorithms are mainly designed for white pigs, and the detection effect of black pigs is poor in low-light environments. In addition, when black pigs gather and adhesion and occlusion occur, the complexity of detection is further increased. Although strong light irradiation in the pigpen can improve the detection accuracy, it will have an adverse effect on the normal growth of pigs. To ensure accurate detection of black pigs in low-light environments without interfering with the normal growth of pigs, this research presents the IAT-YOLO model, derived from YOLOv7. It combines the brightness adaptive module IAT (Illumination-Adaptive-Transformer), the CA (Coordinate Attention mechanism) and the improved SPPCSPC-R module, which can effectively identify and locate the position and number of black pigs. Tests on the low-light black pig dataset reveal that the proposed model attains 96.8% accuracy, 83.8% recall, 91.8% mAP@0.5, and 54.5% mAP@0.5:0.95, which demonstrates higher accuracy and provides technical support for the intelligent detection of black pigs in such environments.},
  keywords={Smart agriculture;Adaptation models;Radiation effects;Accuracy;Computational modeling;Object detection;Robustness;Real-time systems;Detection algorithms;Farming;black pig inventory;object detection;low-light enhancement;attention mechanism;smart farming},
  doi={10.1109/ICSIDP62679.2024.10869173},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10871707,
  author={Bhatt, Vinod and Gupta, Dev Brat and Jain, Divya and Saxena, Rajeev and Sirohi, Gajendra and Tiwari, Rajesh},
  booktitle={2024 IEEE 6th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={Evolution of Social Interactive Skills through Integration of Artificial Intelligence & Machine Learning for better Employability}, 
  year={2024},
  volume={},
  number={},
  pages={352-355},
  abstract={This article will examine the latest developments in the field’s study and application of artificial intelligence (AI) and how it is changing professional skills in order to meet the concerns brought forth. In many organisational sectors, artificial intelligence (AI) has the potential to reduce cognitive effort or automate tasks that were previously completed by humans. The rapid changes have a significant effect on firms and people, despite the fact that this could result in higher productivity and efficiency because AI is occasionally perceived as a source of job losses. To successfully adapt to this shift, companies and institutions need to establish efforts for upskilling and reskilling as well as new organisational and working patterns. More research is necessary to completely understand how artificial intelligence (AI) impacts human capabilities and how soft skills support AI adoption in enterprises. Future studies should consider Industry 5.0’s challenges, which are likely to require even greater automation and the incorporation of new technologies.},
  keywords={Training;Productivity;Industries;Computer science;Employment;Social sciences;Machine learning;Mathematics;Artificial intelligence;Business;Evolution;Social Interactive Skills;Integration of Artificial Intelligence;Machine Learning;Better Employability;Up Skilling;Re-Skilling Initiatives;Higher Output;Efficiency},
  doi={10.1109/ICCCMLA63077.2024.10871707},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10862099,
  author={Tuteja, Gaurav and Rani, Shalli and Sharma, Ankita and Singla, Seerat},
  booktitle={2024 Global Conference on Communications and Information Technologies (GCCIT)}, 
  title={Enhancing Security Mechanisms in Wireless Sensor Networks for IoT Ecosystems}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The incorporation of WSN-IoT is transforming multiple sectors by improving the gathering, transmission, and analysis of information. This study investigates the collaboration between WSN-IoT, examining the essential methods, uses, and factors that enhance their effectiveness. This article examines 15 pertinent studies to emphasise the technological progress, obstacles, and future potential of WSN-IoT. It offers valuable insights into the expanding importance of WSN-IoT in various industries and beyond. This research article presents a thorough analysis of the integration of Wireless Sensor Networks with the IoT. Our study entails a thorough examination of research publications, specifically concentrating on the methodologies, uses, and crucial variables that determine the effectiveness of WSN-IoT systems. In addition, we emphasise the possible advantages and obstacles of this integration across different sectors.},
  keywords={Industries;Wireless sensor networks;Scalability;Ecosystems;Decision making;Real-time systems;Energy efficiency;Information and communication technology;Security;Monitoring;WSN;IoT;Industry 5.0;Smart Devices;Real-Time Monitoring},
  doi={10.1109/GCCIT63234.2024.10862099},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10862855,
  author={Tuteja, Gaurav and Rani, Shalli and Sharma, Ankita and Singla, Seerat},
  booktitle={2024 Global Conference on Communications and Information Technologies (GCCIT)}, 
  title={Blockchain-Enabled Security and Integrity Mechanisms for Wireless Sensor Networks in IoT Systems*}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Wireless Sensor Networks (WSN) and the Internet of Things (IoT) together present before unheard-of possibilities and difficulties in maintaining data integrity and authentication inside these systems. The application of blockchain technology as a distributed and strong answer to solve these problems is investigated in this work. By means of a thorough investigation of current developments, this article assesses blockchain-based architectures meant to improve security, lower latency, and guarantee data integrity in WSN-IoT systems. We suggest a thorough assessment of several blockchain technologies and their implementation in practical situations stressing its possibilities in industrial IoT, smart cities, healthcare, and smart homes. Though problems including scalability and energy consumption still exist, our results imply that blockchain integration greatly enhances data security and system efficiency.},
  keywords={Industries;Wireless sensor networks;Energy consumption;Technological innovation;Smart cities;Scalability;Data integrity;Medical services;Blockchains;Industrial Internet of Things;WSN;IoT;Industry 5.0;Smart Devices;Real-Time Monitoring},
  doi={10.1109/GCCIT63234.2024.10862855},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10862753,
  author={Tuteja, Gaurav and Rani, Shalli and Sharma, Ankita},
  booktitle={2024 Global Conference on Communications and Information Technologies (GCCIT)}, 
  title={Optimizing Routing Protocols for Energy Efficiency in Large-Scale WSN-IoT Deployments*}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In this paper, energy optimal routing protocols used in large scale WSN with internet integration are discussed in detail. Given the fast growth of IoT, the efficient management of energy in WSN has implied improved lifecycles and sustainable use of WSN. Generally, IoT uses WSNs in which the network consists of large numbers of sensor nodes that need to be low power. Hence, when defining routing protocols that may help in control and even reduction of power usage from the network, then ensuring high data reliability in the network must be given uttermost priority. The contributions of this work are as follows: Provides a thorough review of different types of routing protocols Reviews the protocols’ energy efficiency levels and their evolving best practices Reveals areas where prior work may have limitations for usage with large-scale implementations. Some of our contributions to the field are as follows These areas are represented by a comprehensive assessment of the existing standard and the development of new approaches that integrate adaptive procedures, data accumulation methods, and effective communication structures to increase energy-use efficiency in WSN-IoT systems.},
  keywords={Wireless sensor networks;Reviews;Scalability;Quality of service;Routing;Routing protocols;Energy efficiency;Security;Reliability;Standards;WSN;IoT;Industry 5.0;Smart Devices;Real-Time Monitoring},
  doi={10.1109/GCCIT63234.2024.10862753},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10862105,
  author={Tuteja, Gaurav and Rani, Shalli and Sharma, Ankita},
  booktitle={2024 Global Conference on Communications and Information Technologies (GCCIT)}, 
  title={Enhancing Data Integrity and Authentication in WSN-IoT Systems using Blockchain Technology*}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={With the combination of Wireless Sensor Networks (WSN) and Internet of Things (IoT), the field of data acquisition and communication has been transformed in most of the areas including smart city and industrial use. However, such systems are relatively insecure especially concerning the integrity of data, as well as identity authentication. This paper aims to investigate how blockchain technology cab strengthen WSN-IoT systems by offering distributed and secure mechanisms. Considering the pros and cons of applying existing approaches, we present a conceptual framework based on blockchain, which enhances data security and provides reliable ways of user identification. As the research suggests, there are enhanced aspects of security from the identified threats, and a decreased number of open entrance for invasions, coupled with higher veracity of data in various IoT applications. Different parameters are used in order to analyze the performance of the proposed framework in real-time environments.},
  keywords={Surveys;Wireless sensor networks;Protocols;Smart cities;Data integrity;Authentication;Real-time systems;Blockchains;Complexity theory;Internet of Things;WSN;IoT;Industry 5.0;Smart Devices;Real-Time Monitoring},
  doi={10.1109/GCCIT63234.2024.10862105},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10862083,
  author={Tuteja, Gaurav and Rani, Shalli and Sharma, Ankita},
  booktitle={2024 Global Conference on Communications and Information Technologies (GCCIT)}, 
  title={Blockchain-Enhanced Data Integrity and Authentication in WSN-IoT Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={WSNs together with IoT have become more susceptible to security threats owing to their distributed and resource constraint nature. Maintaining data consistency and strong authentication in these systems is important especially for applications that require low latency. This paper aims to evaluate how blockchain technology can be incorporated to improve security of data in WSN-IoT architecture for better data verification. We discuss existing solutions, identify emerging problems, and present a blockchain-based solution to these problems. Some of our contributions include a comprehensive discussion on the effect of blockchain technology on security parameters including latency, scalability and resource usage. The proposed approach shows that there is a notable enhancement of data quality preservation and security risks minimization in WSN-IoT.},
  keywords={Wireless sensor networks;Risk minimization;Protocols;Smart cities;Data security;Data integrity;Scalability;Authentication;Blockchains;Reliability;WSN;IoT;Industry 5.0;Smart Devices;Real-Time Monitoring},
  doi={10.1109/GCCIT63234.2024.10862083},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10858972,
  author={Tavakkoli, Vahid and Mohsenzadegan, Kabeh and Kambale, Witesyavwirwa Vianney and Kyamakya, Kyandoghere},
  booktitle={2024 19th International Workshop on Semantic and Social Media Adaptation & Personalization (SMAP)}, 
  title={Integrating IEEE 1451 and IEC 61499 Standards for Enhanced Interoperability in Smart Manufacturing and Transportation Systems}, 
  year={2024},
  volume={},
  number={},
  pages={14-18},
  abstract={Achieving interoperability in smart manufacturing and transportation systems is crucial for seamless data exchange and optimized decision-making processes. This paper presents an advanced integration approach combining the IEEE 1451 and IEC 61499 standards to address key interoperability challenges within these sectors. The proposed solution includes ontology mapping tools, real-time data translation services, and semantic reasoning at the fog computing layer, specifically designed to align sensor and actuator models. These innovations bridge theoretical frameworks with practical applications, significantly improving data model translation accuracy and real-time processing efficiency. Our findings highlight the potential of integrating IEEE 1451 and IEC 61499 standards to advance Industry 5.0 ecosystems, contributing to smarter, more responsive industrial systems and enhancing operational efficiency and decision-making capabilities.},
  keywords={Translation;Decision making;Transportation;Ontologies;Real-time systems;IEC Standards;Fifth Industrial Revolution;Interoperability;Standards;Smart manufacturing;Smart Manufacturing;Smart Transportation;Interoperability;IEC 61499;IEEE 1451;Data Models;Ontology Mapping;Wrapper Service;Semantic Reasoning},
  doi={10.1109/SMAP63474.2024.00013},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10857032,
  author={Kober, C. and Buxbaum-Conradi, S. and Fette, M. and Wulfsberg, J. P.},
  booktitle={2024 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Digital Twins: A Critical Perspective and Research Trends}, 
  year={2024},
  volume={},
  number={},
  pages={749-754},
  abstract={This article critically evaluates the current status and future research trends of Digital Twins (DTs) in the manufacturing industry. Despite extensive academic publications and significant interest in practical applications driven by initiatives like Industry 4.0 and 5.0, the actual industrial implementation of DTs remains limited. The gap mainly stems from manufacturing companies being overwhelmed by the complexity of DTs, coupled with insufficient methodological support from academia. This article scrutinises the underlying challenges in developing and implementing DTs, emphasising the need to address not only technical barriers but also organisational, methodological, and human factors. By drawing on extensive research experience and industry insights, the paper highlights critical aspects that need further addressing to enhance the practical use of DTs. It advocates for a redirection of research efforts towards core aspects of DTs, away from the euphoric trend fuelled by the available funding in academia and industry. This reflective approach aims to realign the development and implementation of DTs with the actual needs of the industry, focusing on a realistic perspective on the challenges faced and providing impulses for targeted research and development.},
  keywords={Industries;Manufacturing industries;Reviews;Collaboration;Production;Market research;Digital twins;Fourth Industrial Revolution;Stakeholders;Research and development;Digital Twin Implementation;Digital Twin Challenges;Industrial Application Digital Twins;Critical Evaluation;Industry 5.0},
  doi={10.1109/IEEM62345.2024.10857032},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10857130,
  author={Nkosi, T. and Emuze, F.},
  booktitle={2024 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Predictive Maintenance and Data Analytics: Current Insights}, 
  year={2024},
  volume={},
  number={},
  pages={1169-1173},
  abstract={In the era of Industry 5.0, marked by interconnectedness and smart technologies, the dependable functioning of machinery is of utmost importance. Predictive maintenance and data analytics are pivotal in proactively identifying and resolving machinery failures. Despite previous research emphasising their significance, there remains a gap in synthesising current insights. This review aims to fill that gap by examining the current state of predictive maintenance and data analytics. It seeks to uncover their functionalities, tools, and applications in anticipating and mitigating machinery failures. With a systematic approach, including a comprehensive literature search and analysis, this review aims to provide a better understanding of the subject. The outcomes include critical insights into these methodologies, guiding businesses, and researchers. Moreover, the review identifies gaps in existing literature and proposes future research. The study concludes that predictive maintenance and data analytics could enhance machinery reliability.},
  keywords={Data analysis;Systematics;Reviews;Machine learning;Industrial engineering;Reliability engineering;Maintenance;Machinery;Fifth Industrial Revolution;Predictive maintenance;Data Analytics;Machinery Reliability;Predictive Maintenance},
  doi={10.1109/IEEM62345.2024.10857130},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10857239,
  author={Rai, Shivangi and Sharma, Rrk},
  booktitle={2024 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Relating Strategy of Organization To Newer Technologies Of Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={541-545},
  abstract={In this paper we identify technologies that are slated to be used in Industry 5.0 and were not there in Industry 4.0. These are collaborative robots (also called as COBOTS), digital twin technology and use of wireless 6G technology. We relate these new technologies of Industry 5.0 (in particular the use of COBOTS and Digital Twin Technology) to the strategy of the firm. We note in particular that in organizations with cost leadership strategy (with very low level of environmental / internal uncertainty) there may be less pressing need for use of COBOTS than in firms with differentiation / innovation strategy (where there is much higher level of environmental / internal uncertainty). By using a similar reasoning we also note that in organizations with differentiation / innovation strategy, implementation of Digital Twin technology may take more efforts than the efforts required in implementation of Digital Twin technology in organizations with cost leader strategy.},
  keywords={Wireless communication;Technological innovation;Uncertainty;Costs;Service robots;Organizations;Collaborative robots;Pressing;Digital twins;Fifth Industrial Revolution;New Technologies in Industry 5.0;Collaborative Robots;COBOTS;Digital Twin Technology;Generic Strategy of Organizations},
  doi={10.1109/IEEM62345.2024.10857239},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10856987,
  author={Mabrouk, O. El and Kammoun, M.A and Hajej, Z. and Chaker, A. and Bennour, S.},
  booktitle={2024 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Optimized Production Plan Under Ergonomic Aspects and Operational Effectiveness}, 
  year={2024},
  volume={},
  number={},
  pages={1029-1033},
  abstract={The well-being of operators plays a key role in enhancing efficiency, productivity, and demand fulfillment in manufacturing systems. Improving both ergonomic conditions and operational effectiveness is essential for cost optimization, taking in account inventory cost, while meeting demand. This paper explores the integration of ergonomic considerations with production strategies. Recognizing the interconnectedness of these factors, we propose practical solutions to enhance system performance while safeguarding operator health. A model is developed incorporating inputs from ergonomic metrics, production process and production demand. Thus, the total production cost was optimized under the predefined constraints to balance productivity and worker well-being while meeting production targets within service level agreements. The results of our model demonstrate the effectiveness of our ergonomic strategy in optimizing production plans, which enhances production output and reduces costs while balancing the workload for operators.},
  keywords={Productivity;Measurement;Costs;Ergonomics;System performance;Production;Workstations;Timing;Optimization;Service level agreements;Industry 5.0;Production planning;Ergonomic Aspect;Optimization;Rotation Strategy},
  doi={10.1109/IEEM62345.2024.10856987},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10856990,
  author={Harkonen, J. and Koskinen, J. and Kotilainen, T.},
  booktitle={2024 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Industry 5.0: Data Analytics & Product Management Perspective}, 
  year={2024},
  volume={},
  number={},
  pages={0481-0485},
  abstract={Product management (PM), and product-centric approaches to data analytics can be valuable during Industry 5.0 (I5.0). This study explores the impact of $\mathrm{I 5. 0}$ on data analytics by taking a PM perspective. A scoping review was conducted to synthesize a conceptual model for data analytics. The findings indicate specific characteristics of 15.0 for data analytics. The developed concept forms a logical whole consisting of flexible business processes, scalable data management, and advanced analytics. Productization, master data, dynamic data models, and holistic end-to-end product lifecycle analytics are at the core of human-centric tailored capabilities and deeper ethical, sustainability, and collaborative insights.},
  keywords={Industries;Ethics;Data analysis;Reviews;Collaboration;Industrial engineering;Data models;Sustainable development;Fifth Industrial Revolution;Portfolios;Industry 5.0;data analytics;productization;product management;product data management;product portfolio management},
  doi={10.1109/IEEM62345.2024.10856990},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10857008,
  author={Salem, N. and Baklouti, S. and Kammoun, M.A. and Rezgui, T. and Hajej, Z. and Bennour, S.},
  booktitle={2024 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Real-Time Ergonomic Risk Assessment Using Inertial Measurement Units: A Case Study in the Manufacturing Industry}, 
  year={2024},
  volume={},
  number={},
  pages={800-804},
  abstract={This study presents a novel method utilizing wearable technology for ergonomic risk assessment, specifically targeting the mitigation of work-related musculoskeletal disorders (WMSDs) within industrial settings. It employs Inertial Measurement Units (IMUs) to capture and analyze joint angles in real time, with a detailed focus on the shoulder, elbow, and wrist during repetitive tasks. A significant advancement involves converting IMU data into a comprehensive 3D orientation model using quaternions, significantly aiding in visualizing limb movements and detecting potential ergonomic risks. A case study from the automotive industry highlights the importance of closely monitoring wrist movements to manage ergonomic risks effectively. By advancing the understanding of ergonomic risks and facilitating targeted interventions, this study contributes to integrating innovative solutions for improving productivity and worker well-being, in line with Industry 5.0 principles. Additionally, we propose future directions for integrating AI and machine learning to enhance predictive ergonomic risk assessment.},
  keywords={Wrist;Musculoskeletal system;Measurement units;Three-dimensional displays;Ergonomics;Employment;Machine learning;Real-time systems;Vehicle dynamics;Monitoring;Ergonomic Risks;Production Planning;Industry 5.0;Inertial Measurement Units;Work-related Musculoskeletal Disorders},
  doi={10.1109/IEEM62345.2024.10857008},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10857073,
  author={Wang, Shu and Zhou, Feng and Jiao, Jianxin Roger},
  booktitle={2024 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Manufacturing Nudging Personalization Through Optimization of Nudge Configuration Using 2D Genetic Algorithm}, 
  year={2024},
  volume={},
  number={},
  pages={1034-1038},
  abstract={Human-automation symbiosis (HAS) is a key aspect of Industry 5.0, marking the collaborative relationship between humans and automation systems. Nudging, a behavioral economics concept that indirectly encourages individuals to act in a certain way through subtle interventions, can be applied in the manufacturing context to improve the collaboration efficiency between human and automation agents. While manufacturing nudges facilitates the symbiotic relationship, they may also impact certain aspects of manufacturing system performance. Therefore, the objective of nudging personalization is to achieve HAS while maintaining system performance for a group of people, which suggests a multi-objective optimization problem. In this paper, a behavioral economics model for nudge evaluation using the conjoint prospect theory is proposed, and the formulation of manufacturing nudging personalization optimization is proposed, which is defined as the prospect value of the selected nudges relative to their engineering cost. A 2D genetic algorithm (GA) is employed to solve the optimization problem. Its feasibility and effectiveness are validated through a jet engine assembly case study.},
  keywords={Symbiosis;Measurement;Costs;System performance;Collaboration;Real-time systems;Mathematical models;Manufacturing;Optimization;Genetic algorithms;Manufacturing Nudging;Nudging Design;Nudge Theory;Prospect Theory;Genetic Algorithm},
  doi={10.1109/IEEM62345.2024.10857073},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10854929,
  author={Caratozzolo, Patricia and Rueda-Castro, Valentina and Azofeifa, Jose Daniel and Lara-Prieto, Vianney and Membrillo-Hernández, Jorge},
  booktitle={2024 World Engineering Education Forum - Global Engineering Deans Council (WEEF-GEDC)}, 
  title={The New Engineering Education to Face Industry 5.0 Challenges}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The shift from Industry 4.0 to Industry 5.0 indicates a human-centered, sustainable, and resilient workplace, emphasizing the integration of human factors into industrial systems and work processes. This paper examines how universities must redesign engineering programs to prepare students for the Industry 5.0 era, integrating advanced technologies with human-centric skills. The methodology involved a non-systematic mapping of literature and a cross-case synthesis of the main initiatives of ten universities in the United States, Latin America, and Europe, focusing on successful practices in engineering education. Two primary research clusters were identified: Industry 5.0 Challenges and Sustainable Socio-Economic Development. Findings suggest that universities with innovative, interdisciplinary engineering programs supported by global higher education associations are better positioned to meet Industry 5.0 requirements. This study underscores the importance of an interdisciplinary and holistic approach to engineering education, which is essential for addressing the complex demands of Industry 5.0.},
  keywords={Employment;Focusing;Europe;Human factors;Fourth Industrial Revolution;Fifth Industrial Revolution;Engineering education;Socioeconomics;Faces;Educational Innovation;Higher Education;Future Skills;Engineering Education;Industry 5.0},
  doi={10.1109/WEEF-GEDC63419.2024.10854929},
  ISSN={2837-5025},
  month={Dec},}@INPROCEEDINGS{10848585,
  author={Tavakkoli, Vahid and Mohsenzadegan, Kabeh and Kambale, Witesyavwirwa Vianney and Kyamakya, Kyandoghere},
  booktitle={2024 31st IEEE International Conference on Electronics, Circuits and Systems (ICECS)}, 
  title={Unveiling Synergies: Integrating IEEE 1451 and ISO 15926 for Advanced Interoperability in Smart Manufacturing and Transportation}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={In smart manufacturing and transportation systems, seamless interoperability is crucial for efficient data exchange and informed decision-making. This paper explores integrating IEEE 1451 and ISO 15926 data models to enhance interoperability in these sectors. We align sensor and actuator models to bolster interoperability and assess leveraging these standards within the Arrowhead flexible Production Value Network (fPVN). We propose innovative solutions, including an ontology mapping tool for seamless data integration, a wrapper service for real-time data translation, and a lightweight semantic reasoner at the fog computing layer. These solutions bridge the gap between theoretical constructs and practical applications, overcoming interoperability barriers, enhancing decision-making, and refining operational effectiveness. Our study shows significant potential for improving system cohesiveness, efficiency, and robustness tailored to Industry 5.0. This research provides a foundation for future implementations in smart manufacturing and transportation, paving the way for advanced, responsive, and sustainable industrial ecosystems.},
  keywords={ISO Standards;Decision making;Semantics;Ecosystems;Transportation;Ontologies;Data models;Fifth Industrial Revolution;Interoperability;Smart manufacturing;Smart Manufacturing;Smart Transportation;Interoperability;IEEE 1451;ISO 15926;Data Models;Ontology Mapping;Wrapper Service;Semantic Reasoning},
  doi={10.1109/ICECS61496.2024.10848585},
  ISSN={2995-0589},
  month={Nov},}@INPROCEEDINGS{10852491,
  author={Lykov, Artem and Tsetserukou, Dzmitry},
  booktitle={2024 2nd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={LLM-BRAIn: AI-driven Fast Generation of Robot Behaviour Tree based on Large Language Model}, 
  year={2024},
  volume={},
  number={},
  pages={392-397},
  abstract={This paper introduces a pioneering methodology in autonomous robot control, denoted as LLM-BRAIn, enabling the generation of adaptive behaviors in robots in response to operator commands, while simultaneously considering a multitude of potential future events. Unlike traditional step-by-step behavior generation methods, LLM-BRAIn leverages a behavior tree (BT) format that inherently encompasses various potential outcomes, thus reducing the frequency of model queries and optimizing resource utilization and decision-making time. LLM-BRAIn is a transformer-based Large Language Model (LLM) fine-tuned from the Stanford Alpaca 7B model to generate a BT from text descriptions. The model was trained on 8.5k instruction-following demonstrations generated using GPT-3.5. LLM-BRAIn accurately builds complex robot behavior while remaining small enough to run on the robot’s onboard microcomputer. The model generates structurally and logically correct BTs and can manage instructions not presented in the training set. Experiments revealed no significant subjective differences between BTs generated by LLM-BRAIn and human-created BTs, with participants distinguishing between them correctly in only 4.53 out of 10 cases, indicating performance close to random chance.The proposed approach holds promise for applications across various domains, including mobile robotics, drone operations, robot manipulator systems, and Industry 5.0. This applicability stems from the BT framework’s inherent consideration of numerous potential outcomes, obviating the need for exhaustive deliberation at each step, thereby expediting the robot’s operations. We provide a dataset for LLM-BRAIn replication: huggingface.co/datasets/ArtemLykov/LLM BRAIn dataset.},
  keywords={Training;Time-frequency analysis;Service robots;Large language models;Transformers;Resource management;Mobile robots;Robots;Drones;Autonomous robots;Robotics;Large Language Models;AI},
  doi={10.1109/FLLM63129.2024.10852491},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10853249,
  author={Jiang, Ji’ao},
  booktitle={2nd International Conference on Mechatronic Automation and Electrical Engineering (ICMAEE 2024)}, 
  title={Challenges and innovations in metal additive manufacturing for the automotive industry under the framework of industry 5.0}, 
  year={2024},
  volume={2024},
  number={},
  pages={382-388},
  abstract={This study explores the application of metal additive manufacturing (MAM) within the automotive industry under the framework of Industry 5.0. MAM, a key technology for fabricating components layer by layer from CAD models, facilitates the production of complex geometric structures with high flexibility and precision. Industry 5.0, with its emphasis on human-centric technologies, sustainability, and intelligent optimization, presents new opportunities for MAM to address traditional manufacturing challenges such as material inefficiencies, limited design flexibility, and high production costs. Despite its transformative potential, MAM still faces significant challenges in the automotive sector, including material defects, high equipment costs, complex post-processing requirements, and insufficient infrastructure, particularly in remote areas. This study highlights the integration of MAM with Industry 5.0 principles, such as AI, digital twins, and multi-material printing, to optimize production processes. The findings demonstrate that MAM can substantially enhance lightweight design, material efficiency, and production flexibility, offering sustainable and innovative solutions for the automotive manufacturing industry. Moreover, the integration of Industry 5.0 perspectives further strengthens human-machine collaboration and drives innovation, ensuring more resilient and efficient manufacturing systems.},
  keywords={},
  doi={10.1049/icp.2024.4532},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10849736,
  author={Gufran, Sajida and Aijaz, Adnan},
  booktitle={2024 IEEE Conference on Standards for Communications and Networking (CSCN)}, 
  title={Demo: Paving the Way for Smart Manufacturing with 5G/TSN Convergence and Augmented Reality}, 
  year={2024},
  volume={},
  number={},
  pages={334-336},
  abstract={The fifth-generation (5G) mobile/cellular and timesensitive networking (TSN) technologies are widely recognized as the key to shaping smart manufacturing for Industry 4.0 and beyond. Converged operation of the two offers end-to-end real-time and deterministic connectivity over hybrid wired and wireless segments. On the other hand, the augmented reality (AR) technology provides various benefits for the manufacturing sector. To this end, this demonstration showcases AR-aided remote assistance use-case over a hybrid TSN and 5G system. The demonstration setup comprises off-the-shelf 5G and TSN devices, a near product-grade 5G system, and an AR solution based on smart glasses. The demonstration shows the viability of over-the-air transmission of scheduled TSN traffic and real-time assistance for a local user from a remote environments. Performance results from the demonstration setup are also shown.},
  keywords={Performance evaluation;Hands;5G mobile communication;Wireless networks;Real-time systems;Fourth Industrial Revolution;Augmented reality;Standards;Smart manufacturing;Smart glasses;5G;802.1Qbv;AR;Industry 4.0;Industry 5.0;Open RAN;remote assistance;smart manufacturing;TSN},
  doi={10.1109/CSCN63874.2024.10849736},
  ISSN={2644-3252},
  month={Nov},}@INPROCEEDINGS{10844409,
  author={Kalem, Gokhan and Kosu, Semiha and Basaran, Mehmet},
  booktitle={2024 6th International Conference on Blockchain Computing and Applications (BCCA)}, 
  title={5G/6G Technology Capabilities Designed for Secure Edge Network: Smart City Use Cases of Turkcell}, 
  year={2024},
  volume={},
  number={},
  pages={807-811},
  abstract={There is no doubt that 5G and 6G technologies coupled with secure edge network capabilities play crucial roles in the evolution of Industry 4.0 and emerging Industry 5.0. In Industry 4.0, 5G enhances smart manufacturing by enabling ultra-reliable low-latency communication (URLLC), massive machine-type communication (mMTC), and enhanced mobile broadband (eMBB). These features support real-time monitoring, automation, edge computing, and data exchange across interconnected devices and systems to improve industrial efficiency and productivity. With Industry 5.0, which focuses on human-machine collaboration, 5G continues to be vital, but the advent of 6G will bring even greater capabilities. 6G is expected to offer a higher level of autonomy and advanced artificial intelligence integration by facilitating seamless interaction between humans, machines as well as intelligent systems via edge networking. This will enable more sophisticated applications, such as advanced robotics, virtual and augmented reality experiences, further connected driving innovations, and also the symbiosis between humans and technology, built on ubiquitous connectivity. From a leading mobile network operator perspective, in this paper, we delve into how 5G technology, empowered with secure edge networks, can transform XR communication, vehicular communication, and also UAV-based aerial communication while enabling safer, more reliable, and more efficient systems in the smart city applications on the road to 6G.},
  keywords={6G mobile communication;Productivity;Technological innovation;5G mobile communication;Smart cities;Collaboration;Ultra reliable low latency communication;Fourth Industrial Revolution;Reliability;Fifth Industrial Revolution;Extended reality;mobility;next-generation mobile communications (5G/6G);secure edge network;smart city applications;UAVs},
  doi={10.1109/BCCA62388.2024.10844409},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10845640,
  author={Mukul, Esin and Güler, Merve},
  booktitle={2024 8th International Symposium on Innovative Approaches in Smart Technologies (ISAS)}, 
  title={An Integrated Hesitant Fuzzy-based SWOT Analysis for Industry 5.0 Technology Evaluation}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Industry 5.0 is a revolutionary period that emphasizes the intersection of human innovation and modern technologies. This paper presents a strong evaluation framework using hesitant fuzzy-based Strengths, Weaknesses, Opportunities, Threats (SWOT) analysis to assess the impact and potential of Industry 5.0 technologies. The integration of hesitant fuzzy-based SWOT analysis with Multi-Criteria Decision-Making (MCDM) methods offers an efficient methodology for such evaluations. The study employs Hesitant Fuzzy Linguistic (HFL) Analytic Hierarchy Process (AHP) and Additive Ratio Assessment (ARAS) methodology to address decision-makers’ uncertainty and hesitation. The HFL AHP approach is used to weight the SWOT factors. The HFL ARAS approach is then used to assess technologies like artificial intelligence, digital twins, cobots, 6 G, and the Internet of Everything. An exemplary application is offered to demonstrate the robustness of the suggested methodology. The results of this application have shown that competitive advantage is the most important SWOT factor and that artificial intelligence is the most appropriate technology.},
  keywords={Technological innovation;Uncertainty;Collaborative robots;Analytic hierarchy process;Linguistics;Robustness;Digital twins;Internet of Things;Fifth Industrial Revolution;Artificial intelligence;Hesitant fuzzy linguistic term sets;industry 5.0;multi-criteria decision-making;SWOT analysis;technology evaluation},
  doi={10.1109/ISAS64331.2024.10845640},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10840533,
  author={Ahmed, Riaz and Khan, Suhel Ahmad and Kumar, Sudesh},
  booktitle={2024 4th International Conference on Technological Advancements in Computational Sciences (ICTACS)}, 
  title={The Role of Industry 5.0 in Empowering Healthcare Through Technology and Value Creation}, 
  year={2024},
  volume={},
  number={},
  pages={1762-1767},
  abstract={Industry 5.0, characterized by the convergence of contemporary technology with human intelligence, has the potential to revolutionize healthcare by prioritizing customization., eco-friendliness, and solutions that focus on the needs of people. The transition from Industry 4.0 to Industry 5.0 signifies a revolution in the field., leading to notable adjustments in social dynamics and manufacturing processes. With the use of information technologies like blockchain, cloud computing, big data analytics, artificial intelligence (AI), and the Internet of Things (IoT)., Industry 5.0 offers individuals in need of healthcare individualized, patient-focused services that are both effective and affordable. Additionally, it analyses the implications and uses of Industry 5.0 for healthcare delivery to look at how it influences the health care system. It also discusses security concerns and the benefits of Healthcare Industry 5.0. This article compares Industry 4.0 with Industry 5.0 in terms of technical development and healthcare. This study covered the shift from Industry 4.0 to Industry 5.0, its implications for health care and the three key tenets of the I5.0 human-centric approach: sustainability., resilience., and resiliency.},
  keywords={Technological innovation;Medical services;Fourth Industrial Revolution;Internet of Things;Security;Resource management;Fifth Industrial Revolution;Artificial intelligence;Sustainable development;Resilience;Industry 4.0;Industry 5.0;Healthcare System;IoT;threats;Security Risk Assessment;Personalization},
  doi={10.1109/ICTACS62700.2024.10840533},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10840854,
  author={Pathak, Arnima and Shivhare, Mani and Kumar, Durgesh},
  booktitle={2024 4th International Conference on Technological Advancements in Computational Sciences (ICTACS)}, 
  title={Smart Educational Ecosystems: Tailoring Employee Training With Ai and Iot in the Industry 5.0 Landscape}, 
  year={2024},
  volume={},
  number={},
  pages={1862-1868},
  abstract={This study investigates the transformational potential of combining the Internet of Things with artificial intelligence to build intelligent educational ecosystems for Industry 5.0 worker training. Seeing the need for tailored learning experiences to match changing skill requirements, the research looks into how AI and IoT may transform workforce education. Using a mixed-methods approach that includes expert interviews, case study analysis, and literature evaluation, the research identifies and evaluates the essential elements of AI- and IoT-driven training systems. The results show that real-time data gathering and feedback enabled by IoT in conjunction with AI-powered tailored learning greatly enhances organizational flexibility, employee engagement, and learning outcomes. The report specifically notes gains in information retention, skill development speed, and training cost savings. The study also tackles issues which include reluctance to technology adoption and worries about data privacy. It emphasizes a human-centric strategy that strikes a balance between technology improvements and ethical issues for enterprises making the transition to Industry 5.0. It also provides useful insights and suggests an implementation structure.},
  keywords={Training;Industries;Ethics;Ecosystems;Transforms;Real-time systems;Internet of Things;Fifth Industrial Revolution;Artificial intelligence;Interviews;Industry 5.0;Artificial Intelligence;Internet of Things;Smart Education;Employee Training;Personalized Learning;Human-Centered Design;Ethical Considerations},
  doi={10.1109/ICTACS62700.2024.10840854},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10838804,
  author={Leißau, Madlene and Laroque, Christoph},
  booktitle={2024 Winter Simulation Conference (WSC)}, 
  title={Breaking Barriers in Semiconductor Simulations: An Automated Low-Code Framework for Model-Structure Synchronisation and Large-Scale Simulation Studies}, 
  year={2024},
  volume={},
  number={},
  pages={1919-1930},
  abstract={The paradigm shift towards Industry 4.0 and the emerging trends of Industry 5.0 present ongoing challenges in production planning and control. In response to these dynamics, discrete event-driven simulation methods are gaining prominence as an operational decision-support-tool, particularly in the semiconductor industry. This paper introduces an automated low-code framework designed to synchronize model structures across simulation tool boundaries for extensive simulation studies, using the Semiconductor Manufacturing Testbed 2020 as a test reference, and aims to serve as a helpful tool for simulation experiments. Key aspects include model structure synchronization, Design of Experiments, and the distributed execution of large-scale simulation studies.},
  keywords={Semiconductor device modeling;Production planning;Electronics industry;Semiconductor device manufacture;Market research;Fourth Industrial Revolution;Synchronization;Fifth Industrial Revolution},
  doi={10.1109/WSC63780.2024.10838804},
  ISSN={1558-4305},
  month={Dec},}@INPROCEEDINGS{10838963,
  author={Hii, Daniel Jun Chung and Hasama, Takamasa},
  booktitle={2024 Winter Simulation Conference (WSC)}, 
  title={Towards the Digital Twinning and Simulation of a Smart Building for Well-Being}, 
  year={2024},
  volume={},
  number={},
  pages={726-737},
  abstract={Smart cities and buildings are enabled by the Internet of Things (IoT) sensor infrastructures integration and monitoring in the current Industry 5.0 era. Environment sensing, people and robots counting enable the simulations of both digital twin and agent-based modelling (ABM). This enables the understanding of the impact between the built environment and humans. The movement analysis allows planning and design of spaces as well as utilizing machine learning methods to train the trajectories for space usage prediction. Human behavior and social interaction comprehension is important to generate people friendly spaces. The GEAR is a smart, green, and WELL certified building embedded with sensors as a living lab for research and development. The diverse workspace layouts create an ideal testbed to study human and built environment interactions. This pursuit is to achieve more sustainable and better designed spaces for human well-being in the fast-changing world.},
  keywords={Smart buildings;Smart cities;Service robots;Robot sensing systems;Trajectory;Sensors;Planning;Internet of Things;Research and development;Monitoring},
  doi={10.1109/WSC63780.2024.10838963},
  ISSN={1558-4305},
  month={Dec},}@INPROCEEDINGS{10841707,
  author={Chandar, Kumar and J, Vijayadurai and K, Chandrasekaran},
  booktitle={2024 3rd International Conference on Automation, Computing and Renewable Systems (ICACRS)}, 
  title={Comparative Analysis of Soft Computing Algorithms for Predicting Employee Turnover in IT Industry}, 
  year={2024},
  volume={},
  number={},
  pages={1643-1647},
  abstract={The COVID-19 pandemic, information technology (IT) enterprises in India have been dealing with a systemic problem of high attrition for the last several years. This has led to employee preferences for remote work and knowledge-based losses for the companies. To improve their knowledge and expertise in Industry 5.0's disruptive technologies and use generative artificial intelligence (AI) in future projects, mid-career professionals depart from their existing companies. A number of training and development initiatives were introduced by Indian IT companies in an effort to motivate staff members to advance their skills. Indian IT organizations are thus developing policies and procedures that emphasize employee growth and career planning to retain staff members; this has turned into a unique retention strategy. The greatest loss to the corporation is personnel turnover since it results in significant indirect costs. In addition to giving employers the chance to resolve any regulatory concerns and enhance employee work-life balance, the research project is to create a model that can anticipate employee departures. The Quantitative Research approach (Data-Driven Decision Making) is used in this research study and data is analysed using statistical analysis and predictive analysis. The proposed predictive model is developed based on soft computing algorithms. Utilizing the IBM HR dataset, the suggested model is verified. As expected, the algorithm does a better task of forecasting who will leave the organization than it does at predicting who will not according to the projected results.},
  keywords={Support vector machines;Training;Renewable energy sources;Accuracy;Computational modeling;Companies;Predictive models;Nearest neighbor methods;Prediction algorithms;Remote working;Soft Computing;Deep Learning;Employee Turnover Prediction;Supervised Learning Models;Logistic Regression;Industry 5.0},
  doi={10.1109/ICACRS62842.2024.10841707},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10836165,
  author={Claudia Carvalho, Ana and Isabel Carvalho, Ana and Correia, Ricardo},
  booktitle={2024 International Conference on Decision Aid Sciences and Applications (DASA)}, 
  title={Robot With Vision Guidance System for Unscrewing Operation}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This work consists in identifying screws along a section of a metal beam, using a camera. Subsequently, the robot moved to the screws with tool (screwdriver) oriented and aligned with the screws, unscrewing them completely automatically. To detect the screws, a dataset of images contextualized with the application was created for personalized training of a neuronal network model. With this solution it is possible to detect and distinguish any type of screw, as the model can be continuously trained and optimized, following the logic of a scalable solution for the following phases of this development.},
  keywords={Training;Machine vision;Computational modeling;Robot vision systems;Metals;Fasteners;Cameras;Logic;Robots;Context modeling;Computer vision;Yolo-v5;Robot;Industry 5.0},
  doi={10.1109/DASA63652.2024.10836165},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10835665,
  author={Karbouj, Bsher and Tobias Schuster, Per Sören and Blumhagen, Moritz and Krüger, Jörg},
  booktitle={2024 IEEE 6th International Conference on Cognitive Machine Intelligence (CogMI)}, 
  title={Optimizing Human-Robot Collaboration in Industry 5.0: A Comparative Study of Communication Mediums and Their Impact on Worker Well-being and Productivity}, 
  year={2024},
  volume={},
  number={},
  pages={182-188},
  abstract={As manufacturing environments transition towards Industry 5.0 paradigms and incorporate human-robot collaborative activities, investigating optimal communication strategies between human workers and robotic assistants is critical. Smooth coordination through communicating needs, plans, and actions is essential for effective teamwork. However, the impacts of different communication mediums on human factors and assembly cycle time in these hybrid teams remain in initial research stages. While direct physical communication channels, like buttons, allow for communicating the needs of a collaborative human partner, this active medium may increase operator workload and stress. In contrast, indirect visual mediums where robots interpret human behavior may reduce active control demands. Evaluating communication effects is critical as Industry 5.0 aims to improve human well-being by facilitating closer human-machine cooperation. This study compared active, direct communication through physical buttons with passive, indirect communication visually through AI-based robot observation and decision-making. 50 participants completed an assembly task across three conditions: no robot assistance, robot assistance via a direct physical medium, and assistance via an indirect visual medium (AI observing and deciding robot actions). Mental workload and stress were assessed using heart rate variability and reaction times. Assembly cycle times were manually recorded. Results showed a 17% reduction in subjective mental workload with the visual communication medium compared to manual assembly for 64% of participants. HRV analysis indicated lower stress levels in both collaborative conditions compared to manual assembly, with the physical button interface showing the lowest stress levels overall. Assembly times averaged 5% faster with AI-controlled visual communication versus direct button control. These results suggest AI-enabled visual communication better optimizes human wellbeing and productivity, which could play a key role for Industry 5.0 goals in transitioning towards closer and more harmonious human-robot collaboration.},
  keywords={Productivity;Visual communication;Service robots;Robot kinematics;Collaboration;Human factors;Manuals;Fifth Industrial Revolution;Heart rate variability;Assembly;Human-Robot Collaboration;Industry 5.0;Communication Medium;Human Factors},
  doi={10.1109/CogMI62246.2024.00032},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10837670,
  author={Bondin, Andrea and Zammit, Joseph Paul},
  booktitle={2024 21st International Conference on Information Technology Based Higher Education and Training (ITHET)}, 
  title={Breaking Barriers: Enhancing Engineering Knowledge Transfer in Higher Education Through Mixed Reality Solutions}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={The current global economic challenges are placing significant demands on employers in the engineering sector to seek industry-ready competent engineers who can quickly contribute without extensive training. However, employers often face the dilemma of selecting candidates from a pool of recent graduates who may lack the hands-on skills needed to navigate traditional manufacturing methods, troubleshoot issues, and improve current processes using modern technological advancements. In today's competitive economic landscape, academic excellence alone does not guarantee successful employment. Employers now value generic skills like creativity, self-confidence, innovation, and hands-on problem-solving abilities more than ever. The skills gap highlighted by industry in recent engineering graduates working in practical settings underscores the need for enhancements in the current higher education system to better align with industry demands. Research in the education sector has explored the potential of technology, particularly Mixed Reality (MR), to enhance learning outcomes. Recent studies have demonstrated MR's effectiveness in improving college students' overall learning outcomes. While some studies have examined extending MR technology to university students, this area is still in its early stages. This paper presents research conducted at the University of Malta, employing multiple methods approaches to identify and analyse the barriers to knowledge transfer in university-level engineering education. It also introduces a framework for developing a Mixed Reality educational tool aimed at better preparing graduates for the workplace. The paper introduces the initial research work and potential of MR in enhancing training precision and efficiency, with initial insights suggesting significant potential improvements in practical skill acquisition. Through this work, we seek to continue to bridge the gap between academic preparation and industry expectations, positioning MR as a key technology in the evolution of engineering education.},
  keywords={Industries;Training;Economics;Technological innovation;Employment;Mixed reality;Virtual reality;Stakeholders;Engineering education;Knowledge transfer;Engineering Education;Mixed Reality;Virtual Learning factories;Upskilling;Industry 4.0/5.0 and Education 4.0},
  doi={10.1109/ITHET61869.2024.10837670},
  ISSN={2473-2060},
  month={Nov},}@INPROCEEDINGS{10838120,
  author={Blancaflor, Eric B. and Robles, Cyrus RJ and Espino, Samuel III and Matignas, Kristine Grace and Abisado, Mideth and Palenzuela, Ronnel},
  booktitle={2024 IEEE 7th International Conference on Computer and Communication Engineering Technology (CCET)}, 
  title={Comparative Analysis of Current Infrastructure of Cloud Computing Unveiling the Trends of Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={200-204},
  abstract={This study aims at a comparative analysis of leading cloud computing architectures, focusing on their readiness for Industry 5.0. It uses Snowball Systematic Literature Review to examine key platforms like AWS, Azure, and Google Cloud to evaluate scalability, security, latency, and data processing capabilities. Emerging technologies such as edge computing and serverless computing were explored alongside data sovereignty and compliance considerations. Insights aim to inform decisions on optimizing cloud infrastructure in the promising Industry 5.0, contributing to resilient, secure, and agile ecosystems supporting this transformative era.},
  keywords={Industries;Cloud computing;Scalability;Focusing;Serverless computing;Computer architecture;Fifth Industrial Revolution;Standards;Edge computing;Systematic literature review;Industry 5.0;Cloud Computing;Emerging Technologies;Network Architecture},
  doi={10.1109/CCET62233.2024.10838120},
  ISSN={2836-5992},
  month={Aug},}@INPROCEEDINGS{10834383,
  author={Rajagopal, Balaji Ganesh and Kannan Raju, Jagadeesh and Jacob, Mincy Rachel},
  booktitle={2024 IEEE International Conference on Teaching, Assessment and Learning for Engineering (TALE)}, 
  title={Empowering Inquisitive Learners: ICT and Holistic Development in University 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={University 5.0 thrives on the transformative power of ICT. Digital learning platforms, virtual labs, and collaborative software elevate the educational experience by fostering creativity and inclusivity. These tools reshape how universities operate: interactive platforms engage students through simulations and readily available materials, while virtual labs provide safe and cost-effective experimentation opportunities. Research is empowered as well, with cloud storage and advanced software accelerating data analysis and collaboration. Online repositories democratize research findings, fostering knowledge exchange and scientific progress. Administration becomes streamlined with online registration, payments, and transcripts minimizing bureaucratic hurdles. Automated workflows further optimize internal processes, allowing staff to dedicate more time to fostering a dynamic learning environment. Finally, ICT bridges the gap between universities and the broader community. Online courses and events connect institutions with alumni, industry leaders, and the public, enriching the overall learning experience. In essence, ICT propels universities towards a more adaptable, responsive, and sustainable educational model, preparing students to thrive in a rapidly evolving world. This work delves into the different verticals in an educational management system in which ICT tools can be introduced to transform the university towards practicing holistic development. Three different architectures are proposed in this article to universalize the teaching-learning process along with holistic development to achieve the requirements for University 5.0.},
  keywords={Technological innovation;Ethics;Data analysis;Atmospheric modeling;Education;Collaboration;Transforms;Aerodynamics;Software;Information and communication technology;ICT-enabled tools;Holistic development;University 5.0;Digital learning platforms;Virtual laboratories;Inclusive education;Educational innovation;Sustainable education model},
  doi={10.1109/TALE62452.2024.10834383},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10828917,
  author={Manjunatha and Aswini, S and Lakhanpal, Sorabh and Rao, Bolleddu Devananda and Srivastava, Abhinav and Smitha, K},
  booktitle={2024 7th International Conference on Contemporary Computing and Informatics (IC3I)}, 
  title={Pioneering AI in UAV-Assisted 6G Networks for the Advancement of Mobile Robotics in Industry 5.0}, 
  year={2024},
  volume={7},
  number={},
  pages={698-707},
  abstract={New methods are needed to keep up with the fast growth of Industry 5.0 when UAVs are added to 6G networks. This study talks about new ways to make tracking, communication, security, resource sharing, and finding problems better in 6G networks that use unmanned aerial vehicles (UAVs). Using exploration-exploitation loops, the Bellman equation, and dynamic adaptation, the Reinforcement Learning for UAV Navigation method makes decisions that are flexible. Machine Learning is used in Dynamic Network Adaptability to make communication methods better in real time. This makes UAV networks more flexible and efficient. Using AI algorithms to design a secure communication protocol gives great security. Important data is sent safely in 6G networks with UAVs using encryption driven by AI. The Scalable Resource Allocation using Genetic Algorithms Algorithm also offers a fresh way of allocating resources, which makes it flexible and scalable for a range of task situations. Anomaly detection in real time is needed for Industry 5.0 apps, and the Real-time Anomaly Detection using Deep Learning Algorithm makes security better. A full test of comparison shows that the suggested options do better in terms of accuracy, dependability, freedom, and openness. The pictures support the idea that the suggested options are better than the current ones. A research paper on Reinforcement Learning for UAV Navigation focuses on the exploration-exploitation, dynamic adaptation, and Bellman equation use of the method. Overall, these options give you all the tools you need to make UAV activities better over 6G networks in Industry 5.0. They make it easier to use UAVs in many situations by encouraging flexible choices, smart use of resources, safe contact, and instant discovery of strange events.},
  keywords={6G mobile communication;Navigation;Reinforcement learning;Autonomous aerial vehicles;Real-time systems;Mathematical models;Security;Resource management;Fifth Industrial Revolution;Vehicle dynamics;Reinforcement Learning;UAV Navigation;6G Networks;Dynamic Network Adaptability;Machine Learning;Secure Communication Protocol;AI Algorithm;Scalable Resource Allocation;Real-time Anomaly Detection;Industry 5.0},
  doi={10.1109/IC3I61595.2024.10828917},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10829054,
  author={Singh, Pooja and Jaiswal, Shalini and Srivastava, Shalini and Azad, M. L. and Mishra, Vernika and Nautiyal, Anshika},
  booktitle={2024 7th International Conference on Contemporary Computing and Informatics (IC3I)}, 
  title={Fashion Forward: Exploring the Influence of AI on Modern Fashion Trends}, 
  year={2024},
  volume={7},
  number={},
  pages={864-869},
  abstract={Fashion has always been a forward-thinking phenomenon that adopts new technology as they become available. Fashion includes design, manufacturing, and consumption, all of which rely on technology to increase product quality and availability in retailers. Artificial intelligence moves as fast as fashion. For almost a decade, artificial intelligence has been utilized to analyse consumer preferences and fashion trends. Its influence on fashion, including the advent of the Fast Fashion movement, is clear. As the garment sector’s digitalization moves toward industry 5.0, the application of artificial intelligence will become more frequent in a wider range of processes. This study will investigate the uses of artificial intelligence in the fashion and business sectors. This research will look into the applications of artificial intelligence in the fashion and business sectors. The paper will also cover modern AI models used in the fashion industry, such as Generative Adversarial Networks (GAN), StyleGAN, StyleGAN2, and Variational Autoencoders (VAEs).},
  keywords={Industries;Training;Technological innovation;Autoencoders;Generative adversarial networks;Market research;Turning;Manufacturing;Artificial intelligence;Business;AI in fashion;AI in apparel industry;Virtual cloth;fashion retailing;Generative Adversarial Networks (GAN);StyleGAN;StyleGAN2;and Variational Autoencoders (VAEs)},
  doi={10.1109/IC3I61595.2024.10829054},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10828864,
  author={Dagar, Reetika and Vijeyata and Srivastav, Rashi and Aarif, Mohd and Lohiya, Ankur and Muthuperumal, S},
  booktitle={2024 International Conference on Intelligent Systems and Advanced Applications (ICISAA)}, 
  title={Enhancing Workplace Efficiency with the Implementation of the Internet of Things to Advance Human Resource Management Practices}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The study delves into the transformative potential of integrating the Internet of Things into Human Resource Management practices, aiming to enhance workplace efficiency and organizational dynamics. Two key hypotheses guide the investigation: first, that the strategic integration of IoT positively influences employee efficiency, measured through metrics like time-to-hire, task completion rates, and HR service response times; and second, that the adoption of IoT-enhanced HRM practices contributes to positive organizational culture and collaboration. The research employs a comprehensive methodology, including quantitative analysis of pre-and post-IoT implementation metrics, qualitative insights derived from thematic analysis, industry-specific and size-stratified comparisons, ANOVA testing, and correlation analyses. Results demonstrate statistically significant improvements post-IoT implementation, reinforcing both hypotheses. Reduced time-to-hire by $\mathbf{3 3 \%}$, increased task completion rates by $\mathbf{2 0 \%}$, and a $\mathbf{5 0 \%}$ reduction in HR service response times signify tangible operational enhancements. Qualitative findings emphasize positive shifts in communication, decision-making, and team dynamics, contributing to a positive organizational culture. Industry-specific analyses highlight the adaptability of IoT benefits across sectors, while size-stratified comparisons showcase its relevance for organizations of varying sizes. The study contributes valuable implications for practitioners, emphasizing the strategic potential of IoT in advancing HRM practices and fostering sustained workplace success in the digital period.},
  keywords={Measurement;Correlation;Employment;Decision making;Organizations;Dynamic scheduling;Time factors;Internet of Things;Intelligent systems;Testing;Internet of Things;HRM Practices;Workplace Efficiency;Organizational Culture;Quantitative Analysis;Qualitative Insights;ANOVA Testing;Correlation Analysis},
  doi={10.1109/ICISAA62385.2024.10828864},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10838154,
  author={G, Nirupama K and G V L, Narasimha Babu},
  booktitle={2024 IEEE 5th Women in Technology Conference (WINTECHCON)}, 
  title={Interoperable SoC Framework for PCIe Design Verification Challenges}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The growing complexities in the Peripheral Component Interconnect (PCIe) designs with each new generation brings in even more challenges in PCIe verification. There is an increasing trend of ASIC re-spins, coupled with the industry demands for lesser Time to Market (TTM) makes it inevitable to take actions to close the verification gap as much as possible, as quickly as possible. This must be done incrementally with better solutions and the proposal takes steps to mitigate some of the PCIe design and verification challenges. The PCIe verification effort has increased 90-fold from PCIe 5.0 to PCIe 6.0. The interoperability issues have an estimated 6-fold increase from PCIe 3.0 to PCIe 6.0. This paper provides a comprehensive solution with a System Verilog (SV) and Universal Verification Methodology (UVM) based framework entailing a PCIe design IP and Verification IP (VIP), that provides a standard scalable environment. The framework facilitates quicker and easy integration of IP into a subsystem or SoC, solves the interoperability issues, employs methods like Register Abstraction Layer (RAL) based configuration APIs for reuse and configurability. The framework facilitates faster testbench bring up, with first PCIe linkup and first test pass time brought down by 75% per PCIe IP. This helps in achieving quick, quality pre-silicon verification sign-off boosting post-silicon confidence.},
  keywords={Industries;Time to market;Market research;Registers;Complexity theory;IP networks;Proposals;Hardware design languages;Interoperability;Standards;PCIe;Interoperability;Verification IP;SoC Integration;Testbench bring up},
  doi={10.1109/Wintechcon61988.2024.10838154},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10827164,
  author={Alam, Md Mahinur and Mohtasin, Golam and Subhan, Md Raihan and Kim, Dong-Seong and Jun, Taesoo},
  booktitle={2024 15th International Conference on Information and Communication Technology Convergence (ICTC)}, 
  title={Federated Semi-Supervised Digital Twin for Enhanced Human-Machine Interaction in Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1270-1275},
  abstract={The integration of collaborative machines in Industry 5.0 has necessitated advanced safety and interaction protocols to enhance productivity and ensure human safety. Traditional safety measures are often bulky, inflexible, and costly, limiting true human-robot collaboration. This research introduces a federated semi-supervised Digital Twin framework designed to address these challenges by leveraging synthetic data generated via Digital Twin technology and real-world data, facilitated by ROS2-based communication. The framework employs Federated Semi-Supervised Learning to enhance the detection and classification of human-machine interactions. Evaluations demonstrate that the proposed model significantly outperforms existing models such as Yolov8 and Mask-R CNN in terms of mean Average Precision (mAP) of 91.87% and accuracy of 98.10% while being more resource-efficient. This study underscores the potential of combining federated learning with Digital Twin technology to create adaptable, efficient, and scalable solutions for smart manufacturing, thereby advancing the field of human-robot collaboration.},
  keywords={Human computer interaction;Adaptation models;Accuracy;Federated learning;Human-robot interaction;Semisupervised learning;Digital twins;Safety;Fifth Industrial Revolution;Synthetic data;Cobot;RoboDK;Federated Learning;MBS;Semi-supervised Learning;SBS},
  doi={10.1109/ICTC62082.2024.10827164},
  ISSN={2162-1241},
  month={Oct},}@INPROCEEDINGS{10820412,
  author={Szeredi, Viktória Varsányiné and Trenka, Zoltán János and Pogatsnik, Monika},
  booktitle={2024 IEEE 6th International Symposium on Logistics and Industrial Informatics (LINDI)}, 
  title={Smart Logistics and Sustainability in Logistics 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={109-114},
  abstract={This systematic review examines how Logistics 5.0 approaches certain problems. Three research questions are in focus: (1) What are the similarities and differences between smart logistics in Industry 4.0 and Industry 5.0? (2) Smart logistics in the era of Industry 5.0. (3) How does Logistics 5.0 respond to issues related to climate change and sustainability? Three keywords were used (Logistics 5.0, Supply chain 5.0, Industry 5.0 & Logistics) to search the literature in the SCOPUS and IEEE Xplore databases. In addition to the three main research questions, the occurrence of certain concepts and expressions were also examined in the selected papers. Such terms include green logistics, Internet of Things (IoT), artificial intelligence (AI). The digital automation solutions of Logistics 4.0 move towards the collaboration of digitization and human efforts in Logistics 5.0. Logistics 5.0 makes environmental protection a top priority while integrating it with technological innovation. Using Logistics 5.0, the targeted collection, online processing and analysis of data at all levels, as well as artificial intelligence in their decisions, enable unprecedented cost, error and time savings and open the way to a better and more sustainable logistics industry.},
  keywords={Technological innovation;Supply chains;Internet of Things;Fifth Industrial Revolution;Artificial intelligence;Sustainable development;Protection;Informatics;Logistics;Systematic literature review;Logistics 5.0;smart logistics;Supply chain 5.0;climate change;sustainability},
  doi={10.1109/LINDI63813.2024.10820412},
  ISSN={2156-8804},
  month={Oct},}@INPROCEEDINGS{10818813,
  author={Rodrigues, Ricardo N. C. and Fonseca, Jaime and Moreira, António H.J.},
  booktitle={2024 International Conference on Advanced Mechatronic Systems (ICAMechS)}, 
  title={Cyber-physical Workbench for human digital twin integration: A system proposal}, 
  year={2024},
  volume={},
  number={},
  pages={153-158},
  abstract={"Industry 5.0" is the next step on an ever-evolving ecosystem with the objective of creating a symbiotic relation between automated processes and human workers, by bringing the human worker again to factory floors and use automated system to enhance the worker. This improvement can be done by using Digital Twins (DT) and Cyber-Physical Systems (CPS), by assessing the human and managing the task to improve performance and monitor ergonomics. To create a foundation for the implementation of this type of DTs a system is proposed to obtain workers joints and assess their state using two RGBD (Red, Green, Blue and Depth) cameras. To evaluate such a system, three distinct tests were executed, one to assess real time error, one for continuous measurements on simple tasks, and the last one to gauge complex tasks. The system showed promising results with an adequate assessment of instant positioning with error inferior to 0.03 m and work volume assessment below 0.01 m3, and an average root-mean-square of 0.035 m on trajectory assessment, but falling short on travel distance calculation with considerable error such as 0.3 m, but improvements are suggested.},
  keywords={Phase measurement;Volume measurement;Measurement uncertainty;Cameras;Time measurement;Digital twins;Trajectory;Wearable devices;Assembly;Testing;Industry 5.0;Cyber-physical system;Workbench;Digital-Twin},
  doi={10.1109/ICAMechS63130.2024.10818813},
  ISSN={2325-0690},
  month={Nov},}@INPROCEEDINGS{10818883,
  author={Thonas, Su and Huafang, Ju and Tina, Yang},
  booktitle={2024 19th International Microsystems, Packaging, Assembly and Circuits Technology Conference (IMPACT)}, 
  title={Utilizing Both Backplane and Cable Connections in Server Systems: Viability and Challenges in a Common AI Server Design}, 
  year={2024},
  volume={},
  number={},
  pages={268-271},
  abstract={Following the introduction of the DC-MHS1 (Data Center Modular Hardware System) and AI (Artificial Intelligence) servers, the adoption of cabling topologies has become increasingly prevalent and indispensable. Within DC-MHS design, the Host Process Module (HPM) necessitates cabling for inter-module connectivity. In AI servers, components such as the HPM, PCI Express (PCIe) switch board, and UBB (Universal Baseboard) may not reside on the same chassis floor, necessitating vertical connections either through traditional backplane design or cables to link boards and modules. These connections are critical for high-speed signal transmission, exemplified by technologies like PCIe 5.02 operating at 32 GT/s. Driven by escalating computing demands, the industry is eagerly anticipating PCIe 6.0 and exploring advancements towards PCIe 7.0, which runs at 64 GT/s and 128 GT/s respectively. This paper presents a generalized connection topology for HPM, PCIe switch board, and UBB. Simulation and measurement results are included to elucidate common challenges encountered in cabling topologies.},
  keywords={Micromechanical devices;Industries;Backplanes;Switches;Packaging;Hardware;Topology;Servers;Artificial intelligence;Floors},
  doi={10.1109/IMPACT63555.2024.10818883},
  ISSN={2150-5942},
  month={Oct},}@INPROCEEDINGS{10817925,
  author={Heimann, Florian and Wetter, Oliver and Wette, Philip},
  booktitle={2024 IEEE/ACM Symposium on Edge Computing (SEC)}, 
  title={Are We There Yet? – Use Cases and Requirements for the Industrial Metaverse}, 
  year={2024},
  volume={},
  number={},
  pages={402-409},
  abstract={The manufacturing industry is constantly looking for new technologies to improve their structures, optimize processes, maximize profit, reduce cost, and improve quality. One such new technology is the metaverse. The metaverse uses a fully interconnected set of Digital Twins (DTs) that spans all parts of industrial production processes and company administration, thus enabling complex company and production insights. Implementations of metaverses in industrial processes are currently still rare, although there are concepts that promise major benefits. So why have these concepts not yet been used on a large scale in industrial production? To investigate this, we collect and discuss industrial use cases and derive requirements for a metaverse at industrial scale. With these requirements, we analyze existing architectures with respect to their applicability not only within big enterprises, but also at small and medium enterprises (SMEs). Furthermore, we present a vision for the Industrial Metaverse (IM) which fits current and future industrial needs. Finally, current open research questions are highlighted and future research directions are presented, with the ultimate goal of providing not only a further theoretical framework, but a broadly usable IM implementation.},
  keywords={Manufacturing industries;Costs;Metaverse;Production;Companies;Computer architecture;Digital twins;Edge computing;Industrial Metaverse;Industry 5.0;Digital Twin},
  doi={10.1109/SEC62691.2024.00044},
  ISSN={2837-4827},
  month={Dec},}@INPROCEEDINGS{10814318,
  author={AlMahasneh, Ruba and Hollósi, Gergely and Ficzere, Dániel and Bancsics, Máté and Lukovszki, Csaba and Varga, Pál},
  booktitle={2024 20th International Conference on Network and Service Management (CNSM)}, 
  title={Uncovering Common AI Challenges Across Industrial Domains in the Transition to Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={AI adoption in industrial applications has been slower than analysts expected due to the lack of best practices and industrial-grade solutions. In response, the Artificial Intelligence in Manufacturing leading to Sustainability and Industry 5.0 (AIMS5.0) project introduces 20 use cases from world-renowned companies, providing an opportunity to thoroughly analyze the challenges of implementing AI in industrial settings. This paper presents the first taxonomy of AI adoption challenges, organized by AI domains across the use cases, highlighting issues such as data collection, algorithmic limitations, and other deficiencies in current solutions. Based on these challenges, we outline the AIMS5.0 AI Toolbox, which offers various solutions to address them, as detailed in the paper. The challenges are validated through two sample, mature use cases, demonstrating how they manifest in different industrial applications.},
  keywords={Taxonomy;Refining;Companies;Data collection;Robustness;Manufacturing;Artificial intelligence;Fifth Industrial Revolution;Sustainable development;Faces;industry5.0;AI;AI toolbox;AI adoptation;AI application;aims5.0;machine learning},
  doi={10.23919/CNSM62983.2024.10814318},
  ISSN={2165-963X},
  month={Oct},}@INPROCEEDINGS{10818077,
  author={Lazcano, Vanel and Cho, Anthony and Loyola, Oscar and Dinani, Hossein T.},
  booktitle={2024 Eighth IEEE International Conference on Robotic Computing (IRC)}, 
  title={Using Neural Networks to Replace Components of a Depth Completion Model}, 
  year={2024},
  volume={},
  number={},
  pages={54-55},
  abstract={Depth data is a crucial source of information for applications like autonomous vehicles and 3D cinema. However, depth maps often contain holes or low-confidence regions, which must be addressed to ensure optimal performance in tasks like object avoidance and path planning. This paper proposes a convolutional neural network (CNN) to replace the feature extraction stage of a hybrid depth completion model. The hybrid model integrates convolutional stages with an infinity Laplacian-based interpolator to propagate sparse depth data into missing regions. The proposed CNN reduces processing time by a factor of three while maintaining comparable accuracy in depth map quality. This research is motivated by the need to improve depth completion systems for autonomous vehicles in the context of heavy machinery operating in complex industrial environments. Aligned with the principles of Industry 5.0, the solution focuses on enhancing efficiency and reliability while considering the integration of autonomous systems with human-centric industrial ecosystems. Preliminary results demonstrate the CNN's effectiveness in depth map completion, emphasizing its potential for improving computational efficiency in real-world applications.},
  keywords={Adaptation models;Accuracy;Three-dimensional displays;Service robots;Computational modeling;Neural networks;Convolutional neural networks;Machinery;Fifth Industrial Revolution;Autonomous vehicles;depth completion;convolutional neural networks;infinity Laplacian;anisotropic diffusion;Industry 5.0},
  doi={10.1109/IRC63610.2024.00055},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10814745,
  author={Ciolacu, Monica I. and Marghescu, Cristina and Mihailescu, Bogdan and Sorecau, Mirela and Sorecau, Emil and Bechet, Paul},
  booktitle={2024 IEEE 30th International Symposium for Design and Technology in Electronic Packaging (SIITME)}, 
  title={Education 5.0: Transforming Engineering Education in the Age of Generative AI}, 
  year={2024},
  volume={},
  number={},
  pages={303-308},
  abstract={The rise of generative AI is reshaping the landscape of Higher Education with implications we must understand and be prepared for. A future engineering graduate that fulfills the Industry 5.0 requirements must demonstrate proficiency in a range of competencies, including innovation, artificial intelligence (AI) methods, creativity, AI-supported decision-making, complex problem solving and leadership. This paper presents three case studies for developing future skills in Engineering Education for Industry 5.0 using problem-based learning, scenario-based learning and non-traditional laboratories that integrate generative AI in their teaching approaches. They were developed to increase students, motivation, curiosity, self-reflection, collaboration, hands-on and multiple perspective thinking of academic learning and new strategies to achieve established goals. Furthermore, the integration of generative AI, GNU Radio, powered GPUs represents a significant advance in radio transceiver development. This synergy boosts the performance and adaptability of radio systems, fostering new research and innovation opportunities in wireless communications.},
  keywords={Wireless communication;Technological innovation;Leadership;Radio transceivers;Generative AI;Laboratories;Problem-solving;Fifth Industrial Revolution;Engineering education;Electronics packaging;deep learning;GNU Radio;GR-Wavelearner;Industry 5.0;wireless communication},
  doi={10.1109/SIITME63973.2024.10814745},
  ISSN={2642-7036},
  month={Oct},}@INPROCEEDINGS{10811278,
  author={Erel-Özçevik, Müge and Bozkaya-Aras, Elif and Bilen, Tuğçe},
  booktitle={2024 IEEE 10th World Forum on Internet of Things (WF-IoT)}, 
  title={Metaverse-Based Order Picking Optimization for Supply Chain of Things}, 
  year={2024},
  volume={},
  number={},
  pages={660-665},
  abstract={In recent years, with the rise of e-commerce and digital services, customers’ expectations have affected supply chain management operations. The logistics industry reacts proactively by integrating new technologies into its systems to meet changing customer expectations. Among these technologies, a relatively new concept called Supply Chain of Things (SCoT) is an enabling technology for supply chain operations to increase productivity and automation. However, a large number of customer orders and increasing concerns about operating costs challenge efficient management and quality of service in SCoT. In this regard, this paper addresses the order-picking problem of minimizing delivery time and operating costs, including travel costs and total costs to the employer. Metaverse can be considered a feasible solution to address this problem due to its advantages of seamless and intelligent interaction between the physical world and the digital world. In this paper, we present a metaverse-based system architecture and design the network digital twin to enable intelligent real-time management of the SCoT environment. We formulate the order-picking problem and propose a genetic algorithm-based solution to satisfy customer demands on time with minimal operating costs by creating a digital twin of the supply chain system in the Metaverse. The simulation results show that the proposed solution achieves significant gains compared with baseline strategies in terms of the total cost to the employer while keeping order delivery time under the acceptable customer level.},
  keywords={Costs;Supply chain management;Metaverse;Simulation;Supply chains;Systems architecture;Real-time systems;Digital twins;Optimization;Genetic algorithms;Metaverse;Digital Twin;Order Picking Problem;Industry 5.0;Supply Chain of Things},
  doi={10.1109/WF-IoT62078.2024.10811278},
  ISSN={2768-1734},
  month={Nov},}@INPROCEEDINGS{10811287,
  author={Podder, Kanhon Kanti and Zhang, Jian and Mao, Shiwen},
  booktitle={2024 IEEE 10th World Forum on Internet of Things (WF-IoT)}, 
  title={Trustworthy Hand Signal Communication Between Smart IoT Agents and Humans}, 
  year={2024},
  volume={},
  number={},
  pages={595-600},
  abstract={Hand signals are the most widely used, feasible, and device-free communication method in manufacturing plants, airport ramps, and other noisy or voice-prohibiting environments. Enabling IoT agents, such as robots, to recognize and communicate by hand signals will facilitate human-machine collaboration for the emerging “Industry 5.0.” While many prior works succeed in hand signal recognition, few can rigorously guarantee the accuracy of their predictions. This project proposes a method that builds on the theory of conformal prediction (CP) to provide statistical guarantees on hand signal recognition accuracy and, based on it, measure the uncertainty in this communication process. It utilizes a calibration set with a few representative samples to ensure that trained models provide a conformal prediction set that reaches or exceeds the truth worth and trustworthiness at a user-specified level. Subsequently, the uncertainty in the recognition process can be detected by measuring the length of the conformal prediction set. Furthermore, the proposed CP-based method can be used with IoT models without fine-tuning as an out-of-the-box and promising lightweight approach to modeling uncertainty. Our experiments show that the proposed conformal recognition method can achieve accurate hand signal prediction in novel scenarios. When selecting an error level $\alpha=0.10$, it provided 100% accuracy for out-of-distribution test sets.},
  keywords={Hands;Training;Uncertainty;Accuracy;Service robots;Measurement uncertainty;Collaboration;Speech recognition;Airports;Calibration;Hand signals;Uncertainty measurement;Conformal prediction;Gesture recognition},
  doi={10.1109/WF-IoT62078.2024.10811287},
  ISSN={2768-1734},
  month={Nov},}@INPROCEEDINGS{10810585,
  author={Kanangnanon, Tanat and Fongsamut, Chalermpan and Jitngernmadan, Prajaks},
  booktitle={2024 8th International Conference on Information Technology (InCIT)}, 
  title={Optimal AI Models for Process Data Analysis in Industry 4.0 Regarding Digital Twin Implementation}, 
  year={2024},
  volume={},
  number={},
  pages={675-680},
  abstract={This study compares YOLOv8 and Mask R-CNN object detection algorithms for defect detection in digital twin applications for smart manufacturing. With the ongoing transformation of manufacturing processes in Industry 4.0 and 5.0, integrating digital twin technology and advanced visual inspection techniques has become crucial for improving quality control and process optimization. Using the expanded MVTec Metal Nut Dataset, we evaluated performance based on mean average precision (mAP), precision, recall, F1-score, and inference time. Results show YOLOv8 consistently outperformed Mask R-CNN in accuracy and computational efficiency, achieving higher scores across all metrics and quicker inference times. This suggests YOLOv8 is more suitable for real-time industrial applications, particularly in digital twin implementations. However, the study emphasizes the importance of considering specific manufacturing contexts when selecting an object detection model. The integration of AI-powered visual inspection with digital twin technology has significant potential to enhance product quality, reduce downtime, and optimize production processes, contributing valuable empirical evidence to guide the implementation of advanced defect detection systems in industry.},
  keywords={Visualization;Object detection;Quality control;Inspection;Real-time systems;Digital twins;Fourth Industrial Revolution;Quality assessment;Defect detection;Smart manufacturing;Digital Twin;YOLO;Industry 4.0;Object Detection;Visual Inspection},
  doi={10.1109/InCIT63192.2024.10810585},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10803305,
  author={Aluas, Mihaela and Angelis, Lefteris and Arapakis, Ioannis and Arvanitou, Elvira and Georgiou, Kostantinos and Gogos, Anastasios and Jahn, Marco and Kehagias, Dionysios and Kordoni, Valia and Macaluso, Sebastian and Mittas, Nikolaos and Moumtzi, Vasiliki and Rossini, Rosaria and Tsekeridou, Sofia and Tsoukalas, Dimitrios and Volioti, Christina and Vontas, Apostolos and Voulgarakis, Vasileios},
  booktitle={2024 50th Euromicro Conference on Software Engineering and Advanced Applications (SEAA)}, 
  title={SKILLAB: Skills Matter}, 
  year={2024},
  volume={},
  number={},
  pages={491-498},
  abstract={As society is continuously adapting to technological change and progress, fast-moving digital transformations are the driving force for setting the necessary skillsets for the workforce. Furthermore, the advent of Industry 5.0 as a defining concept for the future, which advocates a human-centric coalescence of humans and technology or software, renders the skilled workforce the most important asset in any organization or business. The endgame of the digital transformation is to evoke the reshaping, evolution, or replacement of traditional and possibly obsolete processes at intra- or inter-organizational levels in multiple aspects, introducing innovative ways of re-defining the workforce. In this context SKILLAB will act as a smart tool for handling, honing, and widening the competencies of the personnel of companies, forecasting future skill gaps and providing European citizens with a tool for upskilling and reskilling.},
  keywords={Training;Knowledge engineering;Force;Europe;Software;Proposals;Personnel;Forecasting;Software engineering;Recruitment;Skill gaps;Soft Skills;Hard Skills;Labour Market Analytics;European Union},
  doi={10.1109/SEAA64295.2024.00081},
  ISSN={2376-9521},
  month={Aug},}@INPROCEEDINGS{10802213,
  author={Bozzini, Chiara and Boldo, Michele and Martini, Enrico and Bombieri, Nicola},
  booktitle={2024 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)}, 
  title={A Real-time Filter for Human Pose Estimation based on Denoising Diffusion Models for Edge Devices}, 
  year={2024},
  volume={},
  number={},
  pages={10864-10869},
  abstract={Human Pose Estimation (HPE) is increasingly utilized across various sectors, from healthcare to Industry 5.0. To address the inherent inaccuracies in CNN-based HPE systems, filtering models are commonly employed to refine and improve inference results. However, state-of-the-art filtering models often require substantial computational resources, limiting their applicability in resource-constrained environments. To overcome this limitation, we propose a real-time filtering approach based on denoising diffusion models (DM) specifically optimized for edge devices. Through a micro-benchmarking process, we analyze the DM adaptability to different types and levels of noise and determine the optimal setup for specific application scenarios. We present a real-time filter that takes advantage of the DM setup with two configurations to address different application scenarios. Using a widespread edge device, we evaluate the model’s effectiveness in handling both synthetic and real noise generated by state-of-the-art HPE systems. The results demonstrate a significant improvement in real-time filtering performance with minimal computational overhead. The code is available on github.com/PARCO-LAB/LUT-DM-filters.},
  keywords={Performance evaluation;Adaptation models;Filtering;Computational modeling;Noise reduction;Noise;Pose estimation;Medical services;Diffusion models;Real-time systems;Denoising Diffusion Models;Human pose estimation;Filtering;Edge Devices},
  doi={10.1109/IROS58592.2024.10802213},
  ISSN={2153-0866},
  month={Oct},}@INPROCEEDINGS{10795982,
  author={Angrisani, Leopoldo and Arpaia, Pasquale and D'Arco, Mauro and De Benedetto, Egidio and Duraccio, Luigi and Regio, Fabrizio Lo and Tedesco, Annarita},
  booktitle={2024 IEEE International Conference on Metrology for eXtended Reality, Artificial Intelligence and Neural Engineering (MetroXRAINE)}, 
  title={A Metrological Approach to the Performance Characterization of Eye- and Head-Tracking Interfaces in eXtended Reality}, 
  year={2024},
  volume={},
  number={},
  pages={811-815},
  abstract={Given the increasing adoption of eXtended Reality Head-Mounted Displays (XR HMDs) and the related demand for hands-free Human-Machine Interaction (HMI), this paper introduces a metrological approach to the performance charac-terization of Eye- and Head-tracking input interfaces within XR scenarios. In particular, two metrics of interest are identified: Accuracy in selecting objects and Euclidean Distance between the detected gaze and reference points. Without loss of generality, the Microsoft HoloLens 2 HMD was considered as a case study. An experimental campaign involving eight subjects was conducted to investigate the intra- and inter-individual variability of the metrics considered. The obtained experimental results showed robust performance within the interfaces of HoloLens 2, thus allowing the development of high-information-rate XR applications in scenarios where precision tasks are needed.},
  keywords={Performance evaluation;Accuracy;Head-mounted displays;Extended reality;Neural engineering;Euclidean distance;Resists;Metrology;Reliability;Object recognition;Augmented Reality;eXtended Reality;Eye Tracking;Head Tracking;Human-Computer Interaction;Industry 5.0;Metrological Characterization;Measurement;Uncertainty;User Interface;Virtual Reality},
  doi={10.1109/MetroXRAINE62247.2024.10795982},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10796454,
  author={Pugliese, Raffaele and Badini, Silvia and Regondi, Stefano},
  booktitle={2024 IEEE International Conference on Metrology for eXtended Reality, Artificial Intelligence and Neural Engineering (MetroXRAINE)}, 
  title={Words to Matter: A Comparative Study for Developing Intelligent Design and Manufacturing of 3D Materials Based on Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={600-605},
  abstract={The rapid advancement of large language models (LLMs) has opened up new avenues for revolutionizing various domains, including design and manufacturing for Medtech applications. This paper presents a comparative study aimed at leveraging LLMs, specifically Gemini and Microsoft Co-Pilot, to facilitate intelligent design and manufacturing processes for 3D materials. By harnessing the natural language capabilities of these models, we explore their efficacy in generating and optimizing designs, streamlining manufacturing workflows, and enhancing overall efficiency and creativity in material production. Through a series of experiments and case studies, we evaluate the performance, strengths, and limitations of each LLM in different stages of the design and manufacturing pipeline. Furthermore, given the recent advancements in image generation techniques, particularly exemplified by DALL-E, which has demonstrated the ability to create photorealistic images from textual prompts, we present a novel approach for generating intricate 3D printable architectures by pairing text prompts with imaging processes. Our findings contribute to advancing the integration of LLMs in industrial settings, shedding light on their potential to reshape traditional approaches to material design and production. Ultimately, this research paves the way for the development of intelligent systems that bridge the gap between words and tangible materials, ushering in a new era of innovation and productivity in the manufacturing industry.},
  keywords={Waste reduction;Biological system modeling;Large language models;Biomimetics;Training data;Collaboration;Three-dimensional printing;Data models;Intelligent systems;Creativity;large language models;human-machine interaction;materials;additive manufacturing;3D-printing;industry 5.0},
  doi={10.1109/MetroXRAINE62247.2024.10796454},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10797155,
  author={Berti, Nicola and Arman, Ala and Esmaili, Parisa and Zeynivand, Mohsen and Battini, Daria and Bianchini, Devis and Cristaldi, Loredana and De Giuli, Laura Boca and Galeazzo, Ambra and Gruosso, Giambattista and Bella, Alessio La and Leotta, Francesco and Martiri, Luca and Masero, Eva and Mecella, Massimo and Plebani, Pierluigi and Rocco, Paolo and Salmaso, Luigi and Scattolini, Riccardo and Susto, Gian Antonio and Tanca, Letizia},
  booktitle={2024 IEEE International Conference on Metrology for eXtended Reality, Artificial Intelligence and Neural Engineering (MetroXRAINE)}, 
  title={Sustainability and Resilience in the MICS SPOKE8 Project: The Role of the Digital Twin}, 
  year={2024},
  volume={},
  number={},
  pages={669-673},
  abstract={The concept of the Digital Twin (DT) has risen to prominence in parallel with the ongoing digitization initiatives across industries and the rise of Industry 4.0. This innovative approach harnesses a diverse array of cutting-edge technologies, including Artificial Intelligence (AI), Big Data analytics, and the Internet of Things (Io'T), to smoothly merge virtual representations with their physical counterparts. Through this integration, organizations can conduct in-depth analysis and make real-time decisions, all backed by data. This transformative fusion of digital and physical fields not only enhances operational efficiency but also opens up new avenues for innovation and value creation within various sectors.},
  keywords={Technological innovation;Microwave integrated circuits;Neural engineering;Organizations;Learning (artificial intelligence);Metrology;Real-time systems;Digital twins;Sustainable development;Resilience;Digital twin;Artificial Intelligence;Machine Learning (ML);Big data;Industry 4.0 & 5.0},
  doi={10.1109/MetroXRAINE62247.2024.10797155},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10797427,
  author={Villalonga, Alberto and Cruz, Yarens J. and Alfaro, Diego and Haber, Rodolfo E. and Martínez-Lastra, José L. and Castaño, Fernando},
  booktitle={2024 7th Iberian Robotics Conference (ROBOT)}, 
  title={Enhancing Quality Inspection in Zero-Defect Manufacturing Through Robotic-Machine Collaboration}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The modern industrial sector is placing a growing emphasis on sustainability and efficiency. The concept of Industry 5.0 builds upon Industry 4.0, aiming to combine human skills with advanced technologies to create flexible and responsive manufacturing systems. This paper discusses Zero Defect Manufacturing (ZDM), which emphasizes the production of flawless components from the beginning. The paper introduces a pilot line for ZDM, which includes a collaborative robotic quality inspection system that integrates artificial vision and AI decision-making. The system consists of a manipulator robot, an industrial camera, an AI IoT node utilizing a segmentation algorithm for quality control based on YOLO V10, a human operator, and an Autonomous Mobile Robot (AMR) to ensure the safety of the human operator. All these components are interconnected using MQTT and ROS2. The results of the pilot line demonstrate significant improvements in quality control, reduced waste, and enhanced operational efficiency, all of which are in line with the principles of Industry 5.0.},
  keywords={YOLO;Service robots;Quality control;Inspection;Safety;Mobile robots;Fifth Industrial Revolution;Sustainable development;Robots;Autonomous robots;Human safety;Robot-machine interaction;Collaborative robots;Zero-defect;Quality control;computer vision;machine learning},
  doi={10.1109/ROBOT61475.2024.10797427},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10794347,
  author={Catti, Paolo and Bakopoulos, Emmanouil and Stipankov, Anja and Cardona, Natalia and Nikolakis, Nikolaos and Alexopoulos, Kosmas},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Human-Centric Proactive Quality Control in Industry5.0: The Critical Role of Explainable AI}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The integration of human knowledge and experience with artificial intelligence, especially in the context of Industry5.0, holds the promise of advanced capabilities for manufacturing that may facilitate reduced waste and increased efficiency. However, there is a gap between the two. This work discusses the critical role of Explainable AI (XAI) within this paradigm, fostering a collaborative environment where human operators can leverage AI-driven insights. A framework for data-driven proactive quality control is coupled with XAI and human-centric approaches to enable a path towards zero-defect manufacturing processes, improved operational efficiency, and enhanced workforce empowerment. Furthermore, practical implications, the impact of XAI and recommendations for upskilling and reskilling the manufacturing personnel are discussed with a focus on small and medium-sized enterprises.},
  keywords={Technological innovation;Manufacturing processes;Explainable AI;Collaboration;Process control;Quality control;Real-time systems;Manufacturing;Personnel;Predictive analytics;Explainable AI;Industry 5.0;Proactive Quality Control;Manufacturing},
  doi={10.1109/ICE/ITMC61926.2024.10794347},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10794281,
  author={Calabró, Antonello and Marchetti, Eda and Waheed, Tauheed},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={A tour of Cybersecurity and Quality 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={The concept of quality is continuously evolving and adapting to the new digital transformation proposals and solutions at the software or hardware level and precisely the cybersecurity attributes. From the existing Quality 4.0 principles, this paper overviews the evolution of quality to the new concept of Quality 5.0, passing through Industry 4.0 to 5.0. Thus, it provides a systematic survey of the state-of-the-art and a list of open challenges for addressing future research activity in Quality 5.0. It focuses on human-centricity and cybersecurity issues and provides a preliminary conceptual solution for identified challenges.},
  keywords={Surveys;Technological innovation;Solid modeling;Privacy;Systematics;Virtual reality;Software;Proposals;Computer security;Standards;Quality 5.0;Human-centric;Cybersecurity;Quality 4.0;Digital Transformation},
  doi={10.1109/ICE/ITMC61926.2024.10794281},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10794282,
  author={Calado, Jorge S. and Ferreira, José and Mendonça, João Pedro and Jardim-Gonçalves, Ricardo},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={AI Applications in the Configuration and Calibration of Industrial Machines}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={The development and integration of Artificial Intelligence (AI) applications for Industrial Machines (IMs) has been increasing, transforming manual operational processes into semi- or fully automated ones. Time-consuming and specialized tasks can now be assisted by intelligent systems that support or replace machine operators, with the potential of improving efficiency and lowering costs. Establishing a standardized procedure for configuring and calibrating new IMs proves challenging due to the inherent divergences among manufacturers, client-specific requirements and adaptations, and the distinctive characteristics of various application fields. This paper presents an overview of the emerging applications of AI applications for 1M calibration and configuration processes, highlighting the transformative impact of AI on enhancing operational efficiency, reducing downtime, and improving overall performance in industrial settings compared to traditional approaches to machine setup and optimization. This work is being developed in the AIDEAS project, where it will be implemented in a pilot with Computer Numerical Control (CNC) IMs.},
  keywords={Productivity;Technological innovation;Costs;Instruments;Transforms;Calibration;Artificial intelligence;Computer numerical control;Intelligent systems;Optimization;Artificial Intelligence;Industrial Machines;Machine Calibration;Machine Configuration;Smart Manufacturing;Industry 5.0},
  doi={10.1109/ICE/ITMC61926.2024.10794282},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10794210,
  author={Da Bormida in Cugurra, Marina and Koussouris, Sotiris and Cutrona, Vincenzo and Canetta, Luca},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={A Human Rights-Driven AI Assessment of Ethical Industry 5.0 Transition and Sustainability in Circular Value Chains}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={Artificial Intelligence (AI) holds potential to ac-celerate various processes, alleviate human workload, enhance capabilities, and refine decision-making. In the context of cir-cular economy, AI offers various advantages, including defect identification, component classification, and end-of-life product management aligned with company strategies. Nevertheless, AI might have an impact on several Human Right (HR). This paper focuses on safeguarding HRs in the design and deployment of AI tools, particularly those advancing sustainability in manufacturing. A comprehensive Human Rights Impact Assessment (HRIA) is proposed, surpassing conventional methods to proactively mitigate risks aligned with AI regulations and ethical guidelines. The proposed HRIA was validated in three pilot cases that are implemented using an AI platform that works in tandem with Digital Twins to demonstrate circularity scenarios: de-and re-manufacturing of LIB packs in e-mobility, de-and re-manufacturing of consumer WEEE, and process industry in the petrochemical domain. These cases showcased the versatility of the proposed HRIA and its role in uncovering insights.},
  keywords={Industries;Technological innovation;Ethics;Adaptation models;Companies;Petrochemicals;Regulation;Manufacturing;Artificial intelligence;Sustainable development;human rights;ai assessment;ethics;circular economy},
  doi={10.1109/ICE/ITMC61926.2024.10794210},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10794413,
  author={Chelaru, Mihaela and Varkiani, Shahin Manafi},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Investigating the Relationship Between Industry 5.0 and the Great Resignation: A Systematic Literature Review}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={The Great Resignation phenomenon has underlined critical discontentment amongst the workforce worldwide, leading to a mass exodus from careers and industries. On the other hand, the advent of Industry 5.0 introduces an era of greater synergy between humans and technology, focusing on personalization, customization, and collaborative innovation. This research explores the potential link between these two prevailing trends, proposing that the human-centric nature of Industry 5.0 could potentially counter the Great Resignation trend. By cultivating a more fulfilling, adaptable, and collaborative work environment through the integration of advanced digital technologies and human creativity, Industry 5.0 may offer improved job satisfaction, work-life balance, and career progression opportunities. Therefore, it is hypothesised that Industry 5.0 could lead to a reversal of the Great Resignation, fostering a more satisfied and engaged workforce. This study employs a systematic literature review to substantiate this proposed link and its implications on future workplace dynamics and paved the road for further research.},
  keywords={Industries;Productivity;Technological innovation;Engineering profession;Instruments;Roads;Collaboration;Focusing;Market research;Fifth Industrial Revolution;Industry 5.0;Great Resignation;SLR;Human-centred innovation;Employee engagement},
  doi={10.1109/ICE/ITMC61926.2024.10794413},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10794405,
  author={Lupi, Francesco and Rocha, Andre Dionisio and Maffei, Antonio and Ferreira, Pedro and Barata, Josè and Lanzetta, Michele},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={A Survey on Trends in Visual Inspection Systems Toward Industry 5.0 – A Systematic Mapping Study}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={Over the past decades, significant developments have occurred in the manufacturing domain, culminating in the contemporary landscape of Industry 5.0 (I5.0). This era is defined by three primary dimensions: technical aspects, sustainability concerns, and human-centricity. Although the broader manufacturing field features a dispersed array of scientific literature reviews amidst this multidisciplinary transition, a focused examination of Visual Inspection Systems (VIS) within this context appears absent. This study aims to provide a comprehensive mapping study that navigates this complex and emerging area of research for VIS, incorporating both scientific publications and Intellectual Property (IP). Employing a systematic methodology for mapping review, an initial exploratory search was conducted, retrieving 264 documents. Following a systematic screening process, 46 documents were identified as relevant, underscoring the preliminary findings and prevailing trends in the field. Results shows that three main clusters emerged with rising interest in technological solutions. Additionally, this study offers a procedural approach to further investigate these promising exploratory findings and expand upon the current review.},
  keywords={Surveys;Visualization;Technological innovation;Systematics;Reviews;Inspection;Market research;Manufacturing;Fifth Industrial Revolution;Sustainable development;Visual inspection;Industry 5.0;Sustainability;Human-centricity;Technological evolution},
  doi={10.1109/ICE/ITMC61926.2024.10794405},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10794239,
  author={Alimam, Hassan and Mazzuto, Giovanni and Ortenzi, Marco and Paciaroti, Claudia and Ciarapica, Filippo Emanuele and Bevilacqua, Maurizio},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Emanating Intelligent Mechatronics in the Oil and Gas Industry: A Resilient Approach to Refine the Perceptive and Maturity Fusion of Pneumatically Actuated Control Valves Within the Digital Triplet Paradigm}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={In the pursuit of achieving a harmonious equilibrium between automation, mechatronics, human input, and artificial intelligence, this paper underscores the resilience inherent in mechatronic systems. These systems, distinguished by their capacity for sensing, actuation, and intelligent decision-making, play a pivotal role in fostering effective system intelligence and resilience heuristics. The strategy involves harnessing smart sensing, predictive, and prescriptive analytics techniques to collect and analyse operational and environmental data in real-time. This approach aims to rectify discrepancies between data-driven models and experimental observations, thereby elevating the digital maturity of the system. We delve into the intersection of intelligent mechatronics and resilience within the oil and gas industry, specifically focusing on pneumatically actuated control valves in the digital triplet paradigm. By leveraging the hierarchal levels of the digital triplet, holistic integration of the flow control valve as a mechatronics system within the digital triplet paradigm contingent upon cybernetic orders with knowledge and predictive analytics-based artificial intelligence introduces the possible scenario for fostering the digital maturity of the valve by deploying a machine learning-based random forest regressor to construct the soft sensors of the valves in real-time on the cloud platform. The intelligent activity world of the digital triplet comprises deep-learning models for the prediction of the behavior of the valve and consolidates the cognitive capacity for achieving the perceptive level in cyberspace.},
  keywords={Technological innovation;Mechatronics;Soft sensors;Predictive models;Valves;Real-time systems;Petroleum industry;Artificial intelligence;Random forests;Resilience;Digital triplet;Intelligent Mechatronics;Soft Sensor;Artificial Intelligence;Deep Learning;Cybernetics;Industry 5.0},
  doi={10.1109/ICE/ITMC61926.2024.10794239},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10794243,
  author={Zambiasi, Lara Popov and Rabelo, Ricardo José and Junior, Joelmir L. M. and Hribernik, Karl and Frazzon, Enzo Morosini and Zambiasi, Saulo Popov},
  booktitle={2024 IEEE International Conference on Engineering, Technology, and Innovation (ICE/ITMC)}, 
  title={Towards Inclusive Training for Smart Warehouses - An Immersive Intelligent Softbot Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In the realm of modern production and supply chains, efficient management of warehouse operations is essential for minimizing costs and enhancing customer satisfaction. This paper introduces an innovative approach designed to enhance the training of people with disabilities (PWDs) for tasks in smart warehouses, addressing the limitations inherent in conventional training methodologies. Our solution leverages intelligent softbots within an immersive reality environment to provide personalized, and comprehensive enriched training experiences, inclusive of sign language support. We have developed a prototype in simulated warehouse scenarios, where our findings indicate a marked improvement in training outcomes for PWDs. The results underscore the potential of integrating advanced technologies into warehouse operations, in alignment with Industry S.O's emphasis on inclusivity and social sustainability.},
  keywords={Training;Industries;Technological innovation;Sign language;Supply chains;Customer satisfaction;Prototypes;Production;People with disabilities;Sustainable development;smart warehouse;immersive reality;training;softbot;inclusion;industry 5.0},
  doi={10.1109/ICE/ITMC61926.2024.10794243},
  ISSN={2693-8855},
  month={June},}@INPROCEEDINGS{10782689,
  author={Cinquetti, Ettore and Siviero, Ilaria and Babiloni, Fabio and Menegaz, Gloria and Storti, Silvia F.},
  booktitle={2024 46th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)}, 
  title={Passive BCI Towards Health and Safety in Industry: Forecasting Human Vigilance 5.5 s Ahead}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Brain-computer interfaces based on electroencephalography (EEG) recordings are gaining increasing interest in the industrial domain, aiming to enhance health, safety and performance by optimizing the cognitive load of industrial operators and facilitating human-robot interactions. This study introduces a novel experimental protocol and analysis pipeline for predicting vigilance degradation during repetitive tasks. A dataset was recorded from 10 volunteers who observed a robotic arm executing three distinct movements. The EEG power spectrum was analyzed over time using the continuous wavelet transform. Upon verifying the increased amplitude of EEG oscillations in the 8-12 Hz frequency band, we forecast its behaviour, comparing the vector autoregressive model with two deep learning recurrent architectures. The proposed encoder-decoder gated recurrent unit model obtained accurate forecasts (mean absolute error = 0.048, R2 = 0.726) up to 5.5 s into the future. The findings suggested the feasibility of vigilance monitoring in the Industry 5.0 framework, proposing a strategy to prevent human accidents and performance decline during monotonous activities.},
  keywords={Protocols;Service robots;Pipelines;Predictive models;Brain modeling;Wavelet analysis;Electroencephalography;Vectors;Recording;Oscillators;BCI;EEG;vigilance;forecasting;Industry 5.0},
  doi={10.1109/EMBC53108.2024.10782689},
  ISSN={2694-0604},
  month={July},}@INPROCEEDINGS{10788655,
  author={Bardales, Einstein Sánchez and Marín, Yuri Reina and Caro, Omer Cruz and Rituay, Angelica M. Carrasco and Fernández, Milena Torres and Santos, River Chavez},
  booktitle={2024 International Symposium on Accreditation of Engineering and Computing Education (ICACIT)}, 
  title={Key Competencies for Industry 5.0 in Undergraduate Engineering Students}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Core competencies have a vital role to enable a sustainable change towards Industry 5.0. In view of this, the study aims to characterize the university training skills for adaptation to Industry 5.0 of engineering students at the National University Toribio Rodriguez de Mendoza of Amazonas (UNTRM). It was a descriptive, non-experimental quantitative research; the study population was made up of students and professors of engineering majors, with a sample of 138 students and 28 professors. The results show, that engineering students possess high levels of competencies related to Industry 5.0, including critical thinking (71.7%), creativity (69.6%), digital competencies (61.6%), resilience (60.9%), ethics and collaboration (69.6%). These results are the consequence of innovative pedagogical strategies implemented by teachers, who integrate methodologies that foster advanced thinking, technological adaptability and ethical awareness, thus preparing future engineers for the challenges of a rapidly evolving world.},
  keywords={Training;Ethics;Accreditation;Teamwork;Fifth Industrial Revolution;Engineering students;Sustainable development;Creativity;Standards;Resilience;Critical thinking;problem solving;creativity;innovation;digital skills;ethical responsibility;academic resilience;teamwork},
  doi={10.1109/ICACIT62963.2024.10788655},
  ISSN={2771-6058},
  month={Oct},}@INPROCEEDINGS{10788065,
  author={Santos, Bruno and Costa, Rogério Luís C. and Santos, Leonel},
  booktitle={2024 21st Annual International Conference on Privacy, Security and Trust (PST)}, 
  title={Cybersecurity in Industry 5.0: Open Challenges and Future Directions}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Unlocking the potential of Industry 5.0 hinges on robust cybersecurity measures. This new Industrial Revolution prioritises human-centric values while addressing pressing soci-etal issues such as resource conservation, climate change, and social stability. Recognising the heightened risk of cyberattacks due to the new enabling technologies in Industry 5.0, this paper analyses potential threats and corresponding countermeasures. Furthermore, it evaluates the existing industrial implementation frameworks, which reveals their inadequacy in ensuring a secure transition from Industry 4.0 to Industry 5.0. Consequently, the paper underscores the necessity of developing a new framework centred on cybersecurity to facilitate organisations' secure adoption of Industry 5.0 principles. The creation of such a framework is emphasised as a necessity for organisations.},
  keywords={Industries;Productivity;Privacy;Reviews;Human-machine systems;Pressing;Stability analysis;Fifth Industrial Revolution;Computer crime;Testing;Cybersecurity;Industry 5.0;Industrial Frame-works;Cyberattacks;Countermeasures},
  doi={10.1109/PST62714.2024.10788065},
  ISSN={2643-4202},
  month={Aug},}@INPROCEEDINGS{10774362,
  author={Brasil, Nicolas N. and Coch, Victor and Oliveira, Bruno and Pinto, Mateus B. and Souza, Gabriel and Lourenço, Rafaella and Lopes, Luiza and Martins, Anajara A. and Duarte Filho, Nelson L. and Gonçalves, Eder M. N. and Oliveira, Vinicius M. and Marcelo, De G. Malheiros and Pias, Marcelo R. and Borges, Eduardo N.},
  booktitle={2024 IEEE 22nd International Conference on Industrial Informatics (INDIN)}, 
  title={A Software Architecture for the Control and Management of Industrial Inspection Evidence}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In today's rapidly evolving industry, new challenges constantly arise that must be addressed quickly to keep up with the growing demand. Industry 5.0 aims to eliminate ob-stacles in production lines and integrate intelligent systems into manufacturing without excluding human operators from their daily tasks. In this context, developing software for controlling and managing data-driven evidence in the production cells becomes essential when considering performance, reliability, and practical aspects, as well as the financial returns it can bring to organizations. This work presents a brief overview of such an approach, proposing the development of a software architecture that manages industrial quality inspection in automotive parts using an Internet of Things publisher/subscriber model for controlling and synchronizing sub-processes. The results obtained demonstrate the benefits of implementing a control and evidence management system, offering production operators online monitoring of failures in manufactured parts and effective visualization of evidence of failures. This helps in decision-making and integrates the operator (user) with the system, which aligns with Industry 5.0 principles. This contribution is supported by creating a database of quality inspection evidence that can be used to train machine learning models to detect failures more accurately in the future.},
  keywords={Software architecture;Process control;Production;Quality control;Inspection;Software;Real-time systems;Software reliability;Sensors;Fifth Industrial Revolution;Management of quality inspection;Evidence-based industrial inspection;Industrial process quality control},
  doi={10.1109/INDIN58382.2024.10774362},
  ISSN={2378-363X},
  month={Aug},}@INPROCEEDINGS{10774450,
  author={Oliveira, Bruno D. and Souza, Gabriel and Brasil, Nicolas N. and Coch, Victor and Pinto, Mateus B. and Lourenço, Rafaella and Lopes, Luiza and Martins, Anajara A. and Filho, Nelson L. Duarte and Oliveira, Vinícius M. and De G. Malheiros, Marcelo and Pias, Marcelo R. and Borges, Eduardo N. and Gonçalves, Eder M. N.},
  booktitle={2024 IEEE 22nd International Conference on Industrial Informatics (INDIN)}, 
  title={Digital Twin Across Industry 5.0: Integrating Dimensional Analysis to a Rotor Inspection Module}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper describes a digital-twin-based approach to dimensional control designed to assist quality inspection of automotive air-conditioning rotors in the vehicle manufacturing industry. It focuses on dimensional quality control within the field of dimensional metrology, aiming to accurately measure the dimensions of parts, subassemblies, and complete equipment systems. The proposed approach has created a prototype, collecting measurement data from a test sample to generate validation results for error profiling. The main goal is to develop a method for improving the precision of sensors used for this type of quality inspection.},
  keywords={Manufacturing industries;Measurement uncertainty;Rotors;Prototypes;Quality control;Inspection;Metrology;Sensors;Digital twins;Informatics;Dimensional analysis;laser sensor;quality inspection},
  doi={10.1109/INDIN58382.2024.10774450},
  ISSN={2378-363X},
  month={Aug},}@INPROCEEDINGS{10774342,
  author={ZHOU, Morgana Mo and ZHANG, Zhifu and LIU, Yucheng and HANCKE, Gerhard Petrus},
  booktitle={2024 IEEE 22nd International Conference on Industrial Informatics (INDIN)}, 
  title={Security Analysis and Evaluation of Denial of Service Attack in LoRaWan-Driven Automation}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Long Range Wide Area Network (LoRaWAN) is a wireless communication protocol used in open Radio Frequency (RF) communication links. However, this openness also makes LoRaWAN vulnerable to Denial of Service (DoS) attacks. LoRaWAn DoS attacks can result in increased packet errors, delays, and additional energy costs, posing risks to the reliability and effectiveness of Industry 5.0 automation. To address these threats, this paper proposes a novel evaluation model that combines the entropy weighting method (EWM) with grey relational analysis (GRA). The model focuses on an intelligent healthcare scenario as a representative application of Industry 5.0. It assesses LoRaWAn performance by considering metrics such as Packet Error Rate (PER), latency, and energy consumption.},
  keywords={Wireless communication;Wide area networks;Radio frequency;Measurement;LoRaWAN;Medical services;Security;Reliability;Fifth Industrial Revolution;Informatics;LoRaWAN;DoS Attack;Industry-5.0},
  doi={10.1109/INDIN58382.2024.10774342},
  ISSN={2378-363X},
  month={Aug},}@INPROCEEDINGS{10774252,
  author={Flores, Everson and Teixeira, Thiago and Barros, Paula and Guterres, Bruna and Junior, Thomaz Pereira and Cabral, Alberto and Malheiros, Marcelo and Dora, Cristiana Lima and Poersch, Luis and Wasielesky, Wilson and Pias, Marcelo Rita},
  booktitle={2024 IEEE 22nd International Conference on Industrial Informatics (INDIN)}, 
  title={On Efficient Data Sharing for Planetary Digital Twins: Distributed Microplastic Monitoring}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Massive garbage patches within all oceanic gyres have garnered global attention, underscoring microplastic pollution as an emerging concern. Various isolated approaches have been proposed for real-time monitoring of microplastics in environmental and industrial settings. However, these fragmented solutions may hinder distributed data and knowledge sharing across applications, limiting the potential for leveraging AI development to enhance early warning systems and decision-making in large-scale industrial operations. To address these challenges, this paper introduces a framework that utilizes Planetary Digital Twins (PDTs) and affordable modular flow cytometry tools. These innovations enable the real-time tracking and sharing of data on microplastic pollution, tracing their origins from polymer-based industrial processes to their presence in the environment. The proposed framework includes a distributed system architecture based on publisher/subscriber for robust and scalable data sharing. By integrating Industry 5.0 principles, which prioritize sustainability and resilient production processes, the digital twin technology enables a dynamic and interconnected monitoring network. The validation results suggest that the proposed system has the potential to expand and enhance environmental risk assessments on a global scale and support the development of mitigation strategies through improved data integration and sharing capabilities for microplastic monitoring.},
  keywords={Technological innovation;Pollution;Environmentally friendly manufacturing techniques;Distributed databases;Systems architecture;Production;Real-time systems;Digital twins;Sustainable development;Monitoring;Planetary Digital Twin;Microplastic Monitoring;Publisher/Subscriber;MQTT;Industry 5.0},
  doi={10.1109/INDIN58382.2024.10774252},
  ISSN={2378-363X},
  month={Aug},}@ARTICLE{10794664,
  author={Liu, Mingqing and Cui, Zhuangzhuang and Miao, Yang and Kim, Minseok and Pollin, Sofie},
  journal={IEEE Open Journal of Antennas and Propagation}, 
  title={A Millimeter-Wave Scattering Channel Model for Indoor Human Activity Sensing}, 
  year={2024},
  volume={},
  number={},
  pages={1-1},
  abstract={In sixth-generation (6G) application scenarios like industry 5.0, augmented reality (AR), autonomous transportation, and eHealth, there is a growing demand for Human Activity Recognition (HAR). Meanwhile, with the deployment of millimeter-wave (mmWave) technologies in fifth-generation (5G) cellular communications, higher-resolution sensing becomes feasible. Utilizing mmWave for communication and HAR has garnered attention, necessitating accurate modeling of sensing channels. This paper proposes a mmWave scattering channel model for indoor HAR, which facilitates system design, optimization, and implementation. In the proposed model, we integrate primitive-based human body scattering where the human body is indicated by a set of primitives, and cluster-based environment scattering models, enabling detailed modeling of self-shadowing and double-bounce environment scattering. Additionally, we develop a simulation framework encompassing signal transmission, sensing channels, and processing, allowing adjustment of system parameters. Simulation results indicated by micro-Doppler signatures including multi-link effects show good agreements with measurements, validating the effectiveness of the proposed model. Meanwhile, the time consumption of the proposed simulation workflow for generating micro-Doppler signatures for most human activities is within 10 minutes.},
  keywords={Scattering;Sensors;Human activity recognition;Millimeter wave communication;Channel models;Trajectory;Three-dimensional displays;Computational modeling;Accuracy;Solid modeling;mmWave ISAC;sensing channel;human activity recognition;self-shadowing check},
  doi={10.1109/OJAP.2024.3516533},
  ISSN={2637-6431},
  month={},}@INPROCEEDINGS{10774682,
  author={Tuteja, Gaurav and Rani, Shalli and Sharma, Ankita and Singla, Seerat},
  booktitle={2024 3rd International Conference for Advancement in Technology (ICONAT)}, 
  title={Integrating Wireless Sensor Networks with IoT for Enhanced Data-Driven Industry Solutions*}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The incorporation of WSN-IoT is transforming multiple sectors by improving the gathering, transmission, and analysis of information. This study investigates the collaboration between WSN-IoT, examining the essential methods, uses, and factors that enhance their effectiveness. This article examines 15 pertinent studies to emphasise the technological progress, obstacles, and future potential of WSN-IoT. It offers valuable insights into the expanding importance of WSN-IoT in various industries and beyond. This research article presents a thorough analysis of the integration of Wireless Sensor Networks (WSN) with the Internet of Things (IoT). Our study entails a thorough examination of research publications, specifically concentrating on the methodologies, uses, and crucial variables that determine the effectiveness of WSN-IoT systems. In addition, we emphasise the possible advantages and obstacles of this integration across different sectors.},
  keywords={Industries;Wireless sensor networks;Scalability;Decision making;Real-time systems;Energy efficiency;Internet of Things;Security;Monitoring;Convergence;WSN;IoT;Industry 5.0;Smart Devices;Real-Time Monitoring},
  doi={10.1109/ICONAT61936.2024.10774682},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10775219,
  author={Leynes, Jhun-Jhun P. and Amorado, Ryndel V.},
  booktitle={2024 14th International Conference on System Engineering and Technology (ICSET)}, 
  title={A Web-based Management System for Diagnostic Laboratory with Business Process Re-Engineering and Data Analytics}, 
  year={2024},
  volume={},
  number={},
  pages={17-23},
  abstract={Management information systems are a challenge for many small businesses. With fast-changing technology, data management has become an integral part of business processes, especially in the healthcare industry. This study uses Business Process Re-Engineering (BPR) and Data Analytics for a Diagnostic Laboratory to improve its operational efficiency through a web-based management system. The obsolete system, consisting of eight modules, is replaced with a sophisticated system involving twenty-one modules. The goal is to evaluate the impact of technology on business operations and user satisfaction. The results indicate that the most recent technology enables board members to monitor corporate performance from any location using various web browsers. The database securely saves and categorizes all operational data. Transactions, test results, and reports are instantly created in PDF format. Subsequently, the gathered information is utilized by means of descriptive and prescriptive analysis. The system acceptance is also assessed using a questionnaire that adheres to the ISO 25010 standards. With an optimal score of 5.0, the results showed a weighted average of 4.79 (“Strongly Agree”), which is significantly higher than the prior system average of 3.69 (“Agree”). The conclusions emphasize that the system has a crucial role in remote management, efficient database management, improved operational efficiency, and reduced turnaround time. Recommendations encompass the integration of digital payment methods for transactions and advocating the established system as a benchmark for other diagnostic laboratories in the health industry. This research has a significant impact on the improvement of diagnostic laboratory management systems.},
  keywords={Industries;Data analysis;Databases;Medical services;Systems engineering and theory;Portable document format;Business process re-engineering;Standards;Monitoring;Business;Diagnostic Laboratory;Management System;Business Process Re-engineering;Data Analytics;System Development},
  doi={10.1109/ICSET63729.2024.10775219},
  ISSN={2470-640X},
  month={Oct},}@INPROCEEDINGS{10769847,
  author={Kuzovkova, T. A. and Sharavova, O. I. and Sharavova, M. M.},
  booktitle={2024 Intelligent Technologies and Electronic Devices in Vehicle and Road Transport Complex (TIRVED)}, 
  title={The Causes and Sources of the Evolution of Engineering Education Competencies in the Field of Electronics and Communications}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The paper examines the impact of contemporary industrialization paradigms on the evolution of technical professionals' skill sets. By analyzing the foundational aspects of manufacturing under Industry 4.0 and Industry 5.0 paradigms, it identifies significant shifts in the nature and structure of manufacturing processes, facilitating the advancement into a novel phase of civilizational growth characterized by the integration and utilization of sophisticated technologies, cyber-physical systems, and cognitive frameworks. This necessitates the acquisition of novel competencies for effective human-machine-object interoperability. To ensure the adequacy of engineers' competencies to new functional and technological requirements, the authors substantiate the professional tasks of specialists in the field of ICT, communication systems and radio engineering. A gamification approach to the formation of new knowledge is proposed, including a set of game situations for training specialists in technical fields, an algorithm and principles of their application.},
  keywords={Training;Stability criteria;Production;Games;Cyber-physical systems;Strategic planning;Software;Teamwork;Robots;Consumer electronics;competencies of engineering education;electronics;communications;models of industries;functional and technological evolution of factors of production;products;higher education;gamification approach},
  doi={10.1109/TIRVED63561.2024.10769847},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10765191,
  author={Khafaga, Ahmed A.A.E.M.A and Horan, Ben and Moreira, Lorena Caires and Kauffman, Marcos and Nienaber, Ann-Marie and Mortimer, Michael},
  booktitle={2024 IEEE International Symposium on Mixed and Augmented Reality Adjunct (ISMAR-Adjunct)}, 
  title={Unlocking Human Potential: Psychological Capital’s Influence on Augmented Reality Adoption in Manufacturing Environments}, 
  year={2024},
  volume={},
  number={},
  pages={439-442},
  abstract={In pursuing human-centric manufacturing, Augmented Reality guidance systems are being adopted to improve human operators' wellbeing and productivity. Despite the potential benefits of AR guidance systems, the adoption and effective use of these technologies hinge on the individual’s intrinsic aspects, such as Psychological Capital (PsyCap). The interplay between PsyCap and Technology Acceptance poses a significant challenge in predicting user behaviour and readiness for adopting AR technologies in manufacturing. This research aims to understand the factors that impact users' behaviour toward AR technologies through understanding their Psychological Capital (PsyCap) and Technology Acceptance. Two experiments were conducted where participants interacted with two separate AR technologies, head-mounted-display AR (n=22) and Spatial AR (n=22). The experiments measured participants' Psychological Capital (Self-efficacy, Hope, Optimism and Resilience) and technology acceptance through Perceived Ease of Use (PEU), Perceived usefulness (PU) and Intention of Use. Preliminary data analysis shows that PU and PEU can be predicted through the PsyCapmeasured resources. The results of this study bring an understanding of human behaviour impacting the adoption of the technology to implement a model toward understanding the readiness of the workforce to adopt AR technologies.},
  keywords={Productivity;Correlation coefficient;Technology acceptance model;Data analysis;Psychology;Resists;Fasteners;Particle measurements;Augmented reality;Resilience;Augmented Reality;Manufacturing;Industry 5.0;Technology Acceptance;Psychological Capital},
  doi={10.1109/ISMAR-Adjunct64951.2024.00128},
  ISSN={2771-1110},
  month={Oct},}@INPROCEEDINGS{10759201,
  author={Kosmidis, Michail and Antoniou, Sarantis and Balaska, Vasiliki and Kansizoglou, Ioannis and Gasteratos, Antonios},
  booktitle={2024 IEEE International Conference on Imaging Systems and Techniques (IST)}, 
  title={Towards Warehouse 5.0: A Framework of Human-Centered Technologies}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Towards the era of Industry 5.0 (I5.0), the globe experiences an evolving web in supply chains, supply hubs, ware-house management, lower latency deliveries, personnel assistance and improved customer experience. To meet the challenges of this reformation, companies, like BMW, Samsung, DHL, IKEA, Amazon, etc., are starting to adopt and develop new human-centered technologies including unmanned aerial vehicles (UAVs), industrial robots, augmented and virtual reality (AR/VR). Additionally, the increased use of technologies, both independently and as collaborative systems, along with the need for remote long-distance cooperative human work, has stretched the capabilities of wireless telecommunications. The above highlights the prerequisite for more robust and improved wireless cellular technologies (5G), offering ultra-fast, low-latency connectivity and responsiveness, especially in the developed AR and VR applications that aim to provide simultaneous remote use. As part of I5.0, the warehouse enterprise is undergoing a revolutionary transformation by integrating all these advanced technologies, thus collectively shaping the concept of Warehouse 5.0. Towards this end, we propose a user-centered conceptual framework consisting of two systems that utilize VR and smart ware-house technologies to train and evaluate personnel in warehouse workflow scenarios while improving warehouse procedures and management. This approach can increase personnel readiness and skills while highlighting potential delays and optimizing various procedures.},
  keywords={Wireless communication;Industries;Supply chains;Imaging;Virtual reality;Industrial robots;Telecommunications;Personnel;Low latency communication;Fifth Industrial Revolution;Augmented Reality;Virtual Reality;5G technology;Warehouse 5.0;vertical industries},
  doi={10.1109/IST63414.2024.10759201},
  ISSN={2832-4234},
  month={Oct},}@INPROCEEDINGS{10759898,
  author={Yuan, Yixiu and Wang, Baicun and Zhong, Ruirui and Hu, Bingtao},
  booktitle={2024 International Conference on Networking, Sensing and Control (ICNSC)}, 
  title={A Spatio-Temporal Transformer Network for Human Motion Prediction in Human-Robot Collaboration}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Efficient human-robot collaboration necessitates bidirectional perception between humans and robots. For robots, understanding the operator's behavior is crucial for enhancing safety and work efficiency in human-robot collaboration. Human limb movements encompass diverse behavioral information, and accurate human motion prediction has attracted significant attention. Existing human motion prediction methods can extract some behavioral features, but they fall short of fully capturing the dynamic and complex interactions across different time points and body joints in human motion sequences. In this study, a Spatio-Temporal Transformer Network model (STTFN) is proposed to automatically learn the spatio-temporal dependency relationships in human motion sequence data for prediction. The spatio-temporal knowledge embedding block employs an attention mechanism and a graph attention network to extract spatio-temporal behavioral features from raw data. An encoder-decoder network based on Transformer and Long Short-Term Memory (LSTM) is constructed for further analysis to acquire motion prediction data. This study conducts an experiment utilizing a human-robot collaborative assembly dataset to validate the effectiveness of the proposed model. The results demonstrate that our model outperforms classical models, thereby advancing the field of human motion prediction.},
  keywords={Knowledge engineering;Human-robot interaction;Collaboration;Predictive models;Transformers;Feature extraction;Robot sensing systems;Prediction algorithms;Behavioral sciences;Long short term memory;Human robot collaboration;Human motion prediction;Transformer;Industry 5.0;Spatio-temporal representation},
  doi={10.1109/ICNSC62968.2024.10759898},
  ISSN={2766-8665},
  month={Oct},}@INPROCEEDINGS{10760200,
  author={Wang, Weitian and Przedworska, Zofia and Parron, Jesse and Lyons, Maxim and Zhu, Michelle and Tuininga, Amy},
  booktitle={2024 International Conference on Networking, Sensing and Control (ICNSC)}, 
  title={MCROS: A Multimodal Collaborative Robot System for Human-Centered Tasks}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Collaborative robots play a significant role in the Industry 5.0 revolution. In this work, we present the development of a new dual-arm all-terrain Multimodal Collaborative Robot System (MCROS), which has dynamic decision-making capabilities in addition to a physical capacity to be controlled and directed for human-centered tasks. MCROS consists of two UR10e collaborative robots, an all-terrain mobile base, a computing and control unit, and a set of multimodal sensory systems for human-robot interaction. These sensory systems include 3D LIDARs, Force-Torque sensors, 3D/security cameras, an inertial measurement unit, and a global position system. Such a design merits a broader range of applications for MCROS. The Robot Operating System is employed for MCROS programming and control, which enables MCROS to be an open-source agent to seamlessly integrate with other cyber-physical systems in different tasks. A specification discussion of MCROS and other existing systems is illustrated. We carry out several applications and analyze the results of MCROS in different real-world work contexts. The scalability of MCROS is also discussed.},
  keywords={Three-dimensional displays;Measurement units;Laser radar;Scalability;Operating systems;Robot vision systems;Collaborative robots;Programming;Sensor systems;Sensors;robotics;human-robot collaboration;sensors;control;dual-arm;multimodal;autonomous system},
  doi={10.1109/ICNSC62968.2024.10760200},
  ISSN={2766-8665},
  month={Oct},}@INPROCEEDINGS{10761601,
  author={Sciarroni, Monica Marconi and Esposito, Marco and Pierleoni, Paola and Storti, Emanuele},
  booktitle={2024 IEEE 8th Forum on Research and Technologies for Society and Industry Innovation (RTSI)}, 
  title={Monitoring Data Streams in Industry 5.0: a Knowledge Graph Approach}, 
  year={2024},
  volume={},
  number={},
  pages={566-571},
  abstract={In the landscape of Industry 5.0, Internet of Ev-erything (IoE) networks are emerging as crucial components for connecting diverse industrial sensors and devices, going beyond the typical Internet of Things (IoT) boundaries to include people, processes, and data. This expanded scope brings forth unprece-dented opportunities for enhanced collaboration and efficiency in industrial settings. On the other hand, due to the need to integrate disparate and heterogeneous devices and data sources, it also introduces both technical and semantic interoperability challenges for meaningful and shared data interpretation and exchange. This paper outlines an architecture for gathering and monitoring semantic data streams in IoE environments, which addresses semantic interoperability through an integrated representation of sensor metadata, locations, preferences, right accesses, tasks and responsibilities in an Enterprise Knowledge Graph. Developed within the HOMEY project, the approach enables dynamic stream monitoring, data querying and exploration, and aims to lay the groundwork for a robust industrial human-centric framework supporting IoE applications.},
  keywords={Soft sensors;Scalability;Semantics;Knowledge graphs;Metadata;Real-time systems;Internet of Things;Streams;Monitoring;Interoperability;Data Stream;Industry 5.0;IoT;Metadata;Knowledge graph},
  doi={10.1109/RTSI61910.2024.10761601},
  ISSN={2687-6817},
  month={Sep.},}@INPROCEEDINGS{10761217,
  author={Dehbozorgi, Mohammad Hossein and Rossi, Monica and Terzi, Sergio and Carminati, Luca and Sala, Roberto and Magni, Francesco and Pirola, Fabiana and Pozzi, Rossella and Strozzi, Fernanda and Rossi, Tommaso},
  booktitle={2024 IEEE 8th Forum on Research and Technologies for Society and Industry Innovation (RTSI)}, 
  title={AI Education for Tomorrow's Workforce: Leveraging Learning Factories for AI Education and Workforce Preparedness}, 
  year={2024},
  volume={},
  number={},
  pages={677-682},
  abstract={Industry 4.0 marks a significant change in the business world, brought about by technologies like automation, IoT, AI, smart factories, and cyber-physical systems. Industry 5.0, on the other hand, prioritizes worker well-being and emphasizes human-centric approaches in manufacturing. While these revolutions offer improved productivity, sustainability, and resilience, integrating them presents challenges, particularly in securing a skilled workforce adept in Artificial Intelligence (AI). Higher education institutions (HEIs) are critical in addressing this need by updating their curricula and enhancing their infrastructure. The boundaries between industries are becoming less distinct due to digital technologies, which means that education needs to adjust to changing requirements. The use of AI tools in education has become a driving force in transforming learning experiences, fostering creativity, and getting people ready for the era of digitalization. This paper explores how Learning Factories (LFs) can serve as a means for AI education, focusing on existing white- and blue-collar workers who primarily benefit from tools like LFs for reskilling and upskilling, as well as prospective workers such as university graduates who can acquire the necessary skills through these factories before entering the workforce.},
  keywords={Industries;Productivity;Technological innovation;Education;Production facilities;Fourth Industrial Revolution;Artificial intelligence;Sustainable development;Smart manufacturing;Resilience;Industry 4.0;Industry 5.0;Artificial Intelligence;Learning Factories;Workforce},
  doi={10.1109/RTSI61910.2024.10761217},
  ISSN={2687-6817},
  month={Sep.},}@INPROCEEDINGS{10761374,
  author={Frizzo, Davide and Borsatti, Francesco and Arcudi, Alessio and De Moliner, Antonio and Oboe, Roberto and Susto, Gian Antonio},
  booktitle={2024 IEEE 8th Forum on Research and Technologies for Society and Industry Innovation (RTSI)}, 
  title={Interpretable Data-Driven Anomaly Detection in Industrial Processes with ExIFFI}, 
  year={2024},
  volume={},
  number={},
  pages={595-600},
  abstract={Anomaly detection (AD) is a crucial process often required in industrial settings. Anomalies can signal underlying issues within a system, prompting further investigation. Industrial processes aim to streamline operations as much as possible, encompassing the production of the final product, making AD an essential mean to reach this goal. Conventional anomaly detection methodologies typically clas-sify observations as either normal or anomalous without providing insight into the reasons behind these classifications. Consequently, in light of the emergence of Industry 5.0, a more desirable approach involves providing interpretable outcomes, enabling users to understand the rationale behind the results. This paper presents the first industrial application of ExIFFI, a recently developed approach focused on the production of fast and efficient explanations for the Extended Isolation Forest (EIF) Anomaly detection method. ExIFFI is tested on two publicly available industrial datasets demonstrating superior effectiveness in explanations and computational efficiency with the respect to other state-of-the-art explainable AD models.},
  keywords={Industries;Technological innovation;Computational modeling;Tiny machine learning;Production;Forestry;Predictive models;Real-time systems;Internet of Things;Anomaly detection;Anomaly Detection;Explainable Artificial Intel-ligence;Industrial Internet of Things},
  doi={10.1109/RTSI61910.2024.10761374},
  ISSN={2687-6817},
  month={Sep.},}@INPROCEEDINGS{10761793,
  author={Esposito, Marco and Sciarroni, Monica Marconi and Fava, Tommaso and Belli, Alberto and Palma, Lorenzo and Storti, Emanuele and Pierleoni, Paola},
  booktitle={2024 IEEE 8th Forum on Research and Technologies for Society and Industry Innovation (RTSI)}, 
  title={Experimental Evaluation of End-to-End Security Protocols for the Internet of Everything}, 
  year={2024},
  volume={},
  number={},
  pages={13-18},
  abstract={The Internet of Everything (IoE) includes inter-connected devices, processes, networks, and people. Within this framework, smart objects collect environmental data and transmit it across the IoE architecture. Smart objects are often resource-constrained, with limited bandwidth, battery, and processing capabilities. IoE applications require some degree of security, which will introduce communication overhead. This paper presents an evaluation of communication protocols for end-to-end security for smart devices in an IoE framework. The JOSE and COSE formats are evaluated and compared to non-secure serialization. Experiments carried out on a Raspberry Pi Zero W and showed that COSE has low overhead, nearly comparable to the non-secure formats. However, COSE is about 3 ms slower than JOSE for the smallest packet size at the transmitter, while the protocols have closer performances at the receiver. For larger packets, COSE becomes faster at both the receiver (>2 kB) and the transmitter (>20 kB). The experiments suggest that COSE, due to its small overhead, may be considered as a potential lightweight solution for end-to-end security in IoE applications where slight latency is acceptable, such as periodic sensor data collection in Industry 5.0 applications. It also demonstrates better scalability than JOSE for increasing payload sizes.},
  keywords={Industries;Protocols;Transmitters;Scalability;Receivers;Time measurement;Encryption;Security;Internet of Things;Payloads;IoE;Industry 5.0;lightweight communication;end-to-end security;MQTT},
  doi={10.1109/RTSI61910.2024.10761793},
  ISSN={2687-6817},
  month={Sep.},}@INPROCEEDINGS{10755675,
  author={Lavrov, Evgeniy and Siryk, Olga and Tatarchuk, Ruslan and Pliuhin, Vladyslav and Chybiriak, Yana and Klimenko, Igor},
  booktitle={2024 IEEE 17th International Conference on Advanced Trends in Radioelectronics, Telecommunications and Computer Engineering (TCSET)}, 
  title={Analysis of Human-Machine Interaction for Assessing the Functional Reliability of Cyber-Physical Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={The article is devoted to decision support aimed at ensuring the reliability of cyber-physical systems and assessing the accuracy and timeliness of the implementation of human-operator and automation interaction processes. The need for increased attention to taking into account “human factors” is substantiated. A method for assessing the accuracy and timeliness of the implementation of cyber-physical systems functioning algorithms is proposed. The apparatus of functional networks by Professor A. Gubinsky and the principle of structural graph analysis proposed by A. Adamenko are used. A Prolog technology for analyzing human-machine interaction structures in CPS is developed. The results of testing the developed method are described},
  keywords={Human computer interaction;Analytical models;Automation;Accuracy;Computer network reliability;Cyber-physical systems;Programming;Telecommunications;Telecommunication network reliability;Testing;ergonomics;human-machine;control system;human-operator;reliability;industry 5.0;operator 5.0},
  doi={10.1109/TCSET64720.2024.10755675},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10752279,
  author={Pratap, Ayush and Sardana, Neha},
  booktitle={2024 IEEE Region 10 Symposium (TENSYMP)}, 
  title={Explaining the Identification of Granular Crack with Deep Learning and XAI}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Precise detection of granular fractures is crucial for various engineering applications, and Deep Learning approaches can transform imaging methodologies and material analysis. This study employed a convolutional neural network (CNN) that incorporated explainability elements to improve the trustworthiness and transparency of the model in classifying granular cracks. After conducting thorough model comparisons and analyses, a bespoke model was chosen. Extensive model comparisons and analyses led to the selection of a custom model with 91% training accuracy and optimized parameters. Fine-tuning of six pre-trained models identified VGG-16 as the top performer, achieving 99.96% training accuracy and 97.7% testing accuracy. Explainable AI (XAI) techniques, particularly the insertion method, provided robust interpretability, with attributed scores of 0.96 for insertion, 0.69 for deletion, and 0.37 for fidelity. Visualization using various attribution mapping methods reinforced the trustworthiness of this work in granular crack identification.},
  keywords={Training;Deep learning;Analytical models;Accuracy;Explainable AI;Scalability;Transforms;Quality control;Convolutional neural networks;Testing;Crack Detection;Deep Learning;Explainable AI (XAI);Industry 5.0},
  doi={10.1109/TENSYMP61132.2024.10752279},
  ISSN={2642-6102},
  month={Sep.},}@INPROCEEDINGS{10752149,
  author={Verma, Rishita and Indra, Gaurav},
  booktitle={2024 IEEE Region 10 Symposium (TENSYMP)}, 
  title={ZIADA: Zero Trust-Based Identity Attestation Framework for DLT Verified AI-Enabled Industrial Internet of Things}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In Smart Manufacturing Industry 5.0, the advancements in AI-enabled Industrial Internet of Things (AIeIIoTs) are propelled by the converging domain of cognitive intelligence and collaborative-AI. However, AIeIIoTs face formidable challenges in network identity attestation and data privacy. The proposed research introduces - ZIADA, a cryptographically secure identity attestation framework with a novel consensus mechanism for AIeIIoTs to address these security concerns. ZIADA competently eliminates the dependency of conventional attestation mechanisms on insecure Key Generation Center (KGC)-cum-Base Station (BS). It leverages the NIST SP 800–207 ZTA (Zero Trust Architecture) principles and proficiently incorporates ID-based Certificateless-Cryptography (CLC) for mitigating unauthorized access risks. Furthermore, the informal analysis of ZIADA demonstrates its resilience against cloning and impersonation attacks, forward and backward secrecy attacks and pseudo-Base-Station attacks. In comparison to state-of-the-art, ZIADA's downtime in the reconnect phase is almost negligible, henceforth achieving the improvement in reliability. Ultimately, simulation results validate ZIADA's efficiency, demonstrating reduced storage and energy consumption, making it highly suitable for dynamic AIeIIoTs in smart manufacturing ecosystems.},
  keywords={Distributed ledger;Simulation;Propulsion;NIST;Zero Trust;Cryptography;Reliability;Industrial Internet of Things;Smart manufacturing;Resilience;Distributed ledger technology (DLT);Zero Trust (ZT);Artificial Intelligence-enabled Industrial Internet of Things (AIeIIoT);Key Generation Centre (KGC);Certificateless Cryptography (CLC);Base Station(BS)},
  doi={10.1109/TENSYMP61132.2024.10752149},
  ISSN={2642-6102},
  month={Sep.},}@ARTICLE{10756671,
  author={Vidales, Miguel Ángel Sánchez and Lamo, Paula},
  journal={IEEE Revista Iberoamericana de Tecnologias del Aprendizaje}, 
  title={Bridge the Gap: Using Challenge-Based Learning to Connect University and Industry}, 
  year={2024},
  volume={19},
  number={},
  pages={371-378},
  abstract={Collaboration between universities and companies has become vital in training future professionals. However, on many occasions, this collaboration could be more agile and efficient to avoid a disconnect between the supply of trained professionals and the demand of the labor market. This situation is aggravated in the case of online training, where students are geographically delocalized and need the opportunity to interact directly with companies. To address this issue and ensure up-to-date and relevant student training, an innovative program that promotes collaboration between the university and various organizations in the Master in Industry 4.0 is presented. The proposal offers a new subject that uses learning based on challenges proposed and directed by leading companies in the sector. This allows students to apply their knowledge and gain insight into the industry in which they will work. Four calls have been carried out, and there are 14 challenges available, covering various industrial sectors and applications related to Industry 4.0/5.0. This paper presents the results of this program. Companies have obtained innovative and valuable solutions for their specific needs. In contrast, students have been able to apply their knowledge in real situations and gain valuable experience in the business world. Many students come from different geographical environments, especially from LATAM, and they value the subject and teaching staff positively. Due to the success of the program in Master in Industry 4.0, the same approach has been implemented in the university’s master’s program in the Internet of Things, with equally satisfactory results.},
  keywords={Companies;Collaboration;Fourth Industrial Revolution;Training;Three-dimensional printing;Proposals;Internet of Things;Employment;Professional aspects;Learning systems;Fifth Industrial Revolution;Electronic learning;Project management;Challenge-based learning;Industry 40/5.0;digital transformation;university–industry collaboration;online education;project-based learning.},
  doi={10.1109/RITA.2024.3501933},
  ISSN={1932-8540},
  month={},}@INPROCEEDINGS{10749931,
  author={Kiourtis, Athanasios and Mavrogiorgou, Argyro and Makridis, Georgios and Kyriazis, Dimosthenis and Soldatos, John and Fatouros, Georgios and Ntalaperas, Dimitrios and Papageorgiou, Xanthi and Almeida, Bruno and Guedes, Joana and Maló, Pedro and Oliveira, Jorge and Scholze, Sebastian and Rosinha, Antonio and Reis, Joaquim and Falsetta, Matteo},
  booktitle={2024 36th Conference of Open Innovations Association (FRUCT)}, 
  title={XR5.0: Human-Centric AI-Enabled Extended Reality Applications for Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={314-323},
  abstract={Applications for Extended Reality (XR) are rapidly expanding across a wide range of industries, including gaming, entertainment, and healthcare. Accompanying this trend is the field of digital manufacturing, which encompasses a broad range of applications such as quick product design, remote maintenance, production process simulation, employee safety, and training. Industrial personnel may benefit from ergonomic and user-friendly cyber-representations of production processes using XR applications, particularly in the industrial arena. These cyber-representations are utilized to create augmented environments for training, simulation, and testing. The wave of Industry 5.0 (I5.0) applications that are certain to be human-centric and emphasize trustworthy human-machine collaboration cannot be supported by current systems because of several issues, such as the requirement for individualized XR visualizations and new methods for world-building, content production, and flow control aspects of XR systems. The XR5.0 project is presented in this publication with the goal of addressing these issues and offering a revolutionary Person-Centric and AI-based XR paradigm that will be customized to the needs and characteristics of I5.0 applications. The project outlines the organizing concepts and guidelines for utilizing XR in I5.0 applications, with a focus on the creation of cutting-edge "XR-made-in-Europe" technology that complements human-centered manufacturing techniques and upholds European ideals. The associated applications consider the workers’ environment through the incorporation of human-centered digital twins (DTs), which make up the "digital image" of the workers. This allows for the simultaneous design and implementation of an innovative fusion of cutting-edge AI paradigms and XR technology. The added value of the XR5.0 project is discussed, and potential use cases and user journeys are analyzed, leading to a discussion of the project’s revolutionary benefits and additional steps that should be taken.},
  keywords={Training;Visualization;Technological innovation;Extended reality;Production;Product design;Manufacturing;Safety;Fifth Industrial Revolution;Testing},
  doi={10.23919/FRUCT64283.2024.10749931},
  ISSN={2305-7254},
  month={Oct},}@INPROCEEDINGS{10749924,
  author={Ismail, Mohammed Nuther and Jameel, Sarah Haitham and Abbas Al-Zeyadi, Bashar Khudhair and Saeed, Adham Mohsen and Salman, Salman Mahmood and Dakov, Serhii and Ali, Haider},
  booktitle={2024 36th Conference of Open Innovations Association (FRUCT)}, 
  title={Investigating Three Digital Transformation Theories TAM, TTF, and UTAUT}, 
  year={2024},
  volume={},
  number={},
  pages={538-548},
  abstract={Background: Businesses of all kinds are breaching into Industry 5.0, and they require pursuing digital transformation (DT) with great aggression as it provides them the leverage in getting a competitive advantage, more numbers on top line as revenue, and much deeper relationships from a customer standpoint. DT is a far-reaching organizational change necessitating the integration of technologies such as blockchain, IoT, AI, and Cloud Computing. This transformation path, however, is riddled with difficulties such as strategy planning, workforce alignment, and technological execution.Objective: The article aims to emphasize the importance of theoretical frameworks to guide successful DT in organizations. It critiques the role of these frameworks in addressing common challenges seen in DT programs.Methodology: The study reviews and analyses a range of theoretical frameworks such as Technology Acceptance Model (TAM), Task-Technology fit, and the Unified Theory of acceptance and use technology (UTAUT) extensively. This article reviews existing models and synthesizes their findings from thorough research in a wide range of organizational environments to understand how they can be applied and have been used within DT projects.Results: The proposed article asserts that the main reason behind most of the failure of DT initiatives is planning which does not take into account many strategic factors and one of those factors are flexible organization and cultural integration. This concludes how the ever-ongoing problem of adopting technology is no longer unexplored by stating that TAM, TTF, and UTAUT can be successfully used to let organizations overcome these hurdles.Conclusions: The article underscores the need for strategic, culturally appropriate approaches to DT and highlights that theoretical underpinnings are integral in this effort. By embedding TAM, TTF, and UTAUT into a typical DT strategy the way businesses navigate their complex environment in time is more likely to acknowledge where technological development should align with strategic goals as well as cultural values. So, this study serves as an invaluable pointers for organizations that want to tread a well-measured course on their road to digital exposure.},
  keywords={Technological innovation;Technology acceptance model;Reviews;Telemedicine;Companies;Planning;Cultural differences;Fifth Industrial Revolution;Artificial intelligence;Assembly},
  doi={10.23919/FRUCT64283.2024.10749924},
  ISSN={2305-7254},
  month={Oct},}@ARTICLE{10750808,
  author={Lei, Ziang and Shi, Jianhua and Luo, Ziren and Cheng, Minghao and Wan, Jiafu},
  journal={IEEE Access}, 
  title={Intelligent Manufacturing From the Perspective of Industry 5.0: Application Review and Prospects}, 
  year={2024},
  volume={12},
  number={},
  pages={167436-167451},
  abstract={While Industry 4.0 improves human productivity, it also raises sustainability and social challenges. Industry 5.0, as a supplement and logical continuation of the Industry 4.0 paradigm, focuses on the development of a human-centric, sustainable, and resilient manufacturing system. This paper reviews the existing literature. First, it discusses the definition and implementation framework for Industry 5.0. Then, it expounds the application status of Industry 5.0 in the field of intelligent manufacturing from four perspectives: digital manufacturing and intelligence, human-centric intelligent manufacturing and production process management, decentralized and resilient production, and sustainable production. It summarizes the role of Industry 5.0 technology in various intelligent manufacturing scenarios, as well as the challenges it faces, and concludes by analyzing Industry 5.0’s potential development direction and future technologies. This paper believes that the application of Industry 5.0 technology will effectively improve the production capacity of intelligent manufacturing systems and promote the development of intelligent manufacturing systems in a safe, efficient, sustainable and resilient direction; the development of Industry 5.0 will focus on giving full play to human creativity, avoiding repetitive labor through human-robot collaboration, and thereby realizing human value.},
  keywords={Fifth Industrial Revolution;Production;Fourth Industrial Revolution;Digital twins;Sustainable development;Service robots;Robots;Industries;Resilience;Smart manufacturing;Human-robot interaction;Internet of Things;Industry 5.0;intelligent manufacturing;digital twin;Internet of Things;human-robot collaboration},
  doi={10.1109/ACCESS.2024.3496697},
  ISSN={2169-3536},
  month={},}@ARTICLE{10747338,
  author={Dhanushkodi, Kavitha and Thejas, S.},
  journal={IEEE Access}, 
  title={AI Enabled Threat Detection: Leveraging Artificial Intelligence for Advanced Security and Cyber Threat Mitigation}, 
  year={2024},
  volume={12},
  number={},
  pages={173127-173136},
  abstract={This comprehensive review examines the role of artificial intelligence (AI) in enhancing threat detection and cybersecurity, focusing on recent advancements and ongoing challenges in this dynamic field. The ability to identify and counteract cybersecurity threats including network breaches, adversarial assaults, and zero-day vulnerabilities has significantly increased with the inclusion of AI, especially machine learning and deep learning techniques. The review underscores the critical role of explainability and resilience in AI models to ensure trustworthiness and reliability in AI-driven security solutions. The studies analyzed span a wide range of sectors, including Industry 5.0, the Internet of Things (IoT), 5G networks, and autonomous vehicles, illustrating AI’s adaptability in tackling unique security issues across these domains. Cutting-edge approaches, such as transformer-based models, federated learning, and blockchain integration, are advancing the development of more robust and real-time threat detection systems. However, challenges persist, particularly in managing large-scale data, enabling real-time processing, and ensuring privacy and security. The review concludes that although substantial progress has been achieved, ongoing research and collaboration are vital to fully harness AI’s potential in securing digital landscapes.},
  keywords={Artificial intelligence;Computer security;Data models;Threat assessment;Adaptation models;Internet of Things;Deep learning;Accuracy;Complexity theory;Analytical models;Intrusion detection;Blockchains;Zero-day vulnerabilities;network intrusion detection;federated learning;blockchain;Internet of Things (IoT);adversarial attacks},
  doi={10.1109/ACCESS.2024.3493957},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10744138,
  author={Ouni, Ridha and Saleem, Kashif and Mohammad, Mohammad and Gawanmeh, Amjad},
  booktitle={2024 7th International Conference on Electrical Engineering and Green Energy (CEEGE)}, 
  title={Equal Transmission Power based Energy Efficient Wireless Sensor Networks for Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={199-205},
  abstract={The world today has progressed in science and technology to an extent unimagined by humans in the past. This scientific development has facilitated our lives in all aspects. All the sectors benefit from science. Industry 5, propelled by advanced automation and AI integration, revolutionizes manufacturing with unprecedented efficiency and customization. Sensors play a vital role in enabling Industry 5.0 by precise monitoring and analysis for informed decision-making. Due to the easiness of deployment, wireless sensor nodes are mostly used devices in the market. Energy consumption remains the primary limitation when these wireless sensors interact with one another in a network as they have a finite amount of energy to operate with—some may not even be rechargeable. In this paper, an energy-efficient algorithm is proposed after experimenting with several scenarios. When intermediary nodes are used as relays in place of direct contact with a remote node, transmission power is reduced. Relaying has the potential to increase energy efficiency in general. The analysis shows that the Equal Transmission Power (ETP) outperforms the other local algorithms.},
  keywords={Wireless communication;Industries;Wireless sensor networks;Sensor phenomena and characterization;Propulsion;Energy efficiency;Volcanoes;Fifth Industrial Revolution;Relays;Monitoring;Algorithm;Communication;Efficient;Energy;Industry 5.0;Power;Transmission;Wireless Sensor Networks},
  doi={10.1109/CEEGE62093.2024.10744138},
  ISSN={},
  month={June},}@INPROCEEDINGS{10739772,
  author={Savranguler, Esma Nur and Gumus, Samed and Ozturk, Yavuz and Harmansah, Coskun},
  booktitle={2024 IEEE 14th International Conference Nanomaterials: Applications & Properties (NAP)}, 
  title={Analysis of Leakage Magnetic Field of Rectangular Shaped Defects in Magnetic Materials and Investigation of Magnetic Fluids in the Field}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Magnetic Particle Inspection (MPI) is a non-destructive testing (NDT) technique widely used in industry to detect surface and sub-surface flaws in ferromagnetic materials. MPI is a simple, fast, and cost-effective technique, particularly useful for evaluating the integrity of welds and critical parts. Detecting surface and sub-surface defects in ferromagnetic materials is essential for ensuring product quality, safety, performance, and regulatory compliance across various industries. Therefore, in this study, the magnetic field and its gradient for rectangular prism-shaped defects in ferromagnetic materials were analyzed. The magnetic fields were calculated using analytical equations. The magnetic field of a 2x7x19 mm sized permanent magnet was measured using a gaussmeter to verify theoretical results. Subsequently, these analyses were used to interpret the forces acting on non-interacting micro to nano-sized particles and magnetic fluid on the crack region. The EFH-1 light hydrocarbon-based magnetic fluid, with an average particle size of about 11.6 nm, was used to experimentally study a 1x1.5x62.5 mm crack on a solid magnetic material. The distribution of the magnetic fluid on the crack was studied for different heights and magnetic field values. For a 2 ml layer of EFH-1 at a height of 2-3.5 mm from the magnetized material, a nearly Gaussian-shaped fluid distribution with a width of around 3.7-5.0 mm was observed. The experimental results are presented and compared with the theoretical analysis.},
  keywords={Industries;Ferrofluid;Welding;Magnetic liquids;Ferromagnetic materials;Solids;Size measurement;Magnetic analysis;Magnetic fields;Testing;NDT;MPI;crack detection;defect;magnetic nanoparticles;magnetic field gradient},
  doi={10.1109/NAP62956.2024.10739772},
  ISSN={},
  month={Sep.},}@ARTICLE{10745828,
  author={Boldo, Michele and De Marchi, Mirco and Martini, Enrico and Aldegheri, Stefano and Bombieri, Nicola},
  journal={IEEE Transactions on Computer-Aided Design of Integrated Circuits and Systems}, 
  title={Domain-Adaptive Online Active Learning for Real-Time Intelligent Video Analytics on Edge Devices}, 
  year={2024},
  volume={43},
  number={11},
  pages={4105-4116},
  abstract={Deep learning (DL) for intelligent video analytics is increasingly pervasive in various application domains, ranging from Healthcare to Industry 5.0. A significant trend involves deploying DL models on edge devices with limited resources. Techniques, such as pruning, quantization, and early exit, have demonstrated the feasibility of real-time inference at the edge by compressing and optimizing deep neural networks (DNNs). However, adapting pretrained models to new and dynamic scenarios remains a significant challenge. While solutions like domain adaptation, active learning (AL), and teacher-student knowledge distillation (KD) contribute to addressing this challenge, they often rely on cloud or well-equipped computing platforms for fine tuning. In this study, we propose a framework for domain-adaptive online AL of DNN models tailored for intelligent video analytics on resource-constrained devices. Our framework employs a KD approach where both teacher and student models are deployed on the edge device. To determine when to retrain the student DNN model without ground-truth or cloud-based teacher inference, our model utilizes singular value decomposition of input data. It implements the identification of key data frames and efficient retraining of the student through the teacher execution at the edge, aiming to prevent model overfitting. We evaluate the framework through two case studies: 1) human pose estimation and 2) car object detection, both implemented on an NVIDIA Jetson NX device.},
  keywords={Training;Adaptation models;Computational modeling;Visual analytics;Pose estimation;Artificial neural networks;Streaming media;Real-time systems;Data models;Integrated circuit modeling;Active learning (AL);edge AI;edge training;human pose estimation (HPE);online distillation;real-time training},
  doi={10.1109/TCAD.2024.3453188},
  ISSN={1937-4151},
  month={Nov},}@INPROCEEDINGS{10741454,
  author={Polverini, Marco and García-Gil, Santiago and García-López, Andrés and Lavacca, Francesco G. and Cianfrani, Antonio and Galán-Jiménez, Jaime},
  booktitle={2024 15th International Conference on Network of the Future (NoF)}, 
  title={DP-DT: Data Plane Digital Twin Architecture to Handle Conflicts among SDN Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={The evolution of networks demands increasingly stringent performance requirements from users, driven by the deployment of innovative services such as augmented reality and self-driving cars. To meet these demands, network management and control tasks require heightened flexibility and responsiveness. Network programmability paradigms, particularly Software Defined Networking (SDN), have emerged as a solution, facilitating the integration of Artificial Intelligence and the deployment of new functionalities. However, The proliferation of heterogeneous control agents in SDN environments can lead to conflicts, resulting in network instability, such as Service Level Agreement (SLA) violations, and inefficient resource usage. Thanks to its ability to enable the execution of what-if analysis, the Digital Twin (DT) technology offers a promising approach to handle conflicts among decisions made by different SDN applications. In this work, we propose a framework that integrates DTs of the network data plane, introducing a new architecture to support synchronization and communication within the ecosystem. Furthermore, a discussion on its integration on the classical SDN workflow is discussed. Additionally, a case study focusing on Industry 5.0 is presented to illustrate the implementation of the data plane DT, demonstrate the effectiveness of the framework in conflict resolution.},
  keywords={Ecosystems;Focusing;Computer architecture;Digital twins;Internet;Autonomous automobiles;Synchronization;Software defined networking;Fifth Industrial Revolution;Service level agreements;Network Digital Twin;SDN;Data Plane;SLA},
  doi={10.1109/NoF62948.2024.10741454},
  ISSN={2833-0072},
  month={Oct},}@INPROCEEDINGS{10741817,
  author={Kuzovkova, Tatyana A. and Sharavova, Olga I. and Sharavova, Maria M.},
  booktitle={2024 International Conference on Engineering Management of Communication and Technology (EMCTECH)}, 
  title={The Role of 5G and 6G Mobile Communication Technologies for Industry 4.0 and the Transition to Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The process of development of Industry 4.0 and the continuous transition to Industry 5.0 is scientifically substantiated, the socio-economic consequences of digital transformation and the requirements of new industrial production for the development of infrastructure and technological capabilities of mobile communication networks of recent generations are formulated. A comprehensive approach is proposed to clarify the key points, structures, elements, dynamics of the phases of actualization of the latest industrial changes and to assess the role of the latest mobile communication generations in these changes. As part of this approach, progress in the technical parameters of mobile communication standards in terms of speed, volume and reliability of data transmission makes it possible to clarify the functional and technological evolution of services and products within 5G and 6G networks.},
  keywords={6G mobile communication;Industries;Technological innovation;5G mobile communication;Scalability;Production;Fourth Industrial Revolution;Fifth Industrial Revolution;Socioeconomics;Standards;Industry 4.0;Industry 5.0;network infrastructure requirements;5G and 6G standards;compliance with new productions},
  doi={10.1109/EMCTECH63049.2024.10741817},
  ISSN={3064-9382},
  month={Oct},}@INPROCEEDINGS{10739507,
  author={Gertsik, Yury and Omelchenko, Irina},
  booktitle={2024 17th International Conference on Management of Large-Scale System Development (MLSD)}, 
  title={The University of a Complete Innovation Cycle as a Promising Model for the Large-Scale Scientific and Educational Ecosystems Development}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={In the world and in Russian Federation, there is a constant search for new forms of educational process that would meet the modern requirements of digitalization of industry, science and society. Universities play a significant role in this process, as centers of intellectual resources attraction. The purpose of this article is to analyze the prerequisites for the new university model of a complete innovation cycle formation in the context of sustainable development.},
  keywords={Industries;Technological innovation;Analytical models;Ecosystems;Entrepreneurship;Trajectory;Large-scale systems;Sustainable development;Artificial intelligence;Context modeling;higher education;complete innovation cycle university;digitalization;sustainable development;Industry 5.0;Society 5.0;cluster;ecosystem},
  doi={10.1109/MLSD61779.2024.10739507},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10739632,
  author={A. I, Razumowsky},
  booktitle={2024 17th International Conference on Management of Large-Scale System Development (MLSD)}, 
  title={Digital Twins in the Context of Industry 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={The report outlines a conceptual and practical approach to establishing the operational framework of digital twins (DTs) within Industry 5.0. It examines the procedure for the development and utilization of cognitive shell-metamodels, which enables the creation, correction, scaling, and deployment of DTs productions and their products of any complexity. The method of cognitive metamodelling for DTs integrates the core properties of DTs software, including 3D modeling, tracking of operational and dynamic changes, configuration management, monitoring of communication relationships, calculation of mass and inertial characteristics, and storage and visualization of chronicles for all operational and dynamic activities. This comprehensive approach enhances the flexibility of the interaction chain: human - DTs - communication channel - physical object, thereby bridging the gap between development, deployment, and scaling stages. In the context of Industry 5.0, applying such cognitive metamodels for DTs can bring all stakeholders involved in development and operation closer together in terms of time and location.},
  keywords={Visualization;Three-dimensional displays;Communication channels;Production;Software;Regulation;Digital twins;Stakeholders;Fifth Industrial Revolution;Optimization;industry 5.0;digital twin;metamodelling;data visualization;3D models;information sharing;permanent deployment},
  doi={10.1109/MLSD61779.2024.10739632},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10725650,
  author={Nimmagadda, Sai Varun and Jammula, Tej Mahanth and Kona, Chandra Naga Sai Manikanta and Sonti, Sasank and Dhuli, V Sateeshkrishna and Dodda, Vineela Chandra},
  booktitle={2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Deep Learning Based Techniques for Corn Plant Disease Detection Using UAV Imagery}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={Plant diseases have become a global concern as they pose a significant threat to food security. These diseases have the potential to cause damage to crops, reduce yields, and compromise food quality. Moreover, the rapid spread of fungi, bacteria, and viruses can lead to widespread crop failures, creating food shortages, price increases, and ultimately, the risk of hunger. However, identifying plant diseases at the early stages remains challenging and time-consuming. Traditional methods of disease identification are often time-consuming and require manual inspection, which slows down timely actions and interventions. In recent years, deep learning-based techniques have shown promising outcomes in the realm of plant disease detection. In this paper, we develop three deep-learning models for the identification of healthy and unhealthy corn plant leaves. The models include a fully convolutional auto-encoder model, and a vision transformer, along with a baseline CNN (Convolutional Neural Network) model. We acquired the data set of corn plant images from UAV drones which were used to train and validate the proposed models. The results indicate that the proposed fully convolutional auto-encoder model achieved an accuracy of $\mathbf{9 5. 0 9 \%}$ outperforming both the Vision Transformer and CNN models. By leveraging deep learning-based techniques, such as the fully convolutional auto-encoder model, the agricultural industry can benefit from improved disease detection and prevention. Early and accurate identification of plant diseases allows for timely interventions, such as crop protection measures, which can ultimately safeguard food security.},
  keywords={Deep learning;Plant diseases;Computer vision;Accuracy;Food security;Production;Transformers;Autonomous aerial vehicles;Convolutional neural networks;Protection;Deep learning;Plant disease;Convolutional neural networks;Vision Transformer;fully convolutional autoencoder;UAV},
  doi={10.1109/ICCCNT61001.2024.10725650},
  ISSN={2473-7674},
  month={June},}@INPROCEEDINGS{10731196,
  author={Solovov, Andrey and Zarei, Mohammad and Gautam, Vishal and Ferreira, Bruno and Assunção, Gustavo and Marin-Hernandez, Antonio and Menezes, Paulo},
  booktitle={2024 33rd IEEE International Conference on Robot and Human Interactive Communication (ROMAN)}, 
  title={Exploring Continuous Awareness Modelling for Improving Worker Safety and Trust*}, 
  year={2024},
  volume={},
  number={},
  pages={417-423},
  abstract={The Industry 5.0 Human-Robot Interaction (HRI) goals have the potential for significantly reducing production costs, but require factory workers to trust that robots will not cause them physical harm when sharing the workspace in order to be achieved. To this end, we propose a model that adjusts the robot’s actions to an estimate of the workers’ awareness of its behavior. Its premise is that mutual awareness should be continuous, and if no recent visual contact has been established, then the robot should adapt its range of motion and speed in order to minimize the intersection between the robot’s space and the worker’s space. On the other hand, if the worker steadily establishes visual contact from times to times, the robot operates under a normal or a faster configuration. After a period of habituation, this awareness model can be further tweaked to continuously improve production times, while improving worker’s safety and trust. We present preliminary results of a pilot study with 32 participants, to asses if the existence of this awareness model impacts the outcomes of the combined task. The obtained tepidly optimistic results are the key to build upon in future designs.},
  keywords={Visualization;Adaptation models;Costs;Service robots;Human-robot interaction;Production facilities;Safety;Motion control;Fifth Industrial Revolution},
  doi={10.1109/RO-MAN60168.2024.10731196},
  ISSN={1944-9437},
  month={Aug},}@INPROCEEDINGS{10731259,
  author={Kaden, Sascha and Schwarz, Lucas and Röhrbein, Florian},
  booktitle={2024 33rd IEEE International Conference on Robot and Human Interactive Communication (ROMAN)}, 
  title={A Research Platform for Human-Robot-Interaction with Focus on Collaborative Assembly Scenarios}, 
  year={2024},
  volume={},
  number={},
  pages={1436-1442},
  abstract={Effective communication between robots and human operators is crucial for seamless collaboration in industrial settings. We aim to capture the requirements of collaborative assembly procedures in the context of the Industry 5.0 paradigm and explore the feasibility of various multi-modal feedback systems, including visual cues, sound effects, and virtual eyes. To achieve this, we present a novel research platform designed to investigate human-robot interaction (HRI) strategies in collaborative assembly tasks. The platform uses LEGO bricks to simulate real-world assembly processes. An experiment is designed in which human and robot collaboratively build a structure, allowing us to investigate potential communication interfaces between them. A preliminary user study provides first insights into the perception of the robot’s visualized intentions and actions by the user. The platform setup is not intended to be a fixed system, but rather a starting point for further investigation and future studies in the field of HRI.},
  keywords={Visualization;Service robots;Human-robot interaction;Collaboration;Fifth Industrial Revolution;Assembly},
  doi={10.1109/RO-MAN60168.2024.10731259},
  ISSN={1944-9437},
  month={Aug},}@INPROCEEDINGS{10731360,
  author={Yang, Shaoze and Bhat, Shreyas and Ren, Yutong and Pridham, Paul and Yang, X. Jessie and Stroup, Terra and Salour, Al},
  booktitle={2024 33rd IEEE International Conference on Robot and Human Interactive Communication (ROMAN)}, 
  title={Identifying Worker Motion Through a Manufacturing Plant: A Finite Automaton Model}, 
  year={2024},
  volume={},
  number={},
  pages={1970-1977},
  abstract={Autonomous Guided Vehicles (AGVs) are becoming increasingly common in industrial environments to transport heavy equipment around warehouses. Within the idea of Industry 5.0, these AGVs are expected to work alongside humans in the same shared workspace. To enable smooth and trustworthy interaction between workers and AGVs, the AGVs must be able to model the workers’ behavior and plan their trajectories around it. In this paper, we introduce a Finite Automaton Model (FAM) to model worker motion in such a context. We conduct a human subject experiment using a Virtual Reality (VR) environment and an omnidirectional treadmill to collect data about worker trajectories to tune our model. We show that not only is our model more interpretable, but also outperforms machine learning models at classifying worker motion behavior with limited training data. Future research can use our model to modify AGV behavior to promote trustworthy human-AGV interaction.},
  keywords={Solid modeling;Accuracy;Learning automata;Layout;Hidden Markov models;Predictive models;Data models;Manufacturing;Trajectory;Context modeling},
  doi={10.1109/RO-MAN60168.2024.10731360},
  ISSN={1944-9437},
  month={Aug},}
