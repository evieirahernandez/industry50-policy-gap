abstract = {Artificial Intelligence is transforming the E-commerce industry by predicting the shopping patterns and providing the customized shopping solutions. The germination phase of Industry 5.0 has provided a collaboration of Cobots and Humans assisting each other at work. The study has been conducted to scrutinize the Employability skills required for the creation of the co-working space for Human and Cobots to work together. Relative Importance Index (RII) & Analytical Hierarchy Process (AHP) is utilized to develop the “Employability Skills Interface for Industry 5.0” for improving work performance in the organisational level.}
}
@article{DOYLEKENT2022425,
title = {The development of a novel educational model to successfully upskill technical workers for Industry 5.0: Ireland a case study},
journal = {IFAC-PapersOnLine},
